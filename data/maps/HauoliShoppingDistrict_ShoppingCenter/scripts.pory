mapscripts HauoliShoppingDistrict_ShoppingCenter_MapScripts {}

script HauoliShoppingDistrict_ShoppingCenter_NPC_Worker
{
    lock
    faceplayer
    setspeaker("Office Worker")
    msgbox(format("Welcome to the Hau'oli City Shopping District! The whole city comes to shop and chat here."))
    closemessage
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_Artist
{
    lock
    faceplayer
    setspeaker("Artist")
    msgbox(format("Look at that stunning painting on the wall!\pI came all the way from the Kalos Region to see it. The building in the distance glows the orange-yellow of {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY}... How stunning!"))
    closemessage
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_CreatorCafeStaff
{
    lock
    faceplayer
    setspeaker("Bellhop")
    msgbox(format("This building-in-a-building is the Creator Café!"))
    waitmessage
    if(flag(FLAG_IS_CHAMPION))
    {
        setspeaker("Bellhop")
        msgbox(format("We're freshly open for business. Come on in!"))
        closemessage
    }
    else
    {
        setspeaker("Bellhop")
        msgbox(format("We're still undergoing final preparations to open. Please come back soon!"))
        closemessage
    }
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_Dancer
{
    lock
    faceplayer
    setspeaker("Dancer")
    msgbox(format("I come here after work to dance my problems away with my Pokémon!"))
    closemessage
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_SightseerF
{
    lock
    faceplayer
    setspeaker("Sightseer")
    msgbox(format("Wow, look at that lady dance! And I never knew {COLOR BLUE}Politoed{COLOR DARK_GRAY} could sing like that!"))
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
    waitmovement(0)
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_SightseerM
{
    lock
    faceplayer
    setspeaker("Sightseer")
    msgbox(format("I heard that in Alola, {COLOR BLUE}Bellossom{COLOR DARK_GRAY} is a Grass and Fire-type Pokémon because it can use the power of the sun more fully here.\pSo... when does it start shooting fire out of its fists?"))
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceUp)
    waitmovement(0)
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_Psychic
{
    lock
    faceplayer
    setspeaker("Psychic")
    msgbox(format("I come here to practice reading people's minds."))
    closemessage
    createplayerfieldmugshot
    msgbox(format("{SPEAKER NAME_PLAYER}Oh yeah? What am I thinking?"))
    closemessage
    delay(30)
    emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
    delay(10)
    setspeaker("Psychic")
    msgbox(format("You're thinking you want to move on! Hey!"))
    closemessage
    release
    end
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_Backpacker
{
    lock
    faceplayer
    setspeaker("Backpacker")
    msgbox(format("We came here to visit the Creator Café. It sounds like a lot of important people visit there... I wonder how strong they are!"))
    closemessage
    release
    end
}

