script HauoliShoppingDistrict_ShoppingCenter_NPC_Jester
{
    lock
    faceplayer
    setspeaker("Jester")
    msgbox(format("Why won't my opponent take me seriously! I'm a great {COLOR BLUE}Pokémon TCG{COLOR DARK_GRAY} player!"))
