// --------------------------------------------- Shop Scripts ----------------------------------------------

script HauoliShoppingDistrict_ShoppingCenter_NPC_RangerGardenShop
{
    lock
    faceplayer
    setspeaker("Ranger")
    msgbox(format("Alola! We sell a variety of plants, along with whatever we find while we dig.\pAre you looking to shop here?"))
    waitmessage
    pokemart(Mart_HauoliShoppingDistrict_Garden)

    setspeaker("Ranger")
	msgbox("Come on back now!")
	release
    end
}

// Can you tell idrk what to sell here LMFAO
// Maybe EV-boosting items like Feathers rebranded to be flowers?
// OH OR BERRIES? Eyeball emoji eyeball emoji
mart Mart_HauoliShoppingDistrict_Garden {
	ITEM_GRACIDEA
    ITEM_NEST_BALL
	ITEM_LOVE_BALL
}

script HauoliShoppingDistrict_ShoppingCenter_NPC_PokemonTCGShop
{
    lock
    faceplayer
    setspeaker("TCG Collector")
    msgbox(format("Alola! We sell {COLOR BLUE}Pokémon TCG{COLOR DARK_GRAY}cards.\pHow can I help you?"))
    waitmessage
    pokemart(Mart_HauoliShoppingDistrict_PokemonTCG)

    setspeaker("TCG Collector")
	msgbox("Come back soon!")
	release
    end
}

