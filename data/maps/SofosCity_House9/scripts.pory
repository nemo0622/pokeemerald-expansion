mapscripts SofosCity_House9_MapScripts {}

script SofosCity_House9_EventScript_Nemo
{
    lock
    faceplayer
    speakername("Nemo")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_NEMOS_QUEST)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("I hope you're enjoying your time in the Ilios Region! I should get back to my University work, ehehe."))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_NEMOS_QUEST)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Chaire! I'm Nemo, the developer of Pokémon Lazarus. I hope you're enjoying the Ilios Region - a lot of love and time has gone into it!\p My University Capstone paper was on Hawaiian Honeycreepers, a group of birds endemic to Hawaii. Oricorio was inspired by these incredible birds, so it has become one of my favorites.\p Show me {COLOR GREEN}all four Oricorio Forms{COLOR DARK_GRAY} in your party, and I'll give you something special!"))
        closemessage

        delay(20)
        startquest(QUEST_NEMOS_QUEST)
    }
    else
    {
        msgbox(format("Hey there! You having fun filling up the Pokédex? I hope it's making you think about Biology and conservation. That's the whole motivation behind making this game, you know!\p Right, the Quest I gave you. Show me your {COLOR GREEN}Oricorio Forms{COLOR DARK_GRAY}! First, your {COLOR GREEN}Baile Form{COLOR DARK_GRAY} Oricorio..."))
        closemessage

        checkforspecieslocal(SPECIES_ORICORIO_BAILE, OPEN_PARTY_SCREEN)
        if(var(VAR_RESULT) == TRUE)
        {
            speakername("Nemo")
            msgbox(format("Oricorio's {COLOR GREEN}Baile Form{COLOR DARK_GRAY}! Look at that amazing dancing! Now, how about Oricorio {COLOR GREEN}Pom Pom Form{COLOR DARK_GRAY}?"))
            closemessage
            checkforspecieslocal(SPECIES_ORICORIO_POM_POM, OPEN_PARTY_SCREEN)
            if(var(VAR_RESULT) == TRUE)
            {
                speakername("Nemo")
                msgbox(format("Oricorio's {COLOR GREEN}Pom Pom Form{COLOR DARK_GRAY}! I love their energy. Now, how about Oricorio {COLOR GREEN}Pau Form{COLOR DARK_GRAY}?"))
                closemessage
                checkforspecieslocal(SPECIES_ORICORIO_PAU, OPEN_PARTY_SCREEN)
                if(var(VAR_RESULT) == TRUE)
                {
                    speakername("Nemo")
                    msgbox(format("Oricorio's {COLOR GREEN}Pau Form{COLOR DARK_GRAY}! Swaying like that makes me want to dance, too. Lastly, how about Oricorio {COLOR GREEN}Sensu Form{COLOR DARK_GRAY}?"))
                    closemessage
                    checkforspecieslocal(SPECIES_ORICORIO_SENSU, OPEN_PARTY_SCREEN)
                }
            }
        }
        delay(30)

        if(var(VAR_RESULT) == 0)
        {
            speakername("Nemo")
            msgbox(format("Looks like you've still got some Oricorio catching to do!\p Remember, I want you to show me {COLOR GREEN}all four Oricorio Forms{COLOR DARK_GRAY}. Come visit me when you've caught them!"))
            closemessage
        }
        else
        {
            speakername("Nemo")
            msgbox(format("Fire, Electric, Psychic, and Ghost! Hey, you've caught them all! My University Capstone was on Hawaiian Honeycreepers, so Oricorio will always be special to me.\p I'm sure that was a lot of work, ehehe. Here's something to help you on your journey."))
            closemessage
            delay(5)
            giveitem(ITEM_GLIMMERING_CHARM)
            closemessage
            delay(5)
            speakername("Nemo")
            msgbox(format("The {COLOR GREEN}Glimmering Charm{COLOR DARK_GRAY} boosts the odds of finding wild Pokémon {COLOR GREEN}holding an item{COLOR DARK_GRAY}! That should be helpful if you're looking for a specific item.\p I hope you continue to enjoy your time in the Ilios Region! Working on the game while finishing college and starting a Master's program in Biology has been a lot to handle, but I hope the love and care I feel for wildlife and Pokémon shows in the final product."))
            closemessage

            speakername("Nemo")
            msgbox(format("Oh wait, one more thing! Here's a Cabin Decoration from me!"))
            closemessage
            delay(5)
            givedecoration(DECOR_ORICORIO_DOLL)
            closemessage

            delay(20)
            completequest(QUEST_NEMOS_QUEST)
        }
    }
    release
    end
}

script SofosCity_House9_EventScript_Tyrunt
{
    lock
    faceplayer
    speakername("Tyrunt")
    playmoncry(SPECIES_TYRUNT, CRY_MODE_NORMAL)
    msgbox("Wroooar!")
    waitmoncry
    closemessage
    release
    end
}
