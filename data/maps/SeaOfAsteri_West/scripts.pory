script AsteriSea_EventScript_NPC_ExpertM
{
    lock
    faceplayer
    speakername("Old Man")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_ASTERI_SEA_PEARL_STRING)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Thanks to you, my wife will have her Pearl String necklace back! Once I'm all rested up, I'll take a nice swim back to Marmaro Island."))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_ASTERI_SEA_PEARL_STRING)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Perfect, a young Trainer is just who I needed! I'm in quite a pickle here...\p I bought a {COLOR GREEN}Pearl String{COLOR DARK_GRAY} necklace for my wife when we were married, and she's worn it every day since. When I was young, I made it out of Pearls I found here, so I bring it back every few months to wash it in the sea. But my old hands aren't what they used to be, so I dropped it into the Crescent Trench!\p Please, if you could {COLOR GREEN}Dive{COLOR DARK_GRAY} into the water and {COLOR GREEN}bring the Pearl String{COLOR DARK_GRAY}, it would mean the world!"))
        closemessage
        applymovement(9, Common_Movement_FaceLeft)
        waitmovement(0)

        delay(20)
        startquest(QUEST_ASTERI_SEA_PEARL_STRING)
    }
    else
    {
        msgbox(format("Oh, hi there. Did you happen to find the {COLOR GREEN}Pearl String{COLOR DARK_GRAY} I lost?"))
        closemessage

        checkitem(ITEM_PEARL_STRING)
        delay(30)
        if(var(VAR_RESULT) == FALSE)
        {
            speakername("Old Man")
            msgbox(format("Nothing, huh? It's alright, I knew it was a long shot, anyway...\p If you happen to find a {COLOR GREEN}Pearl String{COLOR DARK_GRAY}, please bring it back to me!"))
            closemessage
            applymovement(9, Common_Movement_FaceLeft)
            waitmovement(0)
            release
            end
        }
        else
        {
            applymovement(9, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(10)
            speakername("Old Man")
            msgbox(format("That's it! A {COLOR GREEN}Pearl String{COLOR DARK_GRAY} necklace! It must be the one I dropped!\p This was an important keepsake for us. Please, take this as my thanks."))
            closemessage
            delay(5)
            giveitem(ITEM_EXP_CANDY_L)
            closemessage
            
            delay(20)
            completequest(QUEST_ASTERI_SEA_PEARL_STRING)
        }
    }
    release
    end
}

