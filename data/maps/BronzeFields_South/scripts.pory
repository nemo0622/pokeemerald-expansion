mapscripts BronzeFields_South_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        // NOTE: NO OVERWORLD ENCOUNTERS ON THIS MAP!
        // the windmills fuck with them badly like 1 in 20 times it's weird. whatever

        if(flag(FLAG_CHIMERA_WEATHER_ACTIVE))
        {
            setweather(WEATHER_ABNORMAL)
        }

        // windmill management sigh
        clearflag(FLAG_TRIGGERED_WINDMILL_SPAWN)
    }

    MAP_SCRIPT_ON_RETURN_TO_FIELD {
        goto(BronzeFields_South_SpawnWindmillVirtualObjects)
    }
}

script BronzeFields_South_EventScript_DirectionSign
{
    lock
    msgbox(format("Bronze Fields - South\n The Farmer's Delight\p {UP_ARROW} Bronze Fields - North\n Jusmail Town {DOWN_ARROW}"))
    closemessage
    release
    end
}

script BronzeFields_South_EventScript_UniversityStudentRouteCheck
{
    lock
    faceplayer
    speakername("Uni. Student")

    if(flag(FLAG_CAUGHT_ALL_MONS_BRONZE_FIELDS))
    {
        msgbox(format("Your Pokédex data is amazing! Now we know more about the local ecosystem, thanks to you."))
        closemessage
    }
    else
    {
        msgbox(format("Chaire (Hyeh-rei)! I'm a student from the Acrisia University.\p I'm looking for {COLOR GREEN}Pokédex data{COLOR DARK_GRAY} of {COLOR GREEN}all Land Pokémon{COLOR DARK_GRAY} found in the southern Bronze Fields. If you've caught all the Pokémon here, please let me know."))
        closemessage
        special(CheckRouteCaptureProgress)
        if(var(VAR_RESULT) == TRUE) // caught all mons on the route!
        {
            delay(20)
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Uni. Student")
            msgbox(format("Incredible! You've caught all the Pokémon that I requested in the area!\p Here's a reward from the University. Keep up your hard work!"))
            closemessage
            delay(5)

            // give reward!
            giveitem(ITEM_BRIGHT_POWDER)
            closemessage

            setflag(FLAG_CAUGHT_ALL_MONS_BRONZE_FIELDS)
        }
    }

    release
    end
}

script BronzeFields_South_EventScript_TriggerWindmillSpawn
{
    setflag(FLAG_TRIGGERED_WINDMILL_SPAWN) // marks that the player has taken >1 step into the route, avoiding interference with event object spawning
    goto(BronzeFields_South_SpawnWindmillVirtualObjects)
}

// Function called by triggers on the entrance tiles of the route!
script BronzeFields_South_SpawnWindmillVirtualObjects
{
    // windmill tiles
    if(flag(FLAG_TRIGGERED_WINDMILL_SPAWN)) // if >1 step has been taken into the route and the mills have not been spawned yet, spawn them!
    {
        createvobject(OBJ_EVENT_GFX_WINDMILL_TL, 15, 22, 27, 4, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_WINDMILL_TR, 16, 26, 27, 4, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_WINDMILL_BL, 17, 22, 31, 4, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_WINDMILL_BR, 18, 26, 31, 4, DIR_SOUTH)
        // setvar(VAR_TEMP_A, 1) // marks them as spawned for now
    }
    release
    end
}

// TRAINER & NPC SCRIPTS

script BronzeFields_South_EventScript_Trainer_BronzeFields_Emerick
{
    trainerbattle_single(TRAINER_EMERICK_BRONZEFIELDS, BronzeFields_South_Text_Trainer_BronzePass_EmerickIntro, BronzeFields_South_Text_Trainer_BronzePass_EmerickDefeat)
    speakername("Emerick")
    msgbox(format("Workin' the farm is tough, but my Pokémon do their best to help me out."))
    closemessage
    release
    end
}
text BronzeFields_South_Text_Trainer_BronzePass_EmerickIntro
{
    format("My Pokémon are farm-raised beauties! Think ya can win against me?")
}
text BronzeFields_South_Text_Trainer_BronzePass_EmerickDefeat
{
    format("Bwahaha! Looks like I need a li'l more trainin'!")
}

script BronzeFields_South_EventScript_Trainer_BronzeFields_Joseph
{
    trainerbattle_single(TRAINER_JOSEPH_BRONZEFIELDS, BronzeFields_South_Text_Trainer_BronzePass_JosephIntro, BronzeFields_South_Text_Trainer_BronzePass_JosephDefeat)
    speakername("Joseph")
    msgbox(format("ACHOO! Why did I become a farmer? I'm allergic to hay!"))
    closemessage
    release
    end
}
text BronzeFields_South_Text_Trainer_BronzePass_JosephIntro
{
    format("Ahh.. ahh... ACHOO! M-my allergies're bad right now...")
}
text BronzeFields_South_Text_Trainer_BronzePass_JosephDefeat
{
    format("My eyes were jus' watery, that's why I lost!")
}

script BronzeFields_South_EventScript_NPC_Man1
{
    lock
    faceplayer
    speakername("Man")
