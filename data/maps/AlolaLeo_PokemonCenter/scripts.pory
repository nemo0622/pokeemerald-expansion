mapscripts AlolaLeo_PokemonCenter_MapScripts {}

script NPC_AlolanNurse
{
    lock
	faceplayer
	setspeaker("Nurse")
	msgbox(format("Alola, welcome to our Pokémon Center! Would you like to heal your Pokémon?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == TRUE)
	{
		setspeaker("Nurse")
		msgbox(format("Great! I'll take your Pokémon for a moment..."))
		closemessage
		applymovement(VAR_LAST_TALKED, moves(walk_in_place_slow_left * 3, delay_16, face_down, step_end))
		waitmovement(0)
		special(HealPlayerParty)
		delay(10)
		applymovement(VAR_LAST_TALKED, Movement_PkmnCenterNurse_Bow)
		waitmovement(0)
		setspeaker("Nurse")
		msgbox(format("Your Pokémon are feeling better. Have a good day!"))
		closemessage
	}
	else
	{
		setspeaker("Nurse")
		msgbox(format("Come back soon!"))
		closemessage
	}
	release
	end
}

script NPC_Pokemon_Comfey
{
	lock
    faceplayer
    setspeaker("Comfey")
    playmoncry(SPECIES_COMFEY, CRY_MODE_NORMAL)
    msgbox(format("Bree-ey!"))
    waitmoncry
    closemessage
	createplayerfieldmugshot
	msgbox(format("{SPEAKER NAME_PLAYER}Hey there, {COLOR BLUE}Comfey{COLOR DARK_GRAY}! Thanks for lending us your healing aura!"))
	closemessage
    release
    end
}

// ---------------------------------------------------------------------------------------------------------

script AlolaLeo_PokemonCenter_NPC_MartClerk
{
	lock
    setspeaker("Clerk")
	message("Alola, cuz! How can I help ya?")
	waitmessage
	pokemart(Mart_AlolaLeo)
    setspeaker("Clerk")
	msgbox("Come on back now!")
	release
    end
}

mart Mart_AlolaLeo {
	ITEM_POKE_BALL
	ITEM_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_AWAKENING
    ITEM_BURN_HEAL
    ITEM_ICE_HEAL
    ITEM_REPEL
}

