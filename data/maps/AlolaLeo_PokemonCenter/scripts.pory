script AlolaLeo_PokemonCenter_NPC_Lady
{
    lock
    faceplayer
    setspeaker("Lady")
    msgbox(format("Every Pokémon Center has a Café, and each Café has a unique drink. One day, I'll try them all!"))
    closemessage
    release
    end
}

script AlolaLeo_PokemonCenter_NPC_Singer
{
    lock
    faceplayer
    setspeaker("Singer")
    msgbox(format("I come down to the Pokémon Center every day. It's a lot quieter out here than in Hau'oli City."))
    closemessage
    release
    end
}

script AlolaLeo_PokemonCenter_NPC_FarmerF
{
    lock
    faceplayer
    setspeaker("Farmer")
    msgbox(format("My family's been ranching in Paniola Town for generations. I was riding {COLOR BLUE}Tauros{COLOR DARK_GRAY} before I could walk!"))
    closemessage
    release
    end
}

script AlolaLeo_PokemonCenter_Pokemon_Herdier
{
	lock
    faceplayer
    setspeaker("Herdier")
    playmoncry(SPECIES_HERDIER, CRY_MODE_NORMAL)
    msgbox(format("Bwouf!"))
    waitmoncry
    closemessage
    msgbox(format("Pet the {COLOR BLUE}Herdier{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == TRUE)
    {
        getobjectfacingdirection(LOCALID_PLAYER, VAR_TEMP_1)
        if(var(VAR_TEMP_1) == DIR_NORTH)
        {
            applymovement(LOCALID_PLAYER, moves(walk_in_place_slow_up * 2, step_end))
        }
        else
        {
            applymovement(LOCALID_PLAYER, moves(walk_in_place_slow_right * 2, step_end))
        }
        waitmovement(0)
        delay(10)
        emote(VAR_LAST_TALKED, EMOTE_HEART)
        delay(10)
        createplayerfieldmugshot
        msgbox(format("{SPEAKER NAME_PLAYER}Aw, good little buddy!"))
        closemessage
    }
    release
    end
}

