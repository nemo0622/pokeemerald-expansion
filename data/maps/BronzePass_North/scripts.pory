mapscripts BronzePass_North_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(8, ENCOUNTER_LAND)
        setobjectaswildencounter(9, ENCOUNTER_LAND)
        setobjectaswildencounter(10, ENCOUNTER_LAND)
        setobjectaswildencounter(11, ENCOUNTER_LAND)
        setobjectaswildencounter(12, ENCOUNTER_LAND)
    }
}

script BronzePass_North_EventScript_ChimeraThug
{
    lock
    speakername("Thug")
    msgbox(format("Gahaha, gimme your stuff! I know you've got a Pokédex in here somewhere!"))
    closemessage
    delay(30)
    emote(2, EMOTE_EXCLAM) // emotes exclamation mark
    delay(30)
    faceplayer
    speakername("Thug")
    msgbox(format("Get outta here, you! The work of Team Chimera is none of your business..."))
    closemessage
    applymovement(2, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script BronzePass_North_EventScript_Deliveryman
{
    lock
    faceplayer
    speakername("Deliveryman")

    // Already did the lost Pokédex delivery event
    if(flag(FLAG_FOUND_LOST_DELIVERY))
    {
        msgbox(format("Phew, that was a close call. That thug got away with a few trinkets, but nothing too valuable.\p Now I just have to... clean all this up... hm."))
        closemessage
        release
        end
    }
    else
    {
        // Do event!!
        msgbox(format("You! You have to help me! This guy attacked my Mudbray and is trying to rob me!"))
        closemessage
        applymovement(2, BronzePass_North_Movement_ChimeraEmphasizes)
        waitmovement(0)
        speakername("Thug")
        msgbox(format("Quit stalling for time, I know you've got good stuff here! I've knocked out your Pokémon, I'll knock you out next!"))
        closemessage
        ballfollowingmon
        applymovement(2, BronzePass_North_Movement_ChimeraConfrontsPlayer)
        waitmovement(0)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
        waitmovement(0)
        speakername("Thug")
        msgbox(format("Trying to stop me, eh? I'll teach you a lesson!"))
        closemessage
        // TRAINER BATTLE HERE!
        trainerbattle_no_intro(TRAINER_BRONZE_PASS_CHIMERA_GRUNT, BronzePass_North_Text_ChimeraGruntDefeated)

        speakername("Chimera Grunt")
        msgbox(format("The Boss is gonna freak... well, they shouldn't have sent a new recruit like me out here anyway.\p You just got lucky, kid! I'll get you for this!"))
        closemessage
        applymovement(2, BronzePass_North_Movement_ChimeraGruntExits)
        waitmovement(0)
        removeobject(2)
        delay(20)

        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        waitmovement(0)
        speakername("Deliveryman")
        msgbox(format("Thanks for saving me, buddy! You're a new student at the University, right? Turns out, that's right where I was headed with this delivery.\p I've got to stay behind and clean this up. Here, take this {COLOR GREEN}package{COLOR DARK_GRAY} and bring it {COLOR GREEN}back to the University{COLOR DARK_GRAY}, I'm sure they'll want it."))
        closemessage
        giveitem(ITEM_PARCEL)
        setflag(FLAG_FOUND_LOST_DELIVERY)
    }

    release
    end
}

text BronzePass_North_Text_ChimeraGruntDefeated
{
    format("Urgh, you're stronger than you look...")
}

movement BronzePass_North_Movement_ChimeraEmphasizes
{
    walk_in_place_right * 2
    step_end
}

movement BronzePass_North_Movement_ChimeraConfrontsPlayer
{
    walk_down
    face_right
    step_end
}

movement BronzePass_North_Movement_ChimeraGruntExits
{
    walk_fast_left * 6
    walk_fast_down * 3
    walk_fast_left
    walk_fast_down * 4
    step_end
}

// -------------------------------------------------------------------------------------------------------
// -------------------------------------------------------------------------------------------------------

script BronzePass_North_EventScript_PreventPassingSouth_GotParcel
{
    lock
    applymovement(13, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Little Girl")
    msgbox(format("E-excuse me... I think that deliveryman is in trouble! I ran away to hide from the scary man over here. Please, you have to help!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)
    release
    end
}

script BronzePass_North_EventScript_LittleGirlBlockingExit
{
    lock
    faceplayer
    speakername("Little Girl")
    if(var(VAR_INTRO_STATE) == 2)
    {
        msgbox(format("I'm too scared of that scary man to move... Please, don't go away without helping!"))
        closemessage
    }
    else
    {
        msgbox(format("The scary man is gone! Thank you!"))
        closemessage
    }
    release
    end
}

