script BronzePass_North_EventScript_Trainer_BronzePass_Chip
{
    trainerbattle_single(TRAINER_BRONZEPASS_CHIP, BronzePass_North_Text_Trainer_BronzePass_ChipIntro, BronzePass_North_Text_Trainer_BronzePass_ChipDefeat)
    speakername("Chip")
    msgbox(format("I guess I need to train my Bug Pokémon more."))
    closemessage
    release
    end
}
text BronzePass_North_Text_Trainer_BronzePass_ChipIntro
{
    format("You'll never beat my Bug Pokémon!")
}
text BronzePass_North_Text_Trainer_BronzePass_ChipDefeat
{
    format("W-what? My Bug Pokémon!")
}

