mapscripts HauoliShoppingDistrict_MalasadaShop_MapScripts {}

script HauoliShoppingDistrict_MalasadaShop_Pokemon_Pichu
{
	lock
    faceplayer
    setspeaker("Pichu")
    playmoncry(SPECIES_PICHU, CRY_MODE_NORMAL)
    msgbox(format("Chuu!"))
    waitmoncry
    closemessage
    msgbox(format("{COLOR BLUE}Pichu{COLOR DARK_GRAY} has a Malasada in its mouth!"))
    closemessage
    release
    end
}

script HauoliShoppingDistrict_MalasadaShop_NPC_Employee
{
    lock
    faceplayer
    setspeaker("Waitress")
    msgbox(format("Alola! Would you like to try our food today?"))
    waitmessage
    pokemart(Mart_HauoliShoppingDistrict_MalasadaShop)

    setspeaker("Waitress")
	msgbox("Until next time!")
	release
    end
}

mart Mart_HauoliShoppingDistrict_MalasadaShop {
	ITEM_BIG_MALASADA
    ITEM_CASTELIACONE
}

// -------------------------------------------------------------------------------------------------

script HauoliShoppingDistrict_MalasadaShop_NPC_Hiker
{
    lock
    faceplayer
    setspeaker("Hiker")
    msgbox(format("These Malasadas are delicious! If I were a Pokémon, I bet I'd still love them!"))
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

