mapscripts PalatiCity_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_PALATI_CITY)

        if(!flag(FLAG_CHIMERA_WEATHER_ACTIVE)) // skips running script in ON_FRAME_TABLE, so the map label will show normally!
        {
            setvar(VAR_TEMP_1, 1)
        }

        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(31, ENCOUNTER_LAND)
        setobjectaswildencounter(32, ENCOUNTER_LAND)
        setobjectaswildencounter(33, ENCOUNTER_LAND)
        setobjectaswildencounter(34, ENCOUNTER_LAND)
    }

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: PalatiCity_EventScript_TryChimeraEvent
    ]
}

script PalatiCity_EventScript_TryChimeraEvent
{
    setvar(VAR_TEMP_1, 1)
    setweather(WEATHER_RAIN_THUNDERSTORM) // no matter what, by getting here, Chimera weather is active! uh oh!
    doweather
    if(flag(FLAG_BADGE07_GET) && !flag(FLAG_DID_CHIMERA_EVENT_PALATI_CITY))
    {
        goto(PalatiCity_EventScript_ChimeraEvent)
    }
    releaseall
    end
}

script PalatiCity_EventScript_ChimeraEvent
{
    setvar(VAR_TEMP_1, 1)

    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
    delay(10)
    applymovement(40, Common_Movement_WalkDown)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    delay(10)
    speakername("Rhadine")
    msgbox(format("It hasn't stormed this badly in generations. Did Team Chimera finally do it?\p {PLAYER}, you've been fighting Team Chimera across the region, right? Then you know better than anyone how desperately they want control over land, sea, and sky. Us Gym Leaders discovered their plan to summon a trio of Legendary Pokémon: {COLOR GREEN}Raikou, Entei, and Suicune{COLOR DARK_GRAY}. These would give Team Chimera absolute control of the region, to do with as they please."))
    closemessage
    delay(10)

    // rania comes up
    speakername("???")
    msgbox(format("{PLAYER}! Thank the Fates, you're here!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    waitmovement(0)
    emote(OBJ_EVENT_ID_PLAYER, EMOTE_QUESTION)
    applymovement(41, PalatiCity_Movement_RaniaApproachesPlayer)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("Piraeus said you'd be here! I sailed with him from Sofos City as fast as I could, but it looks like the weather beat me.\p Niko and I were in Sofos City to study the Acropolis Temple, when Team Chimera burst in and took over! I managed to slip out, but {COLOR RED}one of the Admins captured him{COLOR DARK_GRAY}... If we're going to fight back, I need your help. Please, come to Sofos City with me!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Rhadine")
    msgbox(format("I'll come too! If the rumors are true, then Team Chimera might have already awakened Legendary Pokémon. Come on!"))
    closemessage
    
    warp(MAP_SOFOS_CITY_ACROPOLIS, 5, 10)
    waitstate
    release
    end

    // Then warp to the Sofos City Acropolis Temple, where all NPCs will be hidden and Kalliope will be standing
    // with her Admins and the Legendary Beasts. Niko will also be there, held captive by the Admins.
    // Using the Ancient Machine, Kalliope will transform them into
    // Gouging Fire, Raging Bolt, and Walking Wake. She will then send the Admins across the Region to find Kyogre (Sunken Temple)
    // and Groudon (Satyr's Lair), while she goes to the Tower of Dioxippus to conquer Rayquaza.
    // Her goal is stated to be complete control over the Land, the Sea, and the Sky, so to do that, she needs
    // to destroy any competition (the Weather Trio).
    // Team Chimera defeats Rhadine in a flash and escapes, leaving the Player with Rania, Niko, and Rhadine.
    // Rhadine returns to Palati City to protect her island, and Rania and Niko return to Acrisia City to keep
    // the University safe, expecting it to be a target for Team Chimera (ooo anti-education-conservative subtext here!)
    // This leaves the Player to find and fight the Admins before unlocking the Tower of Dioxippus, where a battle with
    // Kalliope takes place.
}

movement PalatiCity_Movement_RaniaApproachesPlayer
{
    walk_right * 8
    walk_up
    face_up
    step_end
}

