script PalatiCity_EventScript_ManLookingAtArchen
{
    lock
    faceplayer
    speakername("Archen Fan")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_SHOW_MAN_ARCHEN_FROM_PARTY)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("I'm a lot happier now that I've seen your Archen up close. I'd love to catch that one on top of the Gym someday, though."))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_SHOW_MAN_ARCHEN_FROM_PARTY)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Hey! Do you see that Archen up there? I'd love to learn more about it, but I can't chase any down..."))
        closemessage
        delay(30)
        emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
        speakername("Archen Fan")
        msgbox(format("Wait, that's a Rotom Phone! And those are Poké balls on your belt! I bet you can help me.\p {COLOR GREEN}Catch an Archen{COLOR DARK_GRAY} and show me from your {COLOR GREEN}Party{COLOR DARK_GRAY} so I can see one up-close. I'll give you a little something as thanks!"))
        closemessage
        delay(20)
        startquest(QUEST_SHOW_MAN_ARCHEN_FROM_PARTY)
    }
    else
    {
        msgbox(format("I'm still chasing down Archens in the wild, but it's not going well. Do you happen to have one?"))
        closemessage

        checkforspecieslocal(SPECIES_ARCHEN, OPEN_PARTY_SCREEN)
        delay(30)
        if(var(VAR_RESULT) != SPECIES_ARCHEN)
        {
            speakername("Archen Fan")
            msgbox(format("Doesn't look like you've had any luck catching an Archen, either.\p Show me an {COLOR GREEN}Archen from your Party{COLOR DARK_GRAY} if you can catch one. I'd love to see one up-close."))
            closemessage
        }
        else
        {
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Archen Fan")
            msgbox(format("Ehehe, look at that! Wow, it's so cool...\p Thanks for showing me. One day, I know I'll catch one for myself! Here's something for your help."))
            closemessage
            delay(5)
            giveitem(ITEM_NEST_BALL, 10)
            closemessage
            delay(20)
            completequest(QUEST_SHOW_MAN_ARCHEN_FROM_PARTY)
        }
    }
    release
    end
}

