mapscripts FrescoIsles_Gym_MapScripts {}

script FrescoIsles_Gym_EventScript_GymStatue
{
    lock
    if(flag(FLAG_BADGE06_GET))
    {
        msgbox(format("Fresco Isles Pokémon Gym\p Recent Victors: Rania, {PLAYER}"))
    }
    else
    {
        msgbox(format("Fresco Isles Pokémon Gym\p Recent Victors: Rania"))
    }
    closemessage
    release
    end
}

script FrescoIsles_Gym_EventScript_GymMan
{
    lock
    faceplayer
    speakername("Gym Guide")
    if(flag(FLAG_BADGE06_GET))
    {
        msgbox(format("Incredible! You're a rising star! Keep it up, future Champ!"))
    }
    else
    {
        msgbox(format("Welcome to the Fresco Isles Gym!\p Thalia and Melpomene are the Twin Muses of Comedy and Tragedy who run this Gym. They are opposites in many ways, including which Pokémon they use. Thalia uses energetic {COLOR GREEN}Electric-type{COLOR DARK_GRAY} Pokémon, while Melpomene uses slow, somber {COLOR GREEN}Ground-type{COLOR DARK_GRAY} Pokémon. Although their Pokémon are opposites, they make quite the duo!"))
    }
    closemessage
    release
    end
}

script FrescoIsles_Gym_EventScript_Raichu
{
    lock
    faceplayer
    speakername("Raichu")
    playmoncry(SPECIES_RAICHU_ALOLAN, CRY_MODE_NORMAL)
    msgbox("Squee!")
    waitmoncry
    closemessage
    msgbox(format("Raichu is hovering around Thalia, sparking with energy!"))
    closemessage
    release
    end
}

script FrescoIsles_Gym_EventScript_Steelix
{
    lock
    faceplayer
    speakername("Steelix")
    playmoncry(SPECIES_STEELIX, CRY_MODE_NORMAL)
    msgbox("Kruuuaaah...!")
    waitmoncry
    closemessage
    msgbox(format("Steelix looks serious... That might just be how a Steelix looks, though."))
    closemessage
    release
    end
}

