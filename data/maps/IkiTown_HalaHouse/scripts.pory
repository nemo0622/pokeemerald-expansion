mapscripts IkiTown_HalaHouse_MapScripts {}

script IkiTown_HalaHouse_Rowlet
{
    lock
    faceplayer
    setspeaker("Rowlet")
    playmoncry(SPECIES_ROWLET, CRY_MODE_NORMAL)
    msgbox(format("Koo, hoo...!"))
    waitmoncry
    closemessage
    release
    end
}

