script IkiTown_HalaHouse_Hala
{
    lock
    faceplayer
    setspeaker("Hala")
    msgbox(format("{PLAYER}! Welcome in!\p I can see why {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY} revealed itself to you. With your {COLOR GREEN}Z-Power Ring{COLOR DARK_GRAY}, you should be able to progress through the Island Challenge just fine!"))
    closemessage
    release
    end
}
