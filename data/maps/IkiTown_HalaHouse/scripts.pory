script IkiTown_HalaHouse_Hau
{
    lock
    faceplayer
    setspeaker("Hau")
    msgbox(format("Alola! You came by!\p This is Hala's house, but I've been living with him for years.\p I learned so much from our battle during the Manalo Festival... I gotta give you somethin' in return!"))
    closemessage
    giveitem(ITEM_QUICK_BALL, 5)
    closemessage
    setspeaker("Hau")
    msgbox(format("Quick Balls are best at catching Pokémon when you first start a battle. Perfect for picking up new Pokémon, yeah?\p Awrite, I'm gonna head over to the {COLOR GREEN}Alola Leo Trainer School{COLOR DARK_GRAY}! You should come by after talking with Kukui!"))
    closemessage

    delay(10)
    fadescreen(FADE_TO_BLACK)
    delay(30)
    setflag(FLAG_HIDE_HAU_HALAS_HOME)
    setflag(FLAG_HIDE_HAUS_ROWLET_HALAS_HOME)
    setflag(FLAG_HIDE_HAUS_LITTEN_HALAS_HOME)
    setflag(FLAG_HIDE_HAUS_POPPLIO_HALAS_HOME)
    removeobject(2)
    removeobject(3)
    removeobject(7)
    removeobject(8)
    delay(30)
    fadescreen(FADE_FROM_BLACK)
    delay(10)
    release
    end
}

