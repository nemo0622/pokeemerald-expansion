script JusmailTown_EventScript_LittleGirlWithWishingStar
{

	lock
	faceplayer
    speakername("Little Girl")
	if(!flag(FLAG_SPOKE_TO_WISHING_STAR_LITTLE_GIRL))
	{
		msgbox(format("See that broken well?\N It's actually a Wishing Well, and it grants wishes! Really!"))
		closemessage
        speakername("Little Girl")
		msgbox(format("Sometimes, my friends and me throw Wishing Stars down the Wishing Well! Here's a few for you!"))
		closemessage
		giveitem(ITEM_WISHING_STAR, 3)
		setflag(FLAG_SPOKE_TO_WISHING_STAR_LITTLE_GIRL)
	}
	else
	{
		msgbox(format("Did you get anything cool from the Wishing Well?"))
		closemessage
	}
	release
	end

}

script JusmailTown_EventScript_WishingWellSign
{

	lock
	msgbox(format("Jusmail Town Well\N More than meets the eye."))
	closemessage
	msgbox(format("There's more scribbled on here...\p Use Wishing Stars at the Wishing Well! Pokémon are granted to those who seek them!"))
	closemessage
	release
	end

}

script JusmailTown_EventScript_CyclingMan
{
    lock
    faceplayer
    speakername("Cycling Man")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_LOVESTRUCK_BIKER)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Thanks again for helping us get together! Now we can go cycling together every day!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_LOVESTRUCK_BIKER)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Sigh... SIGHHH...\p Oh? Sorry, I've just been so down in the dumps. I saw online that girls only like you if you give them a Heart Scale, but I can't find one...\p I know! You seem nice, help a guy out! If you could find a {COLOR GREEN}Heart Scale{COLOR DARK_GRAY} for me, I'll be in your debt!"))
        closemessage

        delay(20)
        startquest(QUEST_LOVESTRUCK_BIKER)
    }
    else
    {
        msgbox(format("Hm? Oh, I remember you! Did you find a {COLOR GREEN}Heart Scale{COLOR DARK_GRAY} for me?"))
        closemessage

        checkitem(ITEM_HEART_SCALE)
        delay(30)

        if(var(VAR_RESULT) == 0)
        {
            speakername("Cycling Man")
            msgbox(format("No? That's alright, I've been trying to find one, but it takes forever.\p I heard that wild Finneon can be found carrying them, and that sometimes they show up as Hidden Items around the region. Please, help me find a {COLOR GREEN}Heart Scale{COLOR DARK_GRAY}!"))
            closemessage
        }
        else
        {
            applymovement(16, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(15)
            speakername("Cycling Man")
            msgbox(format("A Heart Scale! It's even more beautiful than I imagined... she'll definitely like this!\p I'll ride to her house and give it to her right now! Stay right there!"))
            closemessage

            fadescreenswapbuffers(FADE_TO_BLACK)
            delay(30)
            clearflag(FLAG_HIDE_CYCLING_WOMAN_JUSMAIL)
            addobject(17)
            delay(30)
            fadescreenswapbuffers(FADE_FROM_BLACK)
            delay(20)

            applymovement(16, Common_Movement_Heart)
            waitmovement(0)
            delay(15)
            speakername("Cycling Man")
            msgbox(format("It totally worked, she loved it! Look who's got a girlfriend now!\p I'm so happy right now! Here, take this - it's all thanks to you!"))
            closemessage
            giveitem(ITEM_LOVE_BALL, 5)
            closemessage
            delay(5)
            speakername("Cycling Man")
            msgbox(format("Those are {COLOR GREEN}5 Love Balls{COLOR DARK_GRAY}. I'm so in love, I ended up buying a bunch while I was out shopping, ehehe!"))
            closemessage

            delay(20)
            completequest(QUEST_LOVESTRUCK_BIKER)
        }
    }
}

script JusmailTown_EventScript_CyclingWoman
{
    lock
    faceplayer
    speakername("Cycling Woman")
    msgbox(format("Ahaha, he's so funny! Why'd he think he needed a Heart Scale to ask me out? We literally ride our bikes together every day, of course I liked him back!"))
    closemessage
    release
    end
}

script JusmailTown_EventScript_Bounsweet
{
    lock
    faceplayer
    speakername("Bounsweet")
    playmoncry(SPECIES_BOUNSWEET, CRY_MODE_NORMAL)
    msgbox("Ee-hee!")
    waitmoncry
    closemessage
    release
    end
}

script JusmailTown_EventScript_CoralOutfitBeauty
{
    lock
    faceplayer
    speakername("Fashionista")
    checkoutfitflag(OUTFIT_CORAL)

    if(var(VAR_RESULT) == FALSE) // no coral outfit
    {
        msgbox(format("My cute, pink Bounsweet has inspired me to put together a new outfit!"))
        closemessage
        delay(5)
        showmoneybox(0, 0)
        speakername("Fashionista")
        msgbox(format("You're a new Trainer, right? I'll cut you a deal! I'll give you this {COLOR GREEN}Casual Coral Outfit{COLOR DARK_GRAY} for just ¥1900. How about it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == FALSE) // said no
        {
            hidemoneybox
            speakername("Fashionista")
            msgbox(format("No? Your loss!"))
            closemessage
            release
            end
        }
        else // said yes
        {
            // check money before purchasing
            checkmoney(1900)
            if(var(VAR_RESULT) == FALSE)
            {
                hidemoneybox
                speakername("Fashionista")
                msgbox(format("Hey, you don't have the money for that!"))
                closemessage
                release
                end
            }
            else
            {
                removemoney(1900)
                updatemoneybox
                delay(5)
                unlockoutfit(OUTFIT_CORAL)
                msgbox(format("The Casual Coral Outfit has been added to the Outfit Box!"))
                delay(20)
                closemessage
                hidemoneybox
                delay(5)
                speakername("Fashionista")
                msgbox(format("Thanks! I tried my best to make the Casual Coral Outfit as comfortable as possible."))
                closemessage
            }
        }
    }
    else
    {
        msgbox(format("I hope you like the Casual Coral Outfit! I tried to make it as cute and comfortable as possible, perfect for the Ilios Region heat!"))
        closemessage
    }
    release
    end
}
