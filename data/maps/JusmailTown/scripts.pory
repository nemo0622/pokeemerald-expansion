mapscripts JusmailTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_JUSMAIL_TOWN)

        if(flag(FLAG_CHIMERA_WEATHER_ACTIVE))
        {
            setweather(WEATHER_ABNORMAL)
        }

        // windmill management sigh
        clearflag(FLAG_TRIGGERED_WINDMILL_SPAWN)
    }

    MAP_SCRIPT_ON_RETURN_TO_FIELD {
        goto(JusmailTown_SpawnWindmillVirtualObjects)
    }
}

script JusmailTown_EventScript_DirectionSign
{
    lock
    msgbox(format("Jusmail Town\n The Breadbasket of Ilios\p {UP_ARROW} Bronze Fields\n Wanderers' Woods {DOWN_ARROW}"))
    closemessage
    release
    end
}

script JusmailTown_Sign_MartSign
{
    lock
    msgbox(format("Jusmail Town Roadside Market"))
    closemessage
    release
    end
}

script JusmailTown_EventScript_TriggerWindmillSpawn
{
    setflag(FLAG_TRIGGERED_WINDMILL_SPAWN) // marks that the player has taken >1 step into the route, avoiding interference with event object spawning
    goto(JusmailTown_SpawnWindmillVirtualObjects)
}

// Function called by triggers on the entrance tiles of the route!
script JusmailTown_SpawnWindmillVirtualObjects
{
    // windmill tiles
    if(flag(FLAG_TRIGGERED_WINDMILL_SPAWN)) // if >1 step has been taken into the route and the mills have not been spawned yet, spawn them!
    {
        special(DestroyVirtualObjects) // destroy any existing windmill blade sprites
        createvobject(OBJ_EVENT_GFX_WINDMILL_TL, 16, 20, 19, 4, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_WINDMILL_TR, 17, 24, 19, 4, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_WINDMILL_BL, 18, 20, 23, 4, DIR_SOUTH)
        createvobject(OBJ_EVENT_GFX_WINDMILL_BR, 19, 24, 23, 4, DIR_SOUTH)
        // setvar(VAR_TEMP_A, 1) // marks them as spawned for now
    }
    release
    end
}

script JusmailTown_Sign_GymSign
{
    lock
    msgbox(format("Gym Leader: Polymnia\n Muse of Nature's Hymns"))
    closemessage
    release
    end
}

script JusmailTown_EventScript_NPC_Woman
{
    lock
    faceplayer
    speakername("Woman")
    msgbox(format("Jusmail Town is a really small community, but I love it like this. We live alongside nature here, not in conflict with it."))
    closemessage
    release
    end
}

script JusmailTown_EventScript_NPC_Boy
{
    lock
    faceplayer
    speakername("Boy")
    msgbox(format("Flying-type Pokémon are good against Polymnia's Pokémon, Bug and Grass-type Pokémon.\p I hear most Gym Leaders have a Pokémon that is strong against whatever the Leader is weak against. Sounds like they're tough fights!"))
    closemessage
    release
    end
}

script JusmailTown_EventScript_NPC_Farmer
{
    lock
    faceplayer
    speakername("Farmer")
    msgbox(format("Bleugh, lots of bugs around here... they're cute, but their little legs scare me!"))
    closemessage
    release
    end
}

script JusmailTown_EventScript_MarketMan
{
    lock
    faceplayer
    speakername("Market Man")
    message(format("Welcome to the Jusmail Town Farmer's Market? How can I help you?"))
    waitmessage
    pokemart(JusmailTown_Mart)
    closemessage
    delay(1)
    speakername("Market Man")
    msgbox(format("Make sure to come back soon!"))
    closemessage
    release
    end
}

mart JusmailTown_Mart
{
    ITEM_POKE_BALL
    ITEM_POTION
    ITEM_ANTIDOTE
    ITEM_PARALYZE_HEAL
}

script JusmailTown_EventScript_RockSmashHiker
{
    lock
    faceplayer
    if(!flag(FLAG_BROKE_JUSMAIL_TOWN_ROCKS))
    {
        speakername("Hiker")
        msgbox(format("Trying to head south too, huh? Well, these rocks are blocking the only way.\p Someone with {COLOR GREEN}Rock Smash{COLOR DARK_GRAY} could break these rocks, though."))
        closemessage
    }
    else
    {
        speakername("Hiker")
        msgbox(format("Woah, thanks for clearing the path! Now I can finally head south!"))
        closemessage
    }
    release
    end
}

script JusmailTown_EventScript_PsychicM
{
    lock
    faceplayer
    speakername("Psychic")
    msgbox(format("I believe in the old rumors about the Wishing Well. Maybe I'll get a Pokémon strong enough to defend the town..."))
    closemessage
    delay(20)
    emote(18, EMOTE_QUESTION)
    speakername("Psychic")
    msgbox(format("Hm? Haven't you heard? Team Chimera raided Areios Town, and their Gym Leader has gone missing. That was supposed to be the strongest Gym Leader in the Ilios Region, but Team Chimera still overran it!"))
    closemessage
    release
    end
}

// ----------------------------------------------------------------------------------------------------

script JusmailTown_EventScript_RaniaEventTrigger
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    goto(JusmailTown_EventScript_RaniaEvent)
    end
}

script JusmailTown_EventScript_RaniaEvent
{
    lockall
    applymovement(11, Common_Movement_FacePlayer)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("Chaire, {PLAYER}! I see you've won your first Gym Badge!\p Since you left, Niko and I have decided to do some more field research ourselves, which means training up our own Pokémon teams! What do you say, wanna battle?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 0) // no
    {
        speakername("Rania")
        msgbox(format("Need more time to train? I get you. Let me know when you wanna battle!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
        waitmovement(0)
    }
    else
    {
        speakername("Rania")
        msgbox(format("Alright, here I come!"))
        // TRAINER BATTLE HERE
        trainerbattle_no_intro(TRAINER_JUSMAIL_RANIA, JusmailTown_Text_RaniaDefeated)

        // post-battle script
        lockall
        applymovement(11, Common_Movement_FacePlayer)
        waitmovement(0)
        speakername("Rania")
        msgbox(format("Phew, what a battle! Even against a strong type trio like mine, you still held your own. Looks like that Gym Badge really means something!\p Ah, right, another thing. Professor Elia sent me to give you this HM. Here!"))
        closemessage
        giveitem(ITEM_HM_CUT)
        speakername("Rania")
        msgbox(format("With that HM, you can {COLOR GREEN}cut down small trees{COLOR DARK_GRAY} that might be blocking your path.\p You heading {COLOR GREEN}back to the University{COLOR DARK_GRAY}? I'm doing the same. Meet you there!"))
        closemessage

        // Hide Rania and disable trigger
        setflag(FLAG_HIDE_RANIA_JUSMAIL)
        setvar(VAR_RANIA_STATE, 1)
        setvar(VAR_NIKO_STATE, 1)
        fadescreenswapbuffers(FADE_TO_BLACK)
        delay(30)
        removeobject(11)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        delay(20)
    }
    releaseall
    end
}

text JusmailTown_Text_RaniaDefeated
{
    format("Aw, I thought I balanced my team perfectly!")
}

