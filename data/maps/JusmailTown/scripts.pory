    SPECIES_ELECTRIKE,
    SPECIES_NUMEL,
    SPECIES_SPHEAL,
    SPECIES_CACNEA,
    SPECIES_SNORUNT,
    SPECIES_LUNATONE,
    SPECIES_SOLROCK,
    SPECIES_AZURILL,
    SPECIES_SPOINK,
    SPECIES_PLUSLE,
    SPECIES_MINUN,
    SPECIES_MAWILE,
    SPECIES_MEDITITE,
    SPECIES_MEDITITE,
    SPECIES_SWABLU,
    SPECIES_SWABLU,
    SPECIES_WYNAUT,
    SPECIES_DUSKULL,
    SPECIES_BUDEW,
    SPECIES_SLAKOTH,
    SPECIES_GULPIN,
    SPECIES_TROPIUS,
    SPECIES_WHISMUR,
    SPECIES_CLAMPERL,
    SPECIES_ABSOL,
    SPECIES_SHUPPET,
    SPECIES_SEVIPER,
    SPECIES_ZANGOOSE,
    SPECIES_RELICANTH,
    SPECIES_ARON,
    SPECIES_CASTFORM,
    SPECIES_VOLBEAT,
    SPECIES_ILLUMISE,
    SPECIES_LILEEP,
    SPECIES_ANORITH,
    SPECIES_RALTS,
    SPECIES_BAGON,
    SPECIES_BELDUM,
    SPECIES_CHINGLING,
	SPECIES_SANDSHREW_ALOLAN,
	SPECIES_VULPIX_ALOLAN,
	SPECIES_DIGLETT_ALOLAN,
	SPECIES_GEODUDE_ALOLAN)

			givemon(VAR_RESULT, 1)
			msgbox(format("A POKé BALL appeared... containing a POKéMON!"))
			closemessage
			if(var(VAR_RESULT) == MON_GIVEN_TO_PARTY) 
			{ 
				call(Common_EventScript_GetGiftMonPartySlot)
				call(Common_EventScript_NameReceivedPartyMon) 
			}
			else 
			{ 
				call(Common_EventScript_NameReceivedBoxMon)
				msgbox("The POKéMON was sent to the PC.")
				closemessage
			}

		}
	}

	releaseall
	end

}

script JusmailTown_EventScript_LittleGirlWithWishingStar
{

	lock
	faceplayer
	if(!flag(FLAG_SPOKE_TO_WISHING_STAR_LITTLE_GIRL))
	{
		msgbox(format("See that broken well?\N It's actually a Wishing Well, and it grants wishes! Really!"))
		closemessage
		msgbox(format("Sometimes, my friends and me throw Wishing Stars down the Wishing Well! Here's a few for you!"))
		closemessage
		giveitem(ITEM_WISHING_STAR, 5)
		setflag(FLAG_SPOKE_TO_WISHING_STAR_LITTLE_GIRL)
	}
	else
	{
		msgbox(format("Did you get anything cool from the Wishing Well?"))
		closemessage
	}
	release
	end

}

script JusmailTown_EventScript_WishingWellSign
{

	lock
	msgbox(format("JUSMAIL TOWN WELL\N More than meets the eye."))
	closemessage
	msgbox(format("There's more scribbled on here...\p Use Wishing Stars at the Wishing Well! POKéMON are granted to those who seek them!"))
	closemessage
	release
	end

}
