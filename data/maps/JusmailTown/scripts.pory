script JusmailTown_EventScript_WishingWell
{

	lockall
	msgbox(format("You peer down the Wishing Well...\N The air begins to sparkle."))
	closemessage

	checkitem(ITEM_WISHING_STAR)

	if(var(VAR_RESULT) == 1) // if player has a Wishing Star
	{
		msgbox(format("Toss a Wishing Star into the Well?"), MSGBOX_YESNO)

		if(var(VAR_RESULT) == 1) // yes, toss Wishing Star into well
		{

			removeitem(ITEM_WISHING_STAR)

			msgbox(format("The Wishing Star shines as it falls..."))
			closemessage
			msgbox("...  ...  ...  ...!")
