script JusmailTown_EventScript_LittleGirlWithWishingStar
{

	lock
	faceplayer
    speakername("Little Girl")
	if(!flag(FLAG_SPOKE_TO_WISHING_STAR_LITTLE_GIRL))
	{
		msgbox(format("See that broken well?\N It's actually a Wishing Well, and it grants wishes! Really!"))
		closemessage
        speakername("Little Girl")
		msgbox(format("Sometimes, my friends and me throw Wishing Stars down the Wishing Well! Here's a few for you!"))
		closemessage
		giveitem(ITEM_WISHING_STAR, 3)
		setflag(FLAG_SPOKE_TO_WISHING_STAR_LITTLE_GIRL)
	}
	else
	{
		msgbox(format("Did you get anything cool from the Wishing Well?"))
		closemessage
	}
	release
	end

}

script JusmailTown_EventScript_WishingWellSign
{

	lock
	msgbox(format("JUSMAIL TOWN WELL\N More than meets the eye."))
	closemessage
	msgbox(format("There's more scribbled on here...\p Use Wishing Stars at the Wishing Well! POKéMON are granted to those who seek them!"))
	closemessage
	release
	end

}
