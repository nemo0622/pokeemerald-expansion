mapscripts FrescoIsles_House3_MapScripts {}

script FrescoIsles_House3_EventScript_Boy
{
    lock
    faceplayer
    speakername("Boy")
    msgbox(format("There's all sorts of information kept in these books!"))
    closemessage
    release
    end
}

script FrescoIsles_House3_EventScript_BattleGirl
{
    lock
    faceplayer
    speakername("Battle Girl")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_FIND_RELICANTH)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("I'll head out and catch a Relicanth for myself soon! What an incredible Pokémon."))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_FIND_RELICANTH)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("The old Pokémon Ecology books we have here list Relicanth as extinct, but about 80 years ago, it was rediscovered living deep underwater! Before then, it was only known from ancient fossils. That makes it the {COLOR GREEN}earliest Lazarus Taxon Pokémon we know of{COLOR DARK_GRAY}.\p I've always wanted to see one for myself. If you {COLOR GREEN}catch a Relicanth{COLOR DARK_GRAY}, show me the Pokédex data!"))
        closemessage

        delay(20)
        startquest(QUEST_FIND_RELICANTH)
    }
    else
    {
        msgbox(format("Chaire, hello! I still want to see a Relicanth in the wild, but I'm not sure where they live. Do you have {COLOR GREEN}Relicanth's Pokédex data{COLOR DARK_GRAY}?"))
        closemessage

        delay(30)
        getcaughtmon(SPECIES_RELICANTH)
        if(var(VAR_RESULT) == FALSE)
        {
            speakername("Battle Girl")
            msgbox(format("No Relicanth yet, hm? They're exceedingly rare, from what I can tell.\p From what I hear, they live deep underwater, but I don't know where exactly. When you catch a {COLOR GREEN}Relicanth{COLOR DARK_GRAY}, please, show me the Pokédex data!"))
            closemessage
        }
        else // has relicanth!
        {
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Battle Girl")
            msgbox(format("Wow, you have the Pokédex data for Relicanth! Let me see!"))
            closemessage
            delay(30)
            speakername("Battle Girl")
            msgbox(format("Hmm, I see... According to your Rotom Phone's Pokédex data, Relicanth can be found deep underwater in the Sea of Vulcai's northern section. I'll have to Dive out there soon!\p I can't thank you enough for showing me this. Take this!"))
            closemessage
            delay(5)
            giveitem(ITEM_EXP_CANDY_L)
            closemessage

            delay(20)
            completequest(QUEST_FIND_RELICANTH)
        }
    }
    release
    end
}
