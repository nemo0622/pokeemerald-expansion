mapscripts MyrriniIsland_Mart_MapScripts {}

script MyrriniIsland_Mart_EventScript_MartEmployee
{
    lock
    faceplayer
    speakername("Mart Employee")
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(MyrriniIsland_Mart_Shop)
    closemessage
    delay(1)
    speakername("Mart Employee")
    msgbox(gText_PleaseComeAgain)
    release
    end
}

mart MyrriniIsland_Mart_Shop
{
    ITEM_POKE_BALL
	ITEM_GREAT_BALL
    ITEM_NET_BALL
    ITEM_DIVE_BALL
	ITEM_POTION
	ITEM_SUPER_POTION
    ITEM_HYPER_POTION
    ITEM_REVIVE
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
    ITEM_AWAKENING
    ITEM_BURN_HEAL
	ITEM_ESCAPE_ROPE
	ITEM_REPEL
    ITEM_SUPER_REPEL
    ITEM_MAX_REPEL
}

script MyrriniIsland_Mart_EventScript_Man
{
    lock
    faceplayer
    speakername("Man")
    msgbox(format("If I could, I'd buy everything from the farmer's market outside. There are just some things that can only really be bought in Marts, though."))
    closemessage
    release
    end
}

script MyrriniIsland_Mart_EventScript_Picnicker
{
    lock
    faceplayer
    speakername("Picnicker")
    msgbox(format("I'm stocking up on Repels before going out with my friends!"))
    closemessage
    release
    end
}
