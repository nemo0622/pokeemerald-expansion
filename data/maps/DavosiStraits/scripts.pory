mapscripts DavosiStraits_MapScripts {}

script DavosiStraits_EventScript_Trainer_DavosiStraits_Newell
{
    trainerbattle_single(TRAINER_DAVOSISTRAITS_NEWELL, DavosiStraits_Text_Trainer_DavosiStraits_NewellIntro, DavosiStraits_Text_Trainer_DavosiStraits_NewellDefeat)
    speakername("Newell")
    msgbox(format("These waters are shallow and rocky... Definitely not safe for any ships."))
    closemessage
    release
    end
}
text DavosiStraits_Text_Trainer_DavosiStraits_NewellIntro
{
    format("I found some rare stones in my farm, and they make my Pokémon extremely strong. Take a look!")
}
text DavosiStraits_Text_Trainer_DavosiStraits_NewellDefeat
{
    format("I battle best with soil under me!")
}

