mapscripts PollenRoad_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(14, ENCOUNTER_LAND)
        setobjectaswildencounter(15, ENCOUNTER_LAND)
        setobjectaswildencounter(16, ENCOUNTER_LAND)
        setobjectaswildencounter(17, ENCOUNTER_LAND)
        setobjectaswildencounter(18, ENCOUNTER_LAND)
        setobjectaswildencounter(19, ENCOUNTER_LAND)
        setobjectaswildencounter(20, ENCOUNTER_LAND)
        setobjectaswildencounter(21, ENCOUNTER_LAND)
        setobjectaswildencounter(22, ENCOUNTER_LAND)
        setobjectaswildencounter(23, ENCOUNTER_SURF)
    }
}

script PollenRoad_EventScript_DirectionSign
{
    lock
    msgbox(format("Pollen Road\n Péntepetal City's Backyard\p {LEFT_ARROW} Péntepetal City \n Davosi Straits {RIGHT_ARROW}"))
    closemessage
    release
    end
}

script PollenRoad_EventScript_Trainer_PollenRoad_Ruben
{
    trainerbattle_single(TRAINER_POLLENROAD_RUBEN, PollenRoad_Text_Trainer_PollenRoad_RubenIntro, PollenRoad_Text_Trainer_PollenRoad_RubenDefeat)
    speakername("Ruben")
    msgbox(format("This road ends at the other side of the island. I wonder where the water leads?"))
    closemessage
    release
    end
}
text PollenRoad_Text_Trainer_PollenRoad_RubenIntro
{
    format("I finally made it to Pollen Road! You'll be my first challenge!")
}
text PollenRoad_Text_Trainer_PollenRoad_RubenDefeat
{
    format("Knocked down at my first challenge?!")
}

