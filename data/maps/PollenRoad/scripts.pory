    msgbox(format("Woah... It's the ocean! My parents told me not to swim here because of the rough waters, but I'm a strong swimmer!"))
    closemessage
    release
    end
}

script PollenRoad_EventScript_Nurse
{
    speakername("Nurse")
    msgbox(format("Are you here to heal your Pokémon? Just hand them over to me."))
    closemessage
    applymovement(10, Common_Movement_FaceUp)
    waitmovement(0)
    special(HealPlayerParty)
	callnative(UpdateFollowingPokemon)
    delay(60)
    applymovement(10, Common_Movement_FaceDown)
    waitmovement(0)
    speakername("Nurse")
    msgbox(format("Here's your Pokémon. Good luck out there!"))
    closemessage
    release
    end
}

script PollenRoad_EventScript_Comfey
{
    lock
    faceplayer
    speakername("Comfey")
    playmoncry(SPECIES_COMFEY, CRY_MODE_NORMAL)
    msgbox("Breef!")
    waitmoncry
    closemessage
    release
    end
}

script PollenRoad_EventScript_UniversityStudentRouteCheck
{
    lock
    faceplayer
    speakername("Uni. Student")

    if(flag(FLAG_CAUGHT_ALL_MONS_POLLEN_ROAD))
    {
        msgbox(format("Your Pokédex data is amazing! Now we know more about the local ecosystem, thanks to you."))
        closemessage
    }
    else
    {
        msgbox(format("Chaire! I'm a student from the Acrisia University.\p I'm looking for {COLOR GREEN}Pokédex data{COLOR DARK_GRAY} of {COLOR GREEN}all Land Pokémon{COLOR DARK_GRAY} found in Pollen Road. If you've caught all the Pokémon here, please let me know."))
        closemessage
        special(CheckRouteCaptureProgress)
        if(var(VAR_RESULT) == TRUE) // caught all mons on the route!
        {
            delay(20)
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Uni. Student")
            msgbox(format("Incredible! You've caught all the Pokémon that I requested in the area!\p Here's a reward from the University. Keep up your hard work!"))
            closemessage
            delay(5)

            // give reward!
            giveitem(ITEM_EXP_CANDY_XL, 3)
            closemessage
            delay(5)

            setflag(FLAG_CAUGHT_ALL_MONS_POLLEN_ROAD)
        }
    }

    release
    end
}
