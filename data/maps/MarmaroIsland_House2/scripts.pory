mapscripts MarmaroIsland_House2_MapScripts {}

script MarmaroIsland_House2_EventScript_Girl
{
    lock
    faceplayer
    speakername("Girl")
    msgbox(format("Dad says that Marmaro Island used to be a lot bigger, but stone mining made it shrink. That must've been a lot of stone!"))
    closemessage
    release
    end
}

script MarmaroIsland_House2_EventScript_Boy
{
    lock
    faceplayer
    speakername("Boy")
    msgbox(format("Pokémon everyone thought were extinct have been showing up a lot around here! Maybe it's because of all the fossils in the stone?"))
    closemessage
    release
    end
}

script MarmaroIsland_House2_EventScript_FossilReviveMan
{
    lock
    faceplayer
    speakername("Paleontologist")
    msgbox(format("Chaire! If you've spent time in the Mines, there's a good chance you've found a {COLOR GREEN}Pokémon Fossil{COLOR DARK_GRAY}.\p Through my experiments, I've found a way to {COLOR GREEN}restore Pokémon from Fossils{COLOR DARK_GRAY} back to life! Are you interested?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == FALSE) // not interested
    {
        speakername("Paleontologist")
        msgbox(format("Still looking for Fossils? If you find any, bring them to me!"))
        closemessage
        release
        end
    }
    else
    {
        speakername("Paleontologist")
        msgbox(format("Great! Go ahead and choose the Fossil you want me to restore."))
        closemessage
        delay(5)

        // choose fossil (stored in VAR_ITEM_ID)
        chooseitem(ITEMS_POCKET)
        delay(5)
        
        // Set variable storing fossil choice
        if(var(VAR_ITEM_ID) == ITEM_HELIX_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_OMANYTE)
        }
        elif(var(VAR_ITEM_ID) == ITEM_DOME_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_KABUTO)
        }
        elif(var(VAR_ITEM_ID) == ITEM_OLD_AMBER)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_AERODACTYL)
        }
        elif(var(VAR_ITEM_ID) == ITEM_ROOT_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_LILEEP)
        }
        elif(var(VAR_ITEM_ID) == ITEM_CLAW_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_ANORITH)
        }
        elif(var(VAR_ITEM_ID) == ITEM_SKULL_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_CRANIDOS)
        }
        elif(var(VAR_ITEM_ID) == ITEM_ARMOR_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_SHIELDON)
        }
        elif(var(VAR_ITEM_ID) == ITEM_COVER_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_TIRTOUGA)
        }
        elif(var(VAR_ITEM_ID) == ITEM_PLUME_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_ARCHEN)
        }
        elif(var(VAR_ITEM_ID) == ITEM_JAW_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_TYRUNT)
        }
        elif(var(VAR_ITEM_ID) == ITEM_SAIL_FOSSIL)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_AMAURA)
        }
        else
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, 0) // NO FOSSIL CHOSEN
        }

        // return dialogue based on choice, remove item from bag, and start restoring fossil
        if(var(VAR_WHICH_FOSSIL_REVIVED) == 0) // if no fossil chosen
        {
            speakername("Paleontologist")
            msgbox(format("Hmm... I hate to break it to you, but that just isn't a Fossil.\p Bring me a Pokémon Fossil, and I'll be able to restore it for you."))
            closemessage
            release
            end
        }
        else
        {

            showmoneybox(0, 0)

            bufferitemname(STR_VAR_1, VAR_ITEM_ID)
            bufferspeciesname(STR_VAR_2, VAR_WHICH_FOSSIL_REVIVED)
            speakername("Paleontologist")
            msgbox(format("Ah, this is certainly a {STR_VAR_1}! From my research, I believe a Pokémon known as {STR_VAR_2} will be restored from this.\p This process will be pretty resource-intensive. Including labor and time, it should cost around ¥2000. Are you interested?"), MSGBOX_YESNO)
            closemessage
            delay(5)

            if(var(VAR_RESULT) == 0) // not interested cause money
            {
                hidemoneybox
                speakername("Paleontologist")
                msgbox(format("No? Well, come on back with other Fossils anytime."))
                closemessage
                release
                end
            }
            else
            {
                checkmoney(2000)
                if(var(VAR_RESULT) == FALSE) // dont have 2000 dollars
                {
                    hidemoneybox
                    speakername("Paleontologist")
                    msgbox(format("Hmm... It doesn't look like you've got the funds right now. Come back with a Fossil and ¥2000, and I'll restore it for you!"))
                    closemessage
                    release
                    end
                }
                else
                {
                    removeitem(VAR_ITEM_ID)
                    removemoney(2000)
                    updatemoneybox
                    delay(10)
                    speakername("Paleontologist")
                    msgbox(format("Alright, thanks! I'll just take that Fossil from you, then we'll get started!"))
                    closemessage
                    hidemoneybox
                }
            }

            fadescreen(FADE_TO_BLACK)
            delay(60)
            fadescreen(FADE_FROM_BLACK)
            delay(20)

            speakername("Paleontologist")
            msgbox(format("Thanks for waiting. It was a complete success! The {STR_VAR_2} has imprinted on you, so it is ready to follow you wherever you go. Meet your new {STR_VAR_2}!"))
            closemessage
            delay(5)

            // 1% chance that restored Pokémon is shiny!
            randompercentage(1)
            if(var(VAR_RESULT) == TRUE)
            {
                setflag(FLAG_FORCE_SHINY)
            }

            // random number generate nature number and gender
            random(3) // 0-2, for nature number
            copyvar(VAR_TEMP_0, VAR_RESULT)
            random(2) // 0-1, for gender
            copyvar(VAR_TEMP_1, VAR_RESULT)

            random(3) // generates number 0-2 and stores in VAR_RESULT, used in switches below

            // give species revived! add chance of special moves
            if(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_OMANYTE)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_OMANYTE, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_CONSTRICT, MOVE_WITHDRAW, MOVE_BITE, MOVE_WATER_GUN)
                    case 1: givemon(SPECIES_OMANYTE, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_AQUA_JET, MOVE_WITHDRAW, MOVE_BITE, MOVE_WATER_GUN)
                    case 2: givemon(SPECIES_OMANYTE, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_CONSTRICT, MOVE_IRON_DEFENSE, MOVE_BITE, MOVE_WATER_GUN)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_KABUTO)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_KABUTO, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SCRATCH, MOVE_HARDEN, MOVE_ABSORB, MOVE_LEER)
                    case 1: givemon(SPECIES_KABUTO, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SCRATCH, MOVE_HARDEN, MOVE_ABSORB, MOVE_METAL_CLAW)
                    case 2: givemon(SPECIES_KABUTO, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SCRATCH, MOVE_HARDEN, MOVE_ABSORB, MOVE_ANCHOR_SHOT)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_AERODACTYL)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_AERODACTYL, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_WING_ATTACK, MOVE_SUPERSONIC, MOVE_BITE, MOVE_SCARY_FACE)
                    case 1: givemon(SPECIES_AERODACTYL, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_WING_ATTACK, MOVE_SUPERSONIC, MOVE_BITE, MOVE_SUPER_FANG)
                    case 2: givemon(SPECIES_AERODACTYL, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_WING_ATTACK, MOVE_SUPERSONIC, MOVE_BITE, MOVE_METEOR_MASH)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_LILEEP)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_LILEEP, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_ASTONISH, MOVE_CONSTRICT, MOVE_ACID, MOVE_INGRAIN)
                    case 1: givemon(SPECIES_LILEEP, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_ASTONISH, MOVE_SCALD, MOVE_ACID, MOVE_INGRAIN)
                    case 2: givemon(SPECIES_LILEEP, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_ASTONISH, MOVE_SYNTHESIS, MOVE_ACID, MOVE_INGRAIN)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_ANORITH)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_ANORITH, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SCRATCH, MOVE_HARDEN, MOVE_MUD_SPORT, MOVE_BUBBLE)
                    case 1: givemon(SPECIES_ANORITH, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SCRATCH, MOVE_SPIKY_SHIELD, MOVE_MUD_SPORT, MOVE_BUBBLE)
                    case 2: givemon(SPECIES_ANORITH, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_SCRATCH, MOVE_SHORE_UP, MOVE_MUD_SPORT, MOVE_BUBBLE)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_CRANIDOS)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_CRANIDOS, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_HEADBUTT, MOVE_LEER, MOVE_FOCUS_ENERGY, MOVE_PURSUIT)
                    case 1: givemon(SPECIES_CRANIDOS, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_HEADBUTT, MOVE_SEISMIC_TOSS, MOVE_FOCUS_ENERGY, MOVE_PURSUIT)
                    case 2: givemon(SPECIES_CRANIDOS, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_HEADBUTT, MOVE_GLARE, MOVE_FOCUS_ENERGY, MOVE_PURSUIT)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_SHIELDON)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_SHIELDON, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_TACKLE, MOVE_PROTECT, MOVE_TAUNT, MOVE_METAL_SOUND)
                    case 1: givemon(SPECIES_SHIELDON, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_TACKLE, MOVE_PROTECT, MOVE_PSYSHIELD_BASH, MOVE_METAL_SOUND)
                    case 2: givemon(SPECIES_SHIELDON, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_TACKLE, MOVE_PROTECT, MOVE_AVALANCHE, MOVE_METAL_SOUND)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_TIRTOUGA)
            {
                switch(var(VAR_RESULT)) {
                    case 0: givemon(SPECIES_TIRTOUGA, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_BITE, MOVE_WITHDRAW, MOVE_WATER_GUN, MOVE_ROLLOUT)
                    case 1: givemon(SPECIES_TIRTOUGA, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_BITE, MOVE_ICE_FANG, MOVE_WATER_GUN, MOVE_ROLLOUT)
                    case 2: givemon(SPECIES_TIRTOUGA, 10, ITEM_NONE, ITEM_POKE_BALL, NUM_NATURES, VAR_TEMP_0, VAR_TEMP_1, 0, 0, 0, 0, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_BITE, MOVE_SHORE_UP, MOVE_WATER_GUN, MOVE_ROLLOUT)
                }
            }
            elif(var(VAR_WHICH_FOSSIL_REVIVED) == SPECIES_ARCHEN)
            {
                switch(var(VAR_RESULT)) {
