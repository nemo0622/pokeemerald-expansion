script MarmaroIsland_House2_EventScript_OddKeystoneWoman
{
    lock
    faceplayer
    speakername("Spiritual Woman")
    msgbox(format("Hello... by chance, have you found an {COLOR GREEN}Odd Keystone{COLOR DARK_GRAY} in the Mines?\p In my studies of the occult, I've found that a Pokémon called {COLOR GREEN}Spiritomb{COLOR DARK_GRAY} may live inside them, as they were once used in burial traditions of ancient Ilios. Have you found an Odd Keystone?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == FALSE) // no odd keystone
    {
        speakername("Spiritual Woman")
        msgbox(format("No, I suppose most people wouldn't have one, as they are exceedingly rare. According to legend, over 100 souls are contained in each Odd Keystone, found near burial sites or ancient battlefields.\p If you happen to find an Odd Keystone, please let me know."))
        closemessage
        release
        end
    }
    else
    {
        speakername("Spiritual Woman")
        msgbox(format("Really? What incredible luck. Please, show me..."))
        closemessage
        delay(5)

        // choose fossil (stored in VAR_ITEM_ID)
        chooseitem(ITEMS_POCKET)
        delay(5)
        
        // Set variable storing item choice
        if(var(VAR_ITEM_ID) == ITEM_ODD_KEYSTONE)
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, SPECIES_SPIRITOMB) // yeah im reusing the variable, what about it
        }
        else
        {
            setvar(VAR_WHICH_FOSSIL_REVIVED, 0) // NOTHING CHOSEN
        }

        // return dialogue based on choice, remove item from bag, and give spiritomb
        if(var(VAR_WHICH_FOSSIL_REVIVED) == 0) // if no odd keystone chosen
        {
            speakername("Spiritual Woman")
            msgbox(format("Oh, my sweet summer child, this is not an Odd Keystone at all."))
            closemessage
            release
            end
        }
        else
        {

            showmoneybox(0, 0)

            speakername("Spiritual Woman")
            msgbox(format("Yes, I can feel the spirits swirling inside... this is most certainly an Odd Keystone!\p Awakening Spiritomb from the Odd Keystone is very spiritually intensive. Including labor and time, it should cost around ¥2000. Shall we begin?"), MSGBOX_YESNO)
            closemessage
            delay(5)

            if(var(VAR_RESULT) == 0) // not interested cause money
            {
                hidemoneybox
                speakername("Spiritual Woman")
                msgbox(format("No? Hm. Well please, come back with the Odd Keystone when you can."))
                closemessage
                release
                end
            }
            else
            {
                checkmoney(2000)
                if(var(VAR_RESULT) == FALSE) // dont have 2000 dollars
                {
                    hidemoneybox
                    speakername("Spiritual Woman")
                    msgbox(format("Hmm... I'm sorry, but you're lacking the funds right now. Come back with an Odd Keystone and ¥2000, and I'll awaken the Spiritomb inside."))
                    closemessage
                    release
                    end
                }
                else
                {
                    removeitem(VAR_ITEM_ID)
                    removemoney(2000)
                    updatemoneybox
                    delay(10)
                    speakername("Spiritual Woman")
                    msgbox(format("Okay, I'll place the Odd Keystone in the center of my crystal circle, and we shall begin the ritual. Please, wait there."))
                    closemessage
                    hidemoneybox
                }
            }

            fadescreen(FADE_TO_BLACK)
            delay(60)
            fadescreen(FADE_FROM_BLACK)
            delay(20)

            speakername("Spiritual Woman")
            msgbox(format("The spirits have been stirred by your energy, and Spiritomb has awakened. Take it, and treat it with respect."))
            closemessage
            delay(5)

            // 1% chance that restored Pokémon is shiny!
            randompercentage(1)
            if(var(VAR_RESULT) == TRUE)
            {
                setflag(FLAG_FORCE_SHINY)
            }

            givemon(VAR_WHICH_FOSSIL_REVIVED, 20)
            closemessage

            clearflag(FLAG_FORCE_SHINY)
        }

    }
    release
    end
}
