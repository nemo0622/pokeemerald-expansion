mapscripts KalamiCity_House4_MapScripts {}

script KalamiCity_House4_EventScript_Farmer
{
    lock
    faceplayer
    speakername("Farmer")
    msgbox(format("Most buildings on this side of Kalami City are actually storage warehouses, not homes. Pokémon from the swamp sneak in sometimes."))
    closemessage
    release
    end
}

script KalamiCity_House4_EventScript_Woman
{
    lock
    faceplayer
    speakername("Woman")
    msgbox(format("Some people make rafts which can float up and down the rivers here. I want to ride on one someday!"))
    closemessage
    release
    end
}

script KalamiCity_House4_EventScript_Pikachu
{
    lock
    faceplayer
    speakername("Pikachu")
    playmoncry(SPECIES_PIKACHU, CRY_MODE_NORMAL)
    msgbox("Chuuu!")
    waitmoncry
    closemessage
    release
    end
}

script KalamiCity_House4_EventScript_TropicalYellowOutfitLady
{
    lock
    faceplayer
    speakername("Sunny Lady")
    checkoutfitflag(OUTFIT_TROPICS)

    if(var(VAR_RESULT) == FALSE) // no coral outfit
    {
        msgbox(format("Yellow, yellow, yellow! I love the color yellow!"))
        closemessage
        delay(5)
        showmoneybox(0, 0)
        speakername("Sunny Lady")
        msgbox(format("I was inspired by the beautiful, bright sun and yellow flowers of the forest. I'll give you this {COLOR GREEN}Tropical Yellow Outfit{COLOR DARK_GRAY} for just ¥3000. How about it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == FALSE) // said no
        {
            hidemoneybox
            speakername("Sunny Lady")
            msgbox(format("No? Do you not appreciate the beauty of yellow like I do?"))
            closemessage
            release
            end
        }
        else // said yes
        {
            // check money before purchasing
            checkmoney(3000)
            if(var(VAR_RESULT) == FALSE)
            {
                hidemoneybox
                speakername("Sunny Lady")
                msgbox(format("Hm, looks like you're just short on cash. Come back with a bit more money on you!"))
                closemessage
                release
                end
            }
            else
            {
                removemoney(3000)
                updatemoneybox
                delay(5)
                unlockoutfit(OUTFIT_TROPICS)
                msgbox(format("The Tropical Yellow Outfit has been added to the Outfit Box!"))
                delay(20)
                closemessage
                hidemoneybox
                delay(5)
                speakername("Sunny Lady")
                msgbox(format("Ahaha, yay! Now everyone will see my sunny clothing!"))
                closemessage
            }
        }
    }
    else
    {
        msgbox(format("I made the Tropical Yellow Outfit myself, just for an active Trainer like you!"))
        closemessage
    }
    release
    end
}