script SofosCity_EventScript_StrategicCamper
{
    lock
    faceplayer

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_SHOW_CAMPER_ALOLAN_RAICHU)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        speakername("Camper")
        msgbox(format("Alolan Raichu is the master of battle terrain. It's signature ability, Surge Surfer, summons and electric terrain and increases it's speed. Strategy is all about changing the battlefield to your advantage!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_SHOW_CAMPER_ALOLAN_RAICHU)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        speakername("Camper")
        msgbox(format("I love trying to understand Pokémon battle strategies! Hazards, chip damage, abilities, and of course, battle terrain - they can all be the key to victory!\p There's one Pokémon in particular who excels at managing battle terrain. {COLOR GREEN}Alolan Raichu{COLOR DARK_GRAY}'s ability, Surge Surfer, summons electric terrain while boosting it's speed.\p Show me an {COLOR GREEN}Alolan Raichu{COLOR DARK_GRAY} so I can learn more about it. I'll give you a reward!"))
        closemessage

        delay(20)
        startquest(QUEST_SHOW_CAMPER_ALOLAN_RAICHU)
    }
    else // else, the quest is active, so ask the player about it
    {
        speakername("Camper")
        msgbox(format("What's up? Did you find an {COLOR GREEN}Alolan Raichu{COLOR DARK_GRAY} and study the ability Surge Surfer for me?"))
        closemessage

        checkforspecies(SPECIES_RAICHU_ALOLAN, OPEN_PARTY_SCREEN, SofosCity_EventScript_StrategicCamper_ReactToRaichu) // goto that script if have alolan raichu in party

        // by getting here, you don't have an alolan raichu
        speakername("Camper")
        msgbox(format("Not yet, huh? It's okay, finding a Raichu in the Alolan form isn't common in the Ilios Region. I've only ever seen one once!\p Come back when you have a {COLOR GREEN}complete Pokédex entry for Alolan Raichu{COLOR DARK_GRAY}. I'll give you something to improve your strategy even more!"))
        closemessage
    }
    release
    end
}
script SofosCity_EventScript_StrategicCamper_ReactToRaichu
{
    lock
    delay(20)
    applymovement(26, Common_Movement_Heart)
    waitmovement(0)
    delay(10)
    speakername("Camper")
    msgbox(format("Ahaha, I love it! This data is even more impressive than I expected!\p I just won two of these Alolan Raichu Dolls in a contest. Here, I want you to take one!"))
    closemessage
    givedecoration(DECOR_RAICHU_DOLL)
    delay(5)
    speakername("Camper")
    msgbox(format("It's a pretty large Doll, so make sure to display it on a large Mat with plenty of space!"))
    closemessage

    delay(20)
    completequest(QUEST_SHOW_CAMPER_ALOLAN_RAICHU)

    closemessage
    release
    end
}

