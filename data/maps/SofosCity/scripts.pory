script SofosCity_EventScript_ManWithMurkrow
{
    lock
    faceplayer
    speakername("Angry Man")
    if(!flag(FLAG_GOT_TM_TORMENT))
    {
        msgbox(format("Murkrow... Murkrow! Come on, work with me!\p Argh, I can't do it anymore! I was going to teach Murkrow this move, but it looks like it has it mastered. Take it and scram!"))
        closemessage
        giveitem(ITEM_TM_TORMENT)
        setflag(FLAG_GOT_TM_TORMENT)
    }
    else
    {
        msgbox(format("Grr, this darn Murkrow is gonna make me lose it! Why, why does it enjoy making me angry?!"))
        closemessage
    }
    release
    end
}
