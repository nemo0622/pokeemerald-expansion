script SofosCity_EventScript_ManOutsideBattlePavilion
{
    lock
    faceplayer
    speakername("Man")
    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_TRY_SOFOS_BATTLE_PAVILION)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("There are a few other Battle Pavilions scattered around the Ilios Region. Each has different rules and strategies to win!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_TRY_SOFOS_BATTLE_PAVILION)
    if(var(VAR_RESULT) == 0) // activate quest
    {
        msgbox(format("See that building with the green roof topped with Poké balls? That's the {COLOR GREEN}Sofos City Battle Pavilion{COLOR DARK_GRAY}. It's a popular destination for Trainers obsessed with strategy.\p Hey, you're new here, right? Go {COLOR GREEN}try the Battle Pavilion{COLOR DARK_GRAY} and let me know how it went!"))
        closemessage

        delay(20)
        startquest(QUEST_TRY_SOFOS_BATTLE_PAVILION)
    }
    else // try to complete quest
    {
        msgbox(format("Chaire! Have you tried participating in the {COLOR GREEN}Sofos City Battle Pavilion{COLOR DARK_GRAY} yet?"))
        closemessage

        delay(30)

        if(flag(FLAG_PLAYED_IN_SOFOS_BATTLE_PAVILION)) // did it!
        {
            speakername("Man")
            msgbox(format("Opa! You did it! Did you have fun?\n Right, right, your reward. I hope you continue to participate in Battle Pavilions across Ilios!"))
            closemessage
            delay(5)
            giveitem(ITEM_EXP_CANDY_M, 2)

            delay(20)
            completequest(QUEST_TRY_SOFOS_BATTLE_PAVILION)
        }
    }
    
}

