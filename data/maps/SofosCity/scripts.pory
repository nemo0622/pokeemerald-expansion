script SofosCity_EventScript_TryPiraeusKiposTownEvent
{
    if(flag(FLAG_BADGE04_GET)) // by triggering at all, we know FLAG_DID_PIRAEUS_SAIL_TO_KIPOS_TOWN_EVENT is FALSE. If Badge 4 was earned, do the event
    {
        lockall

        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
        waitmovement(0)
        speakername("Piraeus")
        msgbox(format("{PLAYER}!! Come on over here!"))
        closemessage

        applymovement(60, Common_Movement_FaceUp)
        if(var(VAR_TEMP_0) == 0)
        {
            applymovement(OBJ_EVENT_ID_PLAYER, SofosCity_Movement_ApproachPiraeus0)
        }
        elif(var(VAR_TEMP_0) == 1)
        {
            applymovement(OBJ_EVENT_ID_PLAYER, SofosCity_Movement_ApproachPiraeus1)
        }
        elif(var(VAR_TEMP_0) == 2)
        {
            applymovement(OBJ_EVENT_ID_PLAYER, SofosCity_Movement_ApproachPiraeus2)
        }
        elif(var(VAR_TEMP_0) == 3)
        {
            applymovement(OBJ_EVENT_ID_PLAYER, SofosCity_Movement_ApproachPiraeus3)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, SofosCity_Movement_ApproachPiraeus4)
        }
        waitmovement(0)
        delay(10)

        speakername("Piraeus")
        msgbox(format("My crew and I just got a letter from a Murkrow. The people of {COLOR GREEN}Kipos Town{COLOR DARK_GRAY} are looking for a strong Trainer who's {COLOR GREEN}knowledgeable about Pokémon{COLOR DARK_GRAY}, and as an Acrisia University researcher, who could be better but you?\p Hm? Oh, you've never been to Kipos Town, have you? It's {COLOR GREEN}only accessible by boat{COLOR DARK_GRAY}, so I'll add it to the list of locations we can sail to. Now, time for a detour - let's go!"))
        closemessage
        delay(20)
        warp(MAP_KIPOS_TOWN, 18, 22) // warp to Kipos Town docks, where the event will continue
        // ON WARP TO KIPOS TOWN: townsfolk crowded around docks. Player led to Sunset Wildlife Reserve, where all the
        // Pokémon have been STOLEN by Team Chimera! They're long gone, and now the Wildlife Reserve lays empty.
        // Player is asked to find Pokémon to donate to the Wildlife Reserve, bringing tourism back to the town
        // and raising Pokémon Conservation funds!
        // FOR CROWD: look at how Sootopolis City moves NPCs around!
    }
    release
    end
}

movement SofosCity_Movement_ApproachPiraeus0
{
    walk_down
    walk_right * 2
    walk_down * 4
    step_end
}
movement SofosCity_Movement_ApproachPiraeus1
{
    walk_down
    walk_right
    walk_down * 4
    step_end
}
movement SofosCity_Movement_ApproachPiraeus2
{
    walk_down * 5
    step_end
}
movement SofosCity_Movement_ApproachPiraeus3
{
    walk_down
    walk_left
    walk_down * 4
    step_end
}
movement SofosCity_Movement_ApproachPiraeus4
{
    walk_down
    walk_left * 2
    walk_down * 4
    step_end
}
