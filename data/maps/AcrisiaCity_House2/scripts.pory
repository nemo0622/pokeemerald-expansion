mapscripts AcrisiaCity_House2_MapScripts {}

script AcrisiaCity_House2_EventScript_Lady
{
    lock
    faceplayer
    speakername("Lady")
    msgbox(format("Chaire, hello, darling! The Acrisia University keeps things busy in town."))
    closemessage

    if(!flag(FLAG_GOT_ARISIA_LUCKY_EGG))
    {
        speakername("Lady")
        msgbox(format("You must be the new research assistant everyone's been talking about! Here, I'll give you something to help you out."))
        closemessage
        giveitem(ITEM_LUCKY_EGG)
        setflag(FLAG_GOT_ARISIA_LUCKY_EGG)
    }

    release
    end
}
