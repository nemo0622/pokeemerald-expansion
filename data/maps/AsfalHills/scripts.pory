script AsfalHills_EventScript_NikoMeetPlayerEvent
{
    lockall
    ballfollowingmon
    applymovement(7, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    applymovement(7, Common_Movement_FaceDown)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("{PLAYER}? Opa! I thought it was you! Here, come look at these statues."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, AsfalHills_Movement_PlayerApproachNiko)
    applymovement(8, AsfalHills_Movement_DuskullApproachPlayer)
    waitmovement(0)
    applymovement(7, Common_Movement_FacePlayer)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    delay(10)
    speakername("Niko")
    msgbox(format("Ehehe, looks like Duskull remembers you too!"))
    closemessage
    applymovement(7, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    applymovement(8, AsfalHills_Movement_DuskullReturnsToNiko)
    waitmovement(0)

    // Niko tests you in battle
    delay(10)
    speakername("Niko")
    msgbox(format("In fact, Duskull seems like it wants to battle you... I'm not much of a battler, but I'll give it my all!"))
    closemessage

    trainerbattle_no_intro(TRAINER_ASFALHILLS_NIKO, AsfalHills_Text_NikoLose)

    // cutscene explaining the statues and connecting to Mega Evolution
    delay(10)
    speakername("Niko")
    msgbox(format("Phew, you might even be a better Trainer than Rania..."))
    closemessage
    delay(30)
    emote(7, EMOTE_EXCLAM)
    speakername("Niko")
    msgbox(format("D-don't tell her I said that!\p Ahem, right, I called you over for a reason. Here, look at these statues."))
    closemessage
    applymovement(7, Common_Movement_FaceUp)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("These were two brothers who lived back when the Ilios Region was young. On the left was a mighty king, while to the right was a humble poet.\p Both pursued happiness in different ways. The king, obsessed with worldly possessions, strove to become the richest man in the region. The poet remained humble, choosing to help others and follow his heart.\p Now, thousands of years later, you can see which was better for everyone. The king's statue remains overgrown and weathered, while the statue of the poet is cleaned and cared for."))
    closemessage
    delay(10)
    applymovement(7, Common_Movement_FaceRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("Ahem, sorry for the info dump. The point is, there are more important things in the world than money and power.\p You've had encounters with {COLOR GREEN}Team Chimera{COLOR DARK_GRAY}, as I'm sure you remember. I believe they share a goal with this ancient king. I heard rumors that they've set up camp {COLOR GREEN}somewhere around Sofos City{COLOR DARK_GRAY} to find a hidden treasure: a {COLOR GREEN}Key Stone{COLOR DARK_GRAY}. My bet is, they want to control Mega Evolution and squeeze even more money out of the Ilios Region.\p Head into Sofos City, {COLOR GREEN}root out Team Chimera{COLOR DARK_GRAY}, and {COLOR GREEN}bring me back that Key Stone{COLOR DARK_GRAY}. We can't let them keep their hands on it!"))
    closemessage
    delay(10)
    applymovement(8, AsfalHills_Movement_DuskullReturnsToStatue)
    waitmovement(0)
    applymovement(7, Common_Movement_FaceUp)
    waitmovement(0)

    delay(20)
    startquest(QUEST_BEAT_CHIMERA_SOFOS_CITY) // START MEGA STONE QUEST
    // QUEST REWARD: Niko gives you the Key Stone (Mega Ring) to keep, along with the HM Surf. This ensures that the
    // player will absolutely have to do this quest no matter what lol, even following the Team Chimera root-out
    // battles and the return of the Gym Leader to the Gym.

    setflag(FLAG_TRIGGERED_NIKO_EVENT_ASFAL_HILLS)
    clearflag(FLAG_HIDE_BLOCKING_SOFOS_GYM) // blocks off Sofos Gym
    setflag(FLAG_HIDE_NIKO_ACRISIA_UNIVERSITY)
}

movement AsfalHills_Movement_PlayerApproachNiko
{
    walk_right * 3
    walk_up * 2
    step_end
}
movement AsfalHills_Movement_DuskullApproachPlayer
{
    walk_right * 2
    walk_down
    delay_16
    emote_heart
    step_end
}
movement AsfalHills_Movement_DuskullReturnsToNiko
{
    walk_left * 2
    walk_down
    face_up
    step_end
}
movement AsfalHills_Movement_DuskullReturnsToStatue
{
    walk_up * 2
    face_left
    step_end
}
script AsfalHills_EventScript_Duskull
{
    lock
    faceplayer
    speakername("Duskull")
    playmoncry(SPECIES_DUSKULL, CRY_MODE_NORMAL)
    msgbox("Kaaahhh...")
    waitmoncry
    closemessage
    delay(5)
    msgbox(format("Duskull is studying the statue closely."))
    closemessage
    release
    end
}

script AsfalHills_EventScript_NikoWaitingForPlayer
{
    lock
    faceplayer
    speakername("Niko")
    msgbox(format("Chaire, {PLAYER}. I'm sorry for sending you on such a dangerous quest, but I'm afraid I'm not much of a Pokémon battler.\p Did you find {COLOR GREEN}Team Chimera's Hideout{COLOR DARK_GRAY} around Sofos City?"))
    closemessage

    delay(20)
    checkitem(ITEM_KEY_STONE)
    if(var(VAR_RESULT) == 0) // no key stone yet
    {
        speakername("Niko")
        msgbox(format("Hmm, I don't see the {COLOR GREEN}Key Stone{COLOR DARK_GRAY} with you. Please, we can't let Team Chimera keep that, it's a precious artifact that may hold more power than we know.\p Please, find {COLOR GREEN}Team Chimera's Hideout{COLOR DARK_GRAY} around Sofos City and {COLOR GREEN}bring back the Key Stone{COLOR DARK_GRAY}!"))
        closemessage
        release
        end
    }
    else // brought the key stone!
    {
        applymovement(7, Common_Movement_ExclamationMark)
        waitmovement(0)
        delay(5)
        speakername("Niko")
        msgbox(format("Woah, you got it! The aura radiating around it... it can only mean one thing, my hunch was correct.\p The Key Stone allows skilled Trainers to unlock the powers of {COLOR GREEN}Mega Evolution{COLOR DARK_GRAY}, temporarily changing a Pokémon into an incredibly powerful form. There are only a few of these in the Ilios Region. Most Key Stones have already been claimed by Gym Leaders and a few powerful Trainer families... I suppose it makes sense that one was hidden in the Satyr's Lair from ancient times, though.\p {PLAYER}, I want you to keep the Key Stone. Team Chimera is clearly trying to grow in power, so the safest place for it would be with a skilled Trainer like you."))
        closemessage
        delay(10)
        speakername("Niko")
        msgbox(format("What a wreck! I'm glad you were here to help, {PLAYER}. This has been way too much excitement for me, so I'll be bringing Duskull back to the University.\p Oh! Speaking of which, I have something for you we've been working on in the lab. Take this!"))
        closemessage
        giveitem(ITEM_HM_SURF)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("The HM Surf will allow you to cross the waters of Ilios. Of course, you need the Gym Badge from Sofos City to use it!\p Alright, Duskull and I are getting out of here before any Team Chimera members pay us a visit. Come to Acrisia University soon, as I'll be collecting {COLOR GREEN}Mega Stones{COLOR DARK_GRAY} for you!"))
        closemessage
        fadescreenswapbuffers(FADE_TO_BLACK)
        delay(20)
        setflag(FLAG_HIDE_NIKO_ASFAL_HILLS)
        removeobject(7)
        removeobject(8)
        setflag(FLAG_HIDE_BLOCKING_SOFOS_GYM)
        setflag(FLAG_UNLOCKED_MEGA_EVOLUTION)
        clearflag(FLAG_HIDE_NIKO_ACRISIA_UNIVERSITY)
        setvar(VAR_NIKO_STATE, 8)
        delay(20)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        delay(10)

        delay(20)
        completequest(QUEST_BEAT_CHIMERA_SOFOS_CITY)
    }
    releaseall
    end
}

text AsfalHills_Text_NikoLose
{
    format("Urk... Like I said, I've never been much of a battler.")
}
