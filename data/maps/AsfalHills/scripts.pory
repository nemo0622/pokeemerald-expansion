script AsfalHills_EventScript_Nurse
{
    lock
    faceplayer
    speakername("Nurse")
    msgbox(format("Welcome to my Roadside Pokémon Healing Service! I'm here to help Trainers coming from Pythios Town make it to Sofos City.\p Would you like to heal your Pokémon?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 1)
    {
        closemessage
        call(Common_EventScript_OutOfCenterPartyHeal)
        delay(10)
        speakername("Nurse")
        msgbox(format("Good luck on your adventures!"))
        closemessage
    }
    else
    {
        speakername("Nurse")
        msgbox(format("Feel free to come back any time!"))
        closemessage
    }
    release
    end
}

script AsfalHills_EventScript_Trainer_AsfalHills_Salmai
{
    trainerbattle_single(TRAINER_ASFALHILLS_SALMAI, AsfalHills_Text_Trainer_AsfalHills_SalmaiIntro, AsfalHills_Text_Trainer_AsfalHills_SalmaiDefeat)
    speakername("Salmai")
    msgbox(format("Pokémon Eggs take many steps to hatch. Moving back and forth like this is a way to quickly hatch them!"))
    closemessage
