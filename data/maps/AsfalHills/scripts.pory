        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(23, ENCOUNTER_LAND)
        setobjectaswildencounter(24, ENCOUNTER_LAND)
        setobjectaswildencounter(25, ENCOUNTER_LAND)
        setobjectaswildencounter(26, ENCOUNTER_LAND)
        setobjectaswildencounter(27, ENCOUNTER_LAND)
        setobjectaswildencounter(32, ENCOUNTER_LAND)
    }
}

script AsfalHills_EventScript_DirectionSign
{
    lock
    msgbox(format("Asfal Hills\n The Gentle Coastal Road\p {LEFT_ARROW} Froslass Cavern\n Sofos City {RIGHT_ARROW}"))
    closemessage
    release
    end
}

script AsfalHills_EventScript_LibrarySign
{
    lock
    msgbox(format("Sofos Outskirts Public Library\n Open to all, 24 Hours a day!"))
    closemessage
    release
    end
}

script AsfalHills_EventScript_Nurse
{
    lock
    faceplayer
    speakername("Nurse")
    msgbox(format("Welcome to my Roadside Pokémon Healing Service! I'm here to help Trainers coming from Pythios Town make it to Sofos City.\p Would you like to heal your Pokémon?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 1)
    {
        closemessage
        call(Common_EventScript_OutOfCenterPartyHeal)
        delay(10)
        speakername("Nurse")
        msgbox(format("Good luck on your adventures!"))
        closemessage
    }
    else
    {
        speakername("Nurse")
        msgbox(format("Feel free to come back any time!"))
        closemessage
    }
    release
    end
}

script AsfalHills_EventScript_Trainer_AsfalHills_Salmai
{
    trainerbattle_single(TRAINER_ASFALHILLS_SALMAI, AsfalHills_Text_Trainer_AsfalHills_SalmaiIntro, AsfalHills_Text_Trainer_AsfalHills_SalmaiDefeat)
    speakername("Salmai")
    msgbox(format("Pokémon Eggs take many steps to hatch. Moving back and forth like this is a way to quickly hatch them!"))
    closemessage
    release
    end
}
text AsfalHills_Text_Trainer_AsfalHills_SalmaiIntro
{
    format("There's a good, long horizontal stretch on this route. Perfect for biking back and forth!")
}
text AsfalHills_Text_Trainer_AsfalHills_SalmaiDefeat
{
    format("Huff, huff... I have to keep training!")
}

