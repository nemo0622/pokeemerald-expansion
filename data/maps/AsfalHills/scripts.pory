script AsfalHills_EventScript_ManTryingToGetSouth
{
    lock
    emote(15, EMOTE_EXCLAM)
    waitmovement(0)
    speakername("Angry Man")
    msgbox(format("This is ridiculous! I have business in Port Pello!"))
    closemessage
    applymovement(15, Common_Movement_FacePlayer)
    waitmovement(0)
    speakername("Angry Man")
    msgbox(format("Can you believe this?! Blocking the path to a major city like it's nothing. I know Team Chimera is dangerous, but life must go on... Right?"))
    closemessage
    applymovement(15, Common_Movement_FaceDown)
    waitmovement(0)
    release
    end
}

script AsfalHills_EventScript_WomanTryingToGetSouth
{
    lock
    faceplayer
