        msgbox(format("Areios Town, the hamlet south of Port Pello, was taken over by Team Chimera a few months ago. Now, we're even being blocked from Port Pello. Someone needs to stop Team Chimera before the whole region falls apart!"))
    }
    else
    {
        msgbox(format("Access to Port Pello has been opened up again! I hear a brave Trainer has been causing problems for Team Chimera, making it safer for everyone to travel again."))
    }
    closemessage
    release
    end
}

