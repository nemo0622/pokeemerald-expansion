mapscripts RuinsOfAhiyawa_Lobby_MapScripts {}

script RuinsOfAhiyawa_Lobby_EventScript_PkmnCenterNurse
{
    lock
    faceplayer
    speakername("Nurse")
    msgbox(format("Welcome to the Ahiyawa Pokémon Center! Would you like to heal your Pokémon?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 0)
    {
        speakername("Nurse")
        msgbox(format("We hope to see you again!"))
        closemessage
    }
    else
    {
        speakername("Nurse")
        msgbox(format("Okay, I'll take your Pokémon for a few seconds!"))
        closemessage
        ballfollowingmon
        applymovement(1, Common_Movement_FaceLeft)
        waitmovement(0)
        dofieldeffect(FLDEFF_POKECENTER_HEAL)
	    waitfieldeffect(FLDEFF_POKECENTER_HEAL)
	    applymovement(1, Common_Movement_WalkInPlaceFasterDown)
	    waitmovement(0)
	    special(HealPlayerParty)
	    callnative(UpdateFollowingPokemon)
        speakername("Nurse")
        msgbox(format("Your Pokémon are happy and healthy! We hope to see you again!"))
        closemessage

        // SET HEAL LOCATION TO THIS TOWN
        setrespawn(HEAL_LOCATION_RUINS_OF_AHIYAWA)
    }
    release
    end
}

script RuinsOfAhiyawa_Lobby_Rania
{
    lock
    faceplayer
    speakername("Rania")
    msgbox(format("Chaire, {PLAYER}! We're finally here!\p I'm healing up my Pokémon and making sure they're ready for battle. Once you're ready, you can {COLOR GREEN}enter the Elite Four Challenge{COLOR DARK_GRAY} through the {COLOR GREEN}central door{COLOR DARK_GRAY}! Remember, once you enter, you {COLOR RED}can't exit{COLOR DARK_GRAY} until the end!"))
    closemessage
    release
    end
}

