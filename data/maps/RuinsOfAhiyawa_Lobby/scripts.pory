script RuinsOfAhiyawa_Lobby_EnterEliteFourTrigger
{
    lock
    msgbox(format("Beyond this doorway lies the {COLOR GREEN}Elite Four{COLOR DARK_GRAY}, the greatest challenge for Trainers in the Ilios Region.\p Once you enter, you {COLOR RED}cannot exit{COLOR DARK_GRAY} until you win or lose. Will you enter the Elite Four Challenge?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == FALSE)
    {
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
        waitmovement(0)
        release
        end
    }
    else
    {
        warpcontinuescript(MAP_RUINS_OF_AHIYAWA_E4_ROOM1, 4, 9, RuinsOfAhiyawa_EliteFour_EnterPolymniaRoomScript)
        waitstate
    }
    release
    end
}
