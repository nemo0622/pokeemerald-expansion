script ErinysPath_East_EventScript_Trainer_ErinysPath_E_Lueroi
{
    trainerbattle_single(TRAINER_ERINYSPATH_E_LUEROI, ErinysPath_East_Text_Trainer_ErinysPath_E_LueroiIntro, ErinysPath_East_Text_Trainer_ErinysPath_E_LueroiDefeat)
    speakername("Lueroi")
    msgbox(format("I'm originally from the Kanto Region. That's a long way from here!"))
    closemessage
    release
    end
}
text ErinysPath_East_Text_Trainer_ErinysPath_E_LueroiIntro
{
    format("It's a long road from here to Sofos City. The views are worth the journey, though!")
}
text ErinysPath_East_Text_Trainer_ErinysPath_E_LueroiDefeat
{
    format("Back to the Pokémon Center for me.")
}

script ErinysPath_East_EventScript_Trainer_ErinysPath_E_Kayley
{
    trainerbattle_single(TRAINER_ERINYSPATH_E_KAYLEY, ErinysPath_East_Text_Trainer_ErinysPath_E_KayleyIntro, ErinysPath_East_Text_Trainer_ErinysPath_E_KayleyDefeat)
    speakername("Kayley")
    msgbox(format("I hear they hold Pokémon Contests in the Hoenn Region. I wonder if they hold Contests in Ilios?"))
    closemessage
