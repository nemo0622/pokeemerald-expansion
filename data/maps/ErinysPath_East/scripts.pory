    end
}
text ErinysPath_East_Text_Trainer_ErinysPath_E_KayleyIntro
{
    format("Help my Pokémon train for our show!")
}
text ErinysPath_East_Text_Trainer_ErinysPath_E_KayleyDefeat
{
    format("Phew, great vocals!")
}

