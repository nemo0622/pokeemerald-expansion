mapscripts AcrisiaMountains_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(15, ENCOUNTER_LAND)
        setobjectaswildencounter(16, ENCOUNTER_LAND)
        setobjectaswildencounter(17, ENCOUNTER_LAND)
        setobjectaswildencounter(18, ENCOUNTER_LAND)
        setobjectaswildencounter(19, ENCOUNTER_LAND)
    }
}

script AcrisiaMountains_EventScript_DirectionSign
{
    lock
    msgbox(format("Acrisia Mountains\n A Rocky, Untamed Wilderness\p Acrisia City {RIGHT_ARROW}"))
    closemessage
    release
    end
}

script AcrisiaMountains_EventScript_RockExploringHiker
{
    lock
    faceplayer
    speakername("Archaeologist")
    msgbox(format("The ruins of bygone times are haunting. Ilios is covered in them, and some are thousands of years old. You never know what you'll find hiding under a rock!"))
    closemessage
    release
    end
}

script AcrisiaMountains_EventScript_MattaiosTraining
{
    lock
    speakername("Mattaios")
    msgbox(format("Huff huff huff...\p Always training, always working... Come on Larvitar, help me get stronger!"))
    closemessage
    release
    end
}

script AcrisiaMountains_EventScript_Larvitar
{
    lock
    speakername("Larvitar")
    playmoncry(SPECIES_LARVITAR, CRY_MODE_NORMAL)
    msgbox("Graahhh!")
    waitmoncry
    closemessage
    release
    end
}

script AcrisiaMountains_EventScript_Boy3
{
    lock
    faceplayer
    speakername("Fit Man")
    msgbox(format("Climbing this mountain is good exercise! But wow, there are so many trainers further on. I hear shouts and battles from up in the caves!"))
    closemessage
    release
    end
}

script AcrisiaMountains_EventScript_MachoBraceMan
{
    lock
    faceplayer
    speakername("Muscleman")
    if(flag(FLAG_GOT_MACHO_BRACE))
    {
        msgbox(format("Use that Macho Brace ta get yer Pokémon nice 'n strong!"))
        closemessage
    }
    else
    {
        msgbox(format("Chaire, little buddy! Ya think ya can swim up that waterfall? I've been tryin' every day.\p I've been holdin' this, but it hasn't made me stronger. Maybe it'll help ya with somethin'."))
        closemessage
        giveitem(ITEM_MACHO_BRACE)
        speakername("Muscleman")
        msgbox(format("Pokémon holding that Macho Brace get nice 'n strong! I guess it doesn't work on people, though."))
        closemessage
        setflag(FLAG_GOT_MACHO_BRACE)
    }
    release
    end
}

script AcrisiaMountains_EventScript_Trainer_AcrisiaMtns_Tyre
{
    trainerbattle_single(TRAINER_ACRISIAMTNS_TYRE, AcrisiaMountains_Text_Trainer_AcrisiaMtns_TyreIntro, AcrisiaMountains_Text_Trainer_AcrisiaMtns_TyreDefeat)
    speakername("Tyre")
    msgbox(format("Pokémon have plenty of skills outside of battle. For example, to reach this area your Pokémon had to be able to cut through those shrubs."))
    closemessage
    release
    end
}
text AcrisiaMountains_Text_Trainer_AcrisiaMtns_TyreIntro
{
    format("My Pokémon are training to throw rocks using their Psychic powers!")
}
text AcrisiaMountains_Text_Trainer_AcrisiaMtns_TyreDefeat
{
    format("Looks like they need more work.")
}

