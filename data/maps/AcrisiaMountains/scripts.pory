script AcrisiaMountains_EventScript_LassExploringRuins
{
    lock
    faceplayer
    speakername("Lass")
    if(!flag(FLAG_SHOWED_LASS_BALTOY_IN_MOUNTAINS)) // hasnt done quest yet
    {
        msgbox(format("There are lots of ancient ruins this far up the mountains. I wish we knew more about what came before us...\p The Pokémon {COLOR GREEN}Baltoy{COLOR DARK_GRAY} is said to be from an old civilization. I've always wanted to see one!"))
        closemessage

        getcaughtmon(SPECIES_BALTOY)
        if(var(VAR_RESULT) == 1) // has a baltoy!
        {
            delay(30)
            applymovement(20, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(20)
            speakername("Lass")
            msgbox(format("Hey! That's the Pokédex entry for Baltoy!\p Thanks for showing me. Maybe I'll check out the University for more Pokédex information. Here, take this cool stone I found around the Mountains."))
            closemessage
            giveitem(ITEM_DUSK_STONE)
            setflag(FLAG_SHOWED_LASS_BALTOY_IN_MOUNTAINS)

            delay(20)
            completequest(QUEST_BALTOY_DUSK_STONE)
        }
        else // no baltoy (prolly first time talking to her)
        {
            questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_BALTOY_DUSK_STONE)
            if(var(VAR_RESULT) == 0) // hasnt activated quest yet
            {
                delay(20)
                startquest(QUEST_BALTOY_DUSK_STONE)
            }
        }
    }
    else // already did event
    {
        msgbox(format("I can't wait to check out the University and learn more about Baltoy! I want to figure out everything about the past."))
        closemessage
    }
    release
    end
}

