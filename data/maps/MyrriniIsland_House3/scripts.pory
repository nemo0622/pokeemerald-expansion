mapscripts MyrriniIsland_House3_MapScripts {}

script MyrriniIsland_House3_EventScript_Lycanroc
{
    lock
    faceplayer
    speakername("Lycanroc")
    playmoncry(SPECIES_LYCANROC, CRY_MODE_NORMAL)
    msgbox("Rah-ooo!")
    waitmoncry
    closemessage
    release
    end
}

script MyrriniIsland_House3_EventScript_PunkRocker
{
    lock
    faceplayer
    speakername("Punk Rocker")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_MYRRINI_HEART_SCALE)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("I think my girlfriend will really like this Heart Scale!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_MYRRINI_HEART_SCALE)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Oh, hi... sorry, I've been playing sad songs on the piano today. You see, my girlfriend came over yesterday, but my Lycanroc scared her off. He didn't mean it, he's just misunderstood!\p I need something special to apologize with. If you have an extra {COLOR GREEN}Heart Scale{COLOR DARK_GRAY}, I'll give you something for it. Heart Scales are the best way to show your love!"))
        closemessage

        delay(20)
        startquest(QUEST_MYRRINI_HEART_SCALE)
    }
    else
    {
        msgbox(format("Hey... my girlfriend and I are still on bad terms, I think. Do you have what I asked for?"))
        closemessage

        checkitem(ITEM_HEART_SCALE)
        delay(30)
        if(var(VAR_RESULT) == FALSE)
        {
            speakername("Punk Rocker")
            msgbox(format("No {COLOR GREEN}Heart Scale{COLOR DARK_GRAY}, hm? I know they're rare, so it's a big request, but please bring me one!"))
            closemessage
        }
        else
        {
            applymovement(1, Common_Movement_Heart)
            waitmovement(0)
            delay(10)
            speakername("Punk Rocker")
            msgbox(format("Hey, it's a {COLOR GREEN}Heart Scale{COLOR DARK_GRAY}! My girlfriend will love this!\p Right, I promised you something in return. Here you go!"))
            closemessage
            removeitem(ITEM_HEART_SCALE)
            giveitem(ITEM_TM_SLUDGE_BOMB)
            closemessage

            delay(20)
            completequest(QUEST_MYRRINI_HEART_SCALE)
        }
    }
    release
    end
}
