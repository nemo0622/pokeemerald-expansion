{
    trainerbattle_single(TRAINER_PYTHIOSGYM_GERONI, PythiosTown_Gym_Text_Trainer_PythiosGym_GeroniIntro, PythiosTown_Gym_Text_Trainer_PythiosGym_GeroniDefeat)
    speakername("Geroni")
