mapscripts PythiosTown_Gym_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflashlevel(1)
    }
}

script PythiosTown_Gym_EventScript_GymStatue
{
    lock
    if(flag(FLAG_BADGE03_GET))
    {
        msgbox(format("Pythios Town Pokémon Gym\p Recent Victors: Niko, {PLAYER}"))
    }
    else
    {
        msgbox(format("Pythios Town Pokémon Gym\p Recent Victors: Niko"))
    }
    closemessage
    release
    end
}

script PythiosTown_Gym_EventScript_GymMan
{
    lock
    faceplayer
    speakername("Gym Guide")
    if(flag(FLAG_BADGE03_GET))
    {
        msgbox(format("Incredible! You're a rising star! Keep it up, future Champ!"))
    }
    else
    {
        msgbox(format("Welcome to the Pythios Town Gym!\p The Gym Leader, Sabella, has designed this building as a paradise for Ghost-type and other spiritually-inclined Pokémon. Of course, that makes it seem pretty creepy to me..."))
    }
    closemessage
    release
    end
}

script PythiosTown_Gym_EventScript_Mimikyu
{
    lock
    faceplayer
    speakername("Mimikyu")
    playmoncry(SPECIES_MIMIKYU, CRY_MODE_NORMAL)
    msgbox("Kk... ooouuuuhhh!")
    waitmoncry
    closemessage
    msgbox(format("Mimikyu seems tired."))
    closemessage
    release
    end
}

script PythiosTown_Gym_EventScript_Trainer_PythiosGym_Rosara
{
    trainerbattle_single(TRAINER_PYTHIOSGYM_ROSARA, PythiosTown_Gym_Text_Trainer_PythiosGym_RosaraIntro, PythiosTown_Gym_Text_Trainer_PythiosGym_RosaraDefeat)
    speakername("Rosara")
    msgbox(format("Some people say that Ghost-type Pokémon are lost souls reincarnated."))
    closemessage
    release
    end
}
text PythiosTown_Gym_Text_Trainer_PythiosGym_RosaraIntro
{
    format("I come in here to sing for lost Pokémon. Are you here for battle?")
}
text PythiosTown_Gym_Text_Trainer_PythiosGym_RosaraDefeat
{
    format("Oh, well. Back to singing.")
}

