// ----------------------------------------------------------------------------------------------

script PythiosTown_Gym_EventScript_Sabella
{
    lock
    faceplayer
    if(!flag(FLAG_HARD_MODE))
    {
        goto(PythiosTown_Gym_EventScript_Sabella_NormalDifficulty)
    }
    else
    {
        goto(PythiosTown_Gym_EventScript_Sabella_HardDifficulty)
    }
    release
    end
}

script PythiosTown_Gym_EventScript_Sabella_NormalDifficulty // called when on normal difficulty
{
    trainerbattle_single(TRAINER_LEADER_SABELLA, PythiosTown_Gym_Text_SabellaIntro, PythiosTown_Gym_Text_SabellaDefeat, PythiosTown_Gym_EventScript_Sabella_DefeatedScript, NO_MUSIC)
    speakername("Sabella")
    msgbox(format("As I saw in my visions, you were a worthy challenger. I hope we meet again one day, {PLAYER}."))
    closemessage
    release
    end
}
script PythiosTown_Gym_EventScript_Sabella_HardDifficulty // called when on hard difficulty
{
    trainerbattle_single(TRAINER_LEADER_SABELLA_HARD, PythiosTown_Gym_Text_SabellaIntro, PythiosTown_Gym_Text_SabellaDefeat, PythiosTown_Gym_EventScript_Sabella_DefeatedScript, NO_MUSIC)
    speakername("Sabella")
    msgbox(format("As I saw in my visions, you were a worthy challenger. I hope we meet again one day, {PLAYER}."))
    closemessage
    release
    end
}
text PythiosTown_Gym_Text_SabellaIntro
{
    format("Chaire. I knew you were coming, {PLAYER}. I've seen your journey in my visions, and I believe you are ready to challenge me.\p The Fates have led us here for a great battle. Let us follow our destiny, here and now!")
}
text PythiosTown_Gym_Text_SabellaDefeat
{
    format("Amazing... You've earned your third Gym Badge, as predicted.")
}
// Script called when you defeat the gym leader!
script PythiosTown_Gym_EventScript_Sabella_DefeatedScript
{
    setflag(FLAG_SUPPRESS_SPEAKER_NAME) // fixes message bug i think
    message(format("{PLAYER} received the Grave Badge from Sabella."))
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)

    // Set gym completion flags
    setflag(FLAG_BADGE03_GET)
    // Set all trainers in Gym as defeated
    settrainerflag(TRAINER_PYTHIOSGYM_ROSARA)
    settrainerflag(TRAINER_PYTHIOSGYM_TAFOS)
    settrainerflag(TRAINER_PYTHIOSGYM_ADDONIS)
    settrainerflag(TRAINER_PYTHIOSGYM_GERONI)
    settrainerflag(TRAINER_PYTHIOSGYM_YANNA)
    // // Toggle event flag in Jusmail
    // clearflag(FLAG_HIDE_RANIA_JUSMAIL)

    // Explain badge
    speakername("Sabella")
    msgbox(format("The Grave Badge proves your skills of connecting to the hearts and souls of your Pokémon. You'll also be able to use the {COLOR GREEN}HM Flash{COLOR DARK_GRAY} outside of battle.\p Please, take this before you leave."))
    closemessage

    // Give TM reward and explain, plus end dialogue
    giveitem(ITEM_TM_CALM_MIND)
    speakername("Sabella")
    msgbox(format("That TM contains the move {COLOR GREEN}Calm Mind{COLOR DARK_GRAY}, which will boost your Pokémon's stats.\p I see the open ocean in your future... make sure you speak with a {COLOR GREEN}strange sailor{COLOR DARK_GRAY} on the beach. Then you'll be ready to head east, through the caves to {COLOR GREEN}Sofos City{COLOR DARK_GRAY}. I see greatness in your future."))
    closemessage

    delay(20)
    completequest(QUEST_GYM_3)
    delay(20)
    startquest(QUEST_GYM_4)

    release
    end
}
