script PentepetalCity_EventScript_PickUpRandomFossil
{
    if(!flag(FLAG_HIDDEN_ITEM_PENTEPETAL_FOSSIL))
    {
        lock
        msgbox(format("Hm? There's a strange-looking rock in this bag abandoned by Team Chimera!"))
        closemessage
        delay(5)
        randomelement(ITEM_SKULL_FOSSIL, ITEM_ARMOR_FOSSIL)
        giveitem(VAR_RESULT)
        closemessage
        setflag(FLAG_HIDDEN_ITEM_PENTEPETAL_FOSSIL)
    }
    release
    end
}
