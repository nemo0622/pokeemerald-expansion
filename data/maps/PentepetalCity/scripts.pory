script PentepetalCity_EventScript_Artist
{
    lock
    faceplayer
    speakername("Artist")
    
    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_SHOW_RIBBON_TO_ARTIST)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Your Pokémon has inspired me with their talents! I can see why it wins Ribbons."))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_SHOW_RIBBON_TO_ARTIST)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("I'm looking for the perfect Pokémon to paint... I want a winning art piece, so I need to see a Contest-winning Pokémon!\p Talk to me when you have a {COLOR GREEN}Pokémon with a Ribbon{COLOR DARK_GRAY} to inspire my art."))
        closemessage

        delay(20)
        startquest(QUEST_SHOW_RIBBON_TO_ARTIST)
    }
    else
    {
        msgbox(format("Chaire! Have you won any Pokémon Contests yet? I'd like to see a {COLOR GREEN}Pokémon with a Ribbon{COLOR DARK_GRAY}."))
        closemessage

        special(CheckIfAnyMonsHaveRibbons)
        delay(30)

        if(var(VAR_RESULT) == TRUE)
        {
            applymovement(32, Common_Movement_Heart)
            waitmovement(0)
            delay(10)
            bufferspeciesname(STR_VAR_1, VAR_0x8004)
            speakername("Artist")
            msgbox(format("Your {STR_VAR_1} has a stunning Ribbon! It must be a Pokémon Contest winner, this will make for a perfect painting!\p You have my inspiration flowing. Please, take this!"))
            closemessage

            delay(5)
            giveitem(ITEM_TM_DRAINING_KISS)
            closemessage
            delay(20)
            completequest(QUEST_SHOW_RIBBON_TO_ARTIST)
        }
        else
        {
            speakername("Artist")
            msgbox(format("Hm, still working on the Pokémon Contests, huh? That's okay, I haven't won any either.\p Come to me when you have a {COLOR GREEN}Pokémon with a Contest Ribbon{COLOR DARK_GRAY}. I'll give you a reward for your effort!"))
            closemessage
        }
    }
    release
    end
}

