mapscripts PalatiCity_House3_MapScripts {}

script PalatiCity_House3_EventScript_Athlete
{
    lock
    faceplayer
    speakername("Athlete")
    msgbox(format("Huff huff... I just got back from a run around the island."))
    closemessage
    release
    end
}

script PalatiCity_House3_EventScript_Man
{
    lock
    faceplayer
    speakername("Man")
    msgbox(format("The Gym Leader, Rhadine, is one of the most beautiful women in the region. If I catch a good Rock-type Pokémon, maybe I'll give the Gym a shot."))
    closemessage
    release
    end
}

script PalatiCity_House3_EventScript_OldPalatiOutfitBeauty
{
    lock
    faceplayer
    speakername("Fashionista")
    checkoutfitflag(OUTFIT_PALATI)

    if(var(VAR_RESULT) == FALSE) // no outfit
    {
        msgbox(format("Ehehe, look at my little Tirtouga doll! I think it's fashionable in its own way."))
        closemessage
        delay(5)
        showmoneybox(0, 0)
        speakername("Fashionista")
        msgbox(format("I can tell you have a sharp eye for fashion! I'll give you this {COLOR GREEN}Old Palati Style Outfit{COLOR DARK_GRAY} for just ¥15000. How about it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == FALSE) // said no
        {
            hidemoneybox
            speakername("Fashionista")
            msgbox(format("No? But I thought you were into fashion!"))
            closemessage
            release
            end
        }
        else // said yes
        {
            // check money before purchasing
            checkmoney(15000)
            if(var(VAR_RESULT) == FALSE)
            {
                hidemoneybox
                speakername("Fashionista")
                msgbox(format("Hey, you don't have the money for that!"))
                closemessage
                release
                end
            }
            else
            {
                removemoney(15000)
                updatemoneybox
                delay(5)
                unlockoutfit(OUTFIT_PALATI)
                msgbox(format("The Old Palati Style Outfit has been added to the Outfit Box!"))
                delay(20)
                closemessage
                hidemoneybox
                delay(5)
                speakername("Fashionista")
                msgbox(format("Sweet! The Old Palati Style Outfit is based on artwork of ancient people who once lived on this island. You can learn a lot about cultures through their fashion!"))
                closemessage
            }
        }
    }
    else
    {
        msgbox(format("Have you tried on the Old Palati Style Outfit? It's one of my personal favorites, inspired by the ancient cultural traditions of this island!"))
        closemessage
    }
    release
    end
}
