mapscripts HauoliOutskirts_PlayersRoom_MapScripts {
	MAP_SCRIPT_ON_FRAME_TABLE [
		VAR_INTRO_STATE, 1: HauoliOutskirts_PlayersHouse_IntroEvent
	]
}

script HauoliOutskirts_PlayersHouse_IntroEvent
{
	setvar(VAR_INTRO_STATE, 2)

	lockall
	delay(20)
	emote(LOCALID_MOM, EMOTE_EXCLAM)
	applymovement(LOCALID_MOM, HauoliOutskirts_PlayersHouse_MomApproachPlayersRoom)
	waitmovement(0)

	setspeaker("Mom")
	msgbox(format("Ehehe, sorry about Meowth, {PLAYER}! She's been bouncing around the house like a Hoppip in a hurricane.\p Looks like you finished your video call with Professor Burnet! You should go out and {COLOR GREEN}talk to your Grandpa Samson{COLOR DARK_GRAY} before you meet with the professors. He's just north of here in {COLOR GREEN}Iki Town{COLOR DARK_GRAY}. Try to stay out of the tall grass!"))
	closemessage

	// Start "Welcome to Alola" Quest!
	startquest(QUEST_01)
	completesubquest(QUEST_01, SUB_QUEST_1) // Unlocks ("completes") Subquest 1 - Find Samson Oak

	applymovement(LOCALID_MOM, HauoliOutskirts_PlayersHouse_MomReturnToChair)
	waitmovement(0)

	releaseall
	end
}
movement HauoliOutskirts_PlayersHouse_MomApproachPlayersRoom
{
	walk_up
	walk_right * 3
	walk_up
	face_up
	step_end
}
movement HauoliOutskirts_PlayersHouse_MomReturnToChair
{
	walk_down
	walk_left * 3
	walk_down
	face_left
	step_end
}

// --------------------------------------------------------------------------------------------------

script HauoliOutskirts_PlayersHouse_Script_Mom
{
	lock
	faceplayer
	setspeaker("Mom")
	
	switch(var(VAR_INTRO_STATE))
	{
		case 2: // Left room for first time
			msgbox(format("Your Grandpa, Tutu Samson, is in {COLOR GREEN}Iki Town{COLOR DARK_GRAY} meeting with someone. It sounded like he wanted to talk to you!"))
			closemessage
		case 3: // Just got starter, headed to Iki Town
			msgbox(format("Now that you've got a Pokémon, you should be able to reach {COLOR GREEN}Iki Town{COLOR DARK_GRAY} without a problem.\p Do you two want a rest?"), MSGBOX_YESNO)
			closemessage
			if(var(VAR_RESULT) == TRUE)
			{
				fadescreen(FADE_TO_BLACK)
				delay(30)
				special(HealPlayerParty)
				delay(30)
				fadescreen(FADE_FROM_BLACK)
				delay(15)
				setspeaker("Mom")
				msgbox(format("Hey, you two look like you're ready to go! Have fun out there!"))
				closemessage
			}
		default: // After all tutorial stuff ends
			msgbox(format("Alola and welcome home, {PLAYER}! Do you want to rest your Pokémon while you're here?"), MSGBOX_YESNO)
			if(var(VAR_RESULT) == TRUE)
			{
				fadescreen(FADE_TO_BLACK)
				delay(30)
				special(HealPlayerParty)
				delay(30)
				fadescreen(FADE_FROM_BLACK)
				delay(15)
				setspeaker("Mom")
				msgbox(format("Looks like your Pokémon are all healed. Have fun out there!"))
				closemessage
			}
			else
			{
				setspeaker("Mom")
				msgbox(format("Alright then, stay as long as you'd like. I'm glad you came to visit!"))
				closemessage
			}
	}

	release
	end
}

script HauoliOutskirts_PlayersHouse_Script_Meowth
{
	lock
    faceplayer
    setspeaker("Mom's Meowth")
    playmoncry(SPECIES_MEOWTH, CRY_MODE_NORMAL)
    msgbox(format("Breowww!!"))
    waitmoncry
    closemessage
    release
    end
}

script HauoliOutskirts_PlayersHouse_Script_MomMeetsStarter
{
	lockall
	addobject(3)
	addobject(4)
	switch(var(VAR_STARTER_MON))
	{
		default:
		case SPECIES_ROWLET:
			clearflag(FLAG_HIDE_ROWLET_STARTERS_HOUSE)
			addobject(LOCALID_PH_ROWLET)
			break
		case SPECIES_LITTEN:
			clearflag(FLAG_HIDE_LITTEN_STARTERS_HOUSE)
			addobject(LOCALID_PH_LITTEN)
			break
		case SPECIES_POPPLIO:
			clearflag(FLAG_HIDE_POPPLIO_STARTERS_HOUSE)
			addobject(LOCALID_PH_POPPLIO)
			break
	}
	fadescreen(FADE_FROM_BLACK)
	delay(20)
	applymovement(3, moves(walk_up * 2, face_right, step_end))
	applymovement(4, moves(walk_fast_up * 3, walk_fast_left * 3, jump_in_place_left * 2, face_left, step_end))
	applymovement(LOCALID_PLAYER, moves(walk_up * 3, face_up, step_end))
	switch(var(VAR_STARTER_MON))
	{
		default:
		case SPECIES_ROWLET:
			applymovement(LOCALID_PH_ROWLET, moves(walk_right, walk_up * 2, face_up, step_end))
			break
		case SPECIES_LITTEN:
			applymovement(LOCALID_PH_LITTEN, moves(walk_right, walk_up * 2, face_up, step_end))
			break
		case SPECIES_POPPLIO:
			applymovement(LOCALID_PH_POPPLIO, moves(walk_right, walk_up * 2, face_up, step_end))
			break
	}
	waitmovement(0)
	applymovement(2, moves(face_right, emote_heart, step_end))
	waitmovement(0)
	delay(10)

	emote(LOCALID_MOM, EMOTE_EXCLAM)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	switch(var(VAR_STARTER_MON))
	{
		default:
		case SPECIES_ROWLET:
			applymovement(LOCALID_PH_ROWLET, moves(face_right))
			break
		case SPECIES_LITTEN:
			applymovement(LOCALID_PH_LITTEN, moves(face_right))
			break
		case SPECIES_POPPLIO:
			applymovement(LOCALID_PH_POPPLIO, moves(face_right))
			break
	}
	applymovement(LOCALID_MOM, moves(walk_fast_down * 4, face_left, step_end))
	waitmovement(0)
	setspeaker("Mom")
	msgbox(format("Who's THIS?! It's so CUTE!"))
	closemessage

	applymovement(3, moves(walk_down, face_right))
	waitmovement(0)
	bufferspeciesname(STR_VAR_1, VAR_STARTER_MON)
	setspeaker("Grandpa Samson")
	msgbox(format("That's {STR_VAR_1}, a rare Pokémon native to Alola...\pAnd it's {PLAYER}'s new Pokémon, too!"))
	closemessage
	applymovement(LOCALID_MOM, moves(jump_in_place_left))
	waitmovement(0)
	delay(5)
	setspeaker("Mom")
	msgbox(format("Maika'i loa, that's great! How'd this happen? I just sent {PLAYER} to get you from Iki Town, not get caught up in an adventure!"))
	closemessage

	applymovement(4, moves(walk_right * 4, walk_down, face_down, step_end))
	waitmovement(0)
	setspeaker("Prof. Kukui")
	msgbox(format("{PLAYER} ran into some bad luck with a wild Yungoos on the way, but my Pokémon ran off to save them! With {STR_VAR_1} by their side, {PLAYER}'ll be safe from anything."))
	closemessage
	delay(20)

	emote(4, EMOTE_EXCLAM)
	applymovement(LOCALID_PLAYER, moves(face_right))
	applymovement(4, moves(face_left))
	waitmovement(0)
	setspeaker("Prof. Kukui")
	msgbox(format("Samson and I ran after those Pokémon in such a rush, I forgot why I was in Iki Town in the first place!\p Come to {COLOR GREEN}Iki Town{COLOR DARK_GRAY}. You'll be safe with {STR_VAR_1}, and I want you to meet someone there, yeah!"))
	closemessage

	delay(10)
	fadescreen(FADE_TO_BLACK)
	delay(30)
	applymovement(LOCALID_MOM, moves(walk_fast_up * 4, face_down, step_end))
	waitmovement(0)
	setflag(FLAG_HIDE_SAMSON_ROUTE_01)
	setflag(FLAG_HIDE_STARTERS_ROUTE_01)
	removeobject(3)
	removeobject(4)
	setflag(FLAG_HIDE_ROWLET_STARTERS_HOUSE)
	setflag(FLAG_HIDE_LITTEN_STARTERS_HOUSE)
	setflag(FLAG_HIDE_POPPLIO_STARTERS_HOUSE)
	removeobject(5)
	removeobject(6)
	removeobject(7)
	clearflag(FLAG_HIDE_SAMSON_HAUOLI_OUTSKIRTS)
	fadescreen(FADE_FROM_BLACK)
	delay(30)

	startsubquest(QUEST_01, SUB_QUEST_2) // Unlocks ("completes") Subquest 2 - Follow Kukui to Iki Town

	clearflag(FLAG_OVERWORLD_ENCOUNTERS_DISABLED) // Enables Overworld Encounters
	updatefollowingmon
	releaseall
	end
}

// --------------------------------------------------------------------------------------------------------

script HauoliOutskirts_PlayersHouse_Sign_TV
{
	lock
	msgbox(format("Mom has a sitcom on from when she was a teen. Nostalgia is a powerful thing!"))
	closemessage
	release
	end
}

script HauoliOutskirts_PlayersHouse_Sign_MeowthsFoodBowl
{
	lock
	msgbox(format("It's Meowth's food bowl."))
	closemessage
	if(!flag(FLAG_GOT_AMULET_COIN_HAUOLI))
	{
		setflag(FLAG_GOT_AMULET_COIN_HAUOLI)
		msgbox(format("Hm? There's something in the bowl."))
		closemessage
		giveitem(ITEM_AMULET_COIN)
		closemessage
		msgbox(format("Mom is spoiling Meowth too much!"))
		closemessage
	}
	release
	end
}

script HauoliOutskirts_PlayersHouse_Sign_SamsonsJournal
{
	lock
	msgbox(format("It's Grandpa Samson's field journal! Read it?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == 1)
	{
		setspeaker("Samson Oak")
		msgbox(format("{COLOR GREEN}Lurantis{COLOR DARK_GRAY} is a beautiful Pokémon with sickle-sharp petals able to cut straight through trees. They've evolved to blend in with the bright flowers of Alola, luring in prey with hypnotic swaying and colors before striking.\p There are rumors of a {COLOR RED}super-powerful Lurantis{COLOR DARK_GRAY} lurking deep in the forests of Akala Island. Is this a folktale, or could this be a real {COLOR GREEN}Totem Pokémon{COLOR DARK_GRAY}?"))
	}
	closemessage
	release
	end
}
