mapscripts SofosCity_House4_MapScripts {}

script SofosCity_House4_EventScript_Pawmo
{
    lock
    faceplayer
    speakername("Pawmo")
    playmoncry(SPECIES_PAWMO, CRY_MODE_NORMAL)
    msgbox("Brrzzz!")
    waitmoncry
    closemessage
    release
    end
}

script SofosCity_House4_EventScript_ComputerGuy
{
    lock
    faceplayer
    speakername("Computer Guy")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_5_PINBALL_POINTS)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("My Pinball Protégé! You're always welcome in my house!\p {COLOR GREEN}Pinball Points{COLOR DARK_GRAY} might seem worthless, but they're very valuable to a select few around the Ilios Region. It never hurts to stop by the arcade when you're in town!"))
        closemessage
        applymovement(1, Common_Movement_FaceUp)
        waitmovement(0)
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_5_PINBALL_POINTS)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Have you stopped by the Sofos City {COLOR GREEN}Arcade{COLOR DARK_GRAY} yet? They say the Pinball World Champion trained their skills in this very arcade. A game requiring such perfect strategy is right at home in Sofos City.\p Ehehe, sorry for rambling, I'm just so passionate about Pinball! When you play, you earn {COLOR GREEN}Pinball Points{COLOR DARK_GRAY}, which can be exchanged for exciting prizes.\p I have an idea! Come back to me when you've earned {COLOR GREEN}5 Pinball Points{COLOR DARK_GRAY}. I'll give you a better reward than anything they have in the arcade!"))
        closemessage
        applymovement(1, Common_Movement_FaceUp)
        waitmovement(0)
        
        delay(20)
        startquest(QUEST_5_PINBALL_POINTS)
    }
    else
    {
        msgbox(format("Ah, if it isn't my Pinball Protégé! Have you earned {COLOR GREEN}5 Pinball Points{COLOR DARK_GRAY} and brought them to me?"))
        closemessage

        delay(30)
        if(var(VAR_PINBALL_POINTS) < 5) // less than 5 pinball points
        {
            msgbox(format("Mmm, looks like you need more time at the arcade. Becoming a Pinball Champion takes time and practice!\p Bring me {COLOR GREEN}5 Pinball Points{COLOR DARK_GRAY} to show me that you're improving at the games. I'll give you a great reward!"))
            closemessage
        }
        else // >= 5 pinball points
        {
            applymovement(1, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(15)
            msgbox(format("I knew it! By earning these {COLOR GREEN}Pinball Points{COLOR DARK_GRAY}, you've shown me that you're playing Pinball and becoming great!\p I've got a reward for you. I'll just take those {COLOR GREEN}Pinball Points{COLOR DARK_GRAY} off your hands... hey, nothing comes for free!"))
            closemessage
            delay(5)
            msgbox(format("{PLAYER} gave away {COLOR GREEN}5 Pinball Points{COLOR DARK_GRAY}."))
            closemessage
            subvar(VAR_PINBALL_POINTS, 5)
            delay(5)
            giveitem(ITEM_COVERT_CLOAK)
            closemessage
            delay(5)
            speakername("Computer Guy")
            msgbox(format("A Pokémon holding the Covert Cloak becomes immune to secondary effects from opposing attacks. No more flinching during important battles! See, wasn't that worth the effort?"))
            closemessage

            delay(20)
            completequest(QUEST_5_PINBALL_POINTS)
        }
    }
    release
    end
}
