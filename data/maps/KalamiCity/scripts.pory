script KalamiCity_EventScript_DirectionSign
{
    lock
    msgbox(format("Kalami City\n Reeds, Vines, and Industry\p {UP_ARROW} Riverwalk Trail - South"))
    closemessage
    release
    end
}

script KalamiCity_EventScript_UniversityStudentRouteCheck
{
    lock
    faceplayer
    speakername("Uni. Student")

    if(flag(FLAG_CAUGHT_ALL_MONS_KALAMI_CITY))
    {
        msgbox(format("Your Pokédex data is amazing! Now we know more about the local ecosystem, thanks to you."))
        closemessage
    }
    else
    {
        msgbox(format("Chaire (Hyeh-rei)! I'm a student from the Acrisia University.\p I'm looking for {COLOR GREEN}Pokédex data{COLOR DARK_GRAY} of {COLOR GREEN}all Land and Water Pokémon{COLOR DARK_GRAY} found in Kalami City. If you've caught all the Pokémon here, please let me know."))
        closemessage
        special(CheckRouteCaptureProgress)
        if(var(VAR_RESULT) == TRUE) // caught all mons on the route!
        {
            delay(20)
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Uni. Student")
            msgbox(format("Incredible! You've caught all the Pokémon that I requested in the area!\p Here's a reward from the University. Keep up your hard work!"))
            closemessage
            delay(5)

            // give reward!
            giveitem(ITEM_TM_WHIRLPOOL)
            closemessage
            delay(5)

            checkoutfitflag(OUTFIT_EAST_BLUE)
            if(var(VAR_RESULT) == FALSE)
            {
                unlockoutfit(OUTFIT_EAST_BLUE)
                msgbox(format("The East Ilios Blue Outfit has been added to the Outfit Box!"))
                delay(20)
                closemessage
            }

            setflag(FLAG_CAUGHT_ALL_MONS_KALAMI_CITY)
        }
    }

    release
    end
}

