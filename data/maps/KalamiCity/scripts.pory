script KalamiCity_EventScript_EastBlueOutfitBeauty
{
    lock
    faceplayer
    speakername("Fashionista")
    checkoutfitflag(OUTFIT_EAST_BLUE)

    if(var(VAR_RESULT) == FALSE) // no coral outfit
    {
        msgbox(format("My sweet, colorful Amaura has inspired me to put together a new outfit!"))
        closemessage
        delay(5)
        showmoneybox(0, 0)
        speakername("Fashionista")
        msgbox(format("I can tell you have a sharp eye for fashion! I'll give you this {COLOR GREEN}East Ilios Blue Outfit{COLOR DARK_GRAY} for just ¥6000. How about it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == FALSE) // said no
        {
            hidemoneybox
            speakername("Fashionista")
            msgbox(format("No? But I thought you were into fashion!"))
            closemessage
            release
            end
        }
        else // said yes
        {
            // check money before purchasing
            checkmoney(6000)
            if(var(VAR_RESULT) == FALSE)
            {
                hidemoneybox
                speakername("Fashionista")
                msgbox(format("Hey, you don't have the money for that!"))
                closemessage
                release
                end
            }
            else
            {
                removemoney(6000)
                updatemoneybox
                delay(5)
                unlockoutfit(OUTFIT_EAST_BLUE)
                msgbox(format("The East Ilios Blue Outfit has been added to the Outfit Box!"))
                delay(20)
                closemessage
                hidemoneybox
                delay(5)
                speakername("Fashionista")
                msgbox(format("Sweet! The East Ilios Blue Outfit incorporates the most recent fashion trends from the coastal areas of the region."))
                closemessage
            }
        }
    }
    else
    {
        msgbox(format("Have you tried on the East Ilios Blue Outfit? It sticks to the coolest, most recent fashion trends!"))
        closemessage
    }
    release
    end
}
