{
    trainerbattle_single(TRAINER_KAPTARAWEST_ALLAN, KaptaraIsland_West_Text_Trainer_KaptaraWest_AllanIntro, KaptaraIsland_West_Text_Trainer_KaptaraWest_AllanDefeat)
