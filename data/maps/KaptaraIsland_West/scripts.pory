mapscripts KaptaraIsland_West_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_CHIMERA_WEATHER_ACTIVE) && !flag(FLAG_HIDE_WEATHER_KAPTARA_ISLAND))
        {
            setweather(WEATHER_ABNORMAL)
        }

        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(24, ENCOUNTER_LAND)
        setobjectaswildencounter(25, ENCOUNTER_LAND)
        setobjectaswildencounter(26, ENCOUNTER_LAND)
        setobjectaswildencounter(27, ENCOUNTER_LAND)
        setobjectaswildencounter(28, ENCOUNTER_LAND)
    }

    MAP_SCRIPT_ON_RESUME {
        if(flag(FLAG_SYS_CTRL_OBJ_DELETE))
        {
            removeobject(1) // removes kyogre
        }

        questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_LEGEND_OF_KYOGRE)
        if(var(VAR_RESULT) == TRUE)
        {
            getcaughtmon(SPECIES_KYOGRE)
            if(var(VAR_RESULT) == TRUE)
            {
                // Failsafe to make damn sure that quest will be completed
                completequest(QUEST_LEGEND_OF_KYOGRE)
            }
        }
    }
}

script KaptaraIsland_West_EventScript_DirectionSign
{
    lock
    msgbox(format("Kaptara Island - Krikri Gorge\n Where Giants Come to Sleep\p Palati City {RIGHT_ARROW}"))
    closemessage
    release
    end
}

script KaptaraIsland_West_EventScript_Trainer_KaptaraWest_Dani
{
    trainerbattle_single(TRAINER_KAPTARAWEST_DANI, KaptaraIsland_West_Text_Trainer_KaptaraWest_DaniIntro, KaptaraIsland_West_Text_Trainer_KaptaraWest_DaniDefeat)
    speakername("Dani")
    msgbox(format("Ah, I can't get past the large rocks further ahead, anyway. Maybe I need a special HM?"))
    closemessage
    release
    end
}
text KaptaraIsland_West_Text_Trainer_KaptaraWest_DaniIntro
{
    format("They say there are sunken ruins deep in these woods. I'll beat you there!")
}
text KaptaraIsland_West_Text_Trainer_KaptaraWest_DaniDefeat
{
    format("Looks like you'll get ahead of me.")
}

