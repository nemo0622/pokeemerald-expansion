script JusmailTown_Gym_EventScript_Trainer_JusmailGym_Kari
{
    trainerbattle_single(TRAINER_JUSMAILGYM_KARI, JusmailTown_Gym_Text_Trainer_JusmailGym_KariIntro, JusmailTown_Gym_Text_Trainer_JusmailGym_KariDefeat)
    speakername("Kari")
    msgbox(format("The fruits on these trees are so yummy!"))
    closemessage
    release
    end
}
text JusmailTown_Gym_Text_Trainer_JusmailGym_KariIntro
{
    format("I like it better in here than outside. It's temperature-controlled inside!")
}
text JusmailTown_Gym_Text_Trainer_JusmailGym_KariDefeat
{
    format("Guess I should've trained outside more...")
}

