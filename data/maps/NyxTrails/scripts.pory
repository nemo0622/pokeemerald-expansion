script NyxTrails_EventScript_OldManFung
{
    lock
    faceplayer
    speakername("Old Man Fung")
    if(flag(FLAG_GOT_FIRE_BLAST_FROM_FUNG))
    {
        msgbox(format("Thanks for the help, bud. I'll use that {COLOR GREEN}Fire Blast{COLOR DARK_GRAY} move to defend myself against Team Chimera!"))
        closemessage
    }
    else
    {
        msgbox(format("Finally, a Trainer who isn't Team Chimera! Are you here to take them down?\p I've been hiding here, working on perfecting a move to protect myself. You've just inspired me to finish it! Here, take this."))
        closemessage
        delay(5)
        giveitem(ITEM_TM_FIRE_BLAST)
        setflag(FLAG_GOT_FIRE_BLAST_FROM_FUNG)
        closemessage
        delay(5)
        speakername("Old Man Fung")
        msgbox(format("Only a super-powerful move like {COLOR GREEN}Fire Blast{COLOR DARK_GRAY} could deter these nasty Grunts!"))
        closemessage
    }
    release
    end
}

