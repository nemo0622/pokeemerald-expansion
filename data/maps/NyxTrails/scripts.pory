script NyxTrails_EventScript_FatMan
{
    lock
    faceplayer
    speakername("Scared Man")
    msgbox(format("Uhm... I think these woods are crawling with Team Chimera grunts. We should probably get out of here..."))
    closemessage
    release
    end
}

script NyxTrails_EventScript_Trainer_NyxTrails_Harry
{
    trainerbattle_single(TRAINER_NYXTRAILS_HARRY, NyxTrails_Text_Trainer_NyxTrails_HarryIntro, NyxTrails_Text_Trainer_NyxTrails_HarryDefeat)
    speakername("Harry")
    msgbox(format("I'm supposed to make sure no more Team Chimera members get through to their Hideout."))
    closemessage
    release
    end
}
text NyxTrails_Text_Trainer_NyxTrails_HarryIntro
{
    format("Stop right there! No Team Chimera grunts can pass me!")
}
text NyxTrails_Text_Trainer_NyxTrails_HarryDefeat
{
    format("Oh, you're innocent, sorry 'bout that.")
}

script NyxTrails_EventScript_Trainer_NyxTrails_Brienne
{
    trainerbattle_single(TRAINER_NYXTRAILS_BRIENNE, NyxTrails_Text_Trainer_NyxTrails_BrienneIntro, NyxTrails_Text_Trainer_NyxTrails_BrienneDefeat)
    speakername("Brienne")
    msgbox(format("Areios Town was a tiny hamlet, but that doesn't make Team Chimera's actions any less horrible. A lot of good people lost their homes because of them..."))
    closemessage
    release
    end
}
text NyxTrails_Text_Trainer_NyxTrails_BrienneIntro
{
    format("I'm gonna reclaim Areios Town! You'll see!")
}
text NyxTrails_Text_Trainer_NyxTrails_BrienneDefeat
{
    format("I need a Pokémon Center first!")
}

script NyxTrails_EventScript_Trainer_NyxTrails_Samwell
{
    trainerbattle_single(TRAINER_NYXTRAILS_SAMWELL, NyxTrails_Text_Trainer_NyxTrails_SamwellIntro, NyxTrails_Text_Trainer_NyxTrails_SamwellDefeat)
    speakername("Samwell")
    msgbox(format("The Nyx Trails have always been an undeveloped, desolate place, but this is worse than I thought. I wonder how many Pokémon Team Chimera displaced as they slashed through the forest."))
    closemessage
    release
    end
}
text NyxTrails_Text_Trainer_NyxTrails_SamwellIntro
{
    format("It looks like Team Chimera burned parts of the forest as they passed. How evil!")
}
text NyxTrails_Text_Trainer_NyxTrails_SamwellDefeat
{
    format("I bet you could stop them!")
}

