script NyxTrails_EventScript_DirectionSign
{
    lock
    msgbox(format("The Nyx Trails\n Weak Trainers, Beware!\p {UP_ARROW} Port Pello\n {DOWN_ARROW} Areios Hideout\p Where it says Areios Hideout, the word Town is visibly scratched out underneath."))
    closemessage
    release
    end
}