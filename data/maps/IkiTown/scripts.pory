script IkiTown_Sign_LocationSign
{
	lock
	msgbox(format("Iki Town\n Where We Give Thanks to Pokémon."))
	closemessage
	release
	end
}

script IkiTown_Sign_MahaloTrailUp
{
	lock
	msgbox(format("{UP_ARROW} Mahalo Trail"))
	closemessage
	release
	end
}
