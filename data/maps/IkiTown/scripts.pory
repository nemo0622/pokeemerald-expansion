script IkiTown_NPC_Hau
{
	lock
	faceplayer
	setspeaker("Hau")
	msgbox(format("Alola, {PLAYER}! I can't wait to get my own Pokémon!\p In Mahalo Trail, I felt like I couldn't help... Once I get a Pokémon of my own, I'll be able to help whoever needs it!"))
	closemessage
	release
	end
}

script IkiTown_NPC_Nurse
{
	lock
	faceplayer
	setspeaker("Nurse")
	msgbox(format("Alola! Would you like to heal your Pokémon?"), MSGBOX_YESNO)
	if(var(VAR_RESULT) == TRUE)
	{
		setspeaker("Nurse")
		msgbox(format("Sure! Let me see your Pokémon..."))
		closemessage
		applymovement(26, moves(walk_in_place_slow_left * 3, face_down, step_end))
		waitmovement(0)
		special(HealPlayerParty)
		delay(10)
		applymovement(26, Movement_PkmnCenterNurse_Bow)
		waitmovement(0)
		setspeaker("Nurse")
		msgbox(format("Your Pokémon are feeling better. Have a good day!"))
		closemessage
	}
	else
	{
		setspeaker("Nurse")
		msgbox(format("Come back soon!"))
		closemessage
	}
	release
	end
}

