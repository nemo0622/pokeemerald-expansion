raw `
IkiTown_MapScripts::
	.byte 0
`

script IkiTown_Script_HalaIntro
{
	lockall
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
	switch(var(VAR_TEMP_1))
	{
		case 26:
			applymovement(LOCALID_PLAYER, moves(walk_right, walk_up * 2, delay_16 * 2, face_right, step_end))
		case 28:
			applymovement(LOCALID_PLAYER, moves(walk_left, walk_up * 2, delay_16 * 2, face_right, step_end))
		default:
			applymovement(LOCALID_PLAYER, Common_Movement_WalkUp2)
	}
	// Player position now x27 y23

	// School kids run in circle
	delay(10)
	emote(2, EMOTE_EXCLAM)
	applymovement(2, moves(walk_fast_right, walk_fast_down, walk_fast_left, walk_fast_up, face_right, step_end))
	applymovement(3, moves(walk_fast_down, walk_fast_left, walk_fast_up, walk_fast_right, face_left, step_end))
	waitmovement(0)
	delay(20)

	// Alolan Exeggutor waddles by
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	applymovement(4, moves(walk_right * 8, walk_up * 6, step_end))
	delay(80)
	applymovement(5, moves(walk_fast_right * 8, face_up, delay_16, jump_in_place_up * 2, step_end))
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
	waitmovement(0)
	setspeaker("Prof. Kukui")
	msgbox(format("Aue! Come on, just give me one good Dragon Hammer, {COLOR BLUE}Exeggutor{COLOR DARK_GRAY}!"))
	closemessage
	applymovement(5, moves(walk_fast_up * 6, step_end))
	waitmovement(0)
	setflag(FLAG_HIDE_ALOLAN_EXEGGUTOR_IKI_TOWN)
	removeobject(4)
	removeobject(5)

	// Hala approaches
	delay(20)
	applymovement(LOCALID_HALA_IKI, moves(walk_down * 3, face_up, step_end))
	waitmovement(0)
	emote(LOCALID_HALA_IKI, EMOTE_QUESTION)
	setspeaker("???")
	msgbox(format("Ohoho! Kukui never changes, does he?"))
	closemessage
	delay(10)
	applymovement(LOCALID_HALA_IKI, moves(walk_down * 2, face_down, step_end))
	waitmovement(0)
	setspeaker("Kahuna Hala")
	msgbox(format("Alola! I'm glad to meet you, young Trainer. My name is {COLOR GREEN}Hala{COLOR DARK_GRAY}, {COLOR GREEN}Kahuna of Melemele Island{COLOR DARK_GRAY}.\p I've heard much and more about you. {PLAYER}, grandchild of the legendary Samson Oak, returning to their home island after so long away!\p The {COLOR GREEN}Manalo Festival{COLOR DARK_GRAY} begins soon. Before, this would be when you would be granted a Pokémon, but it seems they beat us to it!\p For now, please join in on the festivities. My grandson {COLOR GREEN}Hau{COLOR DARK_GRAY} just ran {COLOR GREEN}up Mahalo Trail{COLOR DARK_GRAY} - perhaps you could get to know him?"))
	closemessage

	fadescreenswapbuffers(FADE_TO_BLACK)
	delay(30)
	setvar(VAR_INTRO_STATE, 5)
	setflag(FLAG_HIDE_HALA_INTRO_IKI_TOWN)
	removeobject(LOCALID_HALA_IKI)
	delay(30)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(15)

	startsubquest(QUEST_01, SUB_QUEST_3) // Unlock Subquest 3: Find Hau in Mahalo Trail

	releaseall
	end
}

script IkiTown_Script_SavedLillie
{
	lockall
	addobject(16)
	addobject(17)
	addobject(18)
	addobject(19)
	applymovement(LOCALID_PLAYER, moves(walk_down * 2, step_end)) // player at x28, y3
	applymovement(16, moves(walk_down * 2, step_end)) // Lillie
	applymovement(17, moves(walk_down * 2, step_end)) // Hau
	applymovement(18, moves(walk_down * 2, step_end)) // Cosmog
	fadescreen(FADE_FROM_BLACK)
	delay(25)
	clearflag(FLAG_HIDE_MAP_NAME_POPUP)

	applymovement(8, Common_Movement_FaceUp)
	waitmovement(0)
	emote(8, EMOTE_EXCLAM)
	delay(10)
	applymovement(8, moves(walk_left, walk_up * 2, face_up, step_end)) // Kukui
	waitmovement(0)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
	setspeaker("Prof. Kukui")
	msgbox(format("Oho, I wondered where you ran off to, Lillie! Now why'd you go up {COLOR GREEN}Mahalo Trail{COLOR DARK_GRAY}? You training with {COLOR BLUE}Cosmog{COLOR DARK_GRAY}?"))
	closemessage
	applymovement(16, moves(walk_in_place_down * 2, step_end))
	waitmovement(0)
	setspeaker("Lillie")
	msgbox(format("I- I didn't mean to... {COLOR BLUE}Nebbie{COLOR DARK_GRAY} ran off again! Hau came to help, but we were saved by... By..."))
	closemessage
	delay(30)
	emote(16, EMOTE_EXCLAM)
	applymovement(16, moves(walk_in_place_right * 2))
	waitmovement(0)
	setspeaker("Lillie")
	msgbox(format("Eek! I didn't even get their name...!"))
	closemessage

	delay(10)
	applymovement(17, moves(jump_in_place_down * 2, step_end))
	waitmovement(0)
	setspeaker("Hau")
	msgbox(format("Yeah, {PLAYER} ran up and helped us out! They were trapped with {COLOR BLUE}Nebbie{COLOR DARK_GRAY} by a wild {COLOR BLUE}Corviknight{COLOR DARK_GRAY}, but at the last second, {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY} flew in and saved the day!"))
	closemessage

	delay(10)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	applymovement(16, Common_Movement_FaceDown)
	applymovement(19, Common_Movement_WalkUp2)
	waitmovement(0)
	emote(19, EMOTE_QUESTION)
	delay(10)
	setspeaker("Hala")
	msgbox(format("Hey, you three! What's this about {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY}?"))
	closemessage
	applymovement(19, moves(walk_right, walk_up * 3, face_left, step_end))
	applymovement(17, moves(walk_fast_left, walk_fast_down * 2, face_right, step_end))
	waitmovement(19)
	delay(10)
	msgbox(format("Hau told Kahuna Hala the whole story..."))
	closemessage
	delay(10)

	applymovement(19, Common_Movement_FaceUp)
	waitmovement(0)
	setspeaker("Hala")
	msgbox(format("So, {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY} revealed itself to you three... Our {COLOR GREEN}Island Guardian{COLOR DARK_GRAY} can be quite the fickle being, so it must hold strong feelings to come protect you.\p The talk of rampaging Pokémon is concerning, but {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY}'s appearance must be a blessing for our Manalo Festival!\p Most festival preparations are complete. Come {COLOR GREEN}speak to me{COLOR DARK_GRAY} once you are ready to join!"))
	closemessage
	applymovement(19, Common_Movement_FaceLeft)
	waitmovement(0)
	setspeaker("Hala")
	msgbox(format("Hau, follow me to the platform in town. You must be prepared to receive your first Pokémon!"))
	closemessage

	delay(10)
	applymovement(19, moves(walk_down * 4, walk_left * 8, step_end))
	applymovement(17, moves(walk_right, walk_down * 4, walk_left * 8, step_end))
	waitmovement(0)
	emote(8, EMOTE_EXCLAM)
	setspeaker("Prof. Kukui")
	msgbox(format("Aue, the Manalo Festival is actually starting soon! I need to get {COLOR BLUE}Exeggutor{COLOR DARK_GRAY} ready to dance!"))
	closemessage
	applymovement(8, moves(walk_down * 2, walk_right, step_end))
	waitmovement(0)
	delay(10)
	applymovement(16, Common_Movement_FaceLeft)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
	waitmovement(0)
	setspeaker("Lillie")
	msgbox(format("Ahem... So, {PLAYER}, I'm Lillie. It's nice to officially meet you!\p {COLOR BLUE}Nebbie{COLOR DARK_GRAY} and I owe you for helping us. We'll be cheering for you during the festival!"))
	closemessage
	applymovement(18, moves(jump_in_place_down * 2))
	waitmovement(0)
	setspeaker("Nebbie")
	playmoncry(SPECIES_EXEGGUTOR_ALOLA, CRY_MODE_NORMAL)
	msgbox(format("Pew pew!"))
	waitmoncry
	closemessage

	delay(10)
	fadescreenswapbuffers(FADE_TO_BLACK)
	delay(30)
	setflag(FLAG_HIDE_TAPU_KOKO_MAHALO_TRAIL)
	removeobject(16)
	removeobject(17)
	removeobject(18)
	removeobject(19)
	clearflag(FLAG_HIDE_LILLIE_IKI_TOWN)
	addobject(27)
	addobject(28)
	addobject(29)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	delay(30)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(20)

	setvar(VAR_INTRO_STATE, 6)
	startsubquest(QUEST_01, SUB_QUEST_4) // Unlock Subquest 4: Begin the Manalo Festival

	releaseall
	end
}

script IkiTown_Script_ManaloFestival
{
	// Festival setup
	lockall
	fadescreenswapbuffers(FADE_TO_BLACK)
	delay(30)
	clearflag(FLAG_HIDE_MOM_IKI_TOWN)
	addobject(30)
	addobject(31)
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
	switch(var(VAR_TEMP_1))
	{
		case 18:
			applymovement(LOCALID_PLAYER, moves(walk_fast_right * 2, face_left, step_end))
		default:
			applymovement(LOCALID_PLAYER, moves(walk_fast_down, walk_fast_right, face_left, step_end))
	}
	// Player position now x20 y8
	applymovement(27, Common_Movement_FaceDown) // Lillie
	applymovement(28, Common_Movement_FaceDown) // Nebbie
	applymovement(29, moves(walk_fast_down, walk_fast_left, face_right, step_end)) // Hau
	applymovement(11, Common_Movement_WalkUp2) // Dancer & Oricorios
	applymovement(12, Common_Movement_WalkUp)
	applymovement(13, Common_Movement_WalkUp)
	applymovement(14, Common_Movement_WalkUp) // Man
	applymovement(7, Common_Movement_FaceDown) // Hala
	waitmovement(0)
	hidefollower
	fwdtime(22, 0) // Sets time to 22:00 (10:00 PM) for aura
	addminutes(1) // try to force update the time? idk
	delay(30)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(20)

	setspeaker("Hala")
	msgbox(format("Welcome, people of Iki Town, to the main event of our Manalo Festival!"))
	closemessage
	applymovement(14, moves(jump_in_place_up * 2, step_end))
	applymovement(30, moves(jump_in_place_down * 2, step_end))
	emote(11, EMOTE_HEART)
	delay(30)
	setspeaker("Hala")
	msgbox(format("Tonight, we open ourselves to the light of {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY}, our great Island Guardian, and honor it through battle!\p Our first challenger is {COLOR GREEN}Hau{COLOR DARK_GRAY}, my own grandson, who has recently chosen his first Pokémon!\p Our second challenger is {COLOR GREEN}{PLAYER}{COLOR DARK_GRAY}, grandchild of Samson Oak, ready to join the great Trainers of Alola!"))
	closemessage
	applymovement(7, Common_Movement_FaceRight)
	applymovement(30, moves(jump_in_place_down * 2, step_end))
	waitmovement(0)
	setspeaker("Mom")
	msgbox(format("WOO-HOO! Go get 'em, {PLAYER}!"))
	closemessage
	delay(10)
	setspeaker("Hala")
	msgbox(format("Ahem..."))
	closemessage
	applymovement(7, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Hala")
	msgbox(format("Hau! {PLAYER}! Show us what it means to be true Trainers!"))
	closemessage

	delay(15)
	applymovement(29, moves(walk_in_place_right * 2))
	waitmovement(0)
	setspeaker("Hau")
	msgbox(format("As long as we have a good time, then I think we can call it a great battle, eh?\p Give it all you've got! C'mon!"))
	closemessage

	// Battle Hau!
	switch(var(VAR_STARTER_MON))
	{
		default:
		case SPECIES_ROWLET:
			trainerbattle_no_intro(TRAINER_HAU_FESTIVAL_GRASS, format("What? It's already over?!"))
		case SPECIES_LITTEN:
			trainerbattle_no_intro(TRAINER_HAU_FESTIVAL_FIRE, format("What? It's already over?!"))
		case SPECIES_POPPLIO:
			trainerbattle_no_intro(TRAINER_HAU_FESTIVAL_WATER, format("What? It's already over?!"))
	}

	delay(20)
	special(HealPlayerParty)
	setspeaker("Hala")
	msgbox(format("Hoo-ee! Another great battle this year. I'm sure {COLOR BLUE}Tapu Koko{COLOR DARK_GRAY} enjoyed it too!\p You two have come of age and held your own at the Manalo Festival. Please, take these!"))
	closemessage
	applymovement(7, moves(walk_down, walk_right, step_end))
	waitmovement(0)

	giveitem(ITEM_Z_POWER_RING)
	setflag(FLAG_RECEIVED_Z_RING)

	closemessage
	applymovement(7, moves(walk_left * 2, step_end))
	waitmovement(0)
	delay(20)
	applymovement(29, moves(walk_in_place_right * 2))
	waitmovement(0)
	setspeaker("Hau")
	msgbox(format("So sparkly... Thanks, Tutu!"))
	closemessage
	delay(10)
	applymovement(7, moves(walk_right, walk_up, face_down, step_end))
	waitmovement(0)
	setspeaker("Hala")
	msgbox(format("Those are {COLOR GREEN}Z-Power Rings{COLOR DARK_GRAY}, enhanced with keystones blessed by the Island Guardians themselves.\p With {COLOR GREEN}Z-Power{COLOR DARK_GRAY}, you will be able to draw out the hidden power within your Pokémon, unleashing amazing {COLOR GREEN}Z-Moves{COLOR DARK_GRAY} and accessing the {COLOR GREEN}Z-Forms{COLOR DARK_GRAY} of some species."))
	closemessage
	delay(10)
	applymovement(7, moves(walk_in_place_down * 2, step_end))
	waitmovement(7)
	delay(10)
	setspeaker("Hala")
	msgbox(format("With that, you are now ready to embark on the {COLOR GREEN}Island Challenge{COLOR DARK_GRAY}! You must overcome trials on the four main islands of Alola to earn {COLOR GREEN}Z-Crystals{COLOR DARK_GRAY}, unlocking the true potential of your Pokémon.\p That's it for the Manalo Festival! Until next year, everyone!"))
	closemessage
	applymovement(14, moves(jump_in_place_up * 2, step_end))
	applymovement(30, moves(jump_in_place_down * 2, step_end))
	emote(27, EMOTE_HEART)

	delay(30)
	applymovement(29, moves(walk_right * 3, step_end))
	waitmovement(0)
	setspeaker("Hau")
	msgbox(format("I had a blast battling you, {PLAYER}! And now look at us, ready to take on the {COLOR GREEN}Island Challenge{COLOR DARK_GRAY}!\p I'm gonna head home with Hala and rest my Pokémon. You should drop by!"))
	closemessage
	delay(10)
	applymovement(29, moves(walk_left * 8, step_end))
	applymovement(7, moves(delay_16, walk_down, walk_left * 7, step_end))
	delay(30)
	fadescreenswapbuffers(FADE_TO_BLACK)
	waitmovement(0)
	applymovement(27, moves(walk_left * 4, walk_down * 4, walk_right * 7, step_end))
	applymovement(28, moves(walk_left * 5, walk_down * 4, walk_right * 6, step_end))
	delay(20)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	waitmovement(27)
	delay(10)
	setspeaker("Lillie")
	msgbox(format("{PLAYER}, that was amazing! I'm no Trainer, but I couldn't look away from that battle.\p I've been staying at {COLOR GREEN}Professor Kukui's Lab{COLOR DARK_GRAY}, on the beach in southern {COLOR GREEN}Hau'oli Outskirts{COLOR DARK_GRAY}. He's been planning a surprise for you, so come visit!"))
	closemessage
	delay(20)

	setvar(VAR_INTRO_STATE, 7)
	startsubquest(QUEST_01, SUB_QUEST_5) // Unlock Subquest 5: Go to Kukui's Lab

	delay(20)
	fadescreenswapbuffers(FADE_TO_BLACK)
	delay(30)
	setflag(FLAG_HIDE_LILLIE_IKI_TOWN)
	removeobject(27)
	removeobject(28)
	removeobject(29)
	removeobject(7)
	setflag(FLAG_HIDE_MOM_IKI_TOWN)
	removeobject(30)
	removeobject(31)
	applymovement(11, moves(walk_down * 2, face_up, step_end)) // Dancer & Oricorios
	applymovement(12, Common_Movement_WalkDown)
	applymovement(13, Common_Movement_WalkDown)
	applymovement(14, Common_Movement_WalkDown) // Man
	clearflag(FLAG_HIDE_HAU_HALAS_HOME)
	switch(var(VAR_STARTER_MON))
	{
		default:
		case SPECIES_ROWLET:
			clearflag(FLAG_HIDE_HAUS_LITTEN_HALAS_HOME)
		case SPECIES_LITTEN:
			clearflag(FLAG_HIDE_HAUS_POPPLIO_HALAS_HOME)
		case SPECIES_POPPLIO:
			clearflag(FLAG_HIDE_HAUS_ROWLET_HALAS_HOME)
	}
	delay(30)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(20)
	
	releaseall
	end
}

script IkiTown_Script_BlockHalaHouse
{
	lockall
	msgbox(format("Kahuna Hala is outside of his house right now."))
	closemessage
	applymovement(LOCALID_PLAYER, Common_Movement_WalkDown)
	waitmovement(0)
	releaseall
	end
}

// --------------------------------------------- NPC Scripts ------------------------------------------------

script IkiTown_NPC_Hala
{
	lock
	faceplayer
	setspeaker("Hala")
	if(!flag(FLAG_HIDE_HAU_CORVISQUIRE_MAHALO_TRAIL))
	{
		msgbox(format("{PLAYER}, Alola! The {COLOR GREEN}Manalo Festival{COLOR DARK_GRAY} is still being set up. Tonight, we honor our Island Guardian and call on them for their protection.\p {COLOR GREEN}Hau{COLOR DARK_GRAY}, my grandson, has gone {COLOR GREEN}up Mahalo Trail{COLOR DARK_GRAY} with Kukui's Assistant. You should try to find them."))
	}
	else
	{
		msgbox(format("{PLAYER}, come on up! Are you ready to {COLOR GREEN}celebrate the Manalo Festival{COLOR DARK_GRAY} together?"), MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT) == TRUE) // ready!
		{
			setspeaker("Hala")
			msgbox(format("Bahaha, great! I'll have you wait here while I get Hau and the townsfolk together..."))
			closemessage
			delay(20)
			goto(IkiTown_Script_ManaloFestival)
		}
		else
		{
			setspeaker("Hala")
			msgbox(format("I understand. This is a big night for you and my grandson both!\p Come back when you're ready for the festival to begin!"))
		}
	}
	closemessage
	release
	end
}

script IkiTown_NPC_KukuiWithExeggutor
{
	lock
	faceplayer
	setspeaker("Prof. Kukui")
	if(!flag(FLAG_HIDE_HAU_CORVISQUIRE_MAHALO_TRAIL))
	{
		msgbox(format("Check out this guy! {COLOR BLUE}Alolan Exeggutor{COLOR DARK_GRAY} towers over most Pokémon, yeah! It's so high up, it doesn't seem to hear me sometimes...\p You met {COLOR GREEN}Hala{COLOR DARK_GRAY}? He's the {COLOR GREEN}Kahuna{COLOR DARK_GRAY}, leader of Melemele Island. I thought it would be good for you two to chat!"))
	}
	else
	{
		msgbox(format("Thanks again for helping Lillie, cousin. She may seem frail, but she's actually my assistant, yeah!\p You gettin' ready for the Manalo Festival? Head over to the main stage and {COLOR GREEN}talk to Hala{COLOR DARK_GRAY} when you're ready to party!"))
	}
	closemessage
	release
	end
}

