script IkiTown_NPC_DancerWithOricorio
{
	lock
	setspeaker("Dancer")
	msgbox(format("Okay, one more time... {COLOR BLUE}Oricorio{COLOR DARK_GRAY}, dance together!"))
	closemessage

	// Oricorio's "dance"
	delay(10)
	applymovement(12, moves(jump_left, jump_right * 2, jump_left, face_down, step_end))
	waitmovement(0)
	applymovement(13, moves(walk_in_place_down * 2, walk_in_place_right * 2, walk_in_place_up * 2, walk_in_place_left * 2, face_down, step_end))
	waitmovement(0)

	emote(11, EMOTE_X)
	delay(10)
	faceplayer
	setspeaker("Dancer")
	msgbox(format("{COLOR BLUE}Oricorio{COLOR DARK_GRAY} are wonderful dancers, but all have their own style. I'm hoping to dance with them in next year's Manalo Festival!"))
	closemessage
	applymovement(11, Common_Movement_FaceUp)
	waitmovement(0)
	release
	end
}

