mapscripts AcrisiaCity_University_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_INTRO_STATE, 1: AcrisiaCity_University_EventScript_PlayerIntro
        VAR_STARTER_MON, 0: AcrisiaCity_University_EventScript_ChoosePokemon
    ]
}

// Cutscene introducing Niko and Rania, and Player chooses starter Pokémon!
script AcrisiaCity_University_EventScript_PlayerIntro
{
    setvar(VAR_INTRO_STATE, 2)
    setobjectxy(1, 10, 18)
    lockall

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    // Enter building
    speakername("Prof. Elia")
    msgbox(format("Welcome to the Acrisia University! Well, one of many campus locations, but still!\p Come, let me introduce you to everyone."))
    closemessage
    applymovement(1, Common_Movement_WalkRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkRight)
    waitmovement(0)

    // Meet Niko
    speakername("Prof. Elia")
    msgbox(format("Now this here is-"))
    closemessage
    playse(SE_PIN)
    applymovement(3, Common_Movement_ExclamationMark) // Niko
    waitmovement(0)
    speakername("???")
    msgbox(format("WOAH WOAH WOAH!"))
    closemessage
    applymovement(3, AcrisiaCity_University_Movement_NikoStopsPlayer)
    waitmovement(0)
    speakername("???")
    msgbox(format("Come on, Professor! You know sudden movements can scare Duskull!"))
    closemessage
    speakername("Prof. Elia")
    msgbox(format("Oof, sorry Niko..."))
    closemessage
    applymovement(1, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("As I was saying, this is Niko. He's a bit protective of his work, but he's a great resource for knowledge."))
    closemessage
    applymovement(3, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(3, Common_Movement_FaceLeft)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("Sorry about the fuss, but when Duskull gets scared, it starts floating through walls and knocking over the books!\p I study how Pokémon behave in captivity. I'm learning a lot about Poké balls and how to care for captive Pokémon.\p If you have any questions about Poké balls, let me know."))
    closemessage
    applymovement(3, AcrisiaCity_University_Movement_NikoReturnToStation)
    waitmovement(0)

    // Meet Rania
    applymovement(1, AcrisiaCity_University_Movement_ProfessorUp)
    applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerFollowProfessorUp)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("This section of the building is for Rania! Here, I'll let her tell you what she does."))
    closemessage
    applymovement(4, AcrisiaCity_University_Movement_RaniaGreetsPlayer)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("Chaire (Hyeh-rei)! That's how we say 'Hello' here! I'm Rania, and you must be... the new field assistant, {PLAYER}!\p I study the movement of Pokémon populations across the Ilios Region. Part of your fieldwork is collecting Pokémon location data, and I'm the one who goes through it all and finds trends!\p I'd love to keep chatting, but I've got a deadline to meet. Nice to meet you!"))
    closemessage
    applymovement(4, AcrisiaCity_University_Movement_RaniaReturnsToStation)
    waitmovement(0)

    // Over to Professor Elia's area
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)
    applymovement(1, AcrisiaCity_University_Movement_ProfessorToMainPosition)
    applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerFollowProfessorToMainPosition)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("And here's my area of the building! Other students come in and out over time, but they're mostly out doing fieldwork. Speaking of which..."))
    closemessage

    // Tries to find Pokédex, fails. Gets player Pokémon instead
    applymovement(1, AcrisiaCity_University_Movement_ProfessorTriesToFindDex_1)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_QuestionMark)
    applymovement(1, AcrisiaCity_University_Movement_ProfessorTriesToFindDex_2)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("Ehehe... so, it looks like I don't quite have an extra Pokédex on hand. But you know what they say, every mistake can be an opportunity!\p I recently imported a {COLOR GREEN}Rotom Phone{COLOR DARK_GRAY} with a {COLOR GREEN}Pokédex function{COLOR DARK_GRAY} from the Alola Region. It should be here by now, but something's gone wrong - maybe something's delaying the deliveryman...?"))
    closemessage
    delay(30)
    applymovement(1, Common_Movement_ExclamationMark)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("{PLAYER}! Oh, I've had the most fun idea! How about you go {COLOR GREEN}find the lost delivery{COLOR DARK_GRAY} and help them out?\p I've got a few rare Pokémon in my briefcase here. Why don't you choose one to adventure with you?"))
    closemessage

    call(Common_EventScript_SaveGame)

    goto(AcrisiaCity_University_EventScript_ChoosePokemon)

    releaseall
    end

}

script AcrisiaCity_University_EventScript_ChoosePokemon
{
    // Give Pokémon
    callnative(StartNewPokeballCaseUI)
    waitstate

    bufferspeciesname(STR_VAR_1, VAR_STARTER_MON)
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} received a {STR_VAR_1}!"))
    waitmessage
    waitfanfare
    delay(20)
    closemessage
    delay(1)
    speakername("Prof. Elia")
    msgbox(format("Ah, {STR_VAR_1}! That Pokémon suits you. Now, for the task at hand: the {COLOR GREEN}lost delivery{COLOR DARK_GRAY} should be {COLOR GREEN}South{COLOR DARK_GRAY} of Acrisia City. Usually, the mover that brings our shipments here stops to rest their Pokémon in the woods. Why don't you check there?"))
    closemessage

    setflag(FLAG_SYS_B_DASH)
    clearflag(FLAG_HIDE_SECOND_PROFESSOR_SPRITE)
    setflag(FLAG_HIDE_FIRST_PROFESSOR_SPRITE)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    setrespawn(HEAL_LOCATION_ACRISIA_CITY)
    setvar(VAR_BERRY_TREES_PLANTED, 0) // resets number of berry trees planted just in case

    startquest(QUEST_FIND_POKEDEX)

    warpsilent(MAP_ACRISIA_CITY_UNIVERSITY, 6, 12)
    waitstate

    // NOTES:
    // VAR_INTRO_STATE is now 2. Player has a Pokémon, and is tasked with heading South on the road to find the delivery.
    // Some other flags, like running shoes, have also been enabled here just for convenience

    releaseall
    end
}

movement AcrisiaCity_University_Movement_NikoStopsPlayer
{
    walk_fast_left * 2
    jump_in_place_left * 2
    delay_16
    step_end
}

movement AcrisiaCity_University_Movement_NikoReturnToStation
{
    walk_right * 2
    walk_up
    face_up
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorUp
{
    walk_up * 5
    face_right
    step_end
}

movement AcrisiaCity_University_Movement_PlayerFollowProfessorUp
{
    walk_up * 5
    walk_right
    face_up
    step_end
}

movement AcrisiaCity_University_Movement_RaniaGreetsPlayer
{
    walk_right
    walk_down * 3
    walk_left * 2
    face_down
    step_end
}

movement AcrisiaCity_University_Movement_RaniaReturnsToStation
{
    walk_right * 2
    walk_up * 3
    walk_left
    face_left
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorToMainPosition
{
    walk_left * 5
    walk_up * 2
    face_down
    step_end
}

movement AcrisiaCity_University_Movement_PlayerFollowProfessorToMainPosition
{
    walk_left * 6
    walk_up * 1
    face_up
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorTriesToFindDex_1
{
    walk_up
    walk_left
    face_left
    delay_16 * 3
    emote_question_mark
    delay_16
    walk_fast_up
    face_right
    delay_16 * 2
    emote_exclamation_mark
    delay_16
    walk_fast_down * 2
    walk_fast_right * 3
    walk_fast_up * 2
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorTriesToFindDex_2
{
    walk_fast_right * 3
    jump_in_place_right * 2
    delay_16 * 3
    walk_left * 3
    walk_down * 2
    walk_left * 2
    face_down
    step_end
}

// -------------------------------------------------------------------------------------------------------------

script AcrisiaCity_University_EventScript_Duskull
{
    lock
    speakername("Duskull")
    playmoncry(SPECIES_DUSKULL, CRY_MODE_NORMAL)
    msgbox("Bwraaahhh!")
    waitmoncry
    closemessage
    release
    end
}

script AcrisiaCity_University_EventScript_Niko
{
    lock
    faceplayer
    if(var(VAR_NIKO_STATE) == 0) // adventure starting
    {
        speakername("Niko")
        msgbox(format("Come to check out my research, {PLAYER}? I'm observing the Duskull to see how it behaves.\p There are old folktales of Ghost-type Pokémon being evil, but this Duskull seems totally friendly!"))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 1) // beat Rania in Jusmail Town
    {
        speakername("Niko")
        msgbox(format("Chaire, bud! I hear you beat Rania in Jusmail Town. After all the braggin' she did about her team, fwahaha!\p Ahem, hm. Getting the Harvest Badge is a big step for trainers in Ilios! Rania and I are thinking about doing it ourselves. Here's a little congratulatory gift from me!"))
        closemessage
        giveitem(ITEM_NEST_BALL, 3)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("Those Nest Balls are good for catching young, weak Pokémon. My studies say the inside of Nest Balls remind Pokémon of their home. Isn't that cute?\p {COLOR GREEN}Check back in{COLOR DARK_GRAY} as you {COLOR GREEN}defeat Pokémon Gyms{COLOR DARK_GRAY}, and I'll give you little gifts and tips."))
        closemessage
        setvar(VAR_NIKO_STATE, 2)
    }
    elif(var(VAR_NIKO_STATE) == 2) // Gym badge 1, beat rania, got Nest Balls
    {
        speakername("Niko")
        msgbox(format("Give those Nest Balls a shot! They work best with low-level Pokémon.\p {COLOR GREEN}Check back in{COLOR DARK_GRAY} as you {COLOR GREEN}defeat Pokémon Gyms{COLOR DARK_GRAY}, and I'll give you little gifts and tips."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 3) // Got Gym Badge 2
    {
        speakername("Niko")
        msgbox(format("Ehehe, looks like I beat you to Ourani! We're all starting to be pretty strong trainers, huh?\p Ah, I worked on a new Poké Ball type. Give it a test for me!"))
        closemessage
        giveitem(ITEM_TIMER_BALL, 3)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("Those Timer Balls work better when a battle begins to drag on. Hopefully they help... help you catch up to me! Fwahaha!"))
        closemessage
        setvar(VAR_NIKO_STATE, 4)
    }
    elif(var(VAR_NIKO_STATE) == 4) // got gym badge 2, got niko's gift
    {
        speakername("Niko")
        msgbox(format("{PLAYER}! I'm back here to study this little Duskull. In case you can't tell, I really like Ghost-type Pokémon."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 5) // completed Team Chimera event in Wanderer's Woods
    {
        speakername("Niko")
        msgbox(format("Welcome back, {PLAYER}. I hope that run-in with Team Chimera didn't rattle you too bad.\p The Ilios Region is mostly peaceful, but just like anywhere else, there are some people willing to do anything to gain power."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 6) // got Gym Badge 3
    {
        speakername("Niko")
        msgbox(format("Oh, I see you've got the Gym Badge from Pythios Town! Was it worth visiting, even after all the commotion in Wanderer's Woods?\p Ah, yes, while I've got you here - I have a gift!"))
        closemessage
        giveitem(ITEM_AMPHAROSITE)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("That's something called a {COLOR GREEN}Mega Stone{COLOR DARK_GRAY}. These mysterious objects are found in a few other regions, such as Kalos and Alola, but I didn't know there were actually any in Ilios.\p I took it from one of the Team Chimera Grunts in Wanderer's Woods while they ran. I wonder where they got it..."))
        closemessage
        setvar(VAR_NIKO_STATE, 7)
    }
    elif(var(VAR_NIKO_STATE) == 7) // got gym badge 3, got gift
    {
        speakername("Niko")
        msgbox(format("I'm still thinking about that {COLOR GREEN}Mega Stone{COLOR DARK_GRAY} I gave you. If used correctly, they could crush most Pokémon Trainers easily... It's a scary thought."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) >= 8) // did Mega Ring quest
    {
        speakername("Niko")
        message(format("Chaire, {PLAYER}! What brings you to my corner of the University?"))
        waitmessage
        multichoice(21, 5, MULTI_CHOOSE_NIKO_DIALOGUE, TRUE)
        closemessage
        delay(5)

        if(var(VAR_RESULT) == 0) // chose Mega Evolution option
        {
            speakername("Niko")
            msgbox(format("Right, Mega Evolution! I've been doing more research on various {COLOR GREEN}mysterious Stones{COLOR DARK_GRAY}, and I believe they allow Trainers to {COLOR GREEN}Mega Evolve{COLOR DARK_GRAY} Pokémon in battle!\p I'm slowly gathering a collection. It's expensive, but totally worth it for research! Do you want to shop my selection of {COLOR GREEN}Mega Stones{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
            closemessage
            delay(5)
            if(var(VAR_RESULT) == 0) // say no
            {
                speakername("Niko")
                msgbox(format("Ehehe, no worries! Mega Stones are extremely rare, so the University's collection is slow-growing.\p If you're ready to Mega Evolve a Pokémon, stop by and see if we have any to spare! Our {COLOR GREEN}collection will grow over time{COLOR DARK_GRAY}, so make sure to come back regularly."))
                closemessage
                release
                end
            }
            else // say yes
            {
                if(!flag(FLAG_BADGE05_GET))
                {
                    pokemart(AcrisiaCity_University_Mart_MegaStones_Shop1)
                }
                elif(!flag(FLAG_BADGE06_GET))
                {
                    pokemart(AcrisiaCity_University_Mart_MegaStones_Shop2)
                }
                else
                {
                    pokemart(AcrisiaCity_University_Mart_MegaStones_CompleteShop)
                }
                closemessage
                delay(5)
                speakername("Niko")
                msgbox(format("Thanks, stop by again! Our {COLOR GREEN}collection will grow over time{COLOR DARK_GRAY}, so make sure to come back regularly."))
                closemessage
                release
                end
            }
        }
        elif(var(VAR_RESULT) == 1) // conversation
        {
            // ALL FUTURE VAR_NIKO_STATE DIALOGUE DOWN HERE!!!
            if(var(VAR_NIKO_STATE) == 8)
            {
                speakername("Niko")
                msgbox(format("Team Chimera collecting Mega Stones is extremely concerning. They already run rampant, stealing Pokémon and taking over whole towns. If they got their hands on Mega Evolution... No. They have to be stopped."))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 9) // after Myrrini Island event (Rania + Player run into Chimera)
            {
                speakername("Niko")
                msgbox(format("I hear you and Rania had a run-in with Team Chimera on Myrrini Island. What could they have possibly meant by 'reawakening ancient Pokémon'? We all know Lazarus Taxa are being rediscovered left and right, but what are Team Chimera's plans with them?"))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 10) // after Péntepetal City (Chimera takes all Cranidos and Shieldon)
            {
                speakername("Niko")
                msgbox(format("The Cranidos and Shieldon you saved in Péntepetal City are doing well in captivity! Thanks to them, we've learned a lot more about how those species live.\p I've been thinking about Team Chimera's plans. There must be some connection between the Ancient Mechanism parts they collected on Marmaro Island and their obsession with Mega Evolution. In fact, Lazarus Taxa might be connected too. Mark my words, they're planning something big."))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 11) // after Gym 6
            {
                speakername("Niko")
                msgbox(format("I've been looking into Team Chimera's plans. That Ancient Mechanism they've been working to assemble is referred to in centuries-old texts. It seems to have a {COLOR GREEN}connection to Mega Evolution{COLOR DARK_GRAY}, but the specifics aren't clear to me.\p Old carvings and fragments of text state that the Ancient Mechanism can cause a Pokémon to experience a burst of energy, but I need more time to research it."))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 12) // After Gym 7 & Chimera Event
            {
                speakername("Niko")
                msgbox(format("Team Chimera hasn't attacked the University yet. They must still be struggling to wrestle control of the region from Kyogre, Groudon, and Rayquaza.\p Speaking of which, have you found them yet? Those Legendary Pokémon might be our only shot at defeating Team Chimera."))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 13) // After Tower of Dioxippus
            {
                speakername("Niko")
                msgbox(format("Now that the weather around Ilios has calmed down, everyone feels a lot safer. That's all thanks to you!\p Oh, have you been to {COLOR GREEN}Port Pello{COLOR DARK_GRAY} yet? Rania was looking for you there."))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 14) // after Chimera's defeat in Areios!
            {
                speakername("Niko")
                msgbox(format("{PLAYER}, I heard the news! You defeated Kalliope and took down Team Chimera once and for all! You're absolutely the best Trainer from this University... Don't tell Rania I said that, though!"))
                closemessage
                release
                end
            }
            elif(var(VAR_NIKO_STATE) == 15) // after Elite Four
            {
                speakername("Niko")
                msgbox(format("I can't believe you're a Champion now! I hope you continue catching Pokémon and helping us with research. It's been great having you here, {PLAYER}!"))
                closemessage
                release
                end
            }
        }
        else // chose cancel probably
        {
            speakername("Niko")
            msgbox(format("Come back is you want to {COLOR GREEN}check our Mega Stone collection{COLOR DARK_GRAY}. And hey, I've still got rewards and fun things to talk about, too!"))
            closemessage
            release
            end
        }
    }
    release
    end
}

