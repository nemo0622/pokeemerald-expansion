mapscripts AcrisiaCity_University_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_INTRO_STATE, 1: AcrisiaCity_University_EventScript_PlayerIntro
        VAR_STARTER_MON, 0: AcrisiaCity_University_EventScript_ChoosePokemon
    ]
}

// Cutscene introducing Niko and Rania, and Player chooses starter Pokémon!
script AcrisiaCity_University_EventScript_PlayerIntro
{
    setvar(VAR_INTRO_STATE, 2)
    setobjectxy(1, 10, 18)
    lockall

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    // Enter building
    speakername("Prof. Elia")
    msgbox(format("Welcome to the Acrisia University! Well, one of many campus locations, but still!\p Come, let me introduce you to everyone."))
    closemessage
    applymovement(1, Common_Movement_WalkRight)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkRight)
    waitmovement(0)

    // Meet Niko
    speakername("Prof. Elia")
    msgbox(format("Now this here is-"))
    closemessage
    playse(SE_PIN)
    applymovement(3, Common_Movement_ExclamationMark) // Niko
    waitmovement(0)
    speakername("???")
    msgbox(format("WOAH WOAH WOAH!"))
    closemessage
    applymovement(3, AcrisiaCity_University_Movement_NikoStopsPlayer)
    waitmovement(0)
    speakername("???")
    msgbox(format("Come on, Professor! You know sudden movements can scare Duskull!"))
    closemessage
    speakername("Prof. Elia")
    msgbox(format("Oof, sorry Niko..."))
    closemessage
    applymovement(1, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("As I was saying, this is Niko. He's a bit protective of his work, but he's a great resource for knowledge."))
    closemessage
    applymovement(3, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(3, Common_Movement_FaceLeft)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("Sorry about the fuss, but when Duskull gets scared, it starts floating through walls and knocking over the books!\p I study how Pokémon behave in captivity. I'm learning a lot about Poké balls and how to care for captive Pokémon.\p If you have any questions about Poké balls, let me know."))
    closemessage
    applymovement(3, AcrisiaCity_University_Movement_NikoReturnToStation)
    waitmovement(0)

    // Meet Rania
    applymovement(1, AcrisiaCity_University_Movement_ProfessorUp)
    applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerFollowProfessorUp)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("This section of the building is for Rania! Here, I'll let her tell you what she does."))
    closemessage
    applymovement(4, AcrisiaCity_University_Movement_RaniaGreetsPlayer)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("Chaire (Hyeh-rei)! That's how we say 'Hello' here! I'm Rania, and you must be... the new field assistant, {PLAYER}!\p I study the movement of Pokémon populations across the Ilios Region. Part of your fieldwork is collecting Pokémon location data, and I'm the one who goes through it all and finds trends!\p I'd love to keep chatting, but I've got a deadline to meet. Nice to meet you!"))
    closemessage
    applymovement(4, AcrisiaCity_University_Movement_RaniaReturnsToStation)
    waitmovement(0)

    // Over to Professor Elia's area
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)
    applymovement(1, AcrisiaCity_University_Movement_ProfessorToMainPosition)
    applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerFollowProfessorToMainPosition)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("And here's my area of the building! Other students come in and out over time, but they're mostly out doing fieldwork. Speaking of which..."))
    closemessage

    // Tries to find Pokédex, fails. Gets player Pokémon instead
    applymovement(1, AcrisiaCity_University_Movement_ProfessorTriesToFindDex_1)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    playse(SE_PIN)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_QuestionMark)
    applymovement(1, AcrisiaCity_University_Movement_ProfessorTriesToFindDex_2)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("Ehehe... so, it looks like I don't quite have an extra Pokédex on hand. I ordered a new set of lab equipment which included a new one, but it seems like that hasn't come yet..."))
    closemessage
    delay(30)
    applymovement(1, Common_Movement_ExclamationMark)
    waitmovement(0)
    speakername("Prof. Elia")
    msgbox(format("{PLAYER}! Oh, I've had the most fun idea! How about you go {COLOR GREEN}find the lost delivery{COLOR DARK_GRAY} and help them out?\p I've got a few rare Pokémon in my briefcase here. Why don't you choose one to adventure with you?"))
    closemessage

    call(Common_EventScript_SaveGame)

    goto(AcrisiaCity_University_EventScript_ChoosePokemon)

    releaseall
    end

}

script AcrisiaCity_University_EventScript_ChoosePokemon
{
    // Give Pokémon
    callnative(StartNewPokeballCaseUI)
    waitstate

    bufferspeciesname(STR_VAR_1, VAR_STARTER_MON)
    playfanfare(MUS_OBTAIN_ITEM)
    message(format("{PLAYER} received a {STR_VAR_1}!"))
    waitmessage
    waitfanfare
    delay(20)
    closemessage
    delay(1)
    speakername("Prof. Elia")
    msgbox(format("Ah, {STR_VAR_1}! That Pokémon suits you. Now, for the task at hand: the {COLOR GREEN}lost delivery{COLOR DARK_GRAY} should be {COLOR GREEN}South{COLOR DARK_GRAY} of Acrisia City. Usually, the mover that brings our shipments here stops to rest their Pokémon in the woods. Why don't you check there?"))
    closemessage

    setflag(FLAG_SYS_B_DASH)
    clearflag(FLAG_HIDE_SECOND_PROFESSOR_SPRITE)
    setflag(FLAG_HIDE_FIRST_PROFESSOR_SPRITE)
    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    setrespawn(HEAL_LOCATION_ACRISIA_CITY)
    setvar(VAR_BERRY_TREES_PLANTED, 0) // resets number of berry trees planted just in case

    startquest(QUEST_FIND_POKEDEX)

    warpsilent(MAP_ACRISIA_CITY_UNIVERSITY, 6, 12)
    waitstate

    // NOTES:
    // VAR_INTRO_STATE is now 2. Player has a Pokémon, and is tasked with heading South on the road to find the delivery.
    // Some other flags, like running shoes, have also been enabled here just for convenience

    releaseall
    end
}

movement AcrisiaCity_University_Movement_NikoStopsPlayer
{
    walk_fast_left * 2
    jump_in_place_left * 2
    delay_16
    step_end
}

movement AcrisiaCity_University_Movement_NikoReturnToStation
{
    walk_right * 2
    walk_up
    face_up
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorUp
{
    walk_up * 5
    face_right
    step_end
}

movement AcrisiaCity_University_Movement_PlayerFollowProfessorUp
{
    walk_up * 5
    walk_right
    face_up
    step_end
}

movement AcrisiaCity_University_Movement_RaniaGreetsPlayer
{
    walk_right
    walk_down * 3
    walk_left * 2
    face_down
    step_end
}

movement AcrisiaCity_University_Movement_RaniaReturnsToStation
{
    walk_right * 2
    walk_up * 3
    walk_left
    face_left
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorToMainPosition
{
    walk_left * 5
    walk_up * 2
    face_down
    step_end
}

movement AcrisiaCity_University_Movement_PlayerFollowProfessorToMainPosition
{
    walk_left * 6
    walk_up * 1
    face_up
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorTriesToFindDex_1
{
    walk_up
    walk_left
    face_left
    delay_16 * 3
    emote_question_mark
    delay_16
    walk_fast_up
    face_right
    delay_16 * 2
    emote_exclamation_mark
    delay_16
    walk_fast_down * 2
    walk_fast_right * 3
    walk_fast_up * 2
    step_end
}

movement AcrisiaCity_University_Movement_ProfessorTriesToFindDex_2
{
    walk_fast_right * 3
    jump_in_place_right * 2
    delay_16 * 3
    walk_left * 3
    walk_down * 2
    walk_left * 2
    face_down
    step_end
}

// -------------------------------------------------------------------------------------------------------------

script AcrisiaCity_University_EventScript_Duskull
{
    lock
    speakername("Duskull")
    playmoncry(SPECIES_DUSKULL, CRY_MODE_NORMAL)
    msgbox("Bwraaahhh!")
    waitmoncry
    closemessage
    release
    end
}

script AcrisiaCity_University_EventScript_Niko
{
    lock
    faceplayer
    if(var(VAR_NIKO_STATE) == 0) // adventure starting
    {
        speakername("Niko")
        msgbox(format("Come to check out my research, {PLAYER}? I'm observing the Duskull to see how it behaves.\p There are old folktales of Ghost-type Pokémon being evil, but this Duskull seems totally friendly!"))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 1) // beat Rania in Jusmail Town
    {
        speakername("Niko")
        msgbox(format("Chaire, bud! I hear you beat Rania in Jusmail Town. After all the braggin' she did about her team, fwahaha!\p Ahem, hm. Getting the Harvest Badge is a big step for trainers in Ilios! Rania and I are thinking about doing it ourselves. Here's a little congratulatory gift from me!"))
        closemessage
        giveitem(ITEM_NEST_BALL, 3)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("Those Nest Balls are good for catching young, weak Pokémon. My studies say the inside of Nest Balls remind Pokémon of their home. Isn't that cute?\p {COLOR GREEN}Check back in{COLOR DARK_GRAY} as you {COLOR GREEN}defeat Pokémon Gyms{COLOR DARK_GRAY}, and I'll give you little gifts and tips."))
        closemessage
        setvar(VAR_NIKO_STATE, 2)
    }
    elif(var(VAR_NIKO_STATE) == 2) // Gym badge 1, beat rania, got Nest Balls
    {
        speakername("Niko")
        msgbox(format("Give those Nest Balls a shot! They work best with low-level Pokémon.\p {COLOR GREEN}Check back in{COLOR DARK_GRAY} as you {COLOR GREEN}defeat Pokémon Gyms{COLOR DARK_GRAY}, and I'll give you little gifts and tips."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 3) // Got Gym Badge 2
    {
        speakername("Niko")
        msgbox(format("Ehehe, looks like I beat you to Mattaios! We're all starting to be pretty strong trainers, huh?\p Ah, I worked on a new Poké Ball type. Give it a test for me!"))
        closemessage
        giveitem(ITEM_TIMER_BALL, 3)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("Those Timer Balls work better when a battle begins to drag on. Hopefully they help... help you catch up to me! Fwahaha!"))
        closemessage
        setvar(VAR_NIKO_STATE, 4)
    }
    elif(var(VAR_NIKO_STATE) == 4) // got gym badge 2, got niko's gift
    {
        speakername("Niko")
        msgbox(format("{PLAYER}! I'm back here to study this little Duskull. In case you can't tell, I really like Ghost-type Pokémon."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 5) // completed Team Chimera event in Wanderer's Woods
    {
        speakername("Niko")
        msgbox(format("Welcome back, {PLAYER}. I hope that run-in with Team Chimera didn't rattle you too bad.\p The Ilios Region is mostly peaceful, but just like anywhere else, there are some people willing to do anything to gain power."))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) == 6) // got Gym Badge 3
    {
        speakername("Niko")
        msgbox(format("Oh, I see you've got the Gym Badge from Pythios Town! Was it worth visiting, even after all the commotion in Wanderer's Woods?\p Ah, yes, while I've got you here - I have a gift!"))
        closemessage
        giveitem(ITEM_WATER_TERA_SHARD)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("That's something called a {COLOR GREEN}Tera Shard{COLOR DARK_GRAY}. In the Paldea Region, where Terastallization comes from, these Tera Shards can be used to change a Pokémon's Tera Type.\p I took it from one of the Team Chimera Grunts in Wanderer's Woods while they ran. I wonder why they'd be collecting them..."))
        closemessage
        setvar(VAR_NIKO_STATE, 7)
    }
    elif(var(VAR_NIKO_STATE) == 7) // got gym badge 3, got gift
    {
        speakername("Niko")
        msgbox(format("I'm still thinking about that {COLOR GREEN}Tera Shard{COLOR DARK_GRAY} I gave you. Why would Team Chimera be collecting them?"))
        closemessage
    }
    elif(var(VAR_NIKO_STATE) >= 8) // did Tera Orb quest
    {
        speakername("Niko")
        message(format("Chaire, {PLAYER}! What brings you to my corner of the University?"))
        waitmessage
        multichoice(21, 5, MULTI_CHOOSE_NIKO_DIALOGUE, TRUE)
        closemessage
        delay(5)

        if(var(VAR_RESULT) == 0) // chose Tera
        {
            speakername("Niko")
            msgbox(format("Right, Terastallization! I've been doing more research on those {COLOR GREEN}Tera Shards{COLOR DARK_GRAY}, and I believe they allow Trainers to {COLOR GREEN}change a Pokémon's Tera type{COLOR DARK_GRAY}!\p Do you want me to change your Pokémon's Tera type?"), MSGBOX_YESNO)
            closemessage
            delay(5)
            if(var(VAR_RESULT) == 0) // say no
            {
                speakername("Niko")
                msgbox(format("Ehehe, no worries! Sometimes, a Pokémon's natural Tera type works best for it.\p In the future, bring me a {COLOR GREEN}Tera Shard{COLOR DARK_GRAY} to change a Pokémon's Tera type!"))
                closemessage
                release
                end
            }
            else // say yes
            {
                speakername("Niko")
                msgbox(format("Yesss, alright, let's do this! First, what Pokémon do you want to use?"))
                closemessage
                delay(5)
                special(ChoosePartyMon)
                waitstate
                copyvar(VAR_0x800A, VAR_0x8004) // stores chosen Pokémon in VAR_0x8004 i think
                if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) // if didn't choose anything, end early
                {
                    speakername("Niko")
                    msgbox(format("Changed your mind, eh? That's fine.\p In the future, bring me a {COLOR GREEN}Tera Shard{COLOR DARK_GRAY} to change a Pokémon's Tera type!"))
                    closemessage
                    release
                    end
                }
                speakername("Niko")
                msgbox(format("Great! Now, what Tera Shard do you want to use? This will {COLOR GREEN}determine the Tera type of your Pokémon{COLOR DARK_GRAY}."))
                closemessage
                delay(5)
                chooseitem(ITEMS_POCKET)
                delay(5)

                if(var(VAR_ITEM_ID) < ITEM_BUG_TERA_SHARD || var(VAR_ITEM_ID) > ITEM_WATER_TERA_SHARD) // if not a tera shard, end early
                {
                    speakername("Niko")
                    msgbox(format("Umm... {PLAYER}, I hate to break it to you, but that's not a Tera Shard.\p Bring me a {COLOR GREEN}Tera Shard{COLOR DARK_GRAY} if you want to change a Pokémon's Tera Type!"))
                    closemessage
                    release
                    end
                }

                speakername("Niko")
                msgbox(format("Okay, let's get started. Stand back, {PLAYER}!"))
                closemessage
                fadescreen(FADE_TO_BLACK)
                delay(30)
                playfanfare(MUS_LEVEL_UP)
                waitfanfare
                // change Tera type based on item chosen
                // note: this is genuinely the least efficient way to code this. i dont care though im doing it at work
                if(var(VAR_ITEM_ID) == ITEM_BUG_TERA_SHARD)
                {
                    setteratype(TYPE_BUG, VAR_0x8004)
                    removeitem(ITEM_BUG_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_DARK_TERA_SHARD)
                {
                    setteratype(TYPE_DARK, VAR_0x8004)
                    removeitem(ITEM_DARK_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_DRAGON_TERA_SHARD)
                {
                    setteratype(TYPE_DRAGON, VAR_0x8004)
                    removeitem(ITEM_DRAGON_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_ELECTRIC_TERA_SHARD)
                {
                    setteratype(TYPE_ELECTRIC, VAR_0x8004)
                    removeitem(ITEM_ELECTRIC_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_FAIRY_TERA_SHARD)
                {
                    setteratype(TYPE_FAIRY, VAR_0x8004)
                    removeitem(ITEM_FAIRY_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_FIGHTING_TERA_SHARD)
                {
                    setteratype(TYPE_FIGHTING, VAR_0x8004)
                    removeitem(ITEM_FIGHTING_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_FIRE_TERA_SHARD)
                {
                    setteratype(TYPE_FIRE, VAR_0x8004)
                    removeitem(ITEM_FIRE_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_FLYING_TERA_SHARD)
                {
                    setteratype(TYPE_FLYING, VAR_0x8004)
                    removeitem(ITEM_FLYING_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_GHOST_TERA_SHARD)
                {
                    setteratype(TYPE_GHOST, VAR_0x8004)
                    removeitem(ITEM_GHOST_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_GRASS_TERA_SHARD)
                {
                    setteratype(TYPE_GRASS, VAR_0x8004)
                    removeitem(ITEM_GRASS_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_GROUND_TERA_SHARD)
                {
                    setteratype(TYPE_GROUND, VAR_0x8004)
                    removeitem(ITEM_GROUND_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_ICE_TERA_SHARD)
                {
                    setteratype(TYPE_ICE, VAR_0x8004)
                    removeitem(ITEM_ICE_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_NORMAL_TERA_SHARD)
                {
                    setteratype(TYPE_NORMAL, VAR_0x8004)
                    removeitem(ITEM_NORMAL_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_POISON_TERA_SHARD)
                {
                    setteratype(TYPE_POISON, VAR_0x8004)
                    removeitem(ITEM_POISON_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_PSYCHIC_TERA_SHARD)
                {
                    setteratype(TYPE_PSYCHIC, VAR_0x8004)
                    removeitem(ITEM_PSYCHIC_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_ROCK_TERA_SHARD)
                {
                    setteratype(TYPE_ROCK, VAR_0x8004)
                    removeitem(ITEM_ROCK_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_STEEL_TERA_SHARD)
                {
                    setteratype(TYPE_STEEL, VAR_0x8004)
                    removeitem(ITEM_STEEL_TERA_SHARD)
                }
                elif(var(VAR_ITEM_ID) == ITEM_WATER_TERA_SHARD)
                {
                    setteratype(TYPE_WATER, VAR_0x8004)
                    removeitem(ITEM_WATER_TERA_SHARD)
                }

                delay(30)
                fadescreen(FADE_FROM_BLACK)
                delay(20)
                speakername("Niko")
                msgbox(format("Look at that, it was a complete success! You can check the Tera type of your Pokémon in their Summary Screen.\p Come back for more Tera type changes. Andio! See ya!"))
                closemessage
                release
                end
            }
        }
        elif(var(VAR_RESULT) == 1) // conversation
        {
            // ALL FUTURE VAR_NIKO_STATE DIALOGUE DOWN HERE!!!
            if(var(VAR_NIKO_STATE) == 8)
            {
                speakername("Niko")
                msgbox(format("Team Chimera chasing down Tera Orbs and Tera Shards is making me worried. There are already reports of Team Chimera stealing Pokémon, so if they're able to Terastallize, they could become even more threatening."))
                closemessage
                release
                end
            }
        }
        else // chose cancel probably
        {
            speakername("Niko")
            msgbox(format("Come back with {COLOR GREEN}Tera Shards{COLOR DARK_GRAY} to change a Pokémon's Tera type. And hey, I've still got rewards and fun things to talk about, too!"))
            closemessage
            release
            end
        }
    }
    release
    end
}

script AcrisiaCity_University_EventScript_Rania
{
    lock
    faceplayer
    if(var(VAR_RANIA_STATE) == 0) // adventure starting
    {
        speakername("Rania")
        msgbox(format("Chaire, {PLAYER}! You doin' well?\p I help out with Pokédex data analysis. Now that you're here, there's gonna be a lot more data. Come {COLOR GREEN}speak with me{COLOR DARK_GRAY} as you {COLOR GREEN}defeat Pokémon Gyms{COLOR DARK_GRAY}, I'll give you some helpful tips and items!"))
        closemessage
    }
    elif(var(VAR_RANIA_STATE) == 1) // beat her in Jusmail Town
    {
        speakername("Rania")
        msgbox(format("Here comes {PLAYER}, the new Champ! ...Ehehe, just kidding! My Pokémon are still calming down from that battle in Jusmail Town, what a fight!"))
        closemessage
    }
    elif(var(VAR_RANIA_STATE) == 2) // earned 2nd Gym badge
    {
        speakername("Rania")
        msgbox(format("No way, you got the Gemstone Badge?! I haven't even gotten to the Acrisia Caverns yet!\p Yamas! Cheers! We have to celebrate your success somehow! I'll give you this, as a start."))
        closemessage
        giveitem(ITEM_WISHING_STAR, 2)
        closemessage
        delay(5)
        speakername("Rania")
        msgbox(format("Those Wishing Stars can be used at the Wishing Well in Jusmail Town. Old myths say that worthy trainers may earn something from it.\p Speaking of Jusmail Town, you should be able to get rid of those {COLOR GREEN}rocks blocking the path south{COLOR DARK_GRAY}! I'll be seeing you out there, {PLAYER}!"))
        closemessage
        setvar(VAR_RANIA_STATE, 3)
    }
    elif(var(VAR_RANIA_STATE) == 3) // earned 2nd badge, got Rania's reward
    {
        speakername("Rania")
        msgbox(format("Chaire! I come back here to heal my Pokémon and put my new Pokédex data into the computers. Don't you worry, I'll be back out soon! Get ready for some battles!"))
        closemessage
    }
    elif(var(VAR_RANIA_STATE) == 4) // finished Team Chimera event in Wanderer's Woods
    {
        speakername("Rania")
        msgbox(format("Come back to cool off too, {PLAYER}? That fight with Team Chimera sure was something. I wonder why they're collecting Pokémon..."))
        closemessage
    }
    release
    end
}



