script AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs_Trigger1
{
    setvar(VAR_TEMP_1, 1) // indicates trigger used
    goto(AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs)
}
script AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs_Trigger2
{
    setvar(VAR_TEMP_1, 2) // indicates trigger used
    goto(AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs)
}
script AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs_Trigger3
{
    setvar(VAR_TEMP_1, 3) // indicates trigger used
    goto(AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs)
}
script AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs_Trigger4
{
    setvar(VAR_TEMP_1, 4) // indicates trigger used
    goto(AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs)
}

script AcrisiaCity_University_EventScript_NikoGivesFirstPokeballs
{
    // brought from Trigger1-Trigger4 scripts above
    lock
    emote(3, EMOTE_EXCLAM)
    applymovement(3, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("Hold up, come here {PLAYER}!"))
    closemessage
    if(var(VAR_TEMP_1) == 1)
    {
        applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerGoesToNiko_1)
    }
    elif(var(VAR_TEMP_1) == 2)
    {
        applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerGoesToNiko_2)
    }
    elif(var(VAR_TEMP_1) == 3)
    {
        applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerGoesToNiko_3)
    }
    elif(var(VAR_TEMP_1) == 4)
    {
        applymovement(OBJ_EVENT_ID_PLAYER, AcrisiaCity_University_Movement_PlayerGoesToNiko_4)
    }
    waitmovement(0)

    speakername("Niko")
    msgbox(format("You remember me, right? R-right? I'm the one who works with captive Pokémon!"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 0) // say you dont remember niko
    {
        speakername("Niko")
        msgbox(format("No? Some research partner you are.\p I was gonna give you some good Poké balls, but now you're just getting these."))
        closemessage
        giveitem(ITEM_POKE_BALL, 3)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("A little disappointing, huh? Just like being forgotten about! Well, now we're even.\p Come back to the University as you catch more Pokémon. Rania and I can get you some neat stuff... if you remember me, that is."))
        closemessage
    }
    else // you remember niko
    {
        speakername("Niko")
        msgbox(format("Ehehe, I knew you were a real friend!\p I'm only supposed to give you a few Poké balls, but you made my day, so I'll make yours!"))
        closemessage
        giveitem(ITEM_POKE_BALL, 10)
        closemessage
        delay(30)
        giveitem(ITEM_GREAT_BALL, 3)
        closemessage
        delay(5)
        speakername("Niko")
        msgbox(format("Use those Great Balls on Pokémon giving you a hard time! They work like a charm.\p Come back to the University as you fill up the Pokédex! Rania and I might have some new gear for you to try out."))
        closemessage
    }
    applymovement(3, Common_Movement_FaceUp)
    waitmovement(0)
    setvar(VAR_INTRO_STATE, 4) // var_intro_state = 4 means pokeballs have been given
    release
    end
}

movement AcrisiaCity_University_Movement_PlayerGoesToNiko_1
{
    walk_down * 2
    walk_right * 4
}
movement AcrisiaCity_University_Movement_PlayerGoesToNiko_2
{
    walk_down * 2
    walk_right * 3
}
movement AcrisiaCity_University_Movement_PlayerGoesToNiko_3
{
    walk_down * 2
    walk_right * 2
}
movement AcrisiaCity_University_Movement_PlayerGoesToNiko_4
{
    walk_down * 2
    walk_right
}

// -------------------------------------------------------------------------------------------------------------
// ---------------------------  Code called when speaking to Prof. Elia  --------------------------------
// -------------------------------------------------------------------------------------------------------------

script AcrisiaCity_EventScript_ProfessorElia
{
    lock
    faceplayer

    if(var(VAR_INTRO_STATE) == 2) // sent to get lost delivery of Pokédex
    {
        goto(AcrisiaCity_University_EventScript_EliaLostPokedexDeliveryCheck)
    }
    elif(var(VAR_INTRO_STATE) == 3 || var(VAR_INTRO_STATE) == 4) // got Pokédex, sent to Jusmail Town to get 1st badge
    {
        goto(AcrisiaCity_University_EventScript_EliaCheckBadgeOne)
    }
    elif(var(VAR_INTRO_STATE) == 5) // got badge 1, sent to Acrisia Caverns in Acrisia Mountains for 2nd badge
    {
        goto(AcrisiaCity_University_EventScript_EliaCheckBadgeTwo)
    }
    else
    {
        // After VAR_INTRO_STATE is above 5, the "introduction" (first two badges) is over
        // Now, Professor Elia just rates the Pokédex and gives rewards based on progress
        // NOTE: Use Prof. Elm code from Seaglass as reference to giving rewards based on dex progress!!!
        goto(AcrisiaCity_University_EventScript_EliaRatePokedex)
    }

    release
    end

}

script AcrisiaCity_University_EventScript_EliaRatePokedex
{
    // TODO: give rewards based on Pokédex progress, including an HM or two! Encourage catching Pokémon
    // Also have Rania and Niko give rewards based on progression - Niko gives Pokéballs, Rania gives battle items (?)
    // Rania and Niko can also serve as "shops" for unique items unlocked as story progresses
    // this is also just kinda busted in general lol

    speakername("Prof. Elia")
    msgbox(format("Chaire, {PLAYER}! How's your research going? I can check your Pokédex progress!"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 0) // decline
    {
        speakername("Prof. Elia")
        msgbox(format("No? That's okay, go out there and gather some more data! I may have {COLOR GREEN}rewards{COLOR DARK_GRAY} for you next time."))
        closemessage
        release
        end
    }

    setvar(VAR_0x8004, 0) // sets check to Regional Dex (Hoenn)
	specialvar(VAR_RESULT, ScriptGetPokedexInfo)
	copyvar(VAR_0x8008, VAR_0x8005)
	copyvar(VAR_0x8009, VAR_0x8006)
	buffernumberstring(STR_VAR_1, VAR_0x8008) // Num Regional seen
	buffernumberstring(STR_VAR_2, VAR_0x8009) // Num Regional caught
    speakername("Prof. Elia")
	msgbox(format("You've seen {STR_VAR_1} Pokémon, and caught {STR_VAR_2} Pokémon!"))

    // Based on Caught numbers (VAR_0x8009), give rewards and set reward flags (so there arent repeat rewards lol)
    if(var(VAR_0x8009) >= 10 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_01))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_01) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 10 unique Pokémon! You're certainly capable, {PLAYER}. Here's your first progress reward!"))
        closemessage
        giveitem(ITEM_NUGGET)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("That Nugget can be sold for a pretty penny! It should help fund your studies. As you catch more Pokémon, I'll have more for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 25 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_02))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_02) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 25 unique Pokémon! Great job, {PLAYER}! Here's a nice new item."))
        closemessage
        giveitem(ITEM_LOADED_DICE)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("Pokémon holding the Loaded Dice will be able to land multi-hit attacks more times in a row! As you catch more Pokémon, I'll have more for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 50 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_03))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_03) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 50 unique Pokémon! Great job, {PLAYER}! Here's a nice new item."))
        closemessage
        giveitem(ITEM_TM_RETURN)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("That move, Return, gets more powerful the more your Pokémon like you! As you catch more Pokémon, I'll have more for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 100 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_04))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_04) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 100 unique Pokémon! Great job, {PLAYER}!\p We've come across more specimens of the Starter Pokémon you saw at the beginning of your adventure. Here's your first trio!"))
        closemessage
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ROWLET)
        givemon(SPECIES_ROWLET, 10)
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_LITTEN)
        givemon(SPECIES_LITTEN, 10)
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_POPPLIO)
        givemon(SPECIES_POPPLIO, 10)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(format("{PLAYER} received a Rowlet, Litten, and Popplio!"))
        waitfanfare
        closemessage
        delay(10)
        speakername("Prof. Elia")
        msgbox(format("As you catch more Pokémon, I'll have more Starter Pokémon and other rewards for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 135 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_05))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_05) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 135 unique Pokémon! Great job, {PLAYER}!\p We've come across more specimens of the Starter Pokémon you saw at the beginning of your adventure. Here's your first trio!"))
        closemessage
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_CHESPIN)
        givemon(SPECIES_CHESPIN, 10)
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_FENNEKIN)
        givemon(SPECIES_FENNEKIN, 10)
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_FROAKIE)
        givemon(SPECIES_FROAKIE, 10)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(format("{PLAYER} received a Chespin, Fennekin, and Froakie!"))
        waitfanfare
        closemessage
        delay(10)
        speakername("Prof. Elia")
        msgbox(format("As you catch more Pokémon, I'll have more Starter Pokémon and other rewards for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 170 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_06))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_06) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 170 unique Pokémon! Great job, {PLAYER}!\p We've come across more specimens of the Starter Pokémon you saw at the beginning of your adventure. Here's your first trio!"))
        closemessage
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_SPRIGATITO)
        givemon(SPECIES_SPRIGATITO, 10)
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_FUECOCO)
        givemon(SPECIES_FUECOCO, 10)
        setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_QUAXLY)
        givemon(SPECIES_QUAXLY, 10)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox(format("{PLAYER} received a Sprigatito, Fuecoco, and Quaxly!"))
        waitfanfare
        closemessage
        delay(10)
        speakername("Prof. Elia")
        msgbox(format("Looks like you've gotten all 9 Starter Pokémon!\p As you catch more Pokémon, I'll have other rewards for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 200 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_07))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_07) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 200 unique Pokémon! Great job, {PLAYER}! Here's a nice new item."))
        closemessage
        giveitem(ITEM_OVAL_CHARM)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("The Oval Charm increases the odds of Pokémon laying Eggs, which is key to our research!\p You've recorded half of the estimated native Pokémon species in the Ilios Region! As you catch more Pokémon, I'll have more for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 250 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_08))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_08) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 250 unique Pokémon! Great job, {PLAYER}! Here's a nice new item."))
        closemessage
        giveitem(ITEM_LEFTOVERS, 3)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("Those are 3 Leftovers items, which let your Pokémon regain health every turn during battle.\p As you catch more Pokémon, I'll have more for you."))
        closemessage
    }
    if(var(VAR_0x8009) >= 300 && !flag(FLAG_UNIVERSITY_REWARD_ELIA_09))
    {
        setflag(FLAG_UNIVERSITY_REWARD_ELIA_09) // sets flag that item received
        speakername("Prof. Elia")
        msgbox(format("You've captured at least 300 unique Pokémon! Great job, {PLAYER}! Here's a nice new item."))
        closemessage
        giveitem(ITEM_SHINY_CHARM)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("The Shiny Charm drastically increases the chances of finding wild Shiny Pokémon. While you continue to complete the Pokédex, maybe you'll get lucky and find one!\p As you catch more Pokémon, I'll have more for you. You're almost done!"))
        closemessage
    }
    if(var(VAR_0x8009) >= 400)
    {
        if(!flag(FLAG_UNIVERSITY_REWARD_ELIA_10))
        {
            setflag(FLAG_UNIVERSITY_REWARD_ELIA_10) // sets flag that item received
            speakername("Prof. Elia")
            msgbox(format("I-i-incredible! You've actually done it! Your Pokédex contains data for all 400 known Pokémon species in the Ilios Region!\p This calls for something more special than a simple item. Here, and me your Trainer Card."))
            closemessage
            delay(30)
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox(format("{PLAYER} received a Trainer Card Gold Star!"))
            waitfanfare
            closemessage
            delay(30)
            speakername("Prof. Elia")
            msgbox(format("Earning a Gold Star on your Trainer Card is no easy feat. This shows you have done something truly remarkable. Your research will help the Ilios Region for years to come!"))
            closemessage

            delay(20)
            special(DoDomeConfetti)
            completequest(QUEST_COMPLETE_DEX)
        }
        else
        {
            speakername("Prof. Elia")
            msgbox(format("Chaire, {PLAYER}! It's nice to see you around the lab.\p Although you've recorded all the native Pokémon in the Ilios Region, I hope you continue to enjoy your time here!"))
            closemessage
        }
    }
    // fallthrough failsafe - if you've gotten all the rewards possible, just say something vague and end it
    else
    {
        speakername("Prof. Elia")
        msgbox(format("Hmm, it doesn't look like I have any more rewards for you at the moment. Get back out there and find some new Pokémon!"))
        closemessage
    }

    closemessage
    release
    end
}

script AcrisiaCity_University_EventScript_EliaLostPokedexDeliveryCheck
{
    speakername("Prof. Elia")
    msgbox(format("Welcome back, {PLAYER}! Did you find that {COLOR GREEN}lost delivery{COLOR DARK_GRAY} yet?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 0) // no
    {
        msgbox(format("Hmm, that's concerning... local crime groups have been active lately, I'm nervous that the delivery cart was attacked. Keep us updated on the situation."))
        closemessage
    }
    else
    {
        if(flag(FLAG_FOUND_LOST_DELIVERY)) // actually did!
        {
            msgbox(format("Aie! The delivery cart was attacked!? Well I'm glad everyone is okay...\p Here, I'll enable your Pokédex."))
            closemessage
            removeitem(ITEM_PARCEL) // remove key item parcel from bag
            playse(SE_CLICK)
	        delay(10)
	        playse(SE_CLICK)
	        delay (10)
	        playse(SE_CLICK)
	        delay(10)
	        playse(SE_CLICK)
	        delay(20)
            playfanfare(MUS_OBTAIN_ITEM)
            msgbox("{PLAYER}'s {COLOR GREEN}Pokédex{COLOR DARK_GRAY} was enabled!")
            waitfanfare
            setflag(FLAG_SYS_POKEDEX_GET)
            setflag(FLAG_ADVENTURE_STARTED)
            setflag(FLAG_RECEIVED_POKEDEX_FROM_BIRCH)
            closemessage
            speakername("Prof. Elia")
            msgbox(format("Ah, speaking of electronics, here's an {COLOR GREEN}EXP. Share{COLOR DARK_GRAY} to help raise your Pokémon faster. I'll give you a Town Map, too."))
            closemessage
            giveitem(ITEM_EXP_SHARE)
            closemessage
            delay(5)
            setflag(FLAG_EXP_SHARE_ENABLED)
            giveitem(ITEM_TOWN_MAP)
            closemessage
            delay(5)
            speakername("Prof. Elia")
            msgbox(format("I think it's a good idea to train your Pokémon for battle, in case more troublemakers come around. Why don't you {COLOR GREEN}battle the Pokémon Gyms{COLOR DARK_GRAY} you find while you're exploring the Ilios Region? That'll get your Pokémon raring to go!"))
            closemessage
            speakername("Prof. Elia")
            msgbox(format("The {COLOR GREEN}first Gym{COLOR DARK_GRAY} is south of here, in {COLOR GREEN}Jusmail Town{COLOR DARK_GRAY}. Come back to me with the {COLOR GREEN}first Gym Badge{COLOR DARK_GRAY} to show me your skill as a trainer!"))
            closemessage

            delay(20)
            completequest(QUEST_FIND_POKEDEX)
            delay(20)
            startquest(QUEST_GYM_1)

            // Set other vars and stuff
            setvar(VAR_INTRO_STATE, 3) // enables Niko's Pokéball event
            setflag(FLAG_HIDE_RANIA_JUSMAIL) // hides Rania for event in Jusmail
        }
        else
        {
            msgbox(format("You did? Well where's the Pokédex? ...Come on {PLAYER}, we need to make sure the delivery folks are alright! Go look again!"))
            closemessage
        }
    }
    release
    end
}

script AcrisiaCity_University_EventScript_EliaCheckBadgeOne
{
    speakername("Prof. Elia")
    msgbox(format("Chaire, welcome back {PLAYER}! Have you made it to the {COLOR GREEN}Jusmail Town Gym{COLOR DARK_GRAY} yet?"))
    closemessage
    if(!flag(FLAG_BADGE01_GET)) // havent gotten the badge
    {
        speakername("Prof. Elia")
        msgbox(format("Still training, eh? No rush, no rush!\p Come back to the University and check in with me when you have your first Gym Badge."))
        closemessage
    }
    else // got the badge!
    {
        speakername("Prof. Elia")
        msgbox(format("Well done! You're well on your way to being a great trainer.\p Here, I wanted to give you something to celebrate!"))
        closemessage
        giveitem(ITEM_ABILITY_CAPSULE)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("That's an Ability Capsule. It can change the Ability of a Pokémon, which can make it totally different in battle!\p Look, I know I've been sending you back and forth a bunch, but I think I've got a good idea. You should head {COLOR GREEN}west{COLOR DARK_GRAY} from here, up into the {COLOR GREEN}Acrisia Mountains{COLOR DARK_GRAY} for extra training.\p After your training, or if you just feel ready, you can {COLOR GREEN}cross the rail bridge{COLOR DARK_GRAY} over Acrisia City to the east towards {COLOR GREEN}Kalami City{COLOR DARK_GRAY}. Your next Gym Badge will be there. Be sure to come back to Acrisia City after your fight!"))
        closemessage
        setvar(VAR_INTRO_STATE, 5)
        setflag(FLAG_HIDE_RANIA_JUSMAIL) // failsafe - incase player somehow skipped rania in Jusmail
        setflag(FLAG_UNLOCKED_ACRISIA_MTNS) // allows travel into Acrisia Mountains and Riverwalk Trail

        delay(20)
        completequest(QUEST_CHECK_AFTER_GYM_1)
        delay(20)
        startquest(QUEST_GYM_2)
    }
    release
    end
}

script AcrisiaCity_University_EventScript_EliaCheckBadgeTwo
{
    speakername("Prof. Elia")
    msgbox(format("{PLAYER}, welcome, welcome! Have you crossed the rail bridge and explored east to {COLOR GREEN}Kalami City{COLOR DARK_GRAY} yet? Your next Gym Badge is there!"))
    closemessage
    if(!flag(FLAG_BADGE02_GET))
    {
        speakername("Prof. Elia")
        msgbox(format("Not yet, hm? That's fine, the swamps to the east are a tough area. Remember, you can always do some extra training in the Acrisia Mountains to the west!\p Come back and check in with me when you have your second Gym Badge. I've got another gift for you!"))
        closemessage
    }
    else // got the badge!
    {
        // Gives player Rock Smash, letting them get South of Jusmail Town to rest of region
        // This will essentially open up the rest of the game! Player will be totally free to do whatever
        // Speaking to Professor Elia after this will just give prompts to check Pokédex progress
        
        speakername("Prof. Elia")
        msgbox(format("Incredible! You're becoming a great Pokémon trainer. As promised, here's something exciting for you!"))
        closemessage
        giveitem(ITEM_HM_ROCK_SMASH)
        closemessage
        delay(5)
        speakername("Prof. Elia")
        msgbox(format("Oh right, another thing! I ordered an upgrade for your Pokédex."))
        closemessage
        playse(SE_CLICK)
	    delay(10)
	    playse(SE_CLICK)
	    delay (10)
	    playse(SE_CLICK)
	    delay(10)
	    playse(SE_CLICK)
	    delay(20)
        playfanfare(MUS_OBTAIN_ITEM)
        msgbox("{PLAYER} can use the {COLOR GREEN}DexNav{COLOR DARK_GRAY}!")
        waitfanfare
        setflag(FLAG_SYS_DEXNAV_GET)
        closemessage
        speakername("Prof. Elia")
        msgbox(format("It came with directions! It says to select a Pokémon from the {COLOR GREEN}DexNav menu{COLOR DARK_GRAY} to try and find it, then {COLOR GREEN}hold the A Button{COLOR DARK_GRAY} to {COLOR GREEN}creep up on the Pokémon{COLOR DARK_GRAY}! If you move too fast, the Pokémon will {COLOR RED}run away{COLOR DARK_GRAY}. Seems useful!"))
        closemessage
        speakername("Prof. Elia")
        msgbox(format("As you grow stronger, you'll be able to adventure further to find new Pokémon. This'll be great for our studies!\p I believe you're ready to conduct your {COLOR GREEN}independent research{COLOR DARK_GRAY} and {COLOR GREEN}explore Ilios{COLOR DARK_GRAY}. With Rock Smash, you should be able to continue {COLOR GREEN}south to Pythios Town{COLOR DARK_GRAY}.\p Remember to stop back here sometimes! I can check your Pokédex progress and give you rewards for your research, and your fellow University students here will be researching right alongside you. Good luck, {PLAYER}!"))
        closemessage

        setvar(VAR_INTRO_STATE, 6) // "Introductory" stage of game (first 2 badges) complete!

        delay(20)
        completequest(QUEST_CHECK_AFTER_GYM_2)
        delay(20)
        startquest(QUEST_GYM_3)
        delay(20)
        startquest(QUEST_COMPLETE_DEX)
    }
    release
    end
}
