mapscripts DiscusForge_MapScripts {}

script AcrisiaCaves_F1_EventScript_Trainer_AcrisiaCaves_F1_Lana
{
    trainerbattle_single(TRAINER_ACRISIACAVES_F1_LANA, AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaIntro, AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaDefeat)
    speakername("Lana")
    msgbox(format("I guess it's not so bad in here. At least the Pokémon are cool."))
    closemessage
    release
    end
}
text AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaIntro
{
    format("This cave is all dusty and icky. Get me outta here!")
}
text AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaDefeat
{
    format("Argh, nothing is going right!")
}

