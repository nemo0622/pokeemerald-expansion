mapscripts DiscusForge_MapScripts {}

script AcrisiaCaves_F1_EventScript_Trainer_AcrisiaCaves_F1_Lana
{
    trainerbattle_single(TRAINER_ACRISIACAVES_F1_LANA, AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaIntro, AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaDefeat)
    speakername("Lana")
    msgbox(format("I guess it's not so bad in here. At least the Pokémon are cool."))
    closemessage
    release
    end
}
text AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaIntro
{
    format("This cave is all dusty and icky. Get me outta here!")
}
text AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_LanaDefeat
{
    format("Argh, nothing is going right!")
}

script AcrisiaCaves_F1_EventScript_Trainer_AcrisiaCaves_F1_Fraia
{
    trainerbattle_single(TRAINER_ACRISIACAVES_F1_FRAIA, AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_FraiaIntro, AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_FraiaDefeat)
    speakername("Fraia")
    msgbox(format("I though my Pokémon could fight their way through the cave..."))
    closemessage
    release
    end
}
text AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_FraiaIntro
{
    format("I hear there's an old man keeping cool secrets at the end of the cave! I wanna see!")
}
text AcrisiaCaves_F1_Text_Trainer_AcrisiaCaves_F1_FraiaDefeat
{
    format("I guess I'm not ready yet.")
}

script AcrisiaCaves_F1_EventScript_ScientistBlockingLadder
{
    lock
    faceplayer
    speakername("Elder Follower")
    msgbox(format("To pass into the deeper level of the cave, you must {COLOR GREEN}solve these Ruin Puzzles{COLOR DARK_GRAY}.\p The Elder believes that only those wise enough to understand the past should be allowed to train with him."))
    closemessage
    if(flag(FLAG_SOLVED_KABUTO_PUZZLE) && flag(FLAG_SOLVED_OMANYTE_PUZZLE))
    {
        setflag(FLAG_SOLVED_ACRISIA_MOUNTAIN_PUZZLE)
        speakername("Elder Follower")
        msgbox(format("Could it be...? You solved the Ruin Puzzles!\p Please, follow the ladder up to the top of the mountain."))
        closemessage
        fadescreenswapbuffers(FADE_TO_BLACK)
        delay(30)
        removeobject(3)
        removeobject(4)
        delay(30)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        delay(20)
    }
    release
    end
}

script AcrisiaCaves_F1_EventScript_Statue
{
    lock
    msgbox(format("An imposing form looms down from the pedestal. It seems to resemble an ancient Pokémon."))
    closemessage
    release
    end
}

script AcrisiaCaves_F1_EventScript_KabutoDescription
{
    lock
    msgbox(format("It looks like this Pokémon used to scuttle along the sea floor in oceans around the world. It was only known from fossils until living specimens were recently found in the Ilios Region."))
    closemessage
    release
    end
}

script AcrisiaCaves_F1_EventScript_OmanyteDescription
{
    lock
    msgbox(format("It looks like this Pokémon used to float through the ocean in ancient times, using internal pumps to shoot water and propel itself. Living individuals can only be found in the Ilios Region."))
    closemessage
    release
    end
}

// -------------------------------

// Putting all Ruins of Alph puzzle code here for now, even though only Kabuto and Omanyte are done here
script EventScript_KabutoPuzzle // easiest
{
    lockall
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    if(flag(FLAG_SOLVED_KABUTO_PUZZLE))
    {
        setvar(VAR_0x8005, TRUE) // marks puzzle as solved
    }
    else
    {
        setvar(VAR_0x8005, FALSE) // marks puzzle as unsolved
    }
    setvar(VAR_0x8004, SLIDING_PUZZLE_KABUTO) // sets puzzle to do
    special(DoSlidingPuzzle)
    waitstate
    if(var(VAR_RESULT) == TRUE && !flag(FLAG_SOLVED_KABUTO_PUZZLE)) // solved puzzle for the first time!
    {
        setflag(FLAG_SOLVED_KABUTO_PUZZLE)
        delay(30)
        playse(SE_BANG)
        delay(30)
        if(!flag(FLAG_SOLVED_OMANYTE_PUZZLE)) // hasnt solved omanyte yet
        {
            msgbox(format("The puzzle has been solved! The other puzzle must still be completed."))
        }
        else
        {
            msgbox(format("The puzzles have been solved! Time to let the {COLOR GREEN}Elder Followers{COLOR DARK_GRAY} know."))
        }
    }
    releaseall
    end
}

