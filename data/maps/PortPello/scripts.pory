    delay(10)
    emote(13, EMOTE_HEART)
    speakername("Little Girl")
    msgbox(format("Good girl! Here's a Magikarp Biscuit!"))
    closemessage
    release
    end
}

script PortPello_EventScript_Artist
{
    lock
    faceplayer
    speakername("Artist")
    msgbox(format("The cherry trees of Port Pello are one-of-a-kind in Ilios.\p The style of buildings here used to be built in Areios Town, but since {COLOR RED}Team Chimera{COLOR DARK_GRAY} made it their {COLOR RED}Hideout{COLOR DARK_GRAY}, Port Pello is the last place where these buildings are still used."))
    closemessage
    release
    end
}

script PortPello_EventScript_OldManShopping
{
    lock
    faceplayer
    speakername("Old Man")
    msgbox(format("All the ships stopped coming after Team Chimera summoned Gouging Fire, Walking Wake, and Raging Bolt. The news called them the {COLOR RED}Legendary Beasts{COLOR DARK_GRAY}, as they were certainly more than standard Pokémon.\p But now that someone has been putting Team Chimera in their place, the ships have come back! The markets are full again."))
    closemessage
    release
    end
}

script PortPello_EventScript_CyclingTriathleteM
{
    lock
    faceplayer
    speakername("Cyclist")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_SHOW_CYCLIZAR_DEX_PORT_PELLO)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Someday I'll take a cruise to the Fresco Isles and catch a Cyclizar for myself!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_SHOW_CYCLIZAR_DEX_PORT_PELLO)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("These roads are old and a little bumpy. Maybe I should be riding on a Cyclizar instead...\p Oh, are those Poké balls on your belt? You must be a Trainer! If you {COLOR GREEN}catch a Cyclizar{COLOR DARK_GRAY}, show me its {COLOR GREEN}Pokédex data{COLOR DARK_GRAY} on your Rotom Phone. I need to know where to catch a Cyclizar!"))
        closemessage
        delay(20)
        startquest(QUEST_SHOW_CYCLIZAR_DEX_PORT_PELLO)
    }
    else
    {
        msgbox(format("You're back! Got any updates on my ride?"))
        closemessage

        delay(30)
        getcaughtmon(SPECIES_CYCLIZAR)
        if(var(VAR_RESULT) == TRUE)
        {
            emote(17, EMOTE_EXCLAM)
            speakername("Cyclist")
            msgbox(format("Ah, the {COLOR GREEN}Pokédex page{COLOR DARK_GRAY} of {COLOR GREEN}Cyclizar{COLOR DARK_GRAY}! This is just what I needed!\p Hmm... It looks like I can catch one for myself in the Fresco Isles. I'll have to visit there sometime! Here, I want you to have these."))
            closemessage
            delay(5)
            giveitem(ITEM_RARE_CANDY, 3)

            delay(20)
            completequest(QUEST_SHOW_CYCLIZAR_DEX_PORT_PELLO)
        }
        else
        {
            speakername("Cyclist")
            msgbox(format("Uhh... Nope, doesn't look like it's in your Rotom Phone's Pokédex.\p Show me the {COLOR GREEN}complete Pokédex page{COLOR DARK_GRAY} of {COLOR GREEN}Cyclizar{COLOR DARK_GRAY}, and I'll give you a reward!"))
            closemessage
        }
    }
    release
    end
}

