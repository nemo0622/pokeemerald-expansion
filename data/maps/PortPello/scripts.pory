    speakername("Athlete")
    msgbox(format("Port Pello has some of the cleanest air in the Ilios Region. It's perfect for intense training!"))
    closemessage
    release
    end
}

script PortPello_EventScript_LittleGirlWithPyroar
{
    lock
    speakername("Little Girl")
    msgbox(format("Pye-pye, jump!"))
    closemessage
    delay(10)
    applymovement(14, Common_Movement_JumpInPlaceLeft)
