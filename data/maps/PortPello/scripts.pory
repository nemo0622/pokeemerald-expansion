script PortPello_EventScript_RaniaChallengeTrigger
{
    lock
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    goto(PortPello_EventScript_RaniaChallengeScript)
    end
}

script PortPello_EventScript_RaniaChallengeScript
{
    lock
    applymovement(31, Common_Movement_FacePlayer)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("{PLAYER}, you've made it through Port Pello! I thought I saw you coming through.\p Just south of here are the {COLOR RED}Nyx Trails{COLOR DARK_GRAY}, which wind their way down to {COLOR RED}Areios Hideout{COLOR DARK_GRAY}. Are you sure you're ready for that challenge?"), MSGBOX_YESNO)
    closemessage
    delay(5)
    if(var(VAR_RESULT) == FALSE) // not ready
    {
        speakername("Rania")
        msgbox(format("Right. Like Niko said, it's the Pyroar's Den - the heart of {COLOR RED}Team Chimera{COLOR DARK_GRAY}.\p Come over here when your team is ready for a fight. I want to test you before I let you head south."))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
        waitmovement(0)
        release
        end
    }
    else
    {
        // Ready for battle!
        speakername("Rania")
        msgbox(format("You better be ready to back up those words! I challenge you to a battle! Show me just how strong you've gotten!"))
        closemessage

        // RANIA BATTLE
        if(!flag(FLAG_HARD_MODE))
        {
            trainerbattle_no_intro(TRAINER_PORTPELLO_RANIA, PortPello_Text_RaniaLose)
        }
        else
        {
            trainerbattle_no_intro(TRAINER_PORTPELLO_RANIA_HARD, PortPello_Text_RaniaLose)
        }

        delay(10)
        emote(31, EMOTE_EXCLAM)
        speakername("Rania")
        msgbox(format("Ehehe, I'm speechless! {PLAYER}, you're totally ready to kick Team Chimera's butts!\p Oh, while I've got you here, I should tell you about our plans. I've been Flying around the Ilios Region, and it turns out, the {COLOR GREEN}Gym Leaders{COLOR DARK_GRAY} are working on a plan to take down Team Chimera too! A few of the Gym Leaders you've challenged are gathering to {COLOR GREEN}destroy Team Chimera{COLOR DARK_GRAY}.\p The only problem is time... {PLAYER}, they've told me to send you forward without them - we can't afford to wait any longer. I just wanted to let you know that you're not alone in this fight!\p Alright, I'm going to head out and gather more Gym Leaders for the cause. Good luck, {PLAYER}! You can do this!"))
        closemessage

        // fade screen and remove Rania
        fadescreenswapbuffers(FADE_TO_BLACK)
        delay(15)
        setflag(FLAG_HIDE_RANIA_PORT_PELLO)
        removeobject(31)
        delay(15)
        fadescreenswapbuffers(FADE_FROM_BLACK)
        delay(10)
        release
        end

        // This will come to a head after you beat Kalliope in the 8th Gym, where Rania will run in and tell her that
        // Areios Hideout has fallen to the Gym Leaders. The Player will exit the Gym to see Polymnia, Terpsikore,
        // Euterpe, and Rhadine rounding up a few Team Chimera members, thanking the Player before disappearing along
        // with Team Chimera. Note that Kalliope and her Admins will make an escape out of the back of the Gym!
        // (this will allow them to challenge you after the Elite Four in the post game lol, sprites are too good
        // to leave unused in the postgame)
    }
}

text PortPello_Text_RaniaLose
{
    format("You're the strongest Trainer I've met so far... You're ready!")
}
