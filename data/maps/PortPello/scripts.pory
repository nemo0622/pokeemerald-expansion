script PortPello_EventScript_TropiusStatue
{
    lock
    msgbox(format("It's a statue of a mighty Tropius. Read about it?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == FALSE)
    {
        release
        end
    }
    msgbox(format("In the ancient past, the Ilios Region was divided into warring city-states. After losing their family, a young traveler flew away on their Tropius in hopes of finding a new home.\p They flew around the entire region, unable to find a new home. Suddenly, the Tropius descended onto a barren stretch of land, unwanted by any nearby cities. The traveler chose to trust their partner and set up camp.\p In this exact spot, Tropius let out a mighty roar, transforming the barren lands into blooming forests. To show its love for its Trainer, Tropius created beautiful cherry blossom trees, which still shade the city today."))
    closemessage
    delay(30)
    emote(OBJ_EVENT_ID_PLAYER, EMOTE_HEART)
    msgbox(format("Such a beautiful story about the bonds between Trainers and their Pokémon!"))
    closemessage
    release
    end
}

