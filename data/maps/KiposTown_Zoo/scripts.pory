script KiposTown_Zoo_EnvironmentSign_Wetlands
{
    lock
    msgbox(format("Enclosure No. 6: {COLOR GREEN}Wetlands{COLOR DARK_GRAY}\p Although most people steer clear of marshes and bogs, these habitats are key to the survival of many species. They also help prevent soil erosion and lessen the impact of floods, directly providing benefits to humans and Pokémon alike!\p {COLOR GREEN}Water, Poison, and Grass-type{COLOR DARK_GRAY} Pokémon thrive here, alongside various {COLOR GREEN}slimy{COLOR DARK_GRAY} Pokémon."))
    closemessage
    release
    end
}

// -------------------------------------------------------------------------------------------------------
//                                           NPC SCRIPTS
// -------------------------------------------------------------------------------------------------------

script KiposTown_Zoo_South_NPC_Beauty
{
    lock
    faceplayer
    speakername("Beauty")
    msgbox(format("The first Pokémon donated to the Conservation Center... now it became the last one left after Team Chimera's visit. I'm glad the Girafarig somehow stayed, though. I always came and visited it when I was a kid!"))
    closemessage
    applymovement(30, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script KiposTown_Zoo_South_NPC_BugCatcher
{
    lock
    faceplayer
    speakername("Bug Catcher")
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_1) > 0)
    {
        msgbox(format("Hey, there's a Pokémon in the exhibit again! I'm so glad!"))
        closemessage
    }
    else
    {
        msgbox(format("Sniff... I wanted to see the Pokémon, where'd they go?"))
        closemessage
    }
    applymovement(31, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script KiposTown_Zoo_South_NPC_Woman
{
    lock
    faceplayer
    speakername("Woman")
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_1) > 0)
    {
        msgbox(format("It looks like the Pokémon are coming back to the Zoo! Someone is donating them!"))
        closemessage
    }
    else
    {
        msgbox(format("My poor son is so disappointed about the Pokémon being stolen."))
        closemessage
    }
    applymovement(32, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

script KiposTown_Zoo_South_NPC_RichBoy
{
    lock
    faceplayer
    speakername("Rich Boy")
    msgbox(format("I hear that Zoos and Pokémon conservation programs are always a bit short on money. Maybe I could donate a few bucks!"))
    closemessage
    release
    end
}

script KiposTown_Zoo_South_NPC_Youngster
{
    lock
    faceplayer
    speakername("Youngster")
    msgbox(format("We're learning about different Pokémon species in school. Some are always safe to be around, but others can be real scary!"))
    closemessage
    release
    end
}

script KiposTown_Zoo_South_NPC_Worker
{
    lock
    faceplayer
    speakername("Worker")
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_04_1) > 0)
    {
        msgbox(format("After a wild shift at the factory, there's nothing better than coming here and running around with Pokémon. It makes me feel like a kid again!"))
        closemessage
    }
    else
    {
        msgbox(format("Before all the Pokémon were taken, I used to come here to run around with the Pokémon. Now I just do it by myself... I must look so goofy!"))
        closemessage
    }
    release
    end
}

script KiposTown_Zoo_South_NPC_OldWomanInHandsOn
{
    lock
    faceplayer
    speakername("Old Woman")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_FILL_SUBURBS_ZOO)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Oh, it makes me so happy to see all the Pokémon back in this area! Kind-hearted people like you make the world a better place."))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_FILL_SUBURBS_ZOO)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("It's been so sad in the Zoo since Team Chimera came and stole almost all the Pokémon...\p Hm? You're leading the effort to repopulate the Zoo, right? If you could spare the time, please, try to donate {COLOR GREEN}3 Pokémon{COLOR DARK_GRAY} to this exhibit. I miss sitting with the little Pokémon!"))
        closemessage

        delay(20)
        startquest(QUEST_FILL_SUBURBS_ZOO)
    }
    else
    {
        msgbox(format("Chaire, little one... how has donating Pokémon been going?"))
        closemessage

        delay(30)
        if(var(VAR_ZOO_POKEMON_ENCLOSURE_04_1) > 0 && var(VAR_ZOO_POKEMON_ENCLOSURE_04_2) > 0 && var(VAR_ZOO_POKEMON_ENCLOSURE_04_3) > 0)
        {
            applymovement(36, Common_Movement_Heart)
            waitmovement(0)
            delay(10)
            speakername("Old Woman")
            msgbox(format("Ohoho, I knew you could do it! These old eyes can barely see, but I can feel all the Pokémon around me.\p Here, I want you to have this. I've held onto it for years, but it's time to pass it on."))
            closemessage
            delay(5)
            giveitem(ITEM_TM_WISH)
            closemessage
            
            delay(20)
            completequest(QUEST_FILL_SUBURBS_ZOO)
        }
        else
        {
            speakername("Old Woman")
            msgbox(format("It's okay, I know this whole Zoo project is a massive task for a single person. But if anyone can do it, I'm sure it's you, honey!"))
            closemessage
        }
    }
    release
    end
}

script KiposTown_Zoo_South_NPC_Maniac
{
    lock
    faceplayer
    speakername("Bug Maniac")
    msgbox(format("Lots of people overlook insects, but they're actually way more diverse than most other groups of wildlife! Just think about how many Bug-type and other bug-like Pokémon there are!"))
    closemessage
    release
    end
}

script KiposTown_Zoo_South_NPC_Fisherman
{
    lock
    faceplayer
    speakername("Fisherman")
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_06_2) > 0)
    {
        msgbox(format("It's nice to see Pokémon splashing around in the Wetlands Enclosure again. Sure, I go fishing, but I always release them back into the water!"))
        closemessage
    }
    else
    {
        msgbox(format("I miss seeing Pokémon in this Enclosure... Maybe I could bring some fish in to help repopulate it."))
        closemessage
    }
    applymovement(38, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

