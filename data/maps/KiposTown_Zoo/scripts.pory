mapscripts KiposTown_Zoo_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: KiposTown_Zoo_EventScript_CheckEventStatus
    ]

    MAP_SCRIPT_ON_TRANSITION {
        special(UpdateZooGraphics_South)
    }
}

script KiposTown_Zoo_EventScript_CheckEventStatus
{
    setvar(VAR_TEMP_1, 1)

    if(!flag(FLAG_DID_PIRAEUS_SAIL_TO_KIPOS_TOWN_EVENT)) // gotta do event!
    {
        goto(KiposTown_Zoo_EventScript_PlayerShownAround)
    }

    releaseall
    end
}

script KiposTown_Zoo_EventScript_PlayerShownAround
{
    lockall
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    delay(10)

    applymovement(2, KiposTown_Zoo_Movement_RusselWalkToGirafarig)
    applymovement(OBJ_EVENT_ID_PLAYER, KiposTown_Zoo_Movement_PlayerWalkToGirafarig)
    waitmovement(0)
    delay(10)

    speakername("Mr. Russel")
    msgbox(format("This Girafarig was just about the only Pokémon not taken by Team Chimera. We lost over two dozen Pokémon in a single night...\p Girafarig was only saved by the Pokémon {COLOR GREEN}dwelling in the small cave{COLOR DARK_GRAY}, which has refused to come out since. Maybe it's waiting for a strong Trainer such as yourself.\p Come, let's look at some of the empty exhibits."))
    closemessage

    applymovement(2, KiposTown_Zoo_Movement_RusselWalkToSwampExhibit)
    applymovement(OBJ_EVENT_ID_PLAYER, KiposTown_Zoo_Movement_PlayerWalkToSwampExhibit)
    waitmovement(0)
    delay(10)

    speakername("Mr. Russel")
    msgbox(format("Our Zoo has a {COLOR GREEN}wide variety of Pokémon habitats{COLOR DARK_GRAY}, but unfortunately, they have been left barren.\p Team Chimera is long gone, with the stolen Pokémon scattered to the wind. We need your help to {COLOR GREEN}repopulate these Pokémon enclosures{COLOR DARK_GRAY}.\p Each enclosure has two informational signposts. The {COLOR GREEN}brown signs{COLOR DARK_GRAY} have information about the Pokémon in the exhibits. If there is an open space, you can {COLOR GREEN}deposit a Pokémon{COLOR DARK_GRAY} fitting the enclosure. But remember, {COLOR RED}any donated Pokémon will permanently be in the exhibit{COLOR DARK_GRAY}!\p The {COLOR GREEN}green signs{COLOR DARK_GRAY} provide extra information about an exhibit, which can clue you in on what Pokémon fit best."))
    closemessage
    delay(20)
    applymovement(2, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    speakername("Mr. Russel")
    msgbox(format("Fates, look at the time! I apologize for talking your ear off. Here's a small gift from me, which should help you catch more Pokémon."))
    closemessage
    giveitem(ITEM_ULTRA_BALL, 10)
    closemessage
    delay(5)
    speakername("Mr. Russel")
    msgbox(format("Make sure to come donate extra Pokémon you capture on your journey to {COLOR GREEN}help reinvigorate the Conservation Center{COLOR DARK_GRAY}. Thank you for your help in advance!"))
    closemessage

    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    hideobjectat(2, MAP_KIPOS_TOWN_ZOO)
    removeobject(2)
    setflag(FLAG_DID_PIRAEUS_SAIL_TO_KIPOS_TOWN_EVENT)
    clearflag(FLAG_HIDE_RUSSEL_DURING_ZOO_CUTSCENE)
    setvar(VAR_TOTAL_NUM_ZOO_DONATIONS, 0)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)

    delay(20)
    startquest(QUEST_ZOOKEEPER)

    releaseall
    end
}

movement KiposTown_Zoo_Movement_RusselWalkToGirafarig
{
    walk_up * 2
    walk_right * 4
    face_up
    step_end
}
movement KiposTown_Zoo_Movement_PlayerWalkToGirafarig
{
    walk_up * 3
    walk_right * 3
    face_up
    step_end
}
movement KiposTown_Zoo_Movement_RusselWalkToSwampExhibit
{
    walk_down
    walk_right * 5
    walk_up * 6
    walk_right * 4
    walk_up
    face_left
    step_end
}
movement KiposTown_Zoo_Movement_PlayerWalkToSwampExhibit
{
    walk_right
    walk_down
    walk_right * 5
    walk_up * 6
    walk_right * 3
    walk_up
    face_right
    step_end
}

script KiposTown_Zoo_DirectionSign_South_1
{
    lock
    msgbox(format("{LEFT_ARROW} Forest Exhibit\n {UP_ARROW} Rainforest & Hands-On Exhibit\p Fungal Swamp Exhibit {RIGHT_ARROW}\n Exit {DOWN_ARROW}"))
    closemessage
    release
    end
}

script KiposTown_Zoo_DirectionSign_South_2
{
    lock
    msgbox(format("{LEFT_ARROW} Specialty Indoor Exhibits\n {UP_ARROW} 'Exotic Locale' Zoo Exhibits\p Herpetofauna Exhibits {RIGHT_ARROW}\n 'Backyard Friends' Zoo Exhibits {DOWN_ARROW}"))
    closemessage
    release
    end
}

script KiposTown_Zoo_BuildingSign_SpecialtyBuilding
{
    lock
    msgbox(format("Indoor Exhibits - West Building\n Specialty Exhibits"))
    closemessage
    release
    end
}

script KiposTown_Zoo_BuildingSign_HerpetofaunaBuilding
{
    lock
    msgbox(format("Indoor Exhibits - East Building\n Herpetofauna: Reptiles and Amphibians"))
    closemessage
    release
    end
}

// -------------------------------------------------------------------------------------------------------
//                                      POKEMON DONATION SCRIPTS
// -------------------------------------------------------------------------------------------------------

script KiposTown_Zoo_PokemonSign_End
{
    closemessage
    releaseall
    end
}

script KiposTown_Zoo_PokemonSign_DonationScript
{
    special(ChoosePartyMon) // stores party slot in VAR_0x8004
    waitstate

    goto_if_ge(VAR_0x8004, PARTY_SIZE, KiposTown_Zoo_PokemonSign_End) // if no Pokémon chosen, end early

    specialvar(VAR_RESULT, ScriptGetPartyMonSpecies) // stores Pokémon species in VAR_RESULT
    copyvar(VAR_0x8003, VAR_RESULT) // stores species in VAR_0x8003

    if(var(VAR_0x8003) == SPECIES_EGG) // cannot donate an egg!
    {
        msgbox(format("Eggs cannot be donated to this exhibit."))
        goto(KiposTown_Zoo_PokemonSign_End)
    }

    // check compatibility with chosen species & exhibit
    special(GetZooDonationValidity)
    if(var(VAR_0x8002) == 0) // 0 = invalid
    {
        msgbox(format("Unfortunately, this Pokémon is incompatible with this exhibit.\p Would you like to choose another Pokémon for this enclosure?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 0)
        {
            goto(KiposTown_Zoo_PokemonSign_End)
        }
        else
        {
            goto(KiposTown_Zoo_PokemonSign_DonationScript)
        }
        releaseall
        end
    }

    // NOTES:
    // VAR_0x8002 is Donation Validity, VAR_0x8003 is the Pokémon species, VAR_0x8004 is the party slot
    // By reaching this point, the Pokémon is considered real and compatible with the exhibit, and should now be confirmed

    // Confirm they want to donate
    bufferspeciesname(STR_VAR_1, VAR_0x8003)
    msgbox(format("Are you sure you want to donate {STR_VAR_1}? Remember, contributions to the Sunset Wildlife Conservation Center Zoo are {COLOR RED}permanent{COLOR DARK_GRAY}! The Pokémon will be cared for with love, but cannot be withdrawn."), MSGBOX_YESNO)
    if(var(VAR_RESULT) == 0) // said no
    {
        goto(KiposTown_Zoo_PokemonSign_End)
    }
    else // said yes!
    {
        special(DonateMonToZoo) // donates Pokémon in slot VAR_0x8004 to zoo

        // make sure the donation went through
        if(var(VAR_0x8004) == PARTY_SIZE) // this means something went wrong - likely tried donating last Pokémon in party
        {
            msgbox(format("The donation could not be accepted at this time. Please come back with more Pokémon in your party."))
            goto(KiposTown_Zoo_PokemonSign_End)
        }

        // Check which Zoo Pokémon variable to set
        switch(var(VAR_TEMP_0))
        {
            case 1: // Enclosure #1 (Forest), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_01_1, VAR_0x8003)
            case 2: // Enclosure #1 (Forest), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_01_2, VAR_0x8003)
            case 3: // Enclosure #1 (Forest), Pokémon #3
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_01_3, VAR_0x8003)
            case 4: // Enclosure #1 (Forest), Pokémon #4
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_01_4, VAR_0x8003)
            case 5: // Enclosure #2 (Nest), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_02_1, VAR_0x8003)
            case 6: // Enclosure #3 (Rainforest), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_03_1, VAR_0x8003)
            case 7: // Enclosure #3 (Rainforest), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_03_2, VAR_0x8003)
            case 8: // Enclosure #3 (Rainforest), Pokémon #3
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_03_3, VAR_0x8003)
            case 9: // Enclosure #4 (Suburbs), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_04_1, VAR_0x8003)
            case 10: // Enclosure #4 (Suburbs), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_04_2, VAR_0x8003)
            case 11: // Enclosure #4 (Suburbs), Pokémon #3
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_04_3, VAR_0x8003)
            case 12: // Enclosure #5 (Fungal Swamp), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_05_1, VAR_0x8003)
            case 13: // Enclosure #5 (Fungal Swamp), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_05_2, VAR_0x8003)
            case 14: // Enclosure #6 (Wetlands), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_06_1, VAR_0x8003)
            case 15: // Enclosure #6 (Wetlands), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_06_2, VAR_0x8003)
            case 16: // Enclosure #7 (Beach), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_07_1, VAR_0x8003)
            case 17: // Enclosure #7 (Beach), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_07_2, VAR_0x8003)
            case 18: // Enclosure #8 (Desert), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_08_1, VAR_0x8003)
            case 19: // Enclosure #8 (Desert), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_08_2, VAR_0x8003)
            case 20: // Enclosure #9 (Lazarus Taxa), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_09_1, VAR_0x8003)
            case 21: // Enclosure #10 (Mountains), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_10_1, VAR_0x8003)
            case 22: // Enclosure #10 (Mountains), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_10_2, VAR_0x8003)
            case 23: // Enclosure #10 (Mountains), Pokémon #3
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_10_3, VAR_0x8003)
            case 24: // Enclosure #11 (Volcano), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_11_1, VAR_0x8003)
            case 25: // Enclosure #11 (Volcano), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_11_2, VAR_0x8003)
            case 26: // Enclosure #12 (Tundra), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_12_1, VAR_0x8003)
            case 27: // Enclosure #12 (Tundra), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_12_2, VAR_0x8003)
            case 28: // Enclosure #13 (Ruins), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_13_1, VAR_0x8003)
            case 29: // Enclosure #13 (Ruins), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_13_2, VAR_0x8003)
            case 30: // Enclosure #14 (Shallows), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_14_1, VAR_0x8003)
            case 31: // Enclosure #14 (Shallows), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_14_2, VAR_0x8003)
            case 32: // Indoor Enclosure #1 (Warm Water), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1, VAR_0x8003)
            case 33: // Indoor Enclosure #1 (Warm Water), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2, VAR_0x8003)
            case 34: // Indoor Enclosure #1 (Warm Water), Pokémon #3
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3, VAR_0x8003)
            case 35: // Indoor Enclosure #2 (Gymnasium), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_02_1, VAR_0x8003)
            case 36: // Indoor Enclosure #2 (Gymnasium), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_02_2, VAR_0x8003)
            case 37: // Indoor Enclosure #3 (Spirit Center), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_03_1, VAR_0x8003)
            case 38: // Indoor Enclosure #3 (Spirit Center), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_IN_03_2, VAR_0x8003)
            case 39: // Herp. Enclosure #1 (Badlands), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_01_1, VAR_0x8003)
            case 40: // Herp. Enclosure #1 (Badlands), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_01_2, VAR_0x8003)
            case 41: // Herp. Enclosure #2 (Jungle), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_02_1, VAR_0x8003)
            case 42: // Herp. Enclosure #2 (Jungle), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_02_2, VAR_0x8003)
            case 43: // Herp. Enclosure #3 (Mangrove Swamp), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_03_1, VAR_0x8003)
            case 44: // Herp. Enclosure #3 (Mangrove Swamp), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_03_2, VAR_0x8003)
            case 45: // Herp. Enclosure #4 (Birds), Pokémon #1
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_1, VAR_0x8003)
            case 46: // Herp. Enclosure #4 (Birds), Pokémon #2
                copyvar(VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_2, VAR_0x8003)
        }

        addvar(VAR_TOTAL_NUM_ZOO_DONATIONS, 1)
        
        playfanfare(FANFARE_LEVEL_UP)
        msgbox(format("Donated {STR_VAR_1} to the Exhibit! Return soon to view the Pokémon in it's new home!"))
        waitfanfare
        goto(KiposTown_Zoo_PokemonSign_End)
    }
}

// -------------------------------------------------------------------------------------------------------
//                                      POKEMON INFO SIGN SCRIPTS
// -------------------------------------------------------------------------------------------------------

// Girafarig enclosure sign
script KiposTown_Zoo_PokemonSign_Girafarig
{
    lock
    msgbox(format("Special Enclosure: Welcome to the Sunset Wildlife Conservation Zoo!\p This Girafarig was the first Pokémon ever cared for by the Conservation Center. It has always been most comfortable nearby this small cave, making a home here.\p There's more written about Girafarig!"))
    closemessage

    setvar(VAR_0x8003, SPECIES_GIRAFARIG) // loads species into VAR_0x8003
    special(ShowSpeciesZooInfoWindow)
    delay(30)
    waitbuttonpress
    special(CloseSpeciesZooInfoWindow)

    releaseall
    end
}

// -------------------------------------- ENCLOSURE 01: FOREST ---------------------------------------------------
script KiposTown_Zoo_PokemonSign_Forest
{
    lock

    // buffer species names for initial sign info
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_01_1)
    bufferspeciesname(STR_VAR_2, VAR_ZOO_POKEMON_ENCLOSURE_01_2)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_1) == 0) // no Pokémon in slot 1
    {
        bufferstring(STR_VAR_1, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_2) == 0) // no Pokémon in slot 2
    {
        bufferstring(STR_VAR_2, "---")
    }

    // ------------ BASIC ENCLOSURE INFO CODE ------------
    // msgbox(format("Enclosure No. 1: Forest\n Pokémon in Exhibit: {STR_VAR_1}, {STR_VAR_2}"))
    // closemessage
    // gotta be extra cause there's four pokemon here instead of two. lol
    // just use commented msgbox above instead for future enclosures
    msgbox(format("Enclosure No. 1: {COLOR GREEN}Forest{COLOR DARK_GRAY}"))
    closemessage
    msgbox(format("Pokémon in Enclosure (South):\n {STR_VAR_1}, {STR_VAR_2}"))
    closemessage
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_01_3)
    bufferspeciesname(STR_VAR_2, VAR_ZOO_POKEMON_ENCLOSURE_01_4)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_3) == 0) // no Pokémon in slot 3
    {
        bufferstring(STR_VAR_1, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_4) == 0) // no Pokémon in slot 4
    {
        bufferstring(STR_VAR_2, "---")
    }
    msgbox(format("Pokémon in Enclosure (North):\n {STR_VAR_1}, {STR_VAR_2}"))
    closemessage

    // ------------ DISPLAY MORE INFO CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_1) > 0) // AT LEAST ONE Pokémon in enclosure
    {
        // Finally, offer reading Pokédex entries
        msgbox(format("There's information about each Pokémon listed. Read it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 1) // said yes to more information
        {
            copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_01_1) // loads species into VAR_0x8003
            special(ShowSpeciesZooInfoWindow)
            delay(30)
            waitbuttonpress
            special(CloseSpeciesZooInfoWindow)

            if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_2) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_01_2) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
            if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_3) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_01_3) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
            if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_4) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_01_4) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
        }
    }

    // ------------ OFFER DONATIONS CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_01_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 1) // Enclosure #01, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_01_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_01_2) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 2) // Enclosure #01, Pokémon 2 - VAR_ZOO_POKEMON_ENCLOSURE_01_2

        msgbox(format("There is room for a second Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_01_3) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 3) // Enclosure #01, Pokémon 3 - VAR_ZOO_POKEMON_ENCLOSURE_01_3

        msgbox(format("There is room for a third Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_01_4) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 4) // Enclosure #01, Pokémon 4 - VAR_ZOO_POKEMON_ENCLOSURE_01_4

        msgbox(format("There is room for a fourth Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Forest
{
    lock
    msgbox(format("Enclosure No. 1: {COLOR GREEN}Forest{COLOR DARK_GRAY}\p This enclosure is designed to replicate a natural woodland environment. Broadleaf trees are separated by small clearings and shrub growth, and food is plentiful for all Pokémon.\p Many {COLOR GREEN}Grass-type{COLOR DARK_GRAY} and {COLOR GREEN}Bug-type Pokémon{COLOR DARK_GRAY} can be found here, alongside other Pokémon of {COLOR GREEN}Normal and Flying-types{COLOR DARK_GRAY}. Hidden deep in these areas, some {COLOR GREEN}Psychic and Ghost-type{COLOR DARK_GRAY} Pokémon are known to thrive."))
    closemessage
    release
    end
}

// -------------------------------------- ENCLOSURE 02: NEST ---------------------------------------------------
script KiposTown_Zoo_PokemonSign_Nest
{
    lock

    // buffer species names for initial sign info
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_02_1)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_02_1) == 0) // no Pokémon in slot 1
    {
        bufferstring(STR_VAR_1, "---")
    }

    // ------------ BASIC ENCLOSURE INFO CODE ------------
    msgbox(format("Enclosure No. 2: Nest\n Pokémon in Exhibit: {STR_VAR_1}"))
    closemessage

    // ------------ DISPLAY MORE INFO CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_02_1) > 0) // AT LEAST ONE Pokémon in enclosure
    {
        // Finally, offer reading Pokédex entries
        msgbox(format("There's information about the Pokémon listed. Read it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 1) // said yes to more information
        {
            copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_02_1) // loads species into VAR_0x8003
            special(ShowSpeciesZooInfoWindow)
            delay(30)
            waitbuttonpress
            special(CloseSpeciesZooInfoWindow)
        }
    }

    // ------------ OFFER DONATIONS CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_02_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 5) // Enclosure #02, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_02_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Nest
{
    lock
    msgbox(format("Enclosure No. 2: {COLOR GREEN}Nest{COLOR DARK_GRAY}\p Despite their vast evolutionary differences, all Pokémon recorded reproducing have done so through the production of {COLOR GREEN}Eggs{COLOR DARK_GRAY}. This small area is based on natural Pokémon nests, where they tend to lay 1-2 Eggs at a time.\p Although all Pokémon lay Eggs, some provide better parental care than others. Pokémon regarded as {COLOR GREEN}'cure and cuddly'{COLOR DARK_GRAY} are often best suited for nesting alongside Pokémon Eggs. Alternatively, Pokémon species with high levels of {COLOR GREEN}parental care{COLOR DARK_GRAY} can do well alongside other Eggs."))
    closemessage
    release
    end
}

// -------------------------------------- ENCLOSURE 03: Tropical Jungle ---------------------------------------------------
script KiposTown_Zoo_PokemonSign_Rainforest
{
    lock

    // buffer species names for initial sign info
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_03_1)
    bufferspeciesname(STR_VAR_2, VAR_ZOO_POKEMON_ENCLOSURE_03_2)
    bufferspeciesname(STR_VAR_3, VAR_ZOO_POKEMON_ENCLOSURE_03_3)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_1) == 0) // no Pokémon in slot 1
    {
        bufferstring(STR_VAR_1, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_2) == 0) // no Pokémon in slot 2
    {
        bufferstring(STR_VAR_2, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_3) == 0) // no Pokémon in slot 3
    {
        bufferstring(STR_VAR_3, "---")
    }

    // ------------ BASIC ENCLOSURE INFO CODE ------------
    msgbox(format("Enclosure No. 3: Rainforest\n Pokémon in Exhibit: {STR_VAR_1}, {STR_VAR_2}, {STR_VAR_3}"))
    closemessage

    // ------------ DISPLAY MORE INFO CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_1) > 0) // AT LEAST ONE Pokémon in enclosure
    {
        // Finally, offer reading Pokédex entries
        msgbox(format("There's information about each Pokémon listed. Read it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 1) // said yes to more information
        {
            copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_03_1) // loads species into VAR_0x8003
            special(ShowSpeciesZooInfoWindow)
            delay(30)
            waitbuttonpress
            special(CloseSpeciesZooInfoWindow)

            if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_2) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_03_2) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
            if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_3) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_03_3) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
        }
    }

    // ------------ OFFER DONATIONS CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_03_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 6) // Enclosure #01, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_03_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_03_2) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 7) // Enclosure #01, Pokémon 2 - VAR_ZOO_POKEMON_ENCLOSURE_03_2

        msgbox(format("There is room for a second Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_03_3) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 8) // Enclosure #01, Pokémon 3 - VAR_ZOO_POKEMON_ENCLOSURE_03_3

        msgbox(format("There is room for a third Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Rainforest
{
    lock
    msgbox(format("Enclosure No. 3: {COLOR GREEN}Rainforest{COLOR DARK_GRAY}\p These dense jungles are packed with trees and undergrowth, blooming in the heat and humidity of the tropics. Rainforests only cover a small percentage of the planet, but have the highest concentration of wildlife by far. Sadly, these critical ecosystems are threatened by deforestation and climate change.\p Of course, {COLOR GREEN}Grass and Bug-type{COLOR DARK_GRAY} Pokémon thrive in these areas. {COLOR GREEN}Birds{COLOR DARK_GRAY} also make their homes here, alongside a huge variety of {COLOR GREEN}primates{COLOR DARK_GRAY}."))
    closemessage
    release
    end
}

