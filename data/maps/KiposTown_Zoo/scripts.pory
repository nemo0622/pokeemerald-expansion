script KiposTown_Zoo_EnvironmentSign_Suburbs
{
    lock
    msgbox(format("Enclosure No. 4: {COLOR GREEN}Suburbs{COLOR DARK_GRAY}\p Humans are constantly modifying their environment, so naturally, some Pokémon have adapted to live in these conditions. From quiet walkways through woodlands to sprawling concrete cities, some Pokémon have found ways to coexist with human influences.\p In this hands-on exhibit, {COLOR GREEN}highly domesticated{COLOR DARK_GRAY} Pokémon are a great fit. {COLOR GREEN}Anthropomorphic{COLOR DARK_GRAY}, or Human-like, Pokémon are common here, alongside Pokémon connected to {COLOR GREEN}human activities{COLOR DARK_GRAY}, from construction to pollution."))
    closemessage
    release
    end
}

