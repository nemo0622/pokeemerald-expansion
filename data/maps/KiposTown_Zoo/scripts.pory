script KiposTown_Zoo_South_NPC_Scientist
{
    lock
    faceplayer
    speakername("Scientist")
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_02_1) > 0)
    {
        bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_02_1)
        msgbox(format("That {STR_VAR_1} seems to be doing a great job taking care of the Pokémon Eggs! Despite being from different species, it still warms them and shows them affection. Pokémon behavior is fascinating!"))
        closemessage
    }
    else
    {
        msgbox(format("I hope those Pokémon Eggs are doing alright in there. Researchers from the Conservation Center have routinely checked up on them, but they'd probably do better with a Pokémon in there caring for them."))
        closemessage
    }
    applymovement(44, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}