script Route_01_Script_YungoosEncounter
{
	applymovement(LOCALID_PLAYER, moves(walk_up * 4, delay_16 * 4, face_left, delay_16 * 2, face_right, delay_16 * 2, face_up, step_end))
	waitmovement(0)

	clearflag(FLAG_HIDE_YUNGOOS_ROUTE_01)
	addobject(1) // Spawns in Yungoos
	applymovement(1, moves(jump_left, delay_16 * 2, walk_fast_down * 2, jump_in_place_down * 3, step_end))
	emote(LOCALID_PLAYER, EMOTE_EXCLAM)
	waitmovement(1)

	createplayerfieldmugshot(EMOTION_SAD)
	msgbox(format("{SPEAKER NAME_PLAYER}A {COLOR BLUE}Yungoos{COLOR DARK_GRAY}! Grandpa Samson told me about these chasing people down... But I don't have a Pokémon to fight it!"))
	closemessage

	delay(15)
	setspeaker("Wild Yungoos")
    playmoncry(SPECIES_YUNGOOS, CRY_MODE_NORMAL)
    msgbox("Grr-yeow!!")
    waitmoncry
    closemessage
	delay(15)

	// Starters protect Player
	clearflag(FLAG_HIDE_STARTERS_ROUTE_01)
	addobject(2) // Spawn Rowlet
	addobject(3) // Spawn Litten
	addobject(4) // Spawn Popplio
	applymovement(2, moves(walk_right * 3, walk_down, walk_right * 4, walk_up, face_up, step_end))
	applymovement(3, moves(walk_down * 3, walk_right, walk_down * 2, walk_right, face_up, step_end))
	applymovement(4, moves(jump_left * 5, delay_16, face_down, delay_16, face_right, delay_16, face_up, delay_16, walk_left * 2, face_up, step_end))
	emote(LOCALID_PLAYER, EMOTE_EXCLAM)
	waitmovement(4)
	delay(15)

	// Starters each make their sounds
	applymovement(2, moves(face_down, jump_in_place_down * 2, delay_16 * 2, face_up, step_end))
	playmoncry(SPECIES_ROWLET, CRY_MODE_NORMAL)
	msgbox("Koo!")
	waitmoncry
	closemessage
	delay(10)
	applymovement(3, moves(face_down, jump_in_place_down * 2, delay_16 * 2, face_up, step_end))
	playmoncry(SPECIES_LITTEN, CRY_MODE_NORMAL)
	msgbox("Mrower...")
	waitmoncry
	closemessage
	delay(10)
	applymovement(4, moves(face_down, jump_in_place_down * 2, delay_16 * 2, face_up, step_end))
	playmoncry(SPECIES_POPPLIO, CRY_MODE_NORMAL)
	msgbox("Bwark?")
	waitmoncry
	closemessage
	delay(30)

	// Yungoos flees!
	emote(1, EMOTE_QUESTION)
	delay(20)
	setspeaker("Wild Yungoos")
    playmoncry(SPECIES_YUNGOOS, CRY_MODE_NORMAL)
    msgbox("Krr... RAH!")
    waitmoncry
    closemessage
	delay(10)
	applymovement(1, moves(jump_in_place_down * 2, delay_16, walk_fast_up, walk_fast_left * 9, step_end))
	waitmovement(1)
	createplayerfieldmugshot
	msgbox(format("{SPEAKER NAME_PLAYER}Wow, you saved me from that {COLOR BLUE}Yungoos{COLOR DARK_GRAY}! Who are you?"))
	closemessage
	delay(20)

	// Grandpa Samson shows up
	setspeaker("Grandpa Samson")
	createfieldmugshot(MUGSHOT_SAMSON_OAK)
	msgbox(format("Aue! {PLAYER}! You found them!"))
	closemessage
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(0)
	emote(LOCALID_PLAYER, EMOTE_QUESTION)
	delay(10)

	// Fade to black to cleanup objects and scene
	fadescreenswapbuffers(FADE_TO_BLACK)
	delay(20)
	setflag(FLAG_HIDE_YUNGOOS_ROUTE_01)
	removeobject(1)
	clearflag(FLAG_HIDE_SAMSON_ROUTE_01)
	addobject(5) // spawn Samson Oak
	addobject(6) // spawn Prof Kukui
	applymovement(2, Common_Movement_FaceDown)
	applymovement(3, Common_Movement_FaceDown)
	applymovement(4, Common_Movement_FaceDown)
	delay(20)
	applymovement(5, moves(walk_right * 6, face_up, step_end))
	applymovement(6, moves(walk_right * 4, walk_up, face_right, step_end))
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(20)

	// Grandpa Samson dialogue
	waitmovement(5)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceDown)
	waitmovement(0)
	setspeaker("Grandpa Samson")
	createfieldmugshot(MUGSHOT_SAMSON_OAK)
	msgbox(format("We were on the way back from {COLOR GREEN}Iki Town{COLOR DARK_GRAY} when {COLOR GREEN}Rowlet{COLOR DARK_GRAY}, {COLOR RED}Litten{COLOR DARK_GRAY}, and {COLOR BLUE}Popplio{COLOR DARK_GRAY} ran off. How'd ya catch 'em?"))
	closemessage
	delay(10)
	applymovement(6, moves(walk_down * 2, walk_right, step_end))
	waitmovement(0)
	setspeaker("???")
	createfieldmugshot(MUGSHOT_PROF_KUKUI, EMOTION_LAUGH)
	msgbox(format("Ha! Slow down, cousin! It looks like those three were saving them from a Yungoos."))
	closemessage
	delay(10)

	// Kukui character intro
	applymovement(6, moves(walk_up, face_right, step_end))
	applymovement(LOCALID_PLAYER, moves(face_left))
	waitmovement(6)
	delay(10)
	setspeaker("Prof. Kukui")
	createfieldmugshot(MUGSHOT_PROF_KUKUI)
	msgbox(format("The name's Kukui, the Professor of Melemele Island! And by the sound of it, you're {PLAYER}, yeah?\n Welcome to Alola!\p Pokémon like to live in the grass around here. If you want to explore Alola, you'll need your own Pokémon to dish out some moves!"))
	closemessage

	// Samson considers starters
	delay(30)
	emote(5, EMOTE_EXCLAM)
	delay(10)
	applymovement(LOCALID_PLAYER, moves(face_down))
	applymovement(5, moves(walk_in_place_slow_up * 2, face_up, step_end))
	waitmovement(0)
	setspeaker("Grandpa Samson")
	createfieldmugshot(MUGSHOT_SAMSON_OAK)
	msgbox(format("As it happens, I was in Iki Town picking up those {COLOR GREEN}three Pokémon{COLOR DARK_GRAY} to show you before they ran off."))
	waitmessage
	createfieldmugshot(MUGSHOT_SAMSON_OAK, EMOTION_LAUGH)
	setspeaker("Grandpa Samson")
	msgbox(format("How about you {COLOR GREEN}pick one to be your partner{COLOR DARK_GRAY}? They all seem to like you well enough, ohoho!"))
	closemessage

	applymovement(5, moves(walk_down, face_up, step_end))
	applymovement(6, moves(walk_down * 2, face_up, step_end))
	waitmovement(0)

	// Save game prompt, for Those People (lol)
	call(Common_EventScript_SaveGame)

	// Player free to choose starter!
	releaseall
	end
}

script Route_01_Script_ProfKukui_StarterChoice
{
	lock
	faceplayer
	setspeaker("Prof. Kukui")
	createfieldmugshot(MUGSHOT_PROF_KUKUI)
	msgbox(format("Somethin' wrong, {PLAYER}? Pick whichever Pokémon speaks to you the most, yeah!"))
	closemessage
	release
	end
}
script Route_01_Script_SamsonOak_StarterChoice
{
	lock
	faceplayer
	setspeaker("Grandpa Samson")
	createfieldmugshot(MUGSHOT_SAMSON_OAK)
	msgbox(format("Go ahead, pick a Pokémon to join you! They're all quite rare, so choose wisely."))
	closemessage
	release
	end
}

// STARTER CHOICE SCRIPTS
script Route_01_Script_ChooseRowlet
{
	lock
	setspeaker("Rowlet")
	playmoncry(SPECIES_ROWLET, CRY_MODE_NORMAL)
	msgbox("Koo!")
	waitmoncry
	closemessage
	delay(10)
	createplayerfieldmugshot
	msgbox(format("{SPEAKER NAME_PLAYER}Grandpa Samson mentioned this Pokémon! {COLOR GREEN}Rowlet{COLOR DARK_GRAY} likes to fly at night, tucking itself into corners during the day."))
	closemessage
	msgbox(format("{SPEAKER NAME_PLAYER}Should I pick {COLOR GREEN}Rowlet{COLOR DARK_GRAY}, the Grass Quill Pokémon?"), MSGBOX_YESNO)
	closemessage

	if(var(VAR_RESULT) == TRUE) // said yes!
	{
		setvar(VAR_STARTER_MON, SPECIES_ROWLET)
		givemon(SPECIES_ROWLET, 5)
		goto(Route_01_Script_ReactToStarter)
	}
	release
	end
}
