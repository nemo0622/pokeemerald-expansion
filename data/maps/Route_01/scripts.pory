	closemessage
	delay(10)
	createplayerfieldmugshot
	msgbox(format("{SPEAKER NAME_PLAYER}Grandpa Samson mentioned this Pokémon! {COLOR RED}Litten{COLOR DARK_GRAY} acts aloof, but it loves Trainers who help keep its fur clean."))
	closemessage
	msgbox(format("{SPEAKER NAME_PLAYER}Should I pick {COLOR RED}Litten{COLOR DARK_GRAY}, the Fire Cat Pokémon?"), MSGBOX_YESNO)
	closemessage

	if(var(VAR_RESULT) == TRUE) // said yes!
	{
		setvar(VAR_STARTER_MON, SPECIES_LITTEN)
		givemon(SPECIES_LITTEN, 5)
		goto(Route_01_Script_ReactToStarter)
	}
	release
	end
}
