script Route_01_Script_ReactToStarter
{
	lockall
	setvar(VAR_INTRO_STATE, 3)

	// SET STARTER CHOSEN FLAGS (and play fanfare)
	setflag(FLAG_SYS_POKEMON_GET)

	bufferspeciesname(STR_VAR_1, VAR_STARTER_MON)
	createplayerfieldmugshot(EMOTION_LAUGH)
	message(format("{SPEAKER NAME_PLAYER}I choose you, {STR_VAR_1}!"))
	call(Common_EventScript_PlayGymBadgeFanfare)
	closemessage
	delay(15)

	// Move Player into position
	applymovement(5, moves(face_up, step_end))
	applymovement(6, moves(face_up, step_end))
	switch(var(VAR_STARTER_MON))
	{
		case SPECIES_ROWLET:
			applymovement(LOCALID_PLAYER, moves(walk_right, walk_down, face_down, step_end))
			applymovement(2, moves(walk_down, walk_right, face_down, step_end))
		case SPECIES_LITTEN:
		default:
			applymovement(LOCALID_PLAYER, moves(walk_down, face_down, step_end))
			applymovement(3, moves(walk_down, face_down, step_end))
		case SPECIES_POPPLIO:
			applymovement(LOCALID_PLAYER, moves(walk_left, walk_down, face_down, step_end))
			applymovement(4, moves(walk_down, walk_left, face_down, step_end))
	}
	waitmovement(0)

	// Samson reacts to choice, Kukui tells you to say Mahalo (thank you), then you and Samson go back home
	delay(10)
	setspeaker("Grandpa Samson")
	createfieldmugshot(MUGSHOT_SAMSON_OAK, EMOTION_LAUGH)
	msgbox(format("{STR_VAR_1}! I had a feeling that's who you would pick."))
	waitmessage
	createfieldmugshot(MUGSHOT_SAMSON_OAK, EMOTION_NORMAL)
	setspeaker("Grandpa Samson")
	msgbox(format("Now, you thank Professor Kukui for that {STR_VAR_1} with a great big Alolan 'Mahalo'. Those three Pokémon were originally his!"))
	closemessage
	delay(10)
	applymovement(6, moves(walk_up, face_right))
	applymovement(LOCALID_PLAYER, moves(face_left))
	waitmovement(6)
	setspeaker("Prof. Kukui")
	createfieldmugshot(MUGSHOT_PROF_KUKUI)
	msgbox(format("Na-ah, don't sweat it, cousin! When I heard the great Samson Oak's own grandkid was moving back to Alola, I knew they'd shape up to be a Pokémon Trainer!\p I'll get the other two Pokémon back into their Poké Balls, then let's show your Mom your new friend!"))
	closemessage

	delay(10)
	warpcontinuescript(MAP_HAUOLI_OUTSKIRTS_PLAYERS_ROOM, 8, 11, HauoliOutskirts_PlayersHouse_Script_MomMeetsStarter)

	releaseall
	end
}

script Route_01_Script_HauIntro
{
	lock
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
	switch(var(VAR_TEMP_1))
	{
		case 10:
			applymovement(LOCALID_PLAYER, moves(walk_right, walk_up, step_end))
		case 12:
			applymovement(LOCALID_PLAYER, moves(walk_left, walk_up, step_end))
		default:
			applymovement(LOCALID_PLAYER, Common_Movement_WalkUp)
	}
	waitmovement(0)
	emote(LOCALID_HAU_ROUTE01, EMOTE_EXCLAM)
	delay(10)

	applymovement(LOCALID_HAU_ROUTE01, Common_Movement_WalkDown)
	waitmovement(0)
	bufferspeciesname(STR_VAR_1, VAR_STARTER_MON)
	setspeaker("???")
	createfieldmugshot(MUGSHOT_HAU)
	msgbox(format("Hey, hey! You've got a {STR_VAR_1} with you... You must be {PLAYER}!"))

	setspeaker("Hau")
	createfieldmugshot(MUGSHOT_HAU)
	msgbox(format("I'm Hau! Professor Kukui told me to keep an eye out for ya.\p I'll get my first Pokémon at the {COLOR GREEN}Manalo Festival{COLOR DARK_GRAY} tonight, but I heard you already got yours! I figure I should give these to you."))
	closemessage
	giveitem(ITEM_POKE_BALL, 10)
	closemessage
	setspeaker("Hau")
	createfieldmugshot(MUGSHOT_HAU)
	msgbox(format("Kukui gave me a big box of those, but I can't battle wild Pokémon without a partner of my own yet!"))
	waitmessage
	createfieldmugshot(MUGSHOT_HAU, EMOTION_LAUGH)
	setspeaker("Hau")
	msgbox(format("I'm gonna go on ahead. See you later!"))
	closemessage
	applymovement(LOCALID_HAU_ROUTE01, moves(walk_up * 2, walk_left, walk_up * 5, step_end))
	waitmovement(0)

	setflag(FLAG_HIDE_HAU_ROUTE_01)
	removeobject(LOCALID_HAU_ROUTE01)
	setvar(VAR_INTRO_STATE, 4)

	releaseall
	end
}

