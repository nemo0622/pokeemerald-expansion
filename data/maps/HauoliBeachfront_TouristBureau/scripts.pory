mapscripts HauoliBeachfront_TouristBureau_MapScripts {}

script HauoliBeachfront_TouristBureau_NPC_BellhopAtCounter
{
    lock
    faceplayer
    setspeaker("Bellhop")
    msgbox(format("Welcome to the Alola Tourist Bureau! If you need anything, please don't hesitate to let us know."))
    closemessage
    release
    end
}

script HauoliBeachfront_TouristBureau_Pokemon_Machop
{
	lock
    faceplayer
    setspeaker("Machop")
    playmoncry(SPECIES_MACHOP, CRY_MODE_NORMAL)
    msgbox(format("Hyah!"))
    waitmoncry
    closemessage
    release
    end
}

script HauoliBeachfront_TouristBureau_NPC_AetherFoundationEmployee
{
    lock
    faceplayer
    setspeaker("Aether Employee")
    msgbox(format("Welcome! Are you here to learn more about the {COLOR GREEN}Aether Foundation{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == TRUE)
    {
        setspeaker("Aether Employee")
        msgbox(format("Wonderful! The {COLOR GREEN}Aether Foundation{COLOR DARK_GRAY} is the largest conservation organization in Alola. We work to protect wild Pokémon and their habitats.\pSometimes, Pokémon are too hurt to be released back into the wild. That's why our wonderful boss, {COLOR GREEN}Lusamine{COLOR DARK_GRAY}, chose to build a floating home for all Pokémon: the Aether Paradise!"))
        closemessage
    }
    release
    end
}

