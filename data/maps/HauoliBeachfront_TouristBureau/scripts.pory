script HauoliBeachfront_TouristBureau_NPC_HexManiac
{
    lock
    faceplayer
    setspeaker("Hex Maniac")
    msgbox(format("Yeah, I put my {COLOR BLUE}Litwick{COLOR DARK_GRAY} on the table! So what?! It's a candle!"))
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)
    waitmovement(0)
    release
    end
}

