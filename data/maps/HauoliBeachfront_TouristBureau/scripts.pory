script HauoliBeachfront_TouristBureau_NPC_CollectorPlayingCards
{
    lock
    faceplayer
    setspeaker("Collector")
    
    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_TOURIST_DIFFICULTIES)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("I'm gonna catch a one-of-a-kind Pokémon with that Premier Ball!\pProbably something super unique, like... Gengar! Or... Umm... Charizard?"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_TOURIST_DIFFICULTIES)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Everyone says I'm only into Pokémon for the money, so I bought up all the {COLOR BLUE}TCG Packs{COLOR DARK_GRAY} from the local store. That'll show 'em!\p People might stil make fun of me without a real Pokémon, though..."))
        closemessage
        delay(20)
        emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
        delay(10)
        setspeaker("Collector")
        msgbox(format("I've got an idea! If you bring me a {COLOR GREEN}Premier Ball{COLOR DARK_GRAY} to catch a sweet new Pokémon, I'll give you a {COLOR BLUE}TCG Pack{COLOR DARK_GRAY}. Deal?"))
        closemessage

        delay(20)
        startquest(QUEST_TOURIST_DIFFICULTIES)
    }
    else
    {
        msgbox(format("Ugh, finally! Do you have that {COLOR GREEN}Premier Ball{COLOR DARK_GRAY}?"))
        closemessage

        // Check Quest completion
        checkitem(ITEM_PREMIER_BALL)
        delay(30)

        if(var(VAR_RESULT) == FALSE)
        {
            setspeaker("Collector")
            msgbox(format("Guess not...\pI need a {COLOR GREEN}Premier Ball{COLOR DARK_GRAY} so I can catch a real-life Pokémon. Everyone will know how COOL I am!"))
            closemessage
            release
            end
        }
        else
        {
            setspeaker("Collector")
            msgbox(format("Hah! This is the coolest type of Poké ball by far!\pI suppose I can part with a {COLOR BLUE}TCG Pack{COLOR DARK_GRAY}... But if you pull anything good, I want it back!"))
            closemessage
            
            removeitem(ITEM_PREMIER_BALL)
            delay(5)
            giveitem(ITEM_POTION) // TODO: Give a TCG Pack item!
            closemessage

            delay(20)
            completequest(QUEST_TOURIST_DIFFICULTIES)
        }
    }
    release
    end
}

