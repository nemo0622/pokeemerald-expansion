script RuinsOfAhiyawa_EliteFour_Polymnia
{
    lock
    faceplayer
    speakername("Polymnia")

    // if already beat battle, be done lol
    if(flag(FLAG_ELITE_FOUR_DEFEATED_POLYMNIA))
    {
        msgbox(format("That was an incredible battle. Please, continue the challenge ahead!"))
        closemessage
        release
        end
    }

    msgbox(format("{PLAYER}, I'd like to welcome you to the Elite Four! Seeing how far you've come as a Trainer makes me proud... I still remember your first time in my Gym, ehehe!\p Right, I suppose we should get straight to business. As the first member of the newly-formed Elite Four, I challenge you to battle!"))
    closemessage

    if(!flag(FLAG_HARD_MODE))
    {
        trainerbattle_no_intro(TRAINER_ELITEFOUR_POLYMNIA, RuinsOfAhiyawa_EliteFour_PolymniaLoseText)
    }
    else
    {
        trainerbattle_no_intro(TRAINER_ELITEFOUR_POLYMNIA_HARD, RuinsOfAhiyawa_EliteFour_PolymniaLoseText)
    }

    setflag(FLAG_ELITE_FOUR_DEFEATED_POLYMNIA)
    delay(10)
    speakername("Polymnia")
    msgbox(format("Huff, puff... That was quite the battle, {PLAYER}! I'll allow you to pass to the {COLOR GREEN}next room{COLOR DARK_GRAY}. Good luck with your challenge!"))
    closemessage
    release
    end
}
text RuinsOfAhiyawa_EliteFour_PolymniaLoseText
{
    format("You've bloomed like a beautiful garden!")
}

