script RuinsOfAhiyawa_EliteFour_Rhadine
{
    lock
    faceplayer
    speakername("Rhadine")

    // if already beat battle, be done lol
    if(flag(FLAG_ELITE_FOUR_DEFEATED_RHADINE))
    {
        msgbox(format("That was an incredible battle. Please, continue the challenge ahead!"))
        closemessage
        release
        end
    }

    msgbox(format("{PLAYER}... I'm so, so glad you made it this far! It feels like years since we stood in the Sofos Acropolis Temple, gazing up at Team Chimera's Legendary Beasts with clenched fists. Now, they've been defeated, and we stand triumphant.\p Of course, there's still a challenge ahead of you - it's me! Show me your fiery spirit in battle!"))
    closemessage

    if(!flag(FLAG_HARD_MODE))
    {
        trainerbattle_no_intro(TRAINER_ELITEFOUR_RHADINE, RuinsOfAhiyawa_EliteFour_RhadineLoseText)
    }
    else
    {
        trainerbattle_no_intro(TRAINER_ELITEFOUR_RHADINE_HARD, RuinsOfAhiyawa_EliteFour_RhadineLoseText)
    }

    setflag(FLAG_ELITE_FOUR_DEFEATED_RHADINE)
    delay(10)
    speakername("Rhadine")
    msgbox(format("Kehehe, you've beaten me, and with that, you've won your challenge!\p ...Well, you've ALMOST won. What, did you think we didn't have a Champion? A {COLOR GREEN}powerful Trainer{COLOR DARK_GRAY} from Ilios, exploring other regions for years, has returned to battle you.\p Continue through the door behind me nd face one final battle. Only then can you become the Champion of Ilios!"))
    closemessage
    release
    end
}
text RuinsOfAhiyawa_EliteFour_RhadineLoseText
{
    format("Your fire grows brighter and brighter!")
}
