script RuinsOfAhiyawa_EliteFour_Terpsikore
{
    lock
    faceplayer
    speakername("Terpsikore")

    // if already beat battle, be done lol
    if(flag(FLAG_ELITE_FOUR_DEFEATED_TERPSIKORE))
    {
        msgbox(format("That was an incredible battle. Please, continue the challenge ahead!"))
        closemessage
        release
        end
    }

    msgbox(format("Opa, you made it through Polymnia! Ever since you helped me out in {COLOR GREEN}Satyr's Lair{COLOR DARK_GRAY} back in Sofos City, I knew you were something special.\p As you know, I'm the Muse of Dance, which means that balance is key to me. Show me your most graceful moves!"))
    closemessage

    if(!flag(FLAG_HARD_MODE))
    {
        trainerbattle_no_intro(TRAINER_ELITEFOUR_TERPSIKORE, RuinsOfAhiyawa_EliteFour_TerpsikoreLoseText)
    }
    else
    {
        trainerbattle_no_intro(TRAINER_ELITEFOUR_TERPSIKORE_HARD, RuinsOfAhiyawa_EliteFour_TerpsikoreLoseText)
    }

    setflag(FLAG_ELITE_FOUR_DEFEATED_TERPSIKORE)
    delay(10)
    speakername("Terpsikore")
    msgbox(format("I'll never forget the way you move with your Pokémon, {PLAYER}. Please, continue through the next door to continue your challenge!"))
    closemessage
    release
    end
}
text RuinsOfAhiyawa_EliteFour_TerpsikoreLoseText
{
    format("Your Pokémon dance nearly as well as mine!")
}

