mapscripts RuinsOfAhiyawa_E4_Room1_MapScripts {}

script RuinsOfAhiyawa_EliteFour_TryToLeaveRoom
{
    lock
    if(!flag(FLAG_ELITE_FOUR_HIDE_POLYMNIA)) // Polymnia active
    {
        if(!flag(FLAG_ELITE_FOUR_DEFEATED_POLYMNIA))
        {
            msgbox(format("Polymnia must be challenged before moving on!"))
            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
            waitmovement(0)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            waitmovement(0)
            msgbox(format("Continue to the next challenge?"), MSGBOX_YESNO)
            closemessage
            if(var(VAR_RESULT) == FALSE)
            {
                releaseall
                end
            }
            warpcontinuescript(MAP_RUINS_OF_AHIYAWA_E4_ROOM1, 4, 9, RuinsOfAhiyawa_EliteFour_EnterTerpsikoreRoomScript)
        }
    }
    if(!flag(FLAG_ELITE_FOUR_HIDE_TERPSIKORE)) // Terpsikore active
    {
        if(!flag(FLAG_ELITE_FOUR_DEFEATED_TERPSIKORE))
        {
            msgbox(format("Terpsikore must be challenged before moving on!"))
            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
            waitmovement(0)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            waitmovement(0)
            msgbox(format("Continue to the next challenge?"), MSGBOX_YESNO)
            closemessage
            if(var(VAR_RESULT) == FALSE)
            {
                releaseall
                end
            }
            warpcontinuescript(MAP_RUINS_OF_AHIYAWA_E4_ROOM1, 4, 9, RuinsOfAhiyawa_EliteFour_EnterEuterpeRoomScript)
        }
    }
    if(!flag(FLAG_ELITE_FOUR_HIDE_EUTERPE)) // Euterpe active
    {
        if(!flag(FLAG_ELITE_FOUR_DEFEATED_EUTERPE))
        {
            msgbox(format("Euterpe must be challenged before moving on!"))
            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
            waitmovement(0)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            waitmovement(0)
            msgbox(format("Continue to the next challenge?"), MSGBOX_YESNO)
            closemessage
            if(var(VAR_RESULT) == FALSE)
            {
                releaseall
                end
            }
            warpcontinuescript(MAP_RUINS_OF_AHIYAWA_E4_ROOM1, 4, 9, RuinsOfAhiyawa_EliteFour_EnterRhadineRoomScript)
        }
    }
    if(!flag(FLAG_ELITE_FOUR_HIDE_RHADINE)) // Rhadine active
    {
        if(!flag(FLAG_ELITE_FOUR_DEFEATED_RHADINE))
        {
            msgbox(format("Rhadine must be challenged before moving on!"))
            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
            waitmovement(0)
        }
        else
        {
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
            waitmovement(0)
            msgbox(format("Continue to the next challenge?"), MSGBOX_YESNO)
            closemessage
            if(var(VAR_RESULT) == FALSE)
            {
                releaseall
                end
            }
            warpcontinuescript(MAP_RUINS_OF_AHIYAWA_E4_CHAMPIONS_ROOM, 5, 14, RuinsOfAhiyawa_E4_ChampionsRoom_EnterRoom) // warp to champions room
        }
    }
    releaseall
    end
}

script RuinsOfAhiyawa_EliteFour_EnterPolymniaRoomScript
{
    lockall

    // set room up
    // NOTE
    // Objects 1-3: Polymnia
    // Objects 4-6: Terpsikore
    // Objects 7-9: Euterpe
    // Objects 10-12: Rhadine
    clearflag(FLAG_ELITE_FOUR_HIDE_POLYMNIA)
    setflag(FLAG_ELITE_FOUR_HIDE_TERPSIKORE)
    setflag(FLAG_ELITE_FOUR_HIDE_EUTERPE)
    setflag(FLAG_ELITE_FOUR_HIDE_RHADINE)
    addobject(1)
    addobject(2)
    addobject(3)
    removeobject(4)
    removeobject(5)
    removeobject(6)
    removeobject(7)
    removeobject(8)
    removeobject(9)
    removeobject(10)
    removeobject(11)
    removeobject(12)

    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp2)
    fadescreen(FADE_FROM_BLACK)
    waitmovement(0)
    delay(10)
    releaseall
    end
}

script RuinsOfAhiyawa_EliteFour_EventScript_Jumpluff
{
    lock
    faceplayer
    speakername("Jumpluff")
    playmoncry(SPECIES_JUMPLUFF, CRY_MODE_NORMAL)
    msgbox("Chee jee!")
    waitmoncry
    closemessage
    release
    end
}

