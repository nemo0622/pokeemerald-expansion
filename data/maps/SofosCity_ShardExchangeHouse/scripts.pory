mapscripts SofosCity_ShardExchangeHouse_MapScripts {}

script SofosCity_ShardExchangeHouse_EventScript_RedShardMan
{
    lock
    faceplayer
    speakername("Red Shard Man")
    if(!flag(FLAG_SPOKE_TO_RED_SHARD_MAN))
    {
        msgbox(format("You've got a good eye, talking to me instead of my foolish brothers!\p We're all obsessed with collecting different types of {COLOR GREEN}Shards{COLOR DARK_GRAY}. Of course, I collect {COLOR GREEN}Red Shards{COLOR DARK_GRAY}, the coolest of them all! In exchange for shards, I'll give you a random {COLOR GREEN}Evolutionary Item{COLOR DARK_GRAY}.\p For a Red Shard, I'll give you a Fire Stone, a Sun Stone, or a Metal Coat at random."))
        closemessage
        setflag(FLAG_SPOKE_TO_RED_SHARD_MAN)
        delay(10)
    }
    msgbox(format("Have you brought me a Red Shard? I'll give you an Evolutionary Item for it! It'll be a Fire Stone, a Sun Stone, or a Metal Coat, chosen at random."), MSGBOX_YESNO)
    closemessage
    delay(5)
    if(var(VAR_RESULT) == 0) // no
    {
        speakername("Red Shard Man")
        msgbox(format("Ah, off to collect more Shards? Be sure to bring me whatever you find, as long as they're Red Shards!"))
        closemessage
    }
    else
    {
        checkitem(ITEM_RED_SHARD)
        if(var(VAR_RESULT) == 0) // no red shards
        {
            speakername("Red Shard Man")
            msgbox(format("Hey, you can't trick me! You don't have any Red Shards!"))
            closemessage
        }
        else
        {
            speakername("Red Shard Man")
            msgbox(format("Great! I'll just take a Red Shard off your hands...\p As promised, here's your Evolutionary Item!"))
            closemessage
            removeitem(ITEM_RED_SHARD)
            delay(10)
            randomelement(ITEM_FIRE_STONE, ITEM_SUN_STONE, ITEM_METAL_COAT)
            giveitem(VAR_RESULT)
        }
    }
}

