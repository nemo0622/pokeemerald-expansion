script KaptaraIsland_EventScript_YoungsterNeedsMoonStone
{
    lock
    faceplayer
    speakername("Youngster")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_MOON_STONE_YOUNGSTER)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Wigglytuff might not look that strong, but it can pack a serious punch. My friends will be so jealous!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_MOON_STONE_YOUNGSTER)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("I'm digging around here for a Moon Stone. My only Pokémon is a Jigglypuff, and all my friends say it looks weak... I thought its evolution might look stronger!\p Hey, you're a traveler, right? Could you bring me a {COLOR GREEN}Moon Stone{COLOR DARK_GRAY}?"))
        closemessage
        delay(20)
        startquest(QUEST_MOON_STONE_YOUNGSTER)
    }
    else
    {
        msgbox(format("It's you! Did you find a Moon Stone?"))
        closemessage

        checkitem(ITEM_MOON_STONE)
        delay(30)

        if(var(VAR_RESULT) == TRUE)
        {
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Youngster")
            msgbox(format("Hey, that's it! Let me give it to Jigglypuff... aaaand..."))
            closemessage
            delay(30)
            emote(VAR_LAST_TALKED, EMOTE_QUESTION)
            speakername("Youngster")
            msgbox(format("What? A Wigglytuff? It's just a Jigglypuff but taller!\p Well, maybe my friends will stop making fun of me, now that my Pokémon is taller than them. Here, take this!"))
            closemessage
            delay(5)
            giveitem(ITEM_EXP_CANDY_L)
            closemessage
            delay(20)
            completequest(QUEST_MOON_STONE_YOUNGSTER)
        }
        else
        {
            speakername("Youngster")
            msgbox(format("Aw, you don't have a Moon Stone. Please, I need to evolve my Jigglypuff!\p Bring me a {COLOR GREEN}Moon Stone{COLOR DARK_GRAY}, and I'll give you something I found in these ruins!"))
            closemessage
        }
    }
    release
    end
}

script KaptaraIsland_EventScript_BraviaryHisui
{
    lock
    faceplayer
    speakername("Braviary")
    playmoncry(SPECIES_BRAVIARY_HISUIAN, CRY_MODE_NORMAL)
    msgbox("Kraww!")
    waitmoncry
    closemessage
    release
    end
}

script KaptaraIsland_EventScript_BirdKeeperWithFly
{
    lock
    faceplayer
    speakername("Fly Guy")
    
    if(flag(FLAG_RECEIVED_HM_FLY)) // already got Fly
    {
        msgbox(format("Are you enjoying Flying around the region? Of course, you'll need the 7th Gym Badge to use it, but it's one of the most helpful tools I've got!"))
        closemessage
        release
        end
    }
    else
    {
        emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
        msgbox(format("Hey, someone found me! I'm the {COLOR GREEN}Fly Guy{COLOR DARK_GRAY} of Ilios - I give people the {COLOR GREEN}Fly HM{COLOR DARK_GRAY}!\p Oh, but first, you'll have to earn it. Are you ready for a battle?"), MSGBOX_YESNO)
        closemessage
        delay(5)
        if(var(VAR_RESULT) == FALSE)
        {
            speakername("Fly Guy")
            msgbox(format("Ehehe, need some time first, hm? Come back when you're ready for a fight. I'll give you the {COLOR GREEN}Fly HM{COLOR DARK_GRAY} as a reward!"))
            closemessage
            release
            end
        }
        else
        {
            trainerbattle_no_intro(TRAINER_KAPTARAISLAND_FLYGUY, KaptaraIsland_Text_FlyGuyDefeat)

            delay(5)
            speakername("Fly Guy")
            msgbox(format("Ehehe, you clipped my wings and brought me down! You've earned this."))
            closemessage
            delay(5)
            giveitem(ITEM_HM_FLY)
            setflag(FLAG_RECEIVED_HM_FLY)
            closemessage
            delay(5)
            speakername("Fly Guy")
            msgbox(format("After you've earned the {COLOR GREEN}Palati City Gym Badge{COLOR DARK_GRAY}, you can use Fly to travel around the Ilios Region. Neat, huh?"))
            closemessage
        }
    }
    release
    end
}

text KaptaraIsland_Text_FlyGuyDefeat
{
    format("Woah, you blew me away!")
}

