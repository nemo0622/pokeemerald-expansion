mapscripts KaptaraIsland_East_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_CHIMERA_WEATHER_ACTIVE))
        {
            setweather(WEATHER_ABNORMAL)
        }
        else
        {
            random(2)
            switch (var(VAR_RESULT)) {
                case 0: setweather(WEATHER_RAIN)
                case 1: setweather(WEATHER_SUNNY)
            }
        }
        
    }
}

script KaptaraIsland_EventScript_Trainer_KaptaraIsland_Yesui
{
    trainerbattle_single(TRAINER_KAPTARAISLAND_YESUI, KaptaraIsland_Text_Trainer_KaptaraIsland_YesuiIntro, KaptaraIsland_Text_Trainer_KaptaraIsland_YesuiDefeat)
    speakername("Yesui")
    msgbox(format("There used to be wild Litleo and Pyroar all over the Ilios Region, but most were hunted down centuries ago. There are only a few pockets of them left in the wild."))
    closemessage
    release
    end
}
text KaptaraIsland_Text_Trainer_KaptaraIsland_YesuiIntro
{
    format("Go, my shining lions!")
}
text KaptaraIsland_Text_Trainer_KaptaraIsland_YesuiDefeat
{
    format("How could they lose?!")
}

script KaptaraIsland_EventScript_RuinManiac
{
    lock
    faceplayer
    speakername("Ruin Maniac")
    msgbox(format("There are broken fragments of an ancient civilization's buildings all over this side of the island. It seems like the whole island was once covered in palaces, like those remaining in Palati City. I wonder what happened to them..."))
    closemessage
    release
    end
}

