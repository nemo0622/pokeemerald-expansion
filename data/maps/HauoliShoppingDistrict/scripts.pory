script HauoliShoppingDistrict_NPC_IlimaBattle
{
	lock
	faceplayer
	setspeaker("Ilima")
	createfieldmugshot(MUGSHOT_ILIMA)
	msgbox(format("Greetings! I'm itching to see your skills in a proper battle, you know."))
	waitmessage
	removefieldmugshot
	setspeaker("Ilima")
	msgbox(format("I assume you're ready to battle me?"), MSGBOX_YESNO)
	closemessage

	if(var(VAR_RESULT) == TRUE) // Battle!
	{
		setspeaker("Ilima")
		createfieldmugshot(MUGSHOT_ILIMA)
		msgbox(format("Behold the magnificent Pokémon of the one and only Captain Ilima!"))
		closemessage

		trainerbattle_no_intro(TRAINER_CAPTAIN_ILIMA_HAUOLI, format("Yes! You have emerged victorious!"))

		delay(10)
		setspeaker("Ilima")
		createfieldmugshot(MUGSHOT_ILIMA)
		msgbox(format("You - or should I say, you and your Pokémon - make quite the interesting team!\pI do hope you'll come to {COLOR GREEN}Verdant Cavern{COLOR DARK_GRAY} and attempt the first trial of the Island Challenge - the Trial of Ilima!\p You can find Verdant Cavern north of Route 2."))
		closemessage

		getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
		switch(var(VAR_TEMP_1))
		{
			case 48:
				applymovement(24, moves(walk_up, walk_left, face_up, step_end))
			default:
				applymovement(24, moves(walk_left, walk_up, step_end))
		}
		waitmovement(0)
		applymovement(24, moves(walk_up * 6, step_end))
		delay(30)
		fadescreenswapbuffers(FADE_TO_BLACK)
		delay(30)
		setflag(FLAG_HIDE_ILIMA_HAUOLI)
		removeobject(24)
		delay(30)
		fadescreenswapbuffers(FADE_FROM_BLACK)
		delay(20)

		startsubquest(QUEST_TRIAL_ILIMA, QUEST_TRIAL_ILIMA_SUBQUEST_3)
		closemessage
		releaseall

	}
	else
	{
		setspeaker("Ilima")
		createfieldmugshot(MUGSHOT_ILIMA)
		msgbox(format("Well then! I'll wait until you are ready to take me on."))
		closemessage
		releaseall
		end
	}
	end
}

script HauoliShoppingDistrict_NPC_Fisherman
{
	lock
	faceplayer
	setspeaker("Fisherman")
	if(flag(FLAG_RECEIVED_OLD_ROD))
	{
		msgbox(format("Howzit, little Trainer!\pYou here to learn more about Fishing?"), MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT) == FALSE)
		{
			setspeaker("Fisherman")
			msgbox(format("Hah! I'm sure you're an expert already!"))
			closemessage
		}
		else
		{
			setspeaker("Fisherman")
			msgbox(format("Gotcha! When you're fishing, you'll have to fight to reel the Pokémon in. You'll have to keep the Pokémon in the {COLOR GREEN}green bar{COLOR DARK_GRAY} to bring it in!\pSome Pokémon with certain abilities can help you fish. You might even find some treasure, if you're skilled enough to reel that in too!"))
			closemessage
		}
	}
	else
	{
		msgbox(format("Howzit, little Trainer!\pYou look like someone who'd enjoy a good sport, yeah? If you can beat me in a battle, I'll give you something to {COLOR GREEN}catch your own{COLOR DARK_GRAY}!\pSo? Ready to battle?"), MSGBOX_YESNO)
		closemessage
		if(var(VAR_RESULT) == FALSE)
		{
			setspeaker("Fisherman")
			msgbox(format("Mmm, that's okay. Come on back when you're ready to learn the art of Fishing!"))
			closemessage
		}
		else
		{
			setspeaker("Fisherman")
			msgbox(format("Awrite! My fish Pokémon will wash you away!"))
			closemessage
			trainerbattle_no_intro(TRAINER_FISHERMAN_HAUOLI, format("Woah, you served me up on a platter...!"))

			delay(10)
			setspeaker("Fisherman")
			msgbox(format("Ehehe, not bad at all! You should have this."))
			closemessage
			setflag(FLAG_RECEIVED_OLD_ROD)
			giveitem(ITEM_OLD_ROD)
			delay(10)
			setspeaker("Fisherman")
			msgbox(format("There's only a few Pokémon that'll bite on the {COLOR BLUE}Old Rod{COLOR DARK_GRAY}. If you want an upgrade, you'll need to talk to {COLOR GREEN}Lana{COLOR DARK_GRAY} on Akala Island.\pFishing is a li'l complicated in Alola. If you want to learn about the ins-and-outs, come talk to me!"))
			closemessage
		}
	}
	release
	end
}
script HauoliShoppingDistrict_Pokemon_Chinchou
{
	lock
    faceplayer
    setspeaker("Chinchou")
    playmoncry(SPECIES_CHINCHOU, CRY_MODE_NORMAL)
    msgbox(format("Blub blubble."))
    waitmoncry
    closemessage
    release
    end
}

