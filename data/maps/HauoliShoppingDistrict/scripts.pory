script HauoliShoppingDistrict_NPC_SilkScarfWoman
{
	lock
	faceplayer
	setspeaker("Old Woman")
	if(flag(FLAG_GOT_SILK_SCARF))
	{
		msgbox(format("That item, the Silk Scarf, increases the power of Normal-type moves. I'm sure that's helpful early in your adventure."))
	}
	else
	{
		msgbox(format("Hm? Oh, dearie, your Pokémon could use some fashion. Give one of them this!"))
		closemessage
		giveitem(ITEM_SILK_SCARF)
		setflag(FLAG_GOT_SILK_SCARF)
		setspeaker("Old Woman")
		msgbox(format("The Silk Scarf increases the power of Normal-type moves. I'm sure that's helpful early in your adventure."))
	}
	closemessage
	release
	end
}

