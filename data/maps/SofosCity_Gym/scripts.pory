mapscripts SofosCity_Gym_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_SOFOS_GYM_GAUNTLET_ACTIVE)
    }
}

script SofosCity_Gym_EventScript_GymStatue
{
    lock
    if(flag(FLAG_BADGE04_GET))
    {
        msgbox(format("Sofos City Pokémon Gym\p Recent Victors: Rania, {PLAYER}"))
    }
    else
    {
        msgbox(format("Sofos City Pokémon Gym\p Recent Victors: Rania"))
    }
    closemessage
    release
    end
}

script SofosCity_Gym_EventScript_GymMan
{
    lock
    faceplayer
    speakername("Gym Guide")
    if(flag(FLAG_BADGE04_GET))
    {
        msgbox(format("Incredible! You're a rising star! Keep it up, future Champ!"))
    }
    else
    {
        msgbox(format("Welcome to the Sofos City Gym!\p Terpsikore, the Gym Leader, is the Muse of Dance and Chorus. She loves all things related to order and harmony, including organized battle and science. Of course, this means she specializes in both Psychic and Fighting-type Pokémon."))
    }
    closemessage
    release
    end
}

script SofosCity_Gym_Trigger_GauntletWarning
{
    lockall
    applymovement(1, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(15)
    applymovement(1, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)

    // if currently in gauntlet, ask if they want to leave
    if(flag(FLAG_SOFOS_GYM_GAUNTLET_ACTIVE))
    {
        speakername("Gym Guide")
        msgbox(format("Wait there, challenger! If you leave before completing the Trainer Gauntlet, {COLOR RED}all Trainer progress will reset{COLOR DARK_GRAY}. Do you still want to leave?"), MSGBOX_YESNO)
        closemessage
        delay(5)
        if(var(VAR_RESULT) == 0) // stay
        {
            speakername("Gym Guide")
            msgbox(format("Phew! Please step up and continue the challenge."))
            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
            waitmovement(0)
            delay(10)
            setflag(FLAG_SOFOS_GYM_GAUNTLET_ACTIVE)
            releaseall
            end
        }
        else // leave
        {
            speakername("Gym Guide")
            msgbox(format("That's too bad. Please come back soon, with a new strategy to win!"))
            closemessage
            applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
            waitmovement(0)
            delay(10)
            clearflag(FLAG_SOFOS_GYM_GAUNTLET_ACTIVE)
            releaseall
            end
        }
    }

    // by getting here, the Gym Gauntlet must be INACTIVE. Introduce it and ask to let the player enter!
    speakername("Gym Guide")
    msgbox(format("Hold your Ponytas! Before you enter the Gym, I have to let you know the rules.\p This Gym is unique, as it is a {COLOR RED}Trainer Gauntlet{COLOR DARK_GRAY}. Once you enter, you {COLOR RED}cannot leave until all Trainers and the Gym Leader are defeated{COLOR DARK_GRAY}. If you try to leave, {COLOR RED}all Trainers will reset{COLOR DARK_GRAY}.\p Are you prepared for the challenge?"), MSGBOX_YESNO)
    closemessage
    delay(5)
    if(var(VAR_RESULT) == 0) // said no to gauntlet
    {
        speakername("Gym Guide")
        msgbox(format("That's alright, it's certainly an intimidating challenge. {COLOR GREEN}Terpsikore{COLOR DARK_GRAY} says it's the ultimate test of harmony with one's Pokémon!\p Come back when you're ready to face this {COLOR RED}Trainer Gauntlet{COLOR DARK_GRAY}."))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
        waitmovement(0)
        delay(10)
        clearflag(FLAG_SOFOS_GYM_GAUNTLET_ACTIVE)
        releaseall
        end
    }
    else // ready for trainer gauntlet!
    {
        speakername("Gym Guide")
        msgbox(format("Great! Good luck, and remember to heal up with Potions and strategize your moves!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
        waitmovement(0)
        delay(10)
        setflag(FLAG_SOFOS_GYM_GAUNTLET_ACTIVE)

        // RESET ALL TRAINER FLAGS HERE
        cleartrainerflag(TRAINER_SOFOSGYM_BROOKE)
        cleartrainerflag(TRAINER_SOFOSGYM_TYRIEN)
        cleartrainerflag(TRAINER_SOFOSGYM_SAPPHA)
        cleartrainerflag(TRAINER_SOFOSGYM_ARISTO)

        releaseall
        end
    }
    releaseall
    end
}

script SofosCity_Gym_EventScript_PokemonBusyTraining
{
    lock
    msgbox(format("The Pokémon is too busy training to notice you!"))
    closemessage
    release
    end
}
script SofosCity_Gym_EventScript_PokemonBusyLearning
{
