    msgbox(format("The Pokémon is too deep in thought to notice you."))
    closemessage
    release
    end
}

script SofosCity_Gym_EventScript_Mienfoo
{
    lock
    faceplayer
    speakername("Mienfoo")
    playmoncry(SPECIES_MIENFOO, CRY_MODE_NORMAL)
    msgbox("Hiaah!")
    waitmoncry
    closemessage
    msgbox(format("Mienfoo is perfectly balanced on one foot!"))
    closemessage
    release
    end
}

