script SofosCity_Gym_EventScript_Terpsikore
{
    lock
    faceplayer

    // first, check if gauntlet is completed
    if(!flag(0x55E) || !flag(0x55F) || !flag(0x560) || !flag(0x561))
    {
        speakername("Terpsikore")
        msgbox(format("I've been watching, you know! You still have some Trainers left to battle before me.\p After beating the {COLOR GREEN}4 Gym Trainers{COLOR DARK_GRAY}, come here and face me. Your harmony with your Pokémon must be perfect!"))
        closemessage
        release
        end
    }

    if(!flag(FLAG_HARD_MODE))
    {
        goto(SofosCity_Gym_EventScript_Terpsikore_NormalDifficulty)
    }
    else
    {
        goto(SofosCity_Gym_EventScript_Terpsikore_HardDifficulty)
    }
    release
    end
}

script SofosCity_Gym_EventScript_Terpsikore_NormalDifficulty // called when on normal difficulty
{
    trainerbattle_single(TRAINER_LEADER_TERPSIKORE, SofosCity_Gym_Text_TerpsikoreIntro, SofosCity_Gym_Text_TerpsikoreDefeat, SofosCity_Gym_EventScript_Terpsikore_DefeatedScript, NO_MUSIC)
    speakername("Terpsikore")
    msgbox(format("Your harmony with your Pokémon in battle is unmatched! I know you'll go far."))
    closemessage
    release
    end
}
script SofosCity_Gym_EventScript_Terpsikore_HardDifficulty // called when on hard difficulty
{
    trainerbattle_single(TRAINER_LEADER_TERPSIKORE_HARD, SofosCity_Gym_Text_TerpsikoreIntro, SofosCity_Gym_Text_TerpsikoreDefeat, SofosCity_Gym_EventScript_Terpsikore_DefeatedScript, NO_MUSIC)
    speakername("Terpsikore")
    msgbox(format("Your harmony with your Pokémon in battle is unmatched! I know you'll go far."))
    closemessage
    release
    end
}
text SofosCity_Gym_Text_TerpsikoreIntro
{
    format("Oh, it looks like you've completed my Trainer Gauntlet! Only truly impressive Trainers are able to do that and still approach me.\p After seeing your moves in Satyr's Lair, I've been wanting to face you in battle. Let's see if you're all you're cracked up to be!")
}
text SofosCity_Gym_Text_TerpsikoreDefeat
{
    format("Incredible! Your Pokémon danced in perfect sync!")
}
// Script called when you defeat the gym leader!
script SofosCity_Gym_EventScript_Terpsikore_DefeatedScript
{
    setflag(FLAG_SUPPRESS_SPEAKER_NAME) // fixes message bug i think
    message(format("{PLAYER} received the Wisdom Badge from Terpsikore."))
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)

    // Set gym completion flags
    setflag(FLAG_BADGE04_GET)
    // Set all trainers in Gym as defeated
    settrainerflag(TRAINER_SOFOSGYM_BROOKE)
    settrainerflag(TRAINER_SOFOSGYM_TYRIEN)
    settrainerflag(TRAINER_SOFOSGYM_SAPPHA)
    settrainerflag(TRAINER_SOFOSGYM_ARISTO)

    // Explain badge
    speakername("Terpsikore")
    msgbox(format("The Widsom Badge represents your ability to coordinate perfectly with your Pokémon, helping them reach their maximum potential in battle. It also allows you to use the {COLOR GREEN}HM Surf{COLOR DARK_GRAY} outside of battle.\p Right, take this with you!"))
    closemessage

    // Give TM reward and explain, plus end dialogue
    giveitem(ITEM_TM53)
    speakername("Terpsikore")
    msgbox(format("That TM contains the move {COLOR GREEN}Power-Up Punch{COLOR DARK_GRAY}, which boosts the Attack stat while dealing damage. With every attack, your Pokémon will grow louder and stronger!\p You should be able to handle the {COLOR GREEN}Seas of Ilios{COLOR DARK_GRAY} with your Pokémon. Your next badge is {COLOR GREEN}east{COLOR DARK_GRAY}, past Marmaro Island to the sister {COLOR GREEN}island of Myrrini{COLOR DARK_GRAY}."))
    closemessage

    // complete gym quest and begin next one
    delay(20)
    completequest(QUEST_GYM_4)
    delay(20)
    startquest(QUEST_GYM_5)

    // set Niko and Rania state variables if necessary
    setvar(VAR_RANIA_STATE, 7)

    release
    end
}
