script AlolaLeo_InsideSchool_Pokemon_Cosmog
{
	lock
    faceplayer
    setspeaker("Nebbie")
    playmoncry(SPECIES_COSMOG, CRY_MODE_NORMAL)
    msgbox(format("Pew pew!"))
    waitmoncry
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceLeft)
    waitmovement(0)
    release
    end
}

script AlolaLeo_InsideSchool_NPC_Lillie
{
    lock
    setspeaker("Lillie")
    createfieldmugshot(MUGSHOT_LILLIE_HAT, EMOTION_OTHER)
    msgbox(format("{COLOR BLUE}Nebbie{COLOR DARK_GRAY}, you know it's not safe for you to battle!"))
    closemessage
    faceplayer
    setspeaker("Lillie")
    createfieldmugshot(MUGSHOT_LILLIE_HAT, EMOTION_SAD)
    msgbox(format("{COLOR BLUE}Nebbie{COLOR DARK_GRAY} is a {COLOR BLUE}Cosmog{COLOR DARK_GRAY}, so it can only use a few feeble moves in proper battles. Besides, people shouldn't see it for too long..."))
    closemessage
    applymovement(VAR_LAST_TALKED, Common_Movement_FaceRight)
    waitmovement(0)
    release
    end
}

// -------------------------------- Trainer Scripts ------------------------------------

script AlolaLeo_InsideSchool_Trainer_SchoolGirlMia
{
    trainerbattle_single(TRAINER_SCHOOL_GIRL_MIA, 
	format("Go, my secret Berry strategy!"), 
	format("M-my expert strategy...!"))

    setspeaker("School Girl Mia")
    msgbox(format("Lots of Berries grow in Alola. Maybe I'll have a Berry farm when I grow up!"))
    closemessage
    release
    end
}

script AlolaLeo_InsideSchool_Trainer_YoungsterJoey
{
    trainerbattle_single(TRAINER_YOUNGSTER_JOEY, 
	format("I'll show you my Grimer's best move! There's nothing you can do against our Poison Gas!"), 
	format("Hehehe... Poison Gas!"))

    setspeaker("Youngster Joey")
    msgbox(format("Certain Pokémon are immune to some status conditions... Is that how you got through Grimer's gas?"))
    closemessage
    release
    end
}
