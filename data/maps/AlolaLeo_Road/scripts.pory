script AlolaLeo_Road_Trainer_LassHiromi
{
	trainerbattle_single(TRAINER_LASS_HIROMI, 
	format("I'll be the best Trainer at this whole school!"), 
	format("I'll be stronger one day, you'll see!"))

	setspeaker("Lass Hiromi")
	msgbox(format("Our school is pretty small, but we learn a lot about Pokémon!"))
	closemessage
	release
	end
}
