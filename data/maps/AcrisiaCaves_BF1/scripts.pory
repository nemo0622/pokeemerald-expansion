mapscripts AcrisiaCaves_BF1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflashlevel(5)
    }
}

script AcrisiaCaves_BF1_EventScript_GymStatue
{
    lock
    if(flag(FLAG_BADGE02_GET))
    {
        msgbox(format("Acrisia Caves Pokémon Gym\p Recent Victors: Niko, {PLAYER}"))
    }
    else
    {
        msgbox(format("Acrisia Caves Pokémon Gym\p Recent Victors: Niko"))
    }
    closemessage
    release
    end
}

script AcrisiaCaves_BF1_EventScript_Trainer_AcrisiaCaves_BF1_Berkley
{
    trainerbattle_single(TRAINER_ACRISIACAVES_BF1_BERKLEY, AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_BerkleyIntro, AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_BerkleyDefeat)
    speakername("Berkley")
    msgbox(format("I hear fire crackling to the right, could that be where Mattaios is...?"))
    closemessage
    release
    end
}
text AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_BerkleyIntro
{
    format("I want to challenge Mattaios, but I can't find him in this darkness!")
}
text AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_BerkleyDefeat
{
    format("I'll never reach him at this rate!")
}

script AcrisiaCaves_BF1_EventScript_Trainer_AcrisiaCaves_BF1_Margarey
{
    trainerbattle_single(TRAINER_ACRISIACAVES_BF1_MARGAREY, AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_MargareyIntro, AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_MargareyDefeat)
    speakername("Margarey")
    msgbox(format("This Gym is unique, because... well, it's not really a Gym at all! Mattaios spends all his time digging down here."))
    closemessage
    release
    end
}
text AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_MargareyIntro
{
    format("My Pokémon can punch through these quartz gems!")
}
text AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_MargareyDefeat
{
    format("I bet yours can too.")
}

script AcrisiaCaves_BF1_EventScript_Trainer_AcrisiaCaves_BF1_Kylon
{
    trainerbattle_single(TRAINER_ACRISIACAVES_BF1_KYLON, AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_KylonIntro, AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_KylonDefeat)
    speakername("Kylon")
    msgbox(format("You'll just weaken Mattaios up, that'll help me win!"))
    closemessage
    release
    end
}
text AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_KylonIntro
{
    format("Nuh uh, Mattaios is gonna fight ME next!")
}
text AcrisiaCaves_BF1_Text_Trainer_AcrisiaCaves_BF1_KylonDefeat
{
    format("Sniffle... this isn't fair!")
}

// ---------------------------------------------------------------------------------

script AcrisiaCaves_BF1_EventScript_Mattaios
{
    lock
    faceplayer
    if(var(VAR_DIFFICULTY) == 0)
    {
        goto(AcrisiaCaves_BF1_EventScript_MattaiosNormal)
    }
    else
    {
        goto(AcrisiaCaves_BF1_EventScript_MattaiosHard)
    }
    release
    end
}

script AcrisiaCaves_BF1_EventScript_MattaiosNormal
{
    trainerbattle_single(TRAINER_LEADER_MATTAIOS, AcrisiaCaves_BF1_Text_MattaiosIntro, AcrisiaCaves_BF1_Text_MattaiosDefeat, AcrisiaCaves_BF1_EventScript_MattaiosDefeatScript, NO_MUSIC)
    speakername("Mattaios")
    msgbox(format("Now that our battle's over, I should get back to work. Expandin' the caves and looking fer gems never stops fer me."))
    closemessage
    release
    end
}
script AcrisiaCaves_BF1_EventScript_MattaiosHard
{
    trainerbattle_single(TRAINER_LEADER_MATTAIOS_HARD, AcrisiaCaves_BF1_Text_MattaiosIntro, AcrisiaCaves_BF1_Text_MattaiosDefeat, AcrisiaCaves_BF1_EventScript_MattaiosDefeatScript, NO_MUSIC)
    speakername("Mattaios")
    msgbox(format("Now that our battle's over, I should get back to work. Expandin' the caves and looking fer gems never stops fer me."))
    closemessage
    release
    end
}

text AcrisiaCaves_BF1_Text_MattaiosIntro
{
    format("Found yer way down here, eh?\p Most Gym Leaders have their fancy buildings, with their fancy lights and walls. Not me. I dig away down here, always diggin', always in the dark...\p Well, this'll be my break. C'mon!")
}
text AcrisiaCaves_BF1_Text_MattaiosDefeat
{
    format("Yer stronger than me, even after all this diggin'!")
}

script AcrisiaCaves_BF1_EventScript_MattaiosDefeatScript
{
    setflag(FLAG_SUPPRESS_SPEAKER_NAME) // fixes message bug
    message(format("{PLAYER} received the Gemstone Badge from Mattaios."))
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)

    // Set gym completion flags
    setflag(FLAG_BADGE02_GET)
    // Set all trainers in Gym as defeated
    settrainerflag(TRAINER_ACRISIACAVES_F1_UMBER)
    settrainerflag(TRAINER_ACRISIACAVES_BF1_BERKLEY)
    settrainerflag(TRAINER_ACRISIACAVES_BF1_MARGAREY)
    settrainerflag(TRAINER_ACRISIACAVES_BF1_KYLON)

    // Explain badge
    speakername("Mattaios")
    msgbox(format("The Gemstone Badge marks yer second completed Gym, eh? After two Badges, most trainers are fit to explore more of Ilios. Yer certainly strong enough! You'll also be able to use the {COLOR GREEN}HM Rock Smash{COLOR DARK_GRAY} outside battle.\p Fwahaha, there's more fer ya!"))
    closemessage

    // Give TM, explain, end dialogue
    giveitem(ITEM_TM_ROCK_TOMB)
    speakername("Mattaios")
    msgbox(format("That's the TM fer {COLOR GREEN}Rock Tomb{COLOR DARK_GRAY}! My Larvitar here learned this after gettin' rocks dropped on us one-too many times, fwahaha!\p Y'know, another Acrisia University student just passed through here. If I were you, I'd hightail it {COLOR GREEN}back to the University{COLOR DARK_GRAY} to see what's what!"))
    closemessage

    release
    end
}

script AcrisiaCaves_BF1_EventScript_Larvitar
{
    lock
    faceplayer
    speakername("Larvitar")
    playmoncry(SPECIES_LARVITAR, CRY_MODE_NORMAL)
    msgbox("Gwaah.")
    waitmoncry
    closemessage
    msgbox(format("Larvitar is happy to take a break."))
    closemessage
    release
    end
}
