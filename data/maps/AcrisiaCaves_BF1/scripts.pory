mapscripts AcrisiaCaves_BF1_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(3, ENCOUNTER_LAND)
        setobjectaswildencounter(4, ENCOUNTER_LAND)
    }
}

script AcrisiaPeak_EventScript_TryEvent
{
    setvar(VAR_TEMP_1, 1)
    if(flag(FLAG_RECEIVED_BIKE)) // if Espathra gotten, just default to wandering Elder
    {
        setobjectmovementtype(1, MOVEMENT_TYPE_WANDER_AROUND)
        releaseall
        end
    }
    else
    {
        goto(AcrisiaPeak_EventScript_GiveEspathraEvent)
    }
    releaseall
    end
}

script AcrisiaPeak_EventScript_GiveEspathraEvent
{
    lockall
    delay(20)
    applymovement(2, AcrisiaPeak_Movement_EspathraRunsAround)
    // applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
    waitmovement(2)
    delay(20)

    speakername("Elder")
    msgbox(format("Hush now, Espathra, great protector of the mountain! A Trainer will come soon to quell your thirst for adventure."))
    closemessage
    delay(30)
    applymovement(1, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(1, Common_Movement_FaceUp)
    waitmovement(0)

    speakername("Elder")
    msgbox(format("Oho, and what do we have here? See, Espathra, it's just as I said. Come forth, young Trainer."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
    applymovement(1, Common_Movement_WalkUp)
    applymovement(2, AcrisiaPeak_Movement_EspathraGreetsPlayer)
    waitmovement(2)

    speakername("Elder")
    msgbox(format("This Pokémon is special among its kind. It has lived among the mountains here since I was a child, refusing to enter a Poké ball and trusting few. Many have called it a threat, spreading rumors about a monster in the mountain, but it is wise in ways we can't comprehend."))
    closemessage
    applymovement(1, Common_Movement_WalkLeft)
    waitmovement(0)
    applymovement(1, Common_Movement_FaceUp)
    waitmovement(0)
    delay(20)
    speakername("Elder")
    msgbox(format("Great Espathra, is this the Trainer you wish to join?"))
    closemessage
    applymovement(2, AcrisiaPeak_Movement_EspathraJumpInAgreement)
    waitmovement(0)
    delay(10)
    speakername("Elder")
    msgbox(format("Fwahaha, okay, okay! You are free to join them and see the world. Be well, Espathra."))
    closemessage
    applymovement(1, Common_Movement_WalkRight)
    waitmovement(0)
    applymovement(1, Common_Movement_FaceUp)
    waitmovement(0)

    speakername("Elder")
    msgbox(format("As I said, Espathra does not live in a Poké ball. This means it {COLOR GREEN}cannot be used in battle{COLOR DARK_GRAY}. Instead, it can be called at any time to be {COLOR GREEN}ridden across the Ilios Region{COLOR DARK_GRAY} as a loyal mount!\p Take this {COLOR GREEN}Whistle{COLOR DARK_GRAY}. You can use it to summon Espathra from anywhere in Ilios."))
    closemessage
    giveitem(ITEM_ESPATHRA_WHISTLE)
    speakername("Elder")
    msgbox(format("Thank you, young Trainer. You're welcome to come visit me and my sanctuary again."))
    closemessage

    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    removeobject(2)
    setflag(FLAG_RECEIVED_BIKE)
    setobjectmovementtype(1, MOVEMENT_TYPE_WANDER_AROUND)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(30)
    releaseall
    end
}
movement AcrisiaPeak_Movement_EspathraRunsAround
{
    walk_fast_left
    walk_fast_up * 2
    walk_fast_right * 2
    walk_fast_down * 2
    walk_fast_left
    jump_in_place_up * 2
    step_end
}
movement AcrisiaPeak_Movement_EspathraGreetsPlayer
{
    walk_fast_left
    walk_fast_up * 3
    face_right
    jump_in_place_right * 2
    step_end
}
movement AcrisiaPeak_Movement_EspathraJumpInAgreement
{
    jump_in_place_down * 2
    face_right
    step_end
}

script AcrisiaPeak_EventScript_Espathra
{
    lock
    faceplayer
    speakername("Espathra")
    playmoncry(SPECIES_ESPATHRA, CRY_MODE_NORMAL)
    msgbox("Craah! Haaahh!")
    waitmoncry
    closemessage
    msgbox(format("Espathra seems raring to go!"))
    closemessage
    release
    end
}

script AcrisiaPeak_EventScript_Elder
{
    lock
    faceplayer
    speakername("Elder")
    msgbox(format("How is the great Espathra doing under your care? It may not battle for you on your quest for Gym Badges, but I hope it is helping in whatever way it can."))
    closemessage
    release
    end
}
