script KiposTown_Zoo_North_NPC_PaleoGirl
{
    lock
    faceplayer
    speakername("Battle Girl")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_FILL_LAZARUS_ZOO)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_09_1)
        msgbox(format("I'm so obsessed with the {STR_VAR_1} you donated! It's a real living fossil!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_FILL_LAZARUS_ZOO)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("I can't believe Team Chimera even stole the Lazarus Taxa Pokémon. They're already so new and rare... how could they do something so cold?\p Oh, I recognize you. You're donating Pokémon to the Zoo, right? If you can, you should get a {COLOR GREEN}Lazarus Taxa Pokémon{COLOR DARK_GRAY} back into this enclosure! I'd love to see a real {COLOR GREEN}living fossil{COLOR DARK_GRAY}!"))
        closemessage

        delay(20)
        startquest(QUEST_FILL_LAZARUS_ZOO)
    }
    else
    {
        msgbox(format("Hiya! Oh, did you donate a Lazarus Taxa Pokémon?"))
        closemessage
        applymovement(24, Common_Movement_FaceLeft)
        waitmovement(0)

        delay(30)
        if(var(VAR_ZOO_POKEMON_ENCLOSURE_09_1) > 0)
        {
            applymovement(24, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(10)
            bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_09_1)
            speakername("Battle Girl")
            msgbox(format("Woah, no way! It's a real {STR_VAR_1}! I never thought I'd actually get to see one!"))
            closemessage
            applymovement(24, Common_Movement_FacePlayer)
            waitmovement(0)
            speakername("Battle Girl")
            msgbox(format("Think of all the battles it could win, all the new strategies around it... I'm totally blown away!\p Here, take this as my thanks."))
            closemessage
            delay(5)
            giveitem(ITEM_EXP_CANDY_L)
            closemessage

            delay(20)
            completequest(QUEST_FILL_LAZARUS_ZOO)
        }
        else
        {
            applymovement(24, Common_Movement_FacePlayer)
            waitmovement(0)
            speakername("Battle Girl")
            msgbox(format("No, I still don't see anything. Let me know when you donate a {COLOR GREEN}Lazarus Taxa{COLOR DARK_GRAY} Pokémon to this area. Remember, those are {COLOR GREEN}living fossil{COLOR DARK_GRAY} Pokémon!"))
            closemessage
        }
    }
    release
    end
}

