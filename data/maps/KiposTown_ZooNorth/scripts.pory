script KiposTown_Zoo_EnvironmentSign_Mountains
{
    lock
    msgbox(format("Enclosure No. 10: {COLOR GREEN}Mountains{COLOR DARK_GRAY}\p Mountains are often remote, rocky, and rugged, pushing Pokémon to adapt if they're going to survive. Sadly, these once-peaceful landscapes are threatened by mining and resource extraction, tearing up the mountain homes of countless Pokémon species.\p {COLOR GREEN}Rock, Steel, and Fighting-type{COLOR DARK_GRAY} Pokémon seek out mountainous locations. In general, Pokémon with {COLOR GREEN}rugged natures{COLOR DARK_GRAY} can also be found in these spaces."))
    closemessage
    release
    end
}

