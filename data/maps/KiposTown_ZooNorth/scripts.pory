mapscripts KiposTown_ZooNorth_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(UpdateZooGraphics_North)
    }
}

// -------------------------------------------------------------------------------------------------------
//                                      POKEMON INFO SIGN SCRIPTS
// -------------------------------------------------------------------------------------------------------

// -------------------------------------- ENCLOSURE 07: Beach ---------------------------------------------------
script KiposTown_Zoo_PokemonSign_Beach
{
    lock

    // buffer species names for initial sign info
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_07_1)
    bufferspeciesname(STR_VAR_2, VAR_ZOO_POKEMON_ENCLOSURE_07_2)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_07_1) == 0) // no Pokémon in slot 1
    {
        bufferstring(STR_VAR_1, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_07_2) == 0) // no Pokémon in slot 2
    {
        bufferstring(STR_VAR_2, "---")
    }

    // ------------ BASIC ENCLOSURE INFO CODE ------------
    msgbox(format("Enclosure No. 7: Beach\n Pokémon in Exhibit: {STR_VAR_1}, {STR_VAR_2}"))
    closemessage

    // ------------ DISPLAY MORE INFO CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_07_1) > 0) // AT LEAST ONE Pokémon in enclosure
    {
        // Offer reading Pokédex entries
        msgbox(format("There's information about each Pokémon listed. Read it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 1) // said yes to more information
        {
            copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_07_1) // loads species into VAR_0x8003
            special(ShowSpeciesZooInfoWindow)
            delay(30)
            waitbuttonpress
            special(CloseSpeciesZooInfoWindow)

            if(var(VAR_ZOO_POKEMON_ENCLOSURE_07_2) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_07_2) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
        }
    }

    // ------------ OFFER DONATIONS CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_07_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 16) // Enclosure #07, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_07_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_07_2) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 17) // Enclosure #07, Pokémon 2 - VAR_ZOO_POKEMON_ENCLOSURE_07_2

        msgbox(format("There is room for a second Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Beach
{
    lock
    msgbox(format("Enclosure No. 7: {COLOR GREEN}Beach{COLOR DARK_GRAY}\p Both terrestrial and water-dwelling Pokémon make their homes on beaches, where water meets the land. From burrowing in the sand to splashing in the waves, a variety of lifestyles are supported by this environment.\p A range of {COLOR GREEN}Water and Flying-type{COLOR DARK_GRAY} Pokémon make their homes here, often being {COLOR GREEN}semi-aquatic{COLOR DARK_GRAY} in nature."))
    closemessage
    release
    end
}

