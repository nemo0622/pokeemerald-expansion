script KiposTown_Zoo_EnvironmentSign_Desert
{
    lock
    msgbox(format("Enclosure No. 8: {COLOR GREEN}Desert{COLOR DARK_GRAY}\p Arid and dotted with rocks, desert environments provide difficult ways of life for Pokémon species living there. Despite the lack of water and little plant growth besides shrubs, vibrant ecosystems can still develop in the harsh conditions.\p Naturally, {COLOR GREEN}Ground and Rock-type{COLOR DARK_GRAY} Pokémon thrive in the dry, stony conditions. Species which prefer {COLOR GREEN}wide, open ranges{COLOR DARK_GRAY} or {COLOR GREEN}direct sunlight{COLOR DARK_GRAY} may also be found in desert habitats."))
    closemessage
    release
    end
}

