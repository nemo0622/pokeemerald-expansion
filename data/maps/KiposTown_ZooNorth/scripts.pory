script KiposTown_Zoo_EnvironmentSign_LazarusTaxa
{
    lock
    msgbox(format("Enclosure No. 9: {COLOR GREEN}Lazarus Taxa{COLOR DARK_GRAY}\p This exhibit has been created to house species which have been recently rediscovered, as a part of the {COLOR GREEN}Lazarus Taxa phenomenon{COLOR DARK_GRAY} sweeping across the Ilios Region. These Pokémon are extremely rare, being thought long-extinct.\p Lazarus Taxa include Pokémon once known from {COLOR GREEN}fossils{COLOR DARK_GRAY}, which have been discovered living in many environments around Ilios."))
    closemessage
    release
    end
}

