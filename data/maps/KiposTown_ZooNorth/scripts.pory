    if(var(VAR_ZOO_POKEMON_ENCLOSURE_13_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 28) // Enclosure #13, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_13_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_13_2) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 29) // Enclosure #13, Pokémon 2 - VAR_ZOO_POKEMON_ENCLOSURE_13_2

        msgbox(format("There is room for a second Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Ruins
{
    lock
    msgbox(format("Enclosure No. 13: {COLOR GREEN}Ruins{COLOR DARK_GRAY}\p Ruins and cemeteries are often left behind long after the creators leave an area, developing a unique ecosystem of Pokémon around them. For one reason or another, certain species of Pokémon are drawn to these locations, haunting the remains of graves or crumbling towers.\p Pokémon with {COLOR GREEN}spiritual energy{COLOR DARK_GRAY} tend to be found near old graves, such as {COLOR GREEN}Ghost, Dark, and Psychic-type{COLOR DARK_GRAY} species."))
    closemessage
    release
    end
}

// -------------------------------------- ENCLOSURE 14: Shallows ---------------------------------------------------
script KiposTown_Zoo_PokemonSign_Shallows
{
    lock

    // buffer species names for initial sign info
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_14_1)
    bufferspeciesname(STR_VAR_2, VAR_ZOO_POKEMON_ENCLOSURE_14_2)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_14_1) == 0) // no Pokémon in slot 1
    {
        bufferstring(STR_VAR_1, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_14_2) == 0) // no Pokémon in slot 2
    {
        bufferstring(STR_VAR_2, "---")
    }

    // ------------ BASIC ENCLOSURE INFO CODE ------------
    msgbox(format("Enclosure No. 14: Shallows\n Pokémon in Exhibit: {STR_VAR_1}, {STR_VAR_2}"))
    closemessage

    // ------------ DISPLAY MORE INFO CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_14_1) > 0) // AT LEAST ONE Pokémon in enclosure
    {
        // Offer reading Pokédex entries
        msgbox(format("There's information about each Pokémon listed. Read it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 1) // said yes to more information
        {
            copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_14_1) // loads species into VAR_0x8003
            special(ShowSpeciesZooInfoWindow)
            delay(30)
            waitbuttonpress
            special(CloseSpeciesZooInfoWindow)

            if(var(VAR_ZOO_POKEMON_ENCLOSURE_14_2) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_14_2) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
        }
    }

    // ------------ OFFER DONATIONS CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_14_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 30) // Enclosure #13, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_14_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_14_2) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 31) // Enclosure #13, Pokémon 2 - VAR_ZOO_POKEMON_ENCLOSURE_14_2

        msgbox(format("There is room for a second Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Shallows
{
    lock
    msgbox(format("Enclosure No. 14: {COLOR GREEN}Shallows{COLOR DARK_GRAY}\p Thanks to easy access to sunlight, coastal shallows are blooming with plant and Pokémon life alike. Coral reefs supporting countless species further enhance the local diversity, despite being threatened globally by water pollution and warming seas.\p {COLOR GREEN}Water-type{COLOR DARK_GRAY} Pokémon, true to their name, are most commonly found here. Furthermore, many Pokémon associated with {COLOR GREEN}semi-aquatic lifestyles{COLOR DARK_GRAY} can be seen splashing through the waves."))
    closemessage
    release
    end
}

