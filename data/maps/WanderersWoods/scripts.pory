mapscripts WanderersWoods_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(22, ENCOUNTER_LAND)
        setobjectaswildencounter(23, ENCOUNTER_LAND)
        setobjectaswildencounter(24, ENCOUNTER_LAND)
        setobjectaswildencounter(25, ENCOUNTER_LAND)
        setobjectaswildencounter(26, ENCOUNTER_LAND)
        setobjectaswildencounter(27, ENCOUNTER_LAND)
        setobjectaswildencounter(28, ENCOUNTER_LAND)
    }
}

script WanderersWoods_EventScript_DirectionSign
{
    lock
    msgbox(format("Wanderers' Woods - North\n A Trail of Loss and Discovery\p {UP_ARROW} Jusmail Town\n Pythios Town {DOWN_ARROW}"))
    closemessage
    release
    end
}

script WanderersWoods_EventScript_Trainer_WanderersWoods_Zander
{
    trainerbattle_single(TRAINER_WANDERERSWOODS_ZANDER, WanderersWoods_Text_Trainer_WanderersWoods_ZanderIntro, WanderersWoods_Text_Trainer_WanderersWoods_ZanderDefeat)
    speakername("Zander")
    msgbox(format("Apparently people get lost in here all the time. I'm not letting Jusmail Town out of my sight!"))
    closemessage
    release
    end
}
text WanderersWoods_Text_Trainer_WanderersWoods_ZanderIntro
{
    format("I came here for Toedscool because it's funny, but some of these Pokémon are so scary!")
}
text WanderersWoods_Text_Trainer_WanderersWoods_ZanderDefeat
{
    format("Eek! I thought I saw a Ghost Pokémon!")
}

