script WanderersWoods_EventScript_NPC_Man
{
    lock
    faceplayer
    speakername("Man")
    msgbox(format("These red-orange plants are a sign that we're close to Pythios Town. Nobody quite knows why, but plants around there are stuck in a permanent state of autumn."))
    closemessage
    release
    end
}

script WanderersWoods_EventScript_RaniaNPC
{
    lock
    faceplayer
    speakername("Rania")
    msgbox(format("{PLAYER}! Are you headed south to Pythios Town too?\p Niko and I are recording Pokémon behavior around here. Every area in the Ilios Region is packed with new Pokémon!"))
    closemessage
    release
    end
}

script WanderersWoods_EventScript_NikoNPC
{
    lock
    faceplayer
    speakername("Niko")
    msgbox(format("Chaire, {PLAYER}! Pokémon behavior is so interesting, eh?\p Rania and I are getting some data and training our Pokémon while we're at it! Who knows, we might beat you to Pythios Town!"))
    closemessage
    release
    end
}


// ------------------------------------------------------------------------------------------------------
// ------------------------------------ TEAM CHIMERA EVENT ----------------------------------------------
// ------------------------------------------------------------------------------------------------------

script WanderersWoods_Trigger_ChimeraEvent
{
    lock
    applymovement(6, Common_Movement_WalkDown)
    applymovement(7, Common_Movement_WalkDown)
    waitmovement(0)
    applymovement(7, Common_Movement_WalkRight)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("Headed down to Pythios Town? We'll come with you!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("There are reports of Ghost-type and Psychic-type Pokémon there. Maybe we can record some new species!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, WanderersWoods_Movement_PlayerLeadsToChimera)
    applymovement(6, WanderersWoods_Movement_RaniaFollowsToChimera)
    applymovement(7, WanderersWoods_Movement_NikoFollowsToChimera)
    waitmovement(0)
    goto(WanderersWoods_EventScript_ChimeraEvent)
    end
}

script WanderersWoods_EventScript_ChimeraEvent
{
    // Niko & Rania look down and see Team Chimera
    delay(20)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    applymovement(7, Common_Movement_FaceDown)
    applymovement(6, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(7, Common_Movement_ExclamationMark)
    applymovement(6, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(30)

    // Rania wonders what Team Chimera is doing here
    applymovement(6, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("Those are Team Chimera thugs! Remember, that group who attacked the Pokédex shipment when you get here, {PLAYER}? What are they doing to those poor Pokémon?!"))
    closemessage
    applymovement(6, Common_Movement_FaceDown)
    applymovement(7, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)
    waitmovement(0)

    // Team Chimera grunts approach, shout it's none of our business
    applymovement(8, Common_Movement_WalkUp)
    waitmovement(0)
    delay(15)
    speakername("Chimera Grunt")
    msgbox(format("Argh, nothin' like spectators to ruin a perfectly good plan. Stay out of our business!"))
    closemessage
    delay(15)
    applymovement(9, Common_Movement_WalkUp2)
    waitmovement(0)
    speakername("Chimera Grunt")
    msgbox(format("Yeah, this doesn't concern you! The Boss is lookin' for new Pokémon for-"))
    closemessage
    applymovement(10, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(10, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Chimera Admin")
    msgbox(format("Shut it, Grunt! Do you wanna give away all our plans?!"))
    closemessage
    
    // Pokémon take the chance to run
    applymovement(11, Common_Movement_JumpInPlaceLeft)
    applymovement(12, Common_Movement_JumpInPlaceDown)
    applymovement(13, Common_Movement_JumpInPlaceLeft)
    waitmovement(0)
    delay(20)
    applymovement(10, Common_Movement_ExclamationMark)
    applymovement(8, Common_Movement_FaceDown)
    applymovement(9, Common_Movement_FaceDown)
    applymovement(10, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(11, WanderersWoods_Movement_ShroomishEscape)
    applymovement(12, WanderersWoods_Movement_BlitzleEscape)
    applymovement(13, WanderersWoods_Movement_ImpidimpEscape)
    waitmovement(0)
    delay(60)

    // Niko and Rania agree to battle the other grunts, while you take the middle Admin
    applymovement(8, Common_Movement_FaceUp)
    applymovement(9, Common_Movement_FaceUp)
    applymovement(10, Common_Movement_FaceUp)
    speakername("Chimera Admin")
    msgbox(format("No! Our Pokémon got away! This is your fault... you have to pay! Grunts, let's get 'em!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(6, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("We'll help you fight them, {PLAYER}! These thugs can't get away with treating Pokémon like that!"))
    closemessage
    applymovement(6, Common_Movement_FaceDown)
    applymovement(7, Common_Movement_FaceDown)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceDown)

    // Grunts approach, you battle the admin in the middle
    applymovement(8, Common_Movement_WalkUp)
    applymovement(9, Common_Movement_WalkUp)
    applymovement(10, Common_Movement_WalkUp)
    if(!flag(FLAG_HARD_MODE))
    {
        trainerbattle_no_intro(TRAINER_WANDERERSWOODS_CHIMERA_ADMIN, WanderersWoods_Text_ChimeraAdminDefeated)
    }
    else
    {
        trainerbattle_no_intro(TRAINER_WANDERERSWOODS_CHIMERA_ADMIN_HARD, WanderersWoods_Text_ChimeraAdminDefeated)
    }

    // Grunts scatter, Admin watches in disbelief as Niko and Rania run off after them
    applymovement(10, Common_Movement_QuestionMark)
    waitmovement(0)
    applymovement(10, Common_Movement_FaceLeft)
    waitmovement(0)
    applymovement(8, WanderersWoods_Movement_GruntEscapes1)
    waitmovement(0)
    applymovement(7, Common_Movement_WalkDown)
    waitmovement(0)
    speakername("Niko")
    msgbox(format("Hold it! You're not getting away!"))
    closemessage
    applymovement(7, WanderersWoods_Movement_GruntEscapes1)
    waitmovement(0)
    delay(20)
    applymovement(10, Common_Movement_ExclamationMark)
    waitmovement(0)
    applymovement(10, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(9, WanderersWoods_Movement_GruntEscapes2)
    waitmovement(0)
    applymovement(6, Common_Movement_WalkDown)
    waitmovement(0)
    speakername("Rania")
    msgbox(format("{PLAYER}, you stay here and watch this one. I'm going after them!"))
    closemessage
    applymovement(6, WanderersWoods_Movement_GruntEscapes2)
    waitmovement(0)
    delay(60)

    // Admin speaks to player before running off
    applymovement(10, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Chimera Admin")
    msgbox(format("Grr... you're lucky my Arcanine was knocked out while we caught those Pokémon.\p You learn so much about Pokémon, but you do nothing with it! Pokémon, nature, everything around us - you need to use them for everything they're worth!\p The Pokémon we rounded up were to be trained, bringing out their full potential. Of course, some Pokémon can't handle the pressure, so we sell them for a little extra cash. What's the harm in that?\p You won't stop Team Chimera. Next time, my Arcanine will knock you back to your precious University!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    applymovement(10, WanderersWoods_Movement_AdminEscapes)
    waitmovement(0)
    delay(20)

    // Player hears a shout, choose if it was Niko or Rania (determines random Pokémon pool)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
    waitmovement(0)
    speakername("???")
    msgbox(format("Woah, what's this?!"))
    closemessage
    delay(30)
    message(format("Who shouted in the distance?"))
    waitmessage
    multichoice(21, 8, MULTI_NIKO_OR_RANIA, TRUE) // VAR_RESULT: 0 = Niko, 1 = Rania
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(20)
    addobject(7)
    applymovement(7, WanderersWoods_Movement_NikoReturns)
    waitmovement(0)
    addobject(6)
    applymovement(6, WanderersWoods_Movement_RaniaReturns)
    waitmovement(0)
    delay(10)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(30)

    // Niko/Rania talks to player, gives rare egg
    if(var(VAR_RESULT) == 0) // niko egg (random electric, steel, or dark type)
    {
        applymovement(7, Common_Movement_FaceRight)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
        waitmovement(0)
        speakername("Niko")
        msgbox(format("Team Chimera got away from us, but look what one of them dropped! It's a {COLOR GREEN}Pokémon Egg like I've never seen before{COLOR DARK_GRAY}! Maybe it holds a rare Pokémon.\p {PLAYER}, I want you to have it. Pokémon Eggs aren't my specialty."))
        closemessage
        // generate random egg species and give
        setflag(FLAG_FORCE_SHINY) // trying my best to force a shiny egg
        setflag(FLAG_SHINY_CREATION)
        randomelement(SPECIES_MAREEP, SPECIES_BLITZLE, SPECIES_PACHIRISU, SPECIES_ELECTRIKE, SPECIES_PAWMI, SPECIES_WATTREL, SPECIES_PICHU, SPECIES_TOGEDEMARU, SPECIES_DEDENNE, SPECIES_CHINCHOU, SPECIES_HELIOPTILE, SPECIES_VOLTORB, SPECIES_VOLTORB_HISUI, SPECIES_MAGNEMITE, SPECIES_SANDSHREW_ALOLAN, SPECIES_MAWILE, SPECIES_ARON, SPECIES_HONEDGE, SPECIES_BRONZOR, SPECIES_CUFANT, SPECIES_MEOWTH_GALAR, SPECIES_TINKATINK, SPECIES_GRIMER_ALOLAN, SPECIES_MURKROW, SPECIES_VULLABY, SPECIES_SANDILE, SPECIES_HOUNDOUR, SPECIES_ZORUA, SPECIES_MEOWTH_ALOLAN, SPECIES_STUNKY, SPECIES_EKANS, SPECIES_SCRAGGY, SPECIES_IMPIDIMP, SPECIES_ZIGZAGOON_GALAR)
        giveegg(VAR_RESULT)
        playfanfare(MUS_OBTAIN_ITEM)
        message(format("{PLAYER} received a {COLOR GREEN}Rare Egg{COLOR DARK_GRAY}!"))
        waitmessage
        waitfanfare
        delay(20)
        clearflag(FLAG_FORCE_SHINY)
        clearflag(FLAG_SHINY_CREATION)
        speakername("Niko")
        msgbox(format("Carry that Egg around until it hatches. Who knows, maybe it's a new species of Pokémon!\p Rania and I are gonna head back to the University for a while. Let us know if Pythios Town is worth a visit!"))
        closemessage
    }
    else // rania egg (random water, fire, or grass type)
    {
        applymovement(6, Common_Movement_FaceLeft)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
        waitmovement(0)
        speakername("Rania")
        msgbox(format("Team Chimera got away from us, but look what one of them dropped! It's a {COLOR GREEN}Pokémon Egg like I've never seen before{COLOR DARK_GRAY}! Maybe it holds a rare Pokémon.\p {PLAYER}, I want you to have it. Pokémon Eggs aren't my specialty."))
        closemessage
        // generate random egg species and give
        setflag(FLAG_FORCE_SHINY) // trying my best to force a shiny egg
        setflag(FLAG_SHINY_CREATION)
        randomelement(SPECIES_POPPLIO, SPECIES_FROAKIE, SPECIES_QUAXLY, SPECIES_PANPOUR, SPECIES_DUCKLETT, SPECIES_POLIWAG, SPECIES_WOOPER, SPECIES_OMANYTE, SPECIES_KABUTO, SPECIES_WINGULL, SPECIES_SPHEAL, SPECIES_SEEL, SPECIES_BUIZEL, SPECIES_WIMPOD, SPECIES_FINIZEN, SPECIES_CORSOLA, SPECIES_FINNEON, SPECIES_WAILMER, SPECIES_TENTACOOL, SPECIES_CLAUNCHER, SPECIES_BASCULIN_WHITE_STRIPED, SPECIES_SKRELP, SPECIES_CHINCHOU, SPECIES_SHELLDER, SPECIES_CLAMPERL, SPECIES_RELICANTH, SPECIES_MAGIKARP, SPECIES_BRUXISH, SPECIES_LAPRAS, SPECIES_PSYDUCK, SPECIES_REMORAID, SPECIES_CORPHISH, SPECIES_TIRTOUGA, SPECIES_ROWLET, SPECIES_CHESPIN, SPECIES_SPRIGATITO, SPECIES_PANSAGE, SPECIES_HOPPIP, SPECIES_PARAS, SPECIES_APPLIN, SPECIES_SKIDDO, SPECIES_PUMPKABOO, SPECIES_SHROOMISH, SPECIES_BOUNSWEET, SPECIES_TOEDSCOOL, SPECIES_CHERUBI, SPECIES_LILEEP, SPECIES_FOMANTIS, SPECIES_VOLTORB_HISUI, SPECIES_BUDEW, SPECIES_SNOVER, SPECIES_LITTEN, SPECIES_FENNEKIN, SPECIES_FUECOCO, SPECIES_PANSEAR, SPECIES_VULPIX, SPECIES_SALANDIT, SPECIES_HOUNDOUR, SPECIES_PONYTA, SPECIES_LITWICK, SPECIES_CHARCADET, SPECIES_TORKOAL, SPECIES_NUMEL, SPECIES_GROWLITHE, SPECIES_GROWLITHE_HISUI)
        giveegg(VAR_RESULT)
        playfanfare(MUS_OBTAIN_ITEM)
        message(format("{PLAYER} received a {COLOR GREEN}Rare Egg{COLOR DARK_GRAY}!"))
        waitmessage
        waitfanfare
        delay(20)
        clearflag(FLAG_FORCE_SHINY)
        clearflag(FLAG_SHINY_CREATION)
        speakername("Rania")
        msgbox(format("Carry that Egg around until it hatches. Who knows, maybe it's a new species of Pokémon!\p Niko and I are gonna head back to the University for a while. Let us know if Pythios Town is worth a visit!"))
        closemessage
    }

    // fadescreen, remove objects and set hide flags
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    setflag(FLAG_BEAT_CHIMERA_WANDERING_WOODS)
    removeobject(6)
    removeobject(7)
    removeobject(8)
    removeobject(9)
    removeobject(10)
    removeobject(11)
    removeobject(12)
    removeobject(13)
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(30)
    setvar(VAR_RANIA_STATE, 4)
    setvar(VAR_NIKO_STATE, 5)
    releaseall
    end
}

movement WanderersWoods_Movement_PlayerLeadsToChimera
{
    walk_right * 2
    walk_down * 3
    emote_question_mark
    delay_16
    walk_down * 2
    step_end
}

movement WanderersWoods_Movement_RaniaFollowsToChimera
{
    walk_down
    walk_right * 2
    walk_down * 2
    delay_16
    walk_down * 2
    walk_right
    walk_down
    step_end
}

movement WanderersWoods_Movement_NikoFollowsToChimera
{
    walk_in_place_right
    walk_right * 2
    walk_down * 3
    walk_down * 2
    step_end
}

movement WanderersWoods_Movement_ShroomishEscape
{
    walk_fast_left
    walk_fast_up
    walk_fast_left * 7
    step_end
}

movement WanderersWoods_Movement_BlitzleEscape
{
    walk_fast_down * 2
    walk_fast_left * 2
    walk_fast_down * 2
    step_end
}

movement WanderersWoods_Movement_ImpidimpEscape
{
    walk_fast_down
    walk_fast_left * 2
    walk_fast_up
    walk_fast_left * 3
    walk_fast_down * 4
    step_end
}

text WanderersWoods_Text_ChimeraAdminDefeated
{
    format("Beaten and stopped... the Boss won't take this.")
}

movement WanderersWoods_Movement_GruntEscapes1
{
    walk_fast_down * 2
    walk_fast_left * 2
    jump_down * 3
    walk_fast_down * 3
    step_end
}

movement WanderersWoods_Movement_GruntEscapes2
{
    walk_fast_down * 3
    walk_fast_left * 2
    walk_fast_down * 2
    walk_fast_left
    walk_fast_down * 2
    step_end
}

movement WanderersWoods_Movement_AdminEscapes
{
    walk_fast_down * 5
    walk_fast_left * 3
    walk_fast_down * 3
    step_end
}

movement WanderersWoods_Movement_NikoReturns
{
    walk_faster_up * 3
    jump_up * 3
    walk_faster_right * 2
    walk_faster_up * 2
    face_right
    step_end
}

movement WanderersWoods_Movement_RaniaReturns
{
    walk_faster_up * 2
    walk_faster_right
    walk_faster_up * 2
    walk_faster_right * 2
    walk_faster_up * 3
    face_left
    step_end
}
