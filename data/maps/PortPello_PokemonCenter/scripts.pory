    closemessage
    release
    end
}

script PortPello_PokemonCenter_EventScript_Heliolisk
{
    lock
    faceplayer
    speakername("Heliolisk")
    playmoncry(SPECIES_HELIOLISK, CRY_MODE_NORMAL)
    msgbox("Breahh!")
    waitmoncry
    closemessage
    release
    end
}
