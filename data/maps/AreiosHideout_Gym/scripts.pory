mapscripts AreiosHideout_Gym_MapScripts {}

script AreiosHideout_Gym_EventScript_Mamoswine
{
    lock
    faceplayer
    speakername("Mamoswine")
    playmoncry(SPECIES_MAMOSWINE, CRY_MODE_NORMAL)
    msgbox("Moowrah!")
    waitmoncry
    closemessage
    release
    end
}

