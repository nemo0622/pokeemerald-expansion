    end
}

script FrescoIsles_EventScript_WomanOnBeachChair
{
    lock
    faceplayer
    speakername("Woman")
    msgbox(format("I brought my son here for some time to relax. The world is crazy, so it's important to take a moment and sit back."))
    closemessage
    applymovement(4, Common_Movement_FaceDown)
    waitmovement(0)
    release
    end
}

script FrescoIsles_EventScript_HexManiacWithHiddenPower
{
    lock
    faceplayer
    speakername("Crystal Girl")
    if(flag(FLAG_RECEIVED_TM_HIDDEN_POWER)) // reusing existing emerald flag
    {
        msgbox(format("Have you unlocked your Pokémon's Hidden Power yet?"))
        closemessage
    }
    else
    {
        msgbox(format("Just like crystals, Pokémon have special powers unique to them. I've found a way to tap into that potential. Check it out!"))
        closemessage
        delay(5)
        setflag(FLAG_RECEIVED_TM_HIDDEN_POWER)
        giveitem(ITEM_TM_HIDDEN_POWER)
        closemessage
        delay(5)
        speakername("Crystal Girl")
        msgbox(format("Hidden Power is a move that changes type based on the individual Pokémon. You'd be surprised at what secrets your Pokémon might hold."))
        closemessage
    }
    release
    end
}

