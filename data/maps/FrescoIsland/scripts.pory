script FrescoIsles_EventScript_LittleGirl
{
    lock
    faceplayer
    speakername("Little Girl")
    msgbox(format("Hiya! You're an adult, right? Do you know why all the rocks around here are black?"), MSGBOX_YESNO)
    closemessage
    delay(5)
    if(var(VAR_RESULT) == TRUE)
    {
        speakername("Little Girl")
        msgbox(format("Yeah! It's volcanic rock!"))
        closemessage
    }
    else
    {
        speakername("Little Girl")
        msgbox(format("Really? Ehehe, even I know why! It's all made of dried lava!"))
        closemessage
    }
    release
    end
}

script FrescoIsles_EventScript_ArtistNeedsPaintMaterials
{
    lock
    faceplayer
    speakername("Artist")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_SHARDS_FOR_ARTIST)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("These shard-based paints are so bright, they'll be perfect for my masterpiece!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_SHARDS_FOR_ARTIST)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Chaire. By any chance, are you a treasure hunter?\p The Fresco Isles have inspired me to paint my masterpiece, but no paint I find will be good enough. I've heard that special paint can be made from crushed-up {COLOR GREEN}colored Shards{COLOR DARK_GRAY}. Please, bring me {COLOR GREEN}one of each colored Shard{COLOR DARK_GRAY}. I promise to pay you back in kind."))
        closemessage
        delay(20)
        startquest(QUEST_SHARDS_FOR_ARTIST)
    }
    else
    {
        msgbox(format("Hey there. I'm still short on materials to make my special paints. Would you happen to have the colored Shards I requested?"))
        closemessage

        checkitem(ITEM_RED_SHARD)
        if(var(VAR_RESULT) == TRUE)
        {
            checkitem(ITEM_BLUE_SHARD)
            if(var(VAR_RESULT) == TRUE)
            {
                checkitem(ITEM_GREEN_SHARD)
                if(var(VAR_RESULT) == TRUE)
                {
                    checkitem(ITEM_YELLOW_SHARD)
                }
            }
        }

        if(var(VAR_RESULT) == TRUE) // should only be if they have all 4 shards
        {
            emote(10, EMOTE_EXCLAM)
            speakername("Artist")
            msgbox(format("Woah, you have Red, Blue, Green, and Yellow Shards! I'll crush them up into stunning pigments.\p While you were off collecting Shards, I completed another project: a {COLOR GREEN}Clear Amulet{COLOR DARK_GRAY} for your Pokémon to hold."))
            closemessage
            delay(5)
            removeitem(ITEM_RED_SHARD)
            removeitem(ITEM_BLUE_SHARD)
            removeitem(ITEM_GREEN_SHARD)
            removeitem(ITEM_YELLOW_SHARD)
            giveitem(ITEM_CLEAR_AMULET)
            closemessage

            delay(20)
            completequest(QUEST_SHARDS_FOR_ARTIST)
        }
        else
        {
            speakername("Artist")
            msgbox(format("Hm, not yet, huh? I know they're rare.\p Some Pokémon hold colored Shards, and they can be found underground too. Please, bring me {COLOR GREEN}one of every colored Shard type{COLOR DARK_GRAY} once you have them!"))
            closemessage
        }
    }
    release
    end
}

