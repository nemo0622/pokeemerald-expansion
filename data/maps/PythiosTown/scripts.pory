script PythiosTown_EventScripts_NPC_OldMan
{
    lock
    faceplayer
    speakername("Old Man")
    msgbox(format("The graves around Pythios Town are for old heroes of the Ilios Region. Them and their Pokémon helped win wars and fought in great battles.\p Nowadays, people prefer Pokémon battling for entertainment. That's probably for the best."))
    closemessage
    applymovement(7, Common_Movement_FaceDown)
    waitmovement(0)
    release
    end
}

script PythiosTown_EventScripts_NPC_Artist
{
    lock
    if(!flag(FLAG_SPOKE_TO_MOVE_RELEARNER))
    {
        speakername("Artist")
        msgbox(format("A stoic man staring off to the distance...\p Think of the story this statue tells...\n A hero, lost to time...\p I need inspiration, a modern hero!"))
        closemessage
        applymovement(12, Common_Movement_ExclamationMark)
        waitmovement(0)
        delay(20)
        applymovement(12, Common_Movement_FacePlayer)
        waitmovement(0)
        speakername("Artist")
        msgbox(format("Oh? And you, are you a young trainer? A new hero in-the-making?\p I see a Pokédex on you. Speak to me when you have {COLOR GREEN}20 Pokémon{COLOR DARK_GRAY} registered in your Pokédex. If you can give me inspiration, I can {COLOR GREEN}help your Pokémon{COLOR DARK_GRAY}!"))
        closemessage
        setflag(FLAG_SPOKE_TO_MOVE_RELEARNER)
    }
    elif(!flag(FLAG_UNLOCKED_MOVE_RELEARNER))
    {
        applymovement(12, Common_Movement_FacePlayer)
        waitmovement(0)
        speakername("Artist")
        msgbox(format("Chaire, my young hero! I wonder, will we make statues of you someday?\p Have you completed my task? Let me see your Pokédex."))
        closemessage

        setvar(VAR_0x8004, 0) // sets check to Regional Dex (Hoenn)
	    specialvar(VAR_RESULT, ScriptGetPokedexInfo)
	    copyvar(VAR_0x8008, VAR_0x8005)
	    copyvar(VAR_0x8009, VAR_0x8006)
	    buffernumberstring(STR_VAR_1, VAR_0x8008) // Num Regional seen
	    buffernumberstring(STR_VAR_2, VAR_0x8009) // Num Regional caught
        delay(30)
        speakername("Artist")
        msgbox(format("You've caught and recorded data on {STR_VAR_2} Pokémon."))
        closemessage
        delay(30)

        if(var(VAR_0x8009) >= 20) // caught over 20 mons
        {
            applymovement(12, Common_Movement_ExclamationMark)
            waitmovement(0)
            applymovement(12, Common_Movement_JumpInPlaceRight)
            waitmovement(0)
            speakername("Artist")
            msgbox(format("Oh, visions of Pokémon and beauty flow through me! Be still, my beating heart!\p Calm me, sweet statue..."))
            closemessage
            delay(30)
            applymovement(12, Common_Movement_FacePlayer)
            waitmovement(0)
            speakername("Artist")
            msgbox(format("Splendid! Fantastic! You've shown me more than I ever could have hoped!\p Please, young hero, allow me to help you.\n I can draw move directions, which can help {COLOR GREEN}Pokémon relearn old moves{COLOR DARK_GRAY}. Come visit me whenever you need!"))
            closemessage
            setflag(FLAG_UNLOCKED_MOVE_RELEARNER)
        }
        else // did not do it
        {
            speakername("Artist")
            msgbox(format("Mmm... I'm just not quite inspired. Show me {COLOR GREEN}20 complete Pokédex entries{COLOR DARK_GRAY} of caught Pokémon. I must see more of Ilios!"))
            closemessage
        }
    }
    else // did quests, unlocked move relearner, do that
    {
        applymovement(12, Common_Movement_FacePlayer)
        waitmovement(0)
        speakername("Artist")
        msgbox(format("Chaire, young hero! Are you here for move drawings? They can help Pokémon {COLOR GREEN}relearn old moves{COLOR DARK_GRAY}!"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == 0) // no
        {
            speakername("Artist")
            msgbox(format("Understood. I'll stay here and practice my art with this incredible statue. Andio, goodbye!"))
            closemessage
        }
        else // yes
        {
            special(ChooseMonForMoveRelearner)
            waitstate
            if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN)
            {
                speakername("Artist")
                msgbox(format("Not today? That's okay, it's your journey! Come back when you want a Pokémon to remember a move."))
                closemessage
                applymovement(12, Common_Movement_FaceRight)
                waitmovement(0)
                release
                end
            }
            special(IsSelectedMonEgg)
            if(var(VAR_RESULT) == TRUE) // it's a egg
            {
                speakername("Artist")
                msgbox(format("Ah, ever the hero, rushing right into things! I'm sorry, but I cannot teach an Egg to do anything more than sit there. Let me know when it hatches though, perhaps I can draw moves for it as it grows older!"))
                closemessage
                applymovement(12, Common_Movement_FaceRight)
                waitmovement(0)
                release
                end
            }
            if(var(VAR_0x8005) == 0) // no moves to teach
            {
                speakername("Artist")
                msgbox(format("Hmm... ehehe, this is a little embarrassing, young hero... but I don't have anything to teach this Pokémon! It doesn't respond to any of my move drawings.\p Come back with another Pokémon! Andio, goodbye, hero!"))
                closemessage
                applymovement(12, Common_Movement_FaceRight)
                waitmovement(0)
                release
                end
            }
            speakername("Artist")
            msgbox(format("Splendid! Now, what move should this Pokémon learn?"))
            special(TeachMoveRelearnerMove)
	        waitstate
            if(var(VAR_0x8004) == 0) // didnt teach move
            {
                speakername("Artist")
                msgbox(format("Not today? That's okay, it's your journey! Come back when you want a Pokémon to remember a move."))
                closemessage
                applymovement(12, Common_Movement_FaceRight)
                waitmovement(0)
                release
                end
            }
            else
            {
                speakername("Artist")
                msgbox(format("It was a complete success! Your Pokémon recognized my drawings and relearned the move.\p Come back when you want another move relearned, my young hero!"))
                closemessage
            }
        }
    }

    applymovement(12, Common_Movement_FaceRight)
    waitmovement(0)
    release
    end
}

