mapscripts PythiosTown_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_PYTHIOS_TOWN)
        random(3)
        switch (var(VAR_RESULT)) {
            case 0: setweather(WEATHER_NONE)
            case 1: setweather(WEATHER_NONE)
            case 2: setweather(WEATHER_RAIN)
        }

        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(21, ENCOUNTER_LAND)
    }
}

script PythiosTown_Sign_GymSign
{
    lock
    msgbox(format("Gym Leader: Sabella\n The Oracle of Ilios"))
    closemessage
    release
    end
}

script PythiosTown_EventScripts_NPC_Gentleman
{
    lock
    faceplayer
    speakername("Gentleman")
    msgbox(format("Pythios Town is famous for the concentration of spiritual energy here. It attracts Ghost-type and Psychic-type Pokémon.\p Folktales say that the spirits have turned the plants orange, putting the area into a permanent Autumn.\p People flock from all over to hear Sabella, the Gym Leader, predict the future. Some say she has a magic gift..."))
    closemessage
    if(!flag(FLAG_GOT_WILL_O_WISP))
    {
        speakername("Gentleman")
        msgbox(format("Thanks for listening to me ramble. Here, take this {COLOR GREEN}TM Will-O-Wisp{COLOR DARK_GRAY}. It feels like it's connected to this strange town."))
        closemessage
        giveitem(ITEM_TM51)
        setflag(FLAG_GOT_WILL_O_WISP)
    }
    release
    end
}

