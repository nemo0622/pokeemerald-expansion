script PythiosTown_EventScript_Trigger_SabellaIntroductionEvent
{
    lockall
    applymovement(15, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(30)
    applymovement(15, PythiosTown_Movement_FirstSabellaFanWalksToPlayer)
    waitmovement(0)
    applymovement(16, Common_Movement_WalkUp)
    waitmovement(0)
    speakername("Mystical Woman")
    msgbox(format("YES!! Sabella said I'm guarenteed to win my next Pokémon battle! She's never wrong!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkLeft)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    applymovement(15, PythiosTown_Movement_FirstSabellaFanWalksAway)
    waitmovement(0)
    delay(60)

    applymovement(OBJ_EVENT_ID_PLAYER, PythiosTown_Movement_PlayerApproachesLine)
    waitmovement(0)
    delay(60)
    applymovement(16, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(30)
    applymovement(16, Common_Movement_FaceDown)
    waitmovement(0)
    speakername("Worker")
    msgbox(format("Sabella just read my future! She told me 'a big shake-up at work is coming'... that probably means a raise!\p ...Probably!"))
    closemessage
    applymovement(16, PythiosTown_Movement_SecondSabellaFanWalksAway)
    waitmovement(0)
    delay(30)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)

    // finally talk to sabella
    speakername("Sabella")
    msgbox(format("Ah... {PLAYER}, yes?\p How do I know your name? I know much and more, young trainer. My name is Sabella, the spiritual guide and {COLOR GREEN}Gym Leader of Pythios Town{COLOR DARK_GRAY}.\p You're here for your third Gym Challenge. I sense a great battle on the horizon... I shall be {COLOR GREEN}in my Gym{COLOR DARK_GRAY}. I await your challenge."))
    closemessage

    fadescreen(FADE_TO_BLACK)
    delay(30)
    removeobject(15) // sabellas fans
    removeobject(16)
    removeobject(3) // sabella
    removeobject(17) // sabella's pokémon
    removeobject(19) // man blocking gym
    setflag(FLAG_MET_SABELLA_PYTHIOS_TOWN)
    delay(30)
    fadescreen(FADE_FROM_BLACK)
    delay(20)

    releaseall
    end
}

movement PythiosTown_Movement_FirstSabellaFanWalksToPlayer
{
    walk_fast_left
    walk_fast_down * 2
    step_end
}

movement PythiosTown_Movement_FirstSabellaFanWalksAway
{
    walk_fast_down * 6
    walk_fast_right * 8
    step_end
}

movement PythiosTown_Movement_PlayerApproachesLine
{
    walk_right
    walk_up * 2
    walk_right
    face_up
    step_end
}

movement PythiosTown_Movement_SecondSabellaFanWalksAway
{
    walk_fast_left
    walk_fast_down * 9
    step_end
}

