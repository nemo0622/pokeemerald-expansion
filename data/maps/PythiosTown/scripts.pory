script PythiosTown_EventScripts_PIRAEUS
{
    lock
    faceplayer
    if(!flag(FLAG_MET_PIRAEUS_PYTHIOS_TOWN)) // first speak
    {
        speakername("Strange Sailor")
        msgbox(format("Chaire! Hey! I need a strong Trainer to help me out of a bind.\p Come to me when you have the {COLOR GREEN}Pythios Town Gym Badge{COLOR DARK_GRAY}... please!"))
        closemessage
        setflag(FLAG_MET_PIRAEUS_PYTHIOS_TOWN)
        release
        end
    }
    elif(flag(FLAG_MET_PIRAEUS_PYTHIOS_TOWN) && !flag(FLAG_GOT_BADGE_FOR_PIRAEUS))
    {
        speakername("Strange Sailor")
        msgbox(format("Thanks for coming back, I thought you might've left for good! Lemme check your {COLOR GREEN}Badges{COLOR DARK_GRAY}..."))
        closemessage
        delay(60)
        if(!flag(FLAG_BADGE03_GET)) // no badge yet
        {
            speakername("Strange Sailor")
            msgbox(format("Nope, only 2 Gym Badges. That might not be enough.\p Come back when you have the {COLOR GREEN}Pythios Town Gym Badge{COLOR DARK_GRAY}, I need to mke sure you're a strong Trainer."))
            closemessage
            release
            end
        }
        else // got badge
        {
            speakername("Strange Sailor")
            msgbox(format("Hey, you got the Gym Badge! You must be pretty strong.\p So look, here's my situation. Some Team Chimera thugs wanted to take my precious, gorgeous, perfect boat! I took one down with my Pokémon, but they called for backup from an Admin, so now I'm stuck hiding out here.\p Last I saw, the Team Chimera Admin was waiting to catch me leaving {COLOR GREEN}east of Pythios Town{COLOR DARK_GRAY}. Please, help me out here!"))
            closemessage
            setflag(FLAG_GOT_BADGE_FOR_PIRAEUS) // means player can fight Team Chimera east of Pythios Town
            delay(30)
            applymovement(20, Common_Movement_ExclamationMark)
            waitmovement(0)
            delay(20)
            speakername("Piraeus")
            msgbox(format("Oh, and tell 'em {COLOR GREEN}Piraeus{COLOR DARK_GRAY} sent you! Piraeus the Strong! No, Piraeus the Wise... maybe even Piraeus the Great! Fwahaha!"))
            closemessage
            release
            end
        }
    }
    elif(flag(FLAG_GOT_BADGE_FOR_PIRAEUS) && !flag(FLAG_HELPED_PIRAEUS_PYTHIOS_TOWN))
    {
        speakername("Piraeus")
        msgbox(format("The Team Chimera Admin is {COLOR GREEN}east of Pythios Town{COLOR DARK_GRAY}, last I saw. Let me know when you've taken care of them!"))
        closemessage
        release
        end
    }
    elif(flag(FLAG_HELPED_PIRAEUS_PYTHIOS_TOWN)) // unlocked PIRAEUS services
    {
        goto(Common_EventScript_Piraeus)
    }
    release
    end
}
