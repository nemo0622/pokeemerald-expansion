            applymovement(61, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Georgia")
            msgbox(format("This'll be the show of a lifetime!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_GEORGIA, format("What a fight!"))
        case TRAINER_WAKEWATER_NOB: // hiker
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_38)
            addobject(62)
            applymovement(62, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Nob")
            msgbox(format("Huff, huff... I finally made it...!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_NOB, format("Aw, it's over already?"))
        case TRAINER_WAKEWATER_DALE: // black belt
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_39)
            addobject(63)
            applymovement(63, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Dale")
            msgbox(format("Hup! Hyah! Hiya!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_DALE, format("My awesome karate forms barely helped?!"))
        case TRAINER_WAKEWATER_ALLEN: // dragon tamer
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_40)
            addobject(64)
            applymovement(64, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Allen")
            msgbox(format("My Dragon Pokémon are the best to ever live!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_ALLEN, format("Second best isn't so bad."))
    }

}

