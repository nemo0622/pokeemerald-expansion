mapscripts WakewaterIsle_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_WAKEWATER_ISLE)
        special(LoadWakewaterPlayerMonGfx)
        setflag(FLAG_ITEM_HIDE_OPPONENT_MON_WAKEWATER)
        setflag(FLAG_ITEM_HIDE_PLAYER_MON_WAKEWATER)
        call(WakewaterIsle_EventScript_HideAllTrainers)
    }
}

script WakewaterIsle_EventScript_Vaporeon
{
    lock
    faceplayer
    speakername("Vaporeon")
    playmoncry(SPECIES_VAPOREON, CRY_MODE_NORMAL)
    msgbox("Blubburr!")
    waitmoncry
    closemessage
    delay(5)
    msgbox(format("Piraeus' Vaporeon looks excited to be here!"))
    closemessage
    release
    end
}

script WakewaterIsle_EventScript_ChampionBattleSign
{
    lock
    msgbox(format("Champion's Defense\n Prove that You're the Best!"))
    closemessage
    release
    end
}

script WakewaterIsle_EventScript_Boy
{
    lock
    faceplayer
    speakername("Boy")
    msgbox(format("This is where Champion-ranked Trainers come to hone their skills! It's one of the only places that other Trainers can freely challenge them."))
    closemessage
    release
    end
}

script WakewaterIsle_EventScript_Artist
{
    lock
    faceplayer
    speakername("Artist")
    msgbox(format("I'm planning to watch all of today's battles. It'll inspire my new artwork!"))
    closemessage
    release
    end
}

script WakewaterIsle_EventScript_Woman
{
    lock
    faceplayer
    speakername("Woman")
    msgbox(format("Trainers here use {COLOR GREEN}Level Scaling{COLOR DARK_GRAY}. They'll usually match the average level of your Pokémon."))
    closemessage
    release
    end
}

script WakewaterIsle_EventScript_Sailor
{
    lock
    faceplayer
    speakername("Sailor")
    msgbox(format("The waters around Wakewater Isle are so rough, Surfing and Fishing are basically impossible. Only large boats are strong enough to bring people here."))
    closemessage
    release
    end
}

// ------------------------------------------------------------------------------------------------
// ------------------------------------------------------------------------------------------------

script WakewaterIsle_EventScript_BeginChampionsDefense
{
    lockall
    setflag(FLAG_HIDE_MAP_NAME_POPUP)
    msgbox(format("Step up to the {COLOR GREEN}Champion's Defense Challenge{COLOR DARK_GRAY}? You will face {COLOR GREEN}3 Trainers{COLOR DARK_GRAY} back-to-back. Your Pokémon will be healed between each battle."), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == FALSE)
    {
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkDown)
        waitmovement(0)
        clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    }
    else
    {
        warpcontinuescript(MAP_WAKEWATER_ISLE, 29, 19, WakewaterIsle_EventScript_ChampionDefenseScript)
    }
    releaseall
    end
}

script WakewaterIsle_EventScript_ChampionDefenseScript
{
    lockall
    
    addobject(16)
    special(LoadWakewaterPlayerMonGfx)
    addobject(16) // really making sure this is there. lol
    fadescreen(FADE_FROM_BLACK)

    delay(15)
    special(HealPlayerParty)
    call(WakewaterIsle_EventScript_ChooseRandomTrainer) // battle #1

    delay(20)
    msgbox(format("The first Trainer has been defeated! Your Pokémon will be healed while you wait for the second Trainer."))
    closemessage
    delay(20)
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(15)
    call(WakewaterIsle_EventScript_HideAllTrainers)
    special(HealPlayerParty)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(15)

    call(WakewaterIsle_EventScript_ChooseRandomTrainer) // battle #2

    delay(20)
    msgbox(format("The second Trainer has been defeated! Your Pokémon will be healed while you wait for the third Trainer."))
    closemessage
    delay(20)
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(15)
    call(WakewaterIsle_EventScript_HideAllTrainers)
    special(HealPlayerParty)
    delay(15)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(15)

    call(WakewaterIsle_EventScript_ChooseRandomTrainer) // battle #3

    delay(20)
    msgbox(format("All three Trainers have been defeated! Congratulations, Champion!"))
    closemessage

    // give reward
    randomelement(ITEM_NUGGET, ITEM_BIG_NUGGET, ITEM_MASTER_BALL, ITEM_PEARL)
    giveitem(VAR_RESULT)
    closemessage

    clearflag(FLAG_HIDE_MAP_NAME_POPUP)
    warp(MAP_WAKEWATER_ISLE, 30, 22)
    waitstate
    releaseall
    end
}

script WakewaterIsle_EventScript_ChooseRandomTrainer
{
    // Add new Trainers to the randomelement command below:
    randomelement(TRAINER_WAKEWATER_SAMANTHA, TRAINER_WAKEWATER_MAURA, TRAINER_WAKEWATER_PIRAEUS, TRAINER_WAKEWATER_LEXIE, TRAINER_WAKEWATER_ALEXANDER, TRAINER_WAKEWATER_KASSA, TRAINER_WAKEWATER_POLYMNIA, TRAINER_WAKEWATER_OURANI, TRAINER_WAKEWATER_KLEIO, TRAINER_WAKEWATER_TERPSIKORE, TRAINER_WAKEWATER_EUTERPE, TRAINER_WAKEWATER_THALIA_AND_MELPOMENE, TRAINER_WAKEWATER_RHADINE, TRAINER_WAKEWATER_KALLIOPE, TRAINER_WAKEWATER_CHIMERA_ADMIN_M, TRAINER_WAKEWATER_CHIMERA_ADMIN_F, TRAINER_WAKEWATER_ANYALIOS, TRAINER_WAKEWATER_RANIA, TRAINER_WAKEWATER_MICHAH, TRAINER_WAKEWATER_DRAKE, TRAINER_WAKEWATER_SASHA, TRAINER_WAKEWATER_CONNIE, TRAINER_WAKEWATER_SHIA, TRAINER_WAKEWATER_OLIVIA, TRAINER_WAKEWATER_KYLE, TRAINER_WAKEWATER_NEMO, TRAINER_WAKEWATER_CASSIE, TRAINER_WAKEWATER_JARED, TRAINER_WAKEWATER_CAIDEN, TRAINER_WAKEWATER_SEBASTIAN, TRAINER_WAKEWATER_BRODY, TRAINER_WAKEWATER_JERRY, TRAINER_WAKEWATER_ERIKOV, TRAINER_WAKEWATER_SNAD, TRAINER_WAKEWATER_MISSINGNOVGC, TRAINER_WAKEWATER_AMY, TRAINER_WAKEWATER_GEORGIA, TRAINER_WAKEWATER_NOB, TRAINER_WAKEWATER_DALE, TRAINER_WAKEWATER_ALLEN)
    copyvar(VAR_CHOSEN_WAKEWATER_CHALLENGER, VAR_RESULT)

    switch(var(VAR_CHOSEN_WAKEWATER_CHALLENGER))
    {
        default: // failsafe
        case TRAINER_WAKEWATER_SAMANTHA:
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_01)
            addobject(14)
            applymovement(14, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Samantha")
            msgbox(format("Everyone underestimates me because I'm cute. I always prove them wrong!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_SAMANTHA, format("No! My sweet, strong Pokémon!"))
        case TRAINER_WAKEWATER_MAURA:
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_02)
            addobject(15)
            applymovement(15, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Maura")
            msgbox(format("My Pokémon and I all have psychic powers."))
            trainerbattle_no_intro(TRAINER_WAKEWATER_MAURA, format("Our psychic powers... They've failed us!"))
        case TRAINER_WAKEWATER_PIRAEUS:
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_03)
            // addobject(17) // also walks partner Pokémon up!
            // applymovement(17, WakewaterIsle_Movement_TrainerApproachesPlayer) // also walks partner Pokémon up!
            addobject(18)
            applymovement(18, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Piraeus")
            msgbox(format("Bwahaha, you're not the only strong Trainer to sail The Delphis! Let's see what you've got!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_PIRAEUS, format("Ohoho, we'd better sail away!"))
        case TRAINER_WAKEWATER_LEXIE:
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_04)
            addobject(19)
            applymovement(19, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Lexie")
            msgbox(format("My Pokémon and I are gonna kick your butt!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_LEXIE, format("No! We got OUR butts kicked!"))
        case TRAINER_WAKEWATER_ALEXANDER:
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_05)
            addobject(20)
            applymovement(20, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Alexander")
            msgbox(format("Get ready for my ultimate performance!"))
            trainerbattle_no_intro(TRAINER_WAKEWATER_ALEXANDER, format("Aww, my performace was a failure."))
        case TRAINER_WAKEWATER_KASSA: // rich boy
            clearflag(FLAG_HIDE_WAKEWATER_TRAINER_06)
            addobject(21)
            applymovement(21, WakewaterIsle_Movement_TrainerApproachesPlayer)
            waitmovement(0)
            speakername("Kassa")
            msgbox(format("Heh, you could never compete against me."))
            trainerbattle_no_intro(TRAINER_WAKEWATER_ALEXANDER, format("Hey, I still have more money than you!"))
