mapscripts PythiosCemetery_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflashlevel(3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(13, ENCOUNTER_LAND)
        setobjectaswildencounter(14, ENCOUNTER_LAND)
        setobjectaswildencounter(15, ENCOUNTER_LAND)
        setobjectaswildencounter(16, ENCOUNTER_LAND)
        setobjectaswildencounter(17, ENCOUNTER_LAND)
    }
}

script PythiosCemetery_EventScript_Linoone
{
    lock
    faceplayer
    speakername("Linoone")
    playmoncry(SPECIES_LINOONE_GALARIAN, CRY_MODE_NORMAL)
    msgbox("Hissss!")
    waitmoncry
    closemessage
    release
    end
}

script PythiosCemetery_EventScript_Trainer_PythiosCemetery_Grunt1
{
    trainerbattle_single(TRAINER_PYTHIOSCEMETERY_CHIMERA_GRUNT_1, PythiosCemetery_Text_Trainer_PythiosCemetery_Grunt1Intro, PythiosCemetery_Text_Trainer_PythiosCemetery_Grunt1Defeat)
    speakername("Grunt")
    msgbox(format("Look, just leave and don't cause trouble."))
    closemessage
    release
    end
}
text PythiosCemetery_Text_Trainer_PythiosCemetery_Grunt1Intro
{
    format("Hey, you! This is our private Team Chimera meeting spot!")
}
text PythiosCemetery_Text_Trainer_PythiosCemetery_Grunt1Defeat
{
    format("Darn, we might get cleaned out!")
}

