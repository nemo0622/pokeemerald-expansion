script PythiosCemetery_EventScript_OldWoman
{
    lock
    faceplayer
    speakername("Old Woman")
    msgbox(format("People tend to stay away from cemeteries, so the graves fall into ruin. I'm trying to clean some of them up."))
    closemessage
    applymovement(12, Common_Movement_FaceUp)
    waitmovement(0)
    release
    end
}
