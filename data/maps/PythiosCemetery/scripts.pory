script PythiosCemetery_EventScript_Trainer_PythiosCemetery_Admin
{
    lock
    faceplayer
    speakername("Grunt")
    msgbox(format("Wh-what? How did you reach us? I thought that we were the only ones who could get through the Cemetery, thanks to our {COLOR GREEN}Flash HM{COLOR DARK_GRAY}.\p No matter. I'd recognize the Trainer messing up our plans anywhere, even in the dark. I'll stop you, here and now!"))
    closemessage
    trainerbattle_no_intro(TRAINER_PYTHIOSCEMETERY_CHIMERA_GRUNT_3, PythiosCemetery_Text_Trainer_PythiosCemetery_AdminDefeat)
    
    lock
    faceplayer
    speakername("Grunt")
    msgbox(format("Lazarus Taxa, the once-thought-extinct Pokémon species, coming back to the world is a sign. Change is coming, and only Team Chimera is strong enough to control it!"))
    closemessage
    fadescreenswapbuffers(FADE_TO_BLACK)
    delay(30)
    removeobject(4)
    removeobject(5)
    removeobject(6)
    removeobject(7)
    setflag(FLAG_RECEIVED_HM_FLASH) // also hides chimera grunts here #efficient
    delay(30)
    fadescreenswapbuffers(FADE_FROM_BLACK)
    delay(20)
    msgbox(format("The Team Chimera members dropped something while they ran..."))
    closemessage
    giveitem(ITEM_HM_FLASH)
    release
    end
}
text PythiosCemetery_Text_Trainer_PythiosCemetery_AdminDefeat
{
    format("No! The Pythios Cemetery was supposed to be our next new meeting ground!")
}

