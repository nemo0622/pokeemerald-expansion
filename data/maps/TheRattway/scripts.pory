script CorrinCrossing_EventScript_SuperRodFishingGuru
{
    lock
    faceplayer
    speakername("Fishing Guru")
    if(!flag(FLAG_RECEIVED_SUPER_ROD))
    {
        msgbox(format("I was the first on this route when it reopened! I see you have a fisher's heart, like me.\p I'm so excited, I think I'll give you this!"))
        closemessage
        giveitem(ITEM_SUPER_ROD)
        setflag(FLAG_RECEIVED_SUPER_ROD)
        speakername("Fishing Guru")
        msgbox(format("The {COLOR GREEN}Super Rod{COLOR DARK_GRAY} can give you access to a wide array of Water-dwelling Pokémon. You're fighting Team Chimera, yes? Maybe those Pokémon can help you!"))
        closemessage
    }
    else
    {
        msgbox(format("The {COLOR GREEN}Super Rod{COLOR DARK_GRAY} can give you access to a wide array of Water-dwelling Pokémon. You're fighting Team Chimera, yes? Maybe those Pokémon can help you!"))
        closemessage
    }
    release
    end
}

