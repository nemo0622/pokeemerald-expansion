mapscripts TheRattway_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(15, ENCOUNTER_LAND)
        setobjectaswildencounter(16, ENCOUNTER_LAND)
        setobjectaswildencounter(17, ENCOUNTER_LAND)
        setobjectaswildencounter(18, ENCOUNTER_LAND)
        setobjectaswildencounter(19, ENCOUNTER_LAND)
        setobjectaswildencounter(20, ENCOUNTER_LAND)
        setobjectaswildencounter(21, ENCOUNTER_LAND)
    }
}

script CorrinCrossing_EventScript_UniversityStudentRouteCheck
{
    lock
    faceplayer
    speakername("Uni. Student")

    if(flag(FLAG_CAUGHT_ALL_MONS_CORRIN_CROSSING))
    {
        msgbox(format("Your Pokédex data is amazing! Now we know more about the local ecosystem, thanks to you."))
        closemessage
    }
    else
    {
        msgbox(format("Chaire! I'm a student from the Acrisia University.\p I'm looking for {COLOR GREEN}Pokédex data{COLOR DARK_GRAY} of {COLOR GREEN}all Land Pokémon{COLOR DARK_GRAY} found in Corrin Crossing. If you've caught all the Pokémon here, please let me know."))
        closemessage
        special(CheckRouteCaptureProgress)
        if(var(VAR_RESULT) == TRUE) // caught all mons on the route!
        {
            delay(20)
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Uni. Student")
            msgbox(format("Incredible! You've caught all the Pokémon that I requested in the area!\p Here's a reward from the University. Keep up your hard work!"))
            closemessage
            delay(5)

            // give reward!
            giveitem(ITEM_TM54)
            closemessage

            setflag(FLAG_CAUGHT_ALL_MONS_CORRIN_CROSSING)
        }
    }

    release
    end
}

script CorrinCrossing_EventScript_Gentleman
{
    lock
    faceplayer
    speakername("Gentleman")
    msgbox(format("Ohoho, it's nice to be back here!\p I was caught up in Sofos City when this path was closed down due to Team Chimera activity. I missed the soft waves and cherry trees."))
    closemessage
    release
    end
}

script CorrinCrossing_EventScript_Trainer_CorrinCrossing_Wyatt
{
    trainerbattle_single(TRAINER_CORRINCROSSING_WYATT, CorrinCrossing_Text_Trainer_CorrinCrossing_WyattIntro, CorrinCrossing_Text_Trainer_CorrinCrossing_WyattDefeat)
    speakername("Wyatt")
    msgbox(format("I'm still on edge because of Team Chimera. I know they're mostly back in their Areios Hideout now, but I'm still jumpy."))
    closemessage
    release
    end
}
text CorrinCrossing_Text_Trainer_CorrinCrossing_WyattIntro
{
    format("Hold it right there!")
}
text CorrinCrossing_Text_Trainer_CorrinCrossing_WyattDefeat
{
    format("Oops, sorry 'bout that.")
}

