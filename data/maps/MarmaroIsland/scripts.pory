script MarmaroIsland_EventScript_PokefanF
{
    lock
    faceplayer
    speakername("Pokéfan")
    
    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_MARMARO_TIMER_BALL)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("The Timer Ball is gonna work perfectly, I know it!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_MARMARO_TIMER_BALL)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("My Wurmple and I have been chasing down a Growlithe for hours, hitting it with String Shot to slow it down. After all that effort, I'm out of Poké balls!\p Please, {COLOR GREEN}bring me a Timer Ball{COLOR DARK_GRAY} so I can finally catch the Growlithe!"))
        closemessage

        delay(20)
        startquest(QUEST_MARMARO_TIMER_BALL)
    }
    else
    {
        msgbox(format("Hiya! Did you bring that Timer Ball you asked for?"))
        closemessage

        checkitem(ITEM_TIMER_BALL)
        delay(30)
        if(var(VAR_RESULT) == FALSE)
        {
            speakername("Pokéfan")
            msgbox(format("I guess I'm still out of luck...\p When you can, {COLOR GREEN}bring me a Timer Ball{COLOR DARK_GRAY} so I can catch this Growlithe I've been following around the Island!"))
            closemessage
            release
            end
        }
        else
        {
            speakername("Pokéfan")
            msgbox(format("Cheers, you brought a Timer Ball! I'll take that off your hands...\p Here, take these Quick Balls. I was gonna use them on the wild Growlithe, but the battle took too long!"))
            closemessage
            removeitem(ITEM_TIMER_BALL)
            delay(5)
            giveitem(ITEM_QUICK_BALL, 3)
            closemessage

            delay(20)
            completequest(QUEST_MARMARO_TIMER_BALL)
        }
    }
    release
    end
}

