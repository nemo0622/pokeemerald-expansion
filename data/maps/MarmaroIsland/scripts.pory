script MarmaroIsland_EventScript_Beauty
{
    lock
    faceplayer
    speakername("Beauty")
    
    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_MARMARO_EGG_QUEST)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("Holding your Pokémon Egg has convinced me. I'm gonna head to the Sunset Wildlife Conservation Center in Kipos Town and volunteer to help out!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_MARMARO_EGG_QUEST)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("See up there? That Altaria laid an Egg! I'd give anything to hold a Pokémon Egg, they're just so cool!\p Oh, you're a Trainer, right? Could you {COLOR GREEN}bring me a Pokémon Egg to see{COLOR DARK_GRAY} and hold? I've always wanted to hold one, but taking wild Pokémon Eggs from their parents is unethical."))
        closemessage

        delay(20)
        startquest(QUEST_MARMARO_EGG_QUEST)
    }
    else
    {
        msgbox(format("Chaire! Are you here to check out the Altaria nest?\p Oh, right! Do you have a {COLOR GREEN}Pokémon Egg in your Party{COLOR DARK_GRAY} that I could hold? I've always wanted to!"))
        closemessage

        checkforspecies(SPECIES_EGG, OPEN_PARTY_SCREEN, MarmaroIsland_EventScript_Beauty_ReactToEgg) // goto that script if have egg in party

        // by getting here, you didn't choose an egg from party menu
        speakername("Beauty")
        msgbox(format("Aw, I suppose Pokémon Eggs aren't all that common.\p Bring me a {COLOR GREEN}Pokémon Egg to hold{COLOR DARK_GRAY} if you can! I've always wanted to see and hold one myself."))
        closemessage
    }
    release
    end
}
script MarmaroIsland_EventScript_Beauty_ReactToEgg
{
    lock
    delay(20)
    applymovement(22, Common_Movement_Heart)
    waitmovement(0)
    delay(10)
    speakername("Beauty")
    msgbox(format("Amazing! Almost all Pokémon species lay Eggs, and each is slightly different. I'd love to learn even more about them..."))
    closemessage
    delay(10)
    applymovement(22, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    speakername("Beauty")
    msgbox(format("That's right! In Kipos Town, the Sunset Wildlife Conservation Center helps Pokémon with Eggs. Maybe I'll go ahead and volunteer there!\p I'm sure this wasn't easy for you. I want you to have this!"))
    closemessage
    delay(5)
    giveitem(ITEM_ABILITY_PATCH)
    closemessage

    delay(20)
    completequest(QUEST_MARMARO_EGG_QUEST)

    release
    end
}

