mapscripts LastlightRoad_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(flag(FLAG_CHIMERA_WEATHER_ACTIVE))
        {
            setweather(WEATHER_ABNORMAL)
        }

        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(18, ENCOUNTER_LAND)
        setobjectaswildencounter(19, ENCOUNTER_LAND)
        setobjectaswildencounter(20, ENCOUNTER_LAND)
        setobjectaswildencounter(21, ENCOUNTER_LAND)
        setobjectaswildencounter(22, ENCOUNTER_LAND)
    }
}

script LastlightRoad_EventScript_DirectionSign
{
    lock
    msgbox(format("Lastlight Road\n Where Torches Burn Forever\p {UP_ARROW} Kipos Town\n {DOWN_ARROW} Tower of Dioxippus"))
    closemessage
    release
    end
}

script LastlightRoad_EventScript_Girl
{
    lock
    faceplayer
    speakername("Battle Girl")
    msgbox(format("In ancient times, people from all over the Ilios Region used to travel down this road. The Tower at the end of the path was a sacred site, where rituals and competitions took place under the eyes of the gods.\p Not many people walk this way now, though. I would've loved to compete in an ancient battle there!"))
    closemessage
    release
    end
}

script LastlightRoad_EventScript_BugCatcher
{
    lock
    faceplayer
    speakername("Bug Catcher")
    msgbox(format("I sure am sorry about my Scyther acting up. It's too high leveled for me to control it!"))
    closemessage
    applymovement(2, Common_Movement_FaceDown)
    waitmovement(0)
    release
    end
}

script LastlightRoad_EventScript_Scyther
{
    lock
    faceplayer
    speakername("Scyther")
    playmoncry(SPECIES_SCYTHER, CRY_MODE_NORMAL)
    msgbox("Rakakaka!")
    waitmoncry
    closemessage
    release
    end
}

script LastlightRoad_Trigger_ScytherGoesWild
{
    lockall
    ballfollowingmon
    applymovement(3, Common_Movement_JumpInPlaceUp)
    waitmovement(0)
    delay(10)
    applymovement(2, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    speakername("Bug Catcher")
    msgbox(format("Come on, Scyther! Get back in the Poké ball, please!"))
    closemessage
    delay(10)
    applymovement(3, LastlightRoad_Movement_ScytherRunsAround)
    waitmovement(0)
    speakername("Bug Catcher")
    msgbox(format("...Unbelieveable! You're taking up the whole path!"))
    closemessage
    applymovement(2, Common_Movement_FacePlayer)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Bug Catcher")
    msgbox(format("I'm so sorry, but my Scyther won't listen to me. Some Pokémon are just so strong-willed..."))
    closemessage
    applymovement(2, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
    waitmovement(0)
    releaseall
    end
}
movement LastlightRoad_Movement_ScytherRunsAround
{
    walk_right
    walk_down
    jump_in_place_down * 2
    walk_left
    jump_in_place_up * 2
    walk_left
    walk_up
    walk_right * 2
    walk_down
    walk_left * 2
    walk_up
    walk_right
    jump_in_place_up * 2
    face_up
    step_end
}

script LastlightRoad_EventScript_Trainer_Lastlight_Harley
{
    trainerbattle_single(TRAINER_LASTLIGHT_HARLEY, LastlightRoad_Text_Trainer_Lastlight_HarleyIntro, LastlightRoad_Text_Trainer_Lastlight_HarleyDefeat)
