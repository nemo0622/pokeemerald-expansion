script KiposTown_EventScript_TyrantrumSign
{
    lock
    msgbox(format("Tyrantrum Complete Fossil Skeleton\n Estimated Age: 72 Million Years Ago\p Tyrantrum lived during the Late Cretaceous Period, ending 66 million years ago with a mass extinction event. This specimen was excavated in the Unova Region, but specimens of similar species have been found from Galar to Kalos."))
    closemessage
    release
    end
}

script KiposTown_EventScript_DirectionSign
{
    lock
    msgbox(format("Kipos Town\n For Nature, For People, Forever\p {UP_ARROW} Pythios Town\n Lastlight Road {DOWN_ARROW}\p Sunset Wildlife Conservation Center {RIGHT_ARROW}"))
    closemessage
    release
    end
}
