script MyrriniIsland_EventScript_HexManiac
{
    lock
    speakername("Crystal Girl")
    msgbox(format("Huff, huff... Come on, Zorua! We have to keep training!"))
    closemessage
    delay(20)
    applymovement(36, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    faceplayer
    speakername("Crystal Girl")

    // before anything else, if the quest is completed, just do a little dialogue line and end early
    questmenu(QUEST_MENU_CHECK_COMPLETE, QUEST_TRY_MYRRINI_BATTLE_PAVILION)
    if(var(VAR_RESULT) == 1) // quest is complete already
    {
        msgbox(format("If you can do well in the Battle Pavilion, so can Zorua and I! We're gonna be the best!"))
        closemessage
        release
        end
    }

    // by getting here, we know the quest isn't complete. Do different things based on the active status of the quest!
    questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_TRY_MYRRINI_BATTLE_PAVILION)
    if(var(VAR_RESULT) == 0) // quest not active yet! Activate it!
    {
        msgbox(format("Oh! Sorry, we were in an intense training match. Zorua tried their best, but the Battle Pavilion proved to be too much for it.\p Honestly, I'm not convinced the Battle Pavilion is even possible! If you {COLOR GREEN}participate in the Myrrini Battle Pavilion{COLOR DARK_GRAY}, let me know what you think."))
        closemessage

        delay(20)
        startquest(QUEST_TRY_MYRRINI_BATTLE_PAVILION)
    }
    else
    {
        msgbox(format("Hey, you're back! Have you tried the Battle Pavilion on Myrrini Island yet?"))
        closemessage

        delay(30)
        if(flag(FLAG_PLAYED_IN_MYRRINI_BATTLE_PAVILION))
        {
            speakername("Crystal Girl")
            msgbox(format("Oh, you actually did! And your Pokémon did alright?\p Okay, I'm convinced now! Zorua and I just need more training! Thanks for inspiring me. Take this!"))
            closemessage
            delay(5)
            giveitem(ITEM_REAPER_CLOTH)
            closemessage
            
            delay(20)
            completequest(QUEST_TRY_MYRRINI_BATTLE_PAVILION)
        }
        else
        {
            speakername("Crystal Girl")
            msgbox(format("Not yet, huh? I know, it's super intimidating!\p Come back once you've tried the {COLOR GREEN}Myrrini Battle Pavilion{COLOR DARK_GRAY}. Anyway, back to training!"))
            closemessage
        }
    }
    release
    end
}

