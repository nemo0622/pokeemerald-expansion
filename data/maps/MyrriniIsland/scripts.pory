mapscripts MyrriniIsland_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflag(FLAG_VISITED_MYRRINI_ISLAND)

        if(flag(FLAG_HIDE_CHIMERA_EVENT_MYRRINI_ISLAND)) // skips running script in ON_FRAME_TABLE, so the map label will show normally!
        {
            setvar(VAR_TEMP_1, 1)
        }

        if(flag(FLAG_CHIMERA_WEATHER_ACTIVE))
        {
            setweather(WEATHER_ABNORMAL)
        }

        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(46, ENCOUNTER_LAND)
        setobjectaswildencounter(47, ENCOUNTER_LAND)
        setobjectaswildencounter(48, ENCOUNTER_LAND)

        call(Route117_OnTransition)
    }

    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: MyrriniIsland_EventScript_TryChimeraEvent
    ]
}

script MyrriniIsland_EventScript_TryChimeraEvent
{
    setvar(VAR_TEMP_1, 1)
    if(flag(FLAG_BADGE05_GET) && !flag(FLAG_HIDE_CHIMERA_EVENT_MYRRINI_ISLAND))
    {
        goto(MyrriniIsland_EventScript_ChimeraEvent)
    }
    releaseall
    end
}

