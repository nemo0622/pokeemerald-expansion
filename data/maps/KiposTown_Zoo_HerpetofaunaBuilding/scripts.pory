script KiposTown_Zoo_EnvironmentSign_Herp_Swamp
{
    lock
    msgbox(format("Herpetofauna Enclosure No. 3: {COLOR GREEN}Mangrove Swamp{COLOR DARK_GRAY}\p A huge range of reptiles can be found in damp, semi-flooded areas. Pokémon found here vary from passing individuals looking for a drink to species which rely entirely on water. Amphibians, which rely largely on water, can also be found here.\p {COLOR GREEN}Water-type{COLOR DARK_GRAY} Pokémon and species which {COLOR GREEN}swim{COLOR DARK_GRAY} thrive in these ecosystems."))
    closemessage
    release
    end
}

