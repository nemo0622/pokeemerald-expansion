script KiposTown_Zoo_EnvironmentSign_Herp_Jungle
{
    lock
    msgbox(format("Herpetofauna Enclosure No. 2: {COLOR GREEN}Jungle{COLOR DARK_GRAY}\p The complex layers of canopy hanging over jungles allows for a complex ecosystem to form. Many reptiles make their homes here, ranging from small species hiding between leaves to massive, gentle giants.\p Only {COLOR GREEN}Herpetofauna (Reptiles and Amphibians){COLOR DARK_GRAY} are housed in this building. {COLOR GREEN}Grass and Normal-type{COLOR DARK_GRAY} Pokémon are most commonly found in these environments."))
    closemessage
    release
    end
}

