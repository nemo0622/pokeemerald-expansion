script KiposTown_Zoo_EnvironmentSign_Herp_Birds
{
    lock
    msgbox(format("Special Enclosure: {COLOR GREEN}Avian Encounter!{COLOR DARK_GRAY}\p Although traditionally kept separate from the category of Herpetofauna, birds are actually an evolutionary branch of reptiles! Here at the Conservation Center, we are allowing close contact with these species to help visitors form a connection with wildlife.\p {COLOR GREEN}Bird{COLOR DARK_GRAY} Pokémon can be found roaming inside. Take a seat and feel connected with nature!"))
    closemessage
    release
    end
}

script KiposTown_Zoo_EventScript_BirdPokemonInteraction_1
{
    lock
    faceplayer
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_1)
    playmoncry(VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_1, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The {STR_VAR_1} huffed out a greeting!"))
    closemessage
    release
    end
}
script KiposTown_Zoo_EventScript_BirdPokemonInteraction_2
{
    lock
    faceplayer
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_2)
    playmoncry(VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_2, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The {STR_VAR_1} huffed out a greeting!"))
    closemessage
    release
    end
}

// -------------------------------------------------------------------------------------------------------
//                                           NPC SCRIPTS
// -------------------------------------------------------------------------------------------------------

script KiposTown_Zoo_Building_NPC_BugCatcher
{
    lock
    faceplayer
    speakername("Bug Catcher")
    msgbox(format("Herpet- uhhh... Um, Herpayto- no, that's not right...\p Her-pet-o-fau-na... Hey, I did it! It's a weird name, but it's a grouping of {COLOR GREEN}reptiles and amphibians{COLOR DARK_GRAY}. Pretty cool!"))
    closemessage
    release
    end
}

script KiposTown_Zoo_Building_NPC_SchoolKid
{
    lock
    faceplayer
    speakername("School Kid")
    msgbox(format("We came on a school trip here a few weeks ago, right before Team Chimera came in and took all the Pokémon. Now, I keep tagging along with my parents to check up on the Zoo!"))
    closemessage
    release
    end
}

script KiposTown_Zoo_Building_NPC_BirdGirl
{
    lock
    faceplayer
    speakername("Bird Lady")
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_HRP_04_1) > 0)
    {
        msgbox(format("If I stay still enough, the birds are sure to come to me. I've always wanted one to land on me!"))
        closemessage
    }
    else
    {
        msgbox(format("I came in here to see the new bird exhibit, but the Pokémon are all gone! How am I gonna bond with the birds now?"))
        closemessage
    }
    release
    end
}