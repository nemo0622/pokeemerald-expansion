}
text PalatiCity_Gym_Text_Trainer_PalatiGym_RaimundIntro
{
    format("I found this nice little corner to sit in. I'll wait here until someone shows me the way out!")
}
text PalatiCity_Gym_Text_Trainer_PalatiGym_RaimundDefeat
{
    format("Ah, I remember now!")
}

