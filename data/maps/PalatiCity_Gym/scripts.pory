script PalatiGym_EventScript_GymMan
{
    lock
    faceplayer
    speakername("Gym Guide")
    if(flag(FLAG_BADGE07_GET))
    {
        msgbox(format("Incredible! You're a rising star! Keep it up, future Champ!"))
    }
    else
    {
        msgbox(format("Welcome to the Palati City Gym!\p Rhadine, the Gym Leader, uses {COLOR GREEN}Fire and Flying-type{COLOR DARK_GRAY} Pokémon. She only accepts challengers who bring her {COLOR GREEN}fresh Embers from all 3 torches around the Gym{COLOR DARK_GRAY}. If you leave the Gym, the Embers will {COLOR RED}burn out{COLOR DARK_GRAY}, and you'll have to collect them again."))
    }
    closemessage
    release
    end
}

script PalatiGym_EventScript_GymManWarnsPlayer
{
    lock
    faceplayer
    emote(1, EMOTE_EXCLAM)
    applymovement(1, Common_Movement_FaceLeft)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Gym Guide")
    msgbox(format("Hold up! You need to know how this Gym works first!\p {COLOR GREEN}Rhadine{COLOR DARK_GRAY} only accepts Trainers who can follow their hearts through the maze. To challenge her, you must find {COLOR GREEN}3 torches{COLOR DARK_GRAY} around the Gym and {COLOR GREEN}collect Embers{COLOR DARK_GRAY} from them.\p Be careful though! If you leave the Gym, your Embers will {COLOR RED}burn out{COLOR DARK_GRAY}, and you'll have to collect them all again. Good luck!"))
    closemessage
    applymovement(1, Common_Movement_FaceDown)
    waitmovement(0)
    setflag(FLAG_PALATI_GYM_INTRODUCED)
    releaseall
    end
}

script PalatiCity_Gym_EventScript_Trainer_PalatiGym_Mukhin
{
    trainerbattle_single(TRAINER_PALATIGYM_MUKHIN, PalatiCity_Gym_Text_Trainer_PalatiGym_MukhinIntro, PalatiCity_Gym_Text_Trainer_PalatiGym_MukhinDefeat)
    speakername("Mukhin")
    msgbox(format("Supposedly, there was once a labrynth on Kaptara Island which was home to a horrifying, mutated Tauros. But that's all a myth."))
    closemessage
    release
    end
}
text PalatiCity_Gym_Text_Trainer_PalatiGym_MukhinIntro
{
    format("They say this Gym is based on a legendary labrynth. I'm legendarily lost!")
}
text PalatiCity_Gym_Text_Trainer_PalatiGym_MukhinDefeat
{
    format("Uh oh!")
}

script PalatiCity_Gym_EventScript_Trainer_PalatiGym_Raimund
{
