// -----------------------------------------------------------------------------------------------------

script PalatiCity_Gym_EventScript_Toucannon
{
    lock
    faceplayer
    speakername("Toucannon")
    playmoncry(SPECIES_TOUCANNON, CRY_MODE_NORMAL)
    msgbox("Kyaah!")
    waitmoncry
    closemessage
    msgbox(format("Rhadine's Toucannon is resting on a nest, and Pikipek chirps are coming from behind it. Is a whole family of birds living here?"))
    closemessage
    release
    end
}

script PalatiCity_Gym_EventScript_Rhadine
{
    lock
    faceplayer

    if(!flag(FLAG_TEMP_5) || !flag(FLAG_TEMP_6) || !flag(FLAG_TEMP_7))
    {
        speakername("Rhadine")
        msgbox(format("Welcome to the Palati City Gym! I'm Rhadine, the Gym Leader.\p Before you challenge me, you must collect {COLOR GREEN}Embers from the 3 torches around the Gym{COLOR DARK_GRAY}. That'll prove your resolve!"))
        closemessage
        release
        end
    }

    if(!flag(FLAG_HARD_MODE))
    {
        goto(PalatiCity_Gym_EventScript_Rhadine_NormalDifficulty)
    }
    else
    {
        goto(PalatiCity_Gym_EventScript_Rhadine_HardDifficulty)
    }
    release
    end
}

script PalatiCity_Gym_EventScript_Rhadine_NormalDifficulty // called when on normal difficulty
{
    trainerbattle_single(TRAINER_LEADER_RHADINE, PalatiCity_Gym_Text_RhadineIntro, PalatiCity_Gym_Text_RhadineDefeat, PalatiCity_Gym_EventScript_Rhadine_DefeatedScript, NO_MUSIC)
    speakername("Rhadine")
    msgbox(format("Kehehe, your flames burn just as hot as mine!"))
    closemessage
    release
    end
}
script PalatiCity_Gym_EventScript_Rhadine_HardDifficulty // called when on hard difficulty
{
    trainerbattle_single(TRAINER_LEADER_RHADINE_HARD, PalatiCity_Gym_Text_RhadineIntro, PalatiCity_Gym_Text_RhadineDefeat, PalatiCity_Gym_EventScript_Rhadine_DefeatedScript, NO_MUSIC)
    speakername("Rhadine")
    msgbox(format("Kehehe, your flames burn just as hot as mine!"))
    closemessage
    release
    end
}
text PalatiCity_Gym_Text_RhadineIntro
{
    format("Yes, I can feel the heat radiating from you. You've collected Embers from all 3 torches and completed the labrynth!\p I'm Rhadine, Muse of Passion and Freedom. I only accept challenges from the most driven Trainers, and here you are, shining before me! Show me the love you share with your Pokémon!")
}
text PalatiCity_Gym_Text_RhadineDefeat
{
    format("Beautiful! I'd expect nothing less from you!")
}
// Script called when you defeat the gym leader!
script PalatiCity_Gym_EventScript_Rhadine_DefeatedScript
{
    setflag(FLAG_SUPPRESS_SPEAKER_NAME) // fixes message bug i think
    message(format("{PLAYER} received the Passion Badge from Rhadine."))
	waitmessage
	call(Common_EventScript_PlayGymBadgeFanfare)

    // Set gym completion flags
    setflag(FLAG_BADGE07_GET)
    // Set all trainers in Gym as defeated
    settrainerflag(TRAINER_PALATIGYM_MUKHIN)
    settrainerflag(TRAINER_PALATIGYM_RAIMUND)
    settrainerflag(TRAINER_PALATIGYM_MELINA)
    settrainerflag(TRAINER_PALATIGYM_JULIE)
    settrainerflag(TRAINER_PALATIGYM_COLETTE)

    // Explain badge
    speakername("Rhadine")
    msgbox(format("Kehehe, even in here, the Passion Badge shines like the sun! With this achievement, you'll be able to use the {COLOR GREEN}HM Fly{COLOR DARK_GRAY} to cross the region in an instant.\p Before you go, please, take this!"))
    closemessage

    // Give TM reward and explain, plus end dialogue
    giveitem(ITEM_TM_FLAMETHROWER)
    speakername("Rhadine")
    msgbox(format("That TM contains the move {COLOR GREEN}Flamethrower{COLOR DARK_GRAY}! It's one of the most reliable, powerful Fire-type moves a Pokémon can learn.\p Normally, I'd send Trainers on their way to the 8th Gym, but the Gym Leader has gone missing. No, that's not quite right. Euterpe told me what happened on {COLOR GREEN}Myrrini Island{COLOR DARK_GRAY}. {COLOR RED}Kalliope{COLOR DARK_GRAY}, the 8th Gym Leader, is the {COLOR RED}leader of Team Chimera{COLOR DARK_GRAY}.\p To tell the truth, I've been hearing about you from the other Gym Leaders, {PLAYER}."))
    closemessage
    emote(OBJ_EVENT_ID_PLAYER, EMOTE_EXCLAM)
    speakername("Rhadine")
    msgbox(format("Ehehe, come now, it's not that surprising! You've been sweeping through the Gyms and teaching Team Chimera lessons as you go. How could I NOT hear about you?\p Us Gym Leaders have been planning a way to {COLOR GREEN}strike back against Team Chimera{COLOR DARK_GRAY}. We have to stop them before their plans come to fruition, and we could use your help! We'll surround them at Areios Hideo-"))
    closemessage
    delay(5)
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_ExclamationMark)
    applymovement(3, Common_Movement_ExclamationMark)
    msgbox(format("BA-BOOOM!!!"))
    waitmovement(0)
    closemessage
    delay(5)
    speakername("Rhadine")
    msgbox(format("Was that... {PLAYER}, that was a thunderclap! But that can only mean...\p Quick! Come with me!"))
    closemessage

    // complete gym quest and begin next one
    delay(20)
    completequest(QUEST_GYM_7)
    setflag(FLAG_CHIMERA_WEATHER_ACTIVE)
    clearflag(FLAG_HIDE_RHADINE_PALATI_CITY)
    clearflag(FLAG_HIDE_ACROPOLIS_LEGENDARY_DOGS)
    setflag(FLAG_HIDE_SOFOS_ACROPOLIS_NPCS)
    setflag(FLAG_HIDE_ACROPOLIS_LEGENDARY_BEASTS)
    clearflag(FLAG_HIDE_ACROPOLIS_CHIMERA_MEMBERS)
    setflag(FLAG_HIDE_MAP_NAME_POPUP)

    warp(MAP_PALATI_CITY, 41, 37)
    waitstate

    release
    end
}
