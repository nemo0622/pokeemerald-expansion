mapscripts PalatiCity_Gym_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setflashlevel(1)
    }
}

script PalatiGym_EventScript_Torch1
{
    lock
    if(flag(FLAG_TEMP_5)) // if torch is on
    {
        msgbox(format("The torch is glowing brightly, pulsing with heat."))
        closemessage
    }
    else
    {
        msgbox(format("It's one of Rhadine's Torches!\p You took an Ember from the torch. To face Rhadine, Embers from {COLOR GREEN}all 3 torches{COLOR DARK_GRAY} must be taken."))
        closemessage
        setflag(FLAG_TEMP_5)
    }
    release
    end
}

