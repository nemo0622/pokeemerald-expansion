    msgbox(format("That Amaze Mulch is good for more Berry growing, but we thought a Shiny Charm would be a nice extra reward! That's a rare item that makes Shiny Pokémon more common!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Artist")
    msgbox(format("Thank you for everything you do for the Jusmail Town Berry Club, darling. {COLOR GREEN}Keep planting{COLOR DARK_GRAY} Berries and caring for them, and we'll have {COLOR GREEN}more gifts{COLOR DARK_GRAY} for you."))
    closemessage

    delay(20)
    completequest(QUEST_PLANT_100_BERRIES)
    delay(20)
    startquest(QUEST_PLANT_200_BERRIES)

    warpsilent(MAP_JUSMAIL_TOWN_HOUSE1, 6, 9)
    waitstate
    goto(JusmailTown_House1_EventScript_EndScript)
    releaseall
    end
}

script JusmailTown_House1_EventScript_EnterBuilding_200BerryTreeReward
{
    lockall
    applymovement(1, Common_Movement_FaceRight)
    applymovement(2, Common_Movement_FaceDown)
    applymovement(3, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(1, Common_Movement_ExclamationMark)
    applymovement(2, Common_Movement_ExclamationMark)
    applymovement(3, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    applymovement(1, JusmailTown_House1_Movement_ArtistGreetsPlayer)
    applymovement(2, JusmailTown_House1_Movement_PsychicGreetsPlayer)
    applymovement(3, JusmailTown_House1_Movement_BeautyGreetsPlayer)
    delay(60)

    speakername("Group")
    msgbox(format("Opa, opa!! It's {PLAYER}!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)

    speakername("Artist")
    msgbox(format("Berries have never been more popular in Ilios, all thanks to you!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Psychic")
    msgbox(format("People are coming to Jusmail Town just to visit the Berru Club! We've started more research and even gotten into public education. People are really starting to take Berries seriously!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Beauty")
    msgbox(format("Nothing we give could repay what you've done for us. We've been raising a special Pokémon here, so maybe this can be a start!"))
    closemessage

    setflag(FLAG_GOT_BERRY_CLUB_REWARD_200)
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_ARCHEN)
	givemon(SPECIES_ARCHEN, 50, ITEM_YACHE_BERRY, ITEM_POKE_BALL, NATURE_ADAMANT, 2, MON_FEMALE, 0, 252, 4, 252, 0, 0, 31, 31, 31, 31, 31, 31, MOVE_DUAL_WINGBEAT, MOVE_U_TURN, MOVE_ROCK_SLIDE, MOVE_DRAGON_DANCE)

	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("{PLAYER} received the fruit-eating Archen!"))
	waitfanfare
	closemessage

    speakername("Beauty")
    msgbox(format("That Archen has {COLOR GREEN}special moves{COLOR DARK_GRAY} learned from growing up around all these Berries. Make sure to take care of it!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Artist")
    msgbox(format("{PLAYER}, I've had an idea! Here darling, hand me your Trainer Card."))
    closemessage

    delay(30)
    playfanfare(MUS_OBTAIN_ITEM)
    msgbox(format("{PLAYER} received a Trainer Card Gold Star!"))
    waitfanfare
    closemessage
    delay(30)

    speakername("Artist")
    msgbox(format("There, you've {COLOR GREEN}earned a star{COLOR DARK_GRAY} for your Trainer Card. That represents your status as an elite Berry grower!\p Thank you for everything you've done, {PLAYER}. Remember to never stop caring about the environment! And of course, keep coming to visit us, darling!"))
    closemessage

    delay(20)
    special(DoDomeConfetti)
    completequest(QUEST_PLANT_200_BERRIES)

    warpsilent(MAP_JUSMAIL_TOWN_HOUSE1, 6, 9)
    waitstate
    goto(JusmailTown_House1_EventScript_EndScript)
    releaseall
    end
}

// ---------------------------------------------------------------------------------------------------

script JusmailTown_House1_EventScript_CheckBerryTreeRecord
{
    lock
    if(var(VAR_BERRY_TREES_PLANTED) == 0)
    {
        bufferstring(STR_VAR_1, "0")
    }
    else
    {
        buffernumberstring(STR_VAR_1, VAR_BERRY_TREES_PLANTED)
    }
    msgbox(format("Jusmail Town Berry Club - Berry Tree Records\p {PLAYER}'s Trees: {STR_VAR_1} Planted!"))
    closemessage
    release
    end
}