}

// ----------------------------------------- BERRY TREE REWARD EVENTS ---------------------------

script JusmailTown_House1_EventScript_EnterBuilding_20BerryTreeReward
{
    lockall
    applymovement(1, Common_Movement_FaceRight)
    applymovement(2, Common_Movement_FaceDown)
    applymovement(3, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(1, Common_Movement_ExclamationMark)
    applymovement(2, Common_Movement_ExclamationMark)
    applymovement(3, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    applymovement(1, JusmailTown_House1_Movement_ArtistGreetsPlayer)
    applymovement(2, JusmailTown_House1_Movement_PsychicGreetsPlayer)
    applymovement(3, JusmailTown_House1_Movement_BeautyGreetsPlayer)
    delay(60)

    speakername("Group")
    msgbox(format("{PLAYER}! Chaire!!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)

    speakername("Artist")
    msgbox(format("Let me see your Wailmer Pail!\p Mhm, just as I thought, plenty of use. You must be growing Berries!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Psychic")
    msgbox(format("It's not that common for people to really care about Berries like we do! We were talking, and we think it would be nice to reward you somehow."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Beauty")
    msgbox(format("We've gotten into contact with fellow Berry-growers from other regions, and they've sent us these samples. We want you to have them!"))
    closemessage

    giveitem(ITEM_CHILAN_BERRY, 1)
    giveitem(ITEM_HABAN_BERRY, 1)
    giveitem(ITEM_ROSELI_BERRY, 1)
    setflag(FLAG_GOT_BERRY_CLUB_REWARD_20)

    speakername("Beauty")
    msgbox(format("Those Berries can help your Pokémon resist powerful moves of certain types.\p Remember, these are {COLOR GREEN}one of a kind{COLOR DARK_GRAY}, so make sure to plant them and grow more before using them!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Artist")
    msgbox(format("The more Berries you plant, the more people notice, darling! {COLOR GREEN}Keep planting{COLOR DARK_GRAY} Berries and caring for them, and we'll have {COLOR GREEN}more gifts{COLOR DARK_GRAY} for you."))
    closemessage

    delay(20)
    completequest(QUEST_PLANT_20_BERRIES)
    delay(20)
    startquest(QUEST_PLANT_50_BERRIES)

    warpsilent(MAP_JUSMAIL_TOWN_HOUSE1, 6, 9)
    waitstate
    goto(JusmailTown_House1_EventScript_EndScript)
    releaseall
    end
}

script JusmailTown_House1_EventScript_EnterBuilding_50BerryTreeReward
{
    lockall
    applymovement(1, Common_Movement_FaceRight)
    applymovement(2, Common_Movement_FaceDown)
    applymovement(3, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(1, Common_Movement_ExclamationMark)
    applymovement(2, Common_Movement_ExclamationMark)
    applymovement(3, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    applymovement(1, JusmailTown_House1_Movement_ArtistGreetsPlayer)
    applymovement(2, JusmailTown_House1_Movement_PsychicGreetsPlayer)
    applymovement(3, JusmailTown_House1_Movement_BeautyGreetsPlayer)
    delay(60)

    speakername("Group")
    msgbox(format("{PLAYER}! Welcome back!!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)

    speakername("Artist")
    msgbox(format("Just look at your Berry pouch of your Bag, darling! Residue from so many Berries!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    speakername("Psychic")
    msgbox(format("We've started to get some more recognition thanks to your Berry-planting efforts! You really must have been busy."))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)
    speakername("Beauty")
    msgbox(format("We caught this Pokémon feeding on some of our Berries recently. You're the best trainer in the Berry Club, so we figured you should have it!"))
    closemessage

    setflag(FLAG_GOT_BERRY_CLUB_REWARD_50)
    setvar(VAR_TEMP_TRANSFERRED_SPECIES, SPECIES_WOOBAT)
	givemon(SPECIES_WOOBAT, 20, ITEM_SITRUS_BERRY, ITEM_POKE_BALL, NATURE_MODEST, 2, MON_MALE, 0, 0, 0, 252, 252, 0, 31, 31, 31, 31, 31, 31, MOVE_CHATTER, MOVE_DRAINING_KISS, MOVE_STUFF_CHEEKS, MOVE_ESPER_WING)

	playfanfare(MUS_OBTAIN_ITEM)
	msgbox(format("{PLAYER} received the fruit-eating Woobat!"))
	waitfanfare
	closemessage

    speakername("Beauty")
    msgbox(format("That Woobat has {COLOR GREEN}special moves{COLOR DARK_GRAY} that none of us have seen the species use before. Maybe it can help you on your adventure!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    speakername("Artist")
    msgbox(format("Berries in the Ilios Region are getting more popular! {COLOR GREEN}Keep planting{COLOR DARK_GRAY} Berries and caring for them, and we'll have {COLOR GREEN}more gifts{COLOR DARK_GRAY} for you."))
    closemessage

    delay(20)
    completequest(QUEST_PLANT_50_BERRIES)
    delay(20)
    startquest(QUEST_PLANT_100_BERRIES)

    warpsilent(MAP_JUSMAIL_TOWN_HOUSE1, 6, 9)
    waitstate
    goto(JusmailTown_House1_EventScript_EndScript)
    releaseall
    end
}

