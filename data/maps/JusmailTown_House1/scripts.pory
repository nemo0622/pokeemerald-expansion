script JusmailTown_House1_EventScript_Psychic
{
    lock
    faceplayer
    speakername("Psychic")
    message(format("Welcome back to the Berry Club. Looking for some Mulch?"))
    waitmessage
    pokemart(JusmailTown_House1_Mart_Mulch)
    applymovement(2, Common_Movement_FacePlayer)
    waitmovement(0)
    speakername("Psychic")
    msgbox(format("Well, have fun with your Mulch! If you end up {COLOR GREEN}harvesting many Berry Trees{COLOR DARK_GRAY}, let us know! We might have a {COLOR GREEN}reward{COLOR DARK_GRAY} for you, ehehe!"))
    closemessage
    release
    end
}

mart JusmailTown_House1_Mart_Mulch
{
    ITEM_GROWTH_MULCH
    ITEM_DAMP_MULCH
    ITEM_RICH_MULCH
    ITEM_SURPRISE_MULCH
    ITEM_BOOST_MULCH
