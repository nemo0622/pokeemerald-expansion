    waitmovement(0)
    speakername("Psychic")
    msgbox(format("We just finished a regional Berry sampling study with Acrisia University, and the records show you've {COLOR GREEN}planted over 100 Berry Trees{COLOR DARK_GRAY}!"))
    closemessage
