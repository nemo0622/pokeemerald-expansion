mapscripts JusmailTown_House1_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_TEMP_1, 0: JusmailTown_House1_EventScript_CheckStatus
    ]
}

script JusmailTown_House1_EventScript_CheckStatus
{
    setvar(VAR_TEMP_1, 1)
    if(!flag(FLAG_GOT_WAILMER_PAIL)) // introductory scene
    {
        goto(JusmailTown_House1_EventScript_EnterBuildingForFirstTime)
    }
    elif(!flag(FLAG_GOT_BERRY_CLUB_REWARD_20) && var(VAR_BERRY_TREES_PLANTED) >= 20)
    {
        goto(JusmailTown_House1_EventScript_EnterBuilding_20BerryTreeReward)
    }
    elif(!flag(FLAG_GOT_BERRY_CLUB_REWARD_50) && var(VAR_BERRY_TREES_PLANTED) >= 50)
    {
        goto(JusmailTown_House1_EventScript_EnterBuilding_50BerryTreeReward)
    }
    elif(!flag(FLAG_GOT_BERRY_CLUB_REWARD_100) && var(VAR_BERRY_TREES_PLANTED) >= 100)
    {
        goto(JusmailTown_House1_EventScript_EnterBuilding_100BerryTreeReward)
    }
    elif(!flag(FLAG_GOT_BERRY_CLUB_REWARD_200) && var(VAR_BERRY_TREES_PLANTED) >= 200)
    {
        goto(JusmailTown_House1_EventScript_EnterBuilding_200BerryTreeReward)
    }
    else
    {
        goto(JusmailTown_House1_EventScript_EndScript)
    }
    releaseall
    end
}

script JusmailTown_House1_EventScript_Herdier
{
    lock
    faceplayer
    speakername("Herdier")
    playmoncry(SPECIES_HERDIER, CRY_MODE_NORMAL)
    msgbox("Arf arf!")
    waitmoncry
    closemessage
    release
    end
}

script JusmailTown_House1_EventScript_Pumpkaboo
{
    lock
    faceplayer
    speakername("Pumpkaboo")
    playmoncry(SPECIES_PUMPKABOO, CRY_MODE_NORMAL)
    msgbox("Ke ke ke!")
    waitmoncry
    closemessage
    release
    end
}

script JusmailTown_House1_EventScript_EnterBuildingForFirstTime
{
    lockall
    applymovement(1, Common_Movement_FaceRight)
    applymovement(2, Common_Movement_FaceDown)
    applymovement(3, Common_Movement_FaceDown)
    waitmovement(0)
    applymovement(1, Common_Movement_ExclamationMark)
    applymovement(2, Common_Movement_ExclamationMark)
    applymovement(3, Common_Movement_ExclamationMark)
    waitmovement(0)
    delay(10)
    applymovement(1, JusmailTown_House1_Movement_ArtistGreetsPlayer)
    applymovement(2, JusmailTown_House1_Movement_PsychicGreetsPlayer)
    applymovement(3, JusmailTown_House1_Movement_BeautyGreetsPlayer)
    delay(60)

    speakername("Group")
    msgbox(format("Opa, opa! Welcome to the Jusmail Town Berry Club!!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)
    
    if(!flag(FLAG_BADGE01_GET)) // dont have badge 1 yet
    {
        speakername("Artist")
        msgbox(format("What's this? I can't smell the scent of fresh grass and fruits on you... you must not have fought Deo yet! Oh no no NO, this won't do!\p Come back when you've {COLOR GREEN}beaten the Jusmail Town Gym Leader{COLOR DARK_GRAY}, darling."))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        waitmovement(0)
        speakername("Beauty")
        msgbox(format("Don't take it to heart, hon. It's just the rule of the owner, he gets a little, well, intense."))
        closemessage

        warpsilent(MAP_JUSMAIL_TOWN, 10, 14)
        waitstate
    }
    else // ready!
    {
        speakername("Artist")
        msgbox(format("Mmmm, that smell... grass, fruit, a hint of honey... you must have beaten Deo! Congratulations!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
        waitmovement(0)
        speakername("Psychic")
        msgbox(format("You're now an official member of the Jusmail Town Berry Club! Uh, if that's alright with you, of course..."))
        closemessage
        applymovement(1, Common_Movement_ExclamationMark)
        waitmovement(0)
        delay(20)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
        waitmovement(0)
        speakername("Artist")
        msgbox(format("Of course they're alright with it! This is the largest recognized Berry enthusiast club in town! That means a great deal to people like us!\p Pardon my outburst, darling... erm, I suppose I shouldn't call you that forever. What's your name?"))
        closemessage
        delay(60)
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        waitmovement(0)
        speakername("Beauty")
        msgbox(format("Well it's nice to actually meet you, {PLAYER}! Here's a little something to get you started on your Berry-growing journey."))
        closemessage

        giveitem(ITEM_WAILMER_PAIL)
        setflag(FLAG_GOT_WAILMER_PAIL)

        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
        waitmovement(0)
        speakername("Artist")
        msgbox(format("We're dedicated to growing Berries all around Ilios. Here, we sell {COLOR GREEN}Mulch{COLOR DARK_GRAY} to enhance the soil, plus {COLOR GREEN}Berries and Mints{COLOR DARK_GRAY} to help your Pokémon!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceRight)
        waitmovement(0)
        speakername("Psychic")
        msgbox(format("Berries here have some extra complexity. The soil needs to be kept moist and can be helped with our Mulch, and it's important to keep weeds and pests away from the plants. Berries can also hybridize, producing rare, {COLOR GREEN}damage-reducing Berry varieties{COLOR DARK_GRAY}!"))
        closemessage
        applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceUp)
        waitmovement(0)
        speakername("Beauty")
        msgbox(format("Okay, okay, we've talked your ear off long enough. Glad to have you here!"))
        closemessage

        delay(20)
        startquest(QUEST_PLANT_20_BERRIES)

        warpsilent(MAP_JUSMAIL_TOWN_HOUSE1, 6, 9)
        waitstate
        goto(JusmailTown_House1_EventScript_EndScript)
    }
    releaseall
    end
}

script JusmailTown_House1_EventScript_EndScript
{
    lockall
    delay(10)
    releaseall
    end
}

movement JusmailTown_House1_Movement_ArtistGreetsPlayer
{
    jump_right * 2
    walk_fast_down * 4
    walk_fast_right * 3
    face_right
    step_end
}

movement JusmailTown_House1_Movement_PsychicGreetsPlayer
{
    walk_fast_down * 2
    walk_fast_left
    face_left
    step_end
}

movement JusmailTown_House1_Movement_BeautyGreetsPlayer
{
    walk_fast_down
    walk_fast_right
    walk_fast_down
    face_down
    step_end
}



script JusmailTown_House1_EventScript_Artist
{
    lock
    faceplayer
    speakername("Artist")
    message(format("Welcome back to the Berry Club, darling! How can I help you?"))
    waitmessage
    pokemart(JusmailTown_House1_Mart_Mints)
    applymovement(1, Common_Movement_FacePlayer)
    waitmovement(0)
    speakername("Artist")
    msgbox(format("Come on back! Don't make me jump the counter again!"))
    closemessage
    release
    end
}

