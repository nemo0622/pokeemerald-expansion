    applymovement(2, JusmailTown_House1_Movement_PsychicGreetsPlayer)
    applymovement(3, JusmailTown_House1_Movement_BeautyGreetsPlayer)
    delay(60)

    speakername("Group")
    msgbox(format("Chaire, {PLAYER}! Welcome back!"))
    closemessage
    applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_FaceLeft)
    waitmovement(0)

    speakername("Artist")
    msgbox(format("Is that... it is! Mulch on your hands! Ehehe, I knew you were a real Berry fan, darling!"))
