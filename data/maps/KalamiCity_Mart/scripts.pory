mapscripts KalamiCity_Mart_MapScripts {}

script KalamiCity_Mart_EventScript_MartEmployee
{
    lock
    faceplayer
    speakername("Mart Employee")
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(KalamiCity_Mart_Shop)
    closemessage
    delay(1)
    speakername("Mart Employee")
    msgbox(gText_PleaseComeAgain)
    release
    end
}

mart KalamiCity_Mart_Shop
{
    ITEM_POKE_BALL
	ITEM_GREAT_BALL
	ITEM_POTION
	ITEM_SUPER_POTION
	ITEM_ANTIDOTE
	ITEM_PARALYZE_HEAL
	ITEM_ESCAPE_ROPE
	ITEM_REPEL
}

script KalamiCity_Mart_EventScript_BallMartEmployee
{
    lock
    faceplayer
    speakername("Mart Employee")
    message(gText_HowMayIServeYou)
    waitmessage
    pokemart(KalamiCity_Mart_BallShop)
    closemessage
    delay(1)
    speakername("Mart Employee")
    msgbox(gText_PleaseComeAgain)
    release
    end
}

mart KalamiCity_Mart_BallShop
{
    ITEM_HEAL_BALL
    ITEM_NET_BALL
    ITEM_NEST_BALL
    ITEM_DIVE_BALL
    ITEM_DUSK_BALL
    ITEM_TIMER_BALL
    ITEM_QUICK_BALL
    ITEM_REPEAT_BALL
    ITEM_LUXURY_BALL
    ITEM_LEVEL_BALL
    ITEM_LURE_BALL
    ITEM_MOON_BALL
    ITEM_FRIEND_BALL
    ITEM_LOVE_BALL
    ITEM_FAST_BALL
    ITEM_HEAVY_BALL
    ITEM_DREAM_BALL
}

script KalamiCity_Mart_EventScript_HexManiac
{
    lock
    faceplayer
    speakername("Hex Maniac")
    msgbox(format("Mattaios and his Gym helps produce a ton of new Poké ball types! We have a shopkeeper dedicated to some of them here."))
    closemessage
    release
    end
}

script KalamiCity_Mart_EventScript_Girl
{
    lock
    faceplayer
    speakername("Lass")
    msgbox(format("Ehh, do I really need a sweet treat?\p ...Of course I do!"))
    closemessage
    release
    end
}
