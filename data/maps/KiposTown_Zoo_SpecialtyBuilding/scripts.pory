script KiposTown_Zoo_EnvironmentSign_Indoors_Gymnasium
{
    lock
    msgbox(format("Indoors Enclosure No. 2: {COLOR GREEN}Gymnasium{COLOR DARK_GRAY}\p Although they are human-constructed environments, Gymnasiums provide important training locations for a wide range of physically active Pokémon. To further enrich their activity, please feel free to engage with these Pokémon during their training, while staying respectful of their boundaries!\p Traditionally, most Pokémon that take extra time to physically train are {COLOR GREEN}Fighting-type{COLOR DARK_GRAY} species. Certain other {COLOR GREEN}physically fit{COLOR DARK_GRAY} Pokémon also enjoy training in this enclosure."))
    closemessage
    release
    end
}

