mapscripts KiposTown_Zoo_SpecialtyBuilding_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        special(UpdateZooGraphics_SpecialtyBuilding)
    }
}

// -------------------------------------- INDOOR ENCLOSURE 01: Warm Water ---------------------------------------------------
script KiposTown_Zoo_PokemonSign_Indoor_WarmWater
{
    lock

    // buffer species names for initial sign info
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1)
    bufferspeciesname(STR_VAR_2, VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2)
    bufferspeciesname(STR_VAR_3, VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3)
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1) == 0) // no Pokémon in slot 1
    {
        bufferstring(STR_VAR_1, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2) == 0) // no Pokémon in slot 2
    {
        bufferstring(STR_VAR_2, "---")
    }
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3) == 0) // no Pokémon in slot 3
    {
        bufferstring(STR_VAR_3, "---")
    }

    // ------------ BASIC ENCLOSURE INFO CODE ------------
    msgbox(format("Indoors Enclosure No. 1: Warm Water\n Pokémon in Exhibit: {STR_VAR_1}, {STR_VAR_2}, {STR_VAR_3}"))
    closemessage

    // ------------ DISPLAY MORE INFO CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1) > 0) // AT LEAST ONE Pokémon in enclosure
    {
        // Offer reading Pokédex entries
        msgbox(format("There's information about each Pokémon listed. Read it?"), MSGBOX_YESNO)
        closemessage
        if(var(VAR_RESULT) == 1) // said yes to more information
        {
            copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1) // loads species into VAR_0x8003
            special(ShowSpeciesZooInfoWindow)
            delay(30)
            waitbuttonpress
            special(CloseSpeciesZooInfoWindow)

            if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }

            if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3) > 0)
            {
                delay(20)
                copyvar(VAR_0x8003, VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3) // loads species into VAR_0x8003
                special(ShowSpeciesZooInfoWindow)
                delay(30)
                waitbuttonpress
                special(CloseSpeciesZooInfoWindow)
            }
        }
    }

    // ------------ OFFER DONATIONS CODE ------------
    if(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 32) // Indoor Enclosure #1, Pokémon 1 - VAR_ZOO_POKEMON_ENCLOSURE_IN_01_1

        msgbox(format("There are no Pokémon in the exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 33) // Indoor Enclosure #1, Pokémon 2 - VAR_ZOO_POKEMON_ENCLOSURE_IN_01_2

        msgbox(format("There is room for a second Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }
    elif(var(VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3) == 0)
    {
        // Set which zoo pokemon variable is being interacted with
        setvar(VAR_TEMP_0, 34) // Indoor Enclosure #1, Pokémon 3 - VAR_ZOO_POKEMON_ENCLOSURE_IN_01_3

        msgbox(format("There is room for a third Pokémon in this exhibit. Would you like to {COLOR GREEN}donate a Pokémon to the exhibit{COLOR DARK_GRAY}?"), MSGBOX_YESNO)
        closemessage
        goto_if_eq(VAR_RESULT, TRUE, KiposTown_Zoo_PokemonSign_DonationScript) // if yes, donate!
    }

    releaseall
    end
}

script KiposTown_Zoo_EnvironmentSign_Indoors_WarmWater
{
    lock
    msgbox(format("Indoors Enclosure No. 1: {COLOR GREEN}Warm Water{COLOR DARK_GRAY}\p Due to the sheer abundance of Pokémon species living in water biomes, the Conservation Center has reserved an extra area to be a home for these amazing Pokémon! Preserving these habitats is a key component of our mission, saving threatened ecosystems and species alike from complete extinction.\p {COLOR GREEN}Water-type{COLOR DARK_GRAY} Pokémon, true to their name, are most commonly found here. Furthermore, many Pokémon associated with {COLOR GREEN}semi-aquatic lifestyles{COLOR DARK_GRAY} can be seen splashing through the waves."))
    closemessage
    release
    end
}

