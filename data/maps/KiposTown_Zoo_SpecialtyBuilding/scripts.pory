script KiposTown_Zoo_EnvironmentSign_Indoors_SpiritCenter
{
    lock
    msgbox(format("Indoors Enclosure No. 3: {COLOR GREEN}Spirit Center{COLOR DARK_GRAY}\p Many Pokémon have deep connections to powers beyond our understanding. This enclosure allows for human-Pokémon contact in their preferred habitat, around decaying logs and replicas of old ruins. Contact with humans has been deemed safe for these tamed individuals, but please be respectful of their space and intelligence.\p {COLOR GREEN}Psychic and Ghost-type{COLOR DARK_GRAY} Pokémon love this area, alongside other Pokémon with {COLOR GREEN}strong spiritual powes{COLOR DARK_GRAY}."))
    closemessage
    release
    end
}

script KiposTown_Zoo_EventScript_FightingPokemonInteraction_1
{
    lock
    faceplayer
    bufferspeciesname(STR_VAR_1, VAR_ZOO_POKEMON_ENCLOSURE_IN_02_1)
    playmoncry(VAR_ZOO_POKEMON_ENCLOSURE_IN_02_1, CRY_MODE_NORMAL)
    waitmoncry
    msgbox(format("The {STR_VAR_1} huffed out a greeting!"))
    closemessage
    release
    end
}
