mapscripts RiverwalkTrail_West_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_1)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_2)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_3)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_4)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_5)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_6)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_7)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_8)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_9)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_10)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_11)
        clearflag(FLAG_HIDE_OVERWORLD_ENCOUNTER_FLAG_12)
        setobjectaswildencounter(10, ENCOUNTER_LAND)
        setobjectaswildencounter(11, ENCOUNTER_LAND)
        setobjectaswildencounter(12, ENCOUNTER_LAND)
        setobjectaswildencounter(13, ENCOUNTER_LAND)
        setobjectaswildencounter(14, ENCOUNTER_LAND)
    }
}

script RiverwalkTrail_West_EventScript_DirectionSign
{
    lock
    msgbox(format("Riverwalk Trail - West\n The Steep Hiking Trail\p {LEFT_ARROW} Acrisia City\n Riverwalk Trail - South {DOWN_ARROW}"))
    closemessage
    release
    end
}

script RiverwalkTrail_West_EventScript_UniversityStudentRouteCheck
{
    lock
    faceplayer
    speakername("Uni. Student")

    if(flag(FLAG_CAUGHT_ALL_MONS_RIVERWALK))
    {
        msgbox(format("Your Pokédex data is amazing! Now we know more about the local ecosystem, thanks to you."))
        closemessage
    }
    else
    {
        msgbox(format("Chaire! I'm a student from the Acrisia University.\p I'm looking for {COLOR GREEN}Pokédex data{COLOR DARK_GRAY} of {COLOR GREEN}all Land Pokémon{COLOR DARK_GRAY} found in the Riverwalk Trail West and South areas. If you've caught all the Pokémon here, please let me know."))
        closemessage
        special(CheckRouteCaptureProgress)
        if(var(VAR_RESULT) == TRUE) // caught all mons on the route!
        {
            delay(20)
            emote(VAR_LAST_TALKED, EMOTE_EXCLAM)
            speakername("Uni. Student")
            msgbox(format("Incredible! You've caught all the Pokémon that I requested in the area!\p Here's a reward from the University. Keep up your hard work!"))
            closemessage
            delay(5)

            // give reward!
            giveitem(ITEM_EVIOLITE)
            closemessage

            setflag(FLAG_CAUGHT_ALL_MONS_RIVERWALK)
        }
    }

    release
    end
}

script RiverwalkTrail_West_EventScript_ManCrossedBridge
{
    lock
    faceplayer
    speakername("PokéManiac")
    msgbox(format("Ahahaha, yes! I did it! I crossed the bridge and found a new area to catch Pokémon!\p This trail leads into a marshland and Kalami City. Who knows what I'll find!"))
    closemessage
    release
    end
}

script RiverwalkTrail_West_EventScript_TRAINER_RIVERWALK_TRAIL_W_JOSUA
{
    trainerbattle_single(TRAINER_RIVERWALK_TRAIL_W_JOSUA, RiverwalkTrail_West_Text_TRAINER_RIVERWALK_TRAIL_W_JOSUAIntro, RiverwalkTrail_West_Text_TRAINER_RIVERWALK_TRAIL_W_JOSUADefeat)
    speakername("Josua")
    msgbox(format("People often go to the Acrisia Mountains to train. The Trainers there can help prepare your Pokémon for Riverwalk Trail."))
    closemessage
    release
    end
}
text RiverwalkTrail_West_Text_TRAINER_RIVERWALK_TRAIL_W_JOSUAIntro
{
    format("I'm a step above the Trainers in the Bronze Fields! I hope you've been training!")
}
text RiverwalkTrail_West_Text_TRAINER_RIVERWALK_TRAIL_W_JOSUADefeat
{
    format("Wow! Have you been to the Acrisia Mountains yet?")
}

script RiverwalkTrail_WEST_EventScript_Trainer_RiverwalkTrail_WEST_Umber
{
    trainerbattle_single(TRAINER_RIVERWALK_TRAIL_W_UMBER, RiverwalkTrail_WEST_Text_Trainer_RiverwalkTrail_WEST_UmberIntro, RiverwalkTrail_WEST_Text_Trainer_RiverwalkTrail_WEST_UmberDefeat)
    speakername("Umber")
    msgbox(format("I was hoping my Pokémon was magic somehow!"))
    closemessage
    release
    end
}
text RiverwalkTrail_WEST_Text_Trainer_RiverwalkTrail_WEST_UmberIntro
{
    format("Don't freak out, but... I think my Pokémon is from space.")
}
text RiverwalkTrail_WEST_Text_Trainer_RiverwalkTrail_WEST_UmberDefeat
