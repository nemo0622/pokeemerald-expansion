mapscripts HauoliOutskirts_MapScripts {

}

// -------------------------------- Trigger Scripts ------------------------------------
script HauoliOutskirts_Trigger_SightseerMBlocksWest
{
    lock
    applymovement(4, Common_Movement_FaceLeft)
    waitmovement(0)
    emote(4, EMOTE_EXCLAM)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)

    applymovement(4, moves(walk_in_place_left * 2, step_end))
    waitmovement(0)
    setspeaker("Sightseer")
    msgbox(format("Hey- er, Alola! This way leads to Hau'oli City, past the Alola Leo Pokémon School.\p There are some wild Pokémon running loose outside the school. I wouldn't go unless I had some stronger Pokémon with me... That's why I'm waiting for my fiancée to come back!"))
    closemessage
    delay(10)

    applymovement(LOCALID_PLAYER, moves(walk_right, step_end))
    waitmovement(0)
    release
    end
}

script HauoliOutskirts_Trigger_SightseerMBlockSouth
{
    lock
    applymovement(4, Common_Movement_FaceDown)
    waitmovement(0)
    emote(4, EMOTE_EXCLAM)
    applymovement(LOCALID_PLAYER, Common_Movement_FaceUp)
    waitmovement(0)

    applymovement(4, moves(walk_in_place_down * 2, step_end))
    waitmovement(0)
    setspeaker("Sightseer")
    msgbox(format("Hey- er, Alola! That way leads to Professor Kukui's Lab and Ten Carat Hill.\p I saw some wild Pokémon in that grass. I wouldn't go unless I had some stronger Pokémon with me... That's why I'm waiting for my fiancée to come back!"))
    closemessage
    delay(10)

    applymovement(LOCALID_PLAYER, moves(walk_up, step_end))
    waitmovement(0)
    release
    end
}

script HauoliOutskirts_Script_LillieLabEvent
{
    lockall
    applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    emote(LOCALID_PLAYER, EMOTE_QUESTION)
    delay(15)

    createfieldmugshot(MUGSHOT_LILLIE_HAT, EMOTION_OTHER)
    setspeaker("Lillie")
    msgbox(format("{COLOR BLUE}Nebbie{COLOR DARK_GRAY}, you have to stay in the bag! How do you think people will react if they catch a {COLOR BLUE}Cosmog{COLOR DARK_GRAY} wandering around... We don't want {COLOR RED}her{COLOR DARK_GRAY} to find us..."))
    closemessage
    applymovement(12, moves(walk_up, walk_right * 2, walk_down * 2, walk_left, face_up, delay_16, walk_left, walk_up, face_right, delay_16, walk_down, walk_right * 2, walk_up, face_left, step_end)) // Cosmog
    applymovement(11, moves(delay_16, face_up, delay_16 * 2, face_right, delay_16, face_down, delay_16 * 2, face_up, delay_16, face_left, delay_16, step_end)) // Lillie
    waitmovement(12)
    delay(15)
    emote(11, EMOTE_EXCLAM)
    delay(10)
    createfieldmugshot(MUGSHOT_LILLIE_HAT)
    setspeaker("Lillie")
    msgbox(format("{PLAYER}! I- Um, I didn't see you there."))
    closemessage
    applymovement(LOCALID_PLAYER, moves(walk_right, walk_down, walk_right * 3, face_down, step_end))
    applymovement(12, moves(delay_16 * 4, walk_down, walk_left * 2, face_up, jump_in_place_up * 2))
    waitmovement(0)
    delay(15)

    createfieldmugshot(MUGSHOT_LILLIE_HAT)
    setspeaker("Lillie")
    msgbox(format("Ehehe, it looks like {COLOR BLUE}Nebbie{COLOR DARK_GRAY}'s taken an interest in you!"))
    closemessage
    applymovement(LOCALID_PLAYER, Common_Movement_FaceRight)
    waitmovement(0)
    createfieldmugshot(MUGSHOT_LILLIE_HAT)
    setspeaker("Lillie")
    msgbox(format("This is Professor Kukui's Lab! It's... Um...\p Well, it's not the prettiest building, but it serves. Besides, Kukui's research on Pokémon Moves make too much of a mess. A big part of my job as his Assistant is to clean up the rubble..."))
    closemessage
    delay(10)
    applymovement(11, Common_Movement_FaceUp)
    waitmovement(0)
    emote(11, EMOTE_EXCLAM)
    setspeaker("???")
    playmoncry(SPECIES_ROCKRUFF, CRY_MODE_NORMAL)
    msgbox(format("Gruff ruff!"))
    waitmoncry
    closemessage
    setspeaker("Prof. Kukui")
    msgbox(format("Yeah, {COLOR BLUE}Rockruff{COLOR DARK_GRAY}! Use Rock Slide!"))
    closemessage

    delay(10)
    createfieldmugshot(MUGSHOT_LILLIE_HAT)
    setspeaker("Lillie")
    msgbox(format("Not again! Quick, we have to distract him!"))
    closemessage
    applymovement(11, moves(walk_right, walk_up * 4, step_end))
    applymovement(LOCALID_PLAYER, moves(walk_right * 2, walk_up * 4, step_end))
    applymovement(12, moves(walk_up, walk_right * 2, walk_up * 3, step_end))
    waitmovement(LOCALID_PLAYER)

    warpcontinuescript(MAP_HAUOLI_OUTSKIRTS_KUKUI_LAB, 5, 9, HauoliOutskirts_KukuiLab_Script_KukuiGivesDex)

    releaseall
    end
}

// ----------------------------- NPC Scripts -----------------------------

script HauoliOutskirts_Script_SamsonOak
{
    lock
    faceplayer
    createfieldmugshot(MUGSHOT_SAMSON_OAK)
    setspeaker("Grandpa Samson")

    switch(var(VAR_INTRO_STATE))
    {
        case 3: // Just got Starter, headed to Iki Town
        case 4:
        case 5:
        case 6:
        default:
            msgbox(format("Alola, {PLAYER}! How's your Pokémon doing?\p I hope you're settling into the Alola Region. I know it's quite different than Kanto, but give it a chance."))
        case 7: // Got Z-Power Ring at Manalo Festival in Iki Town
            msgbox(format("I saw your battle during the Manalo Festival, you did great!\p Carrying a {COLOR GREEN}Z-Power Ring{COLOR DARK_GRAY} is a big responsibility. I got my own when I was about 18, and did the Island Challenge myself!"))
    }
    
    closemessage
    release
    end
}

script HauoliOutskirts_Script_SightseerM
{
    lock
    faceplayer
    setspeaker("Sightseer")
    msgbox(format("I finally made it to Alola! My fiancée and I are staying in Hau'oli City.\p She wants to explore the tall grass, but I don't have any Pokémon... I think I'll just stay here."))
    closemessage
    release
    end
}

script HauoliOutskirts_Script_LassOnLedge
{
    lock
    faceplayer
    setspeaker("Lady")
    msgbox(format("Are you Samson Oak's grandchild?"))
    closemessage
    createplayerfieldmugshot
    msgbox(format("{SPEAKER NAME_PLAYER}Sure am!"))
    closemessage
    setspeaker("Lady")
    msgbox(format("Oho, charmed! I'd heard his family were moving back to Alola after living in Kanto for years... I had to see for myself!"))
    closemessage
    release
    end
}

