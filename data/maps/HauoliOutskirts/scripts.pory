// --------------------------------- Trainer Scripts ---------------------------------------

script HauoliOutskirts_Trainer_LassMadison
{
	trainerbattle_single(TRAINER_LASS_MADISON, 
	format("We're almost to the beach!"), 
	format("Back to the Pokémon Center for me."))

	setspeaker("Lass Madison")
	msgbox(format("A lot of strange Pokémon live around here. They're my favorites!"))
	closemessage
	release
	end
}

script HauoliOutskirts_Trainer_YoungsterKevin
{
	trainerbattle_single(TRAINER_YOUNGSTER_KEVIN, 
	format("Step back, kid!"), 
	format("Wait, I'm WAY younger than you...!"))

	setspeaker("Youngster Kevin")
	msgbox(format("I wanna catch a Rockruff. I hear if it evolves at night, it turns super scary and cool!"))
	closemessage
	release
	end
}

script HauoliOutskirts_Trainer_SwimmerNatasha
{
	trainerbattle_single(TRAINER_SWIMMER_NATASHA, 
	format("Heyyy-y! Jump in the water with me!"), 
	format("Eek! The water's cold!"))

	setspeaker("Swimmer Natasha")
	msgbox(format("I thought all the water was warm in Alola..."))
	closemessage
	release
	end
}

