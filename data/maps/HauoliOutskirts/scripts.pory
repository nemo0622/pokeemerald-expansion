script HauoliOutskirts_Sign_Directions
{
	lock
	msgbox(format("{LEFT_ARROW} Alola Leo Trainer School\n {LEFT_ARROW} Hau'oli City\p {UP_ARROW} Route 1\n {DOWN_ARROW} Ten Carat Hill"), MSGBOX_SIGN)
	closemessage
	release
	end
}

script HauoliOutskirts_Sign_SeelWatching
{
    lock
    msgbox(format("Alolan Education Tip Number 1:\nPlease watch out for sleeping {COLOR BLUE}Seel{COLOR DARK_GRAY} on the beach!"), MSGBOX_SIGN)
    waitmessage
    msgbox(format("There is more written about {COLOR BLUE}Alolan Seel{COLOR DARK_GRAY}. Read it?"), MSGBOX_YESNO)
    closemessage
    if(var(VAR_RESULT) == TRUE)
    {
        setvar(VAR_0x8003, SPECIES_SEEL)
        special(ShowSpeciesInfoWindow)
        delay(30)
        waitbuttonpress
        special(CloseSpeciesInfoWindow)
    }
    release
    end
}
