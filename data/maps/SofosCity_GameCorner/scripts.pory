mapscripts SofosCity_GameCorner_MapScripts {}

script SofosCity_GameCorner_EventScript_Boy
{
    lock
    faceplayer
    speakername("Boy")
    msgbox(format("This one's my favorite Pinball machine! I can predict how the Meowth moves!"))
    closemessage
    applymovement(1, Common_Movement_FaceOriginalDirection)
    waitmovement(0)
    release
    end
}

