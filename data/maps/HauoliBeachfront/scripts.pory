script HauoliBeachfront_Sign_Taro
{
	lock
	msgbox(format("Alola's First Crops\pTaro roots were grown by the first settlers in Alola, becoming a staple food source for the budding communities.\p Hundreds of years ago, these crops helped feed a prosperous village on the Melemele coastline, which one day grew to become Hau'oli City!"), MSGBOX_SIGN)
	closemessage
	release
	end
}

