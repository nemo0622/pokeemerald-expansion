script HauoliBeachfront_NPC_PKMNBreederWithPikachu
{
	lock
	faceplayer
	setspeaker("{PKMN} Breeder")
	msgbox(format("There are hidden spots of diversity around Alola. Always look for little gaps between trees for secret areas!"))
	closemessage
	release
	end
}

