script HauoliBeachfront_NPC_SightseersWithPyukumuku
{
	lock
	applymovement(14, moves(walk_in_place_right * 2, step_end))
	waitmovement(0)
	setspeaker("Sightseer 1")
	msgbox(format("Look! Catch!"))
	closemessage
	delay(10)
	emote(15, EMOTE_EXCLAM)
	delay(10)
	setspeaker("Sightseer 2")
	msgbox(format("Would you stop?! I know they're squishy, but that's no reason to throw {COLOR BLUE}Pyukumuku{COLOR DARK_GRAY} at me!"))
	closemessage
	release
	end
}

script HauoliBeachfront_NPC_SwimmerWithSister
{
	lock
	faceplayer
	setspeaker("Swimmer")
	if(flag(FLAG_HIDE_CORSOLA_HAUOLI_BEACHFRONT))
	{
		msgbox(format("Thanks again for saving my sister's {COLOR BLUE}Corsola{COLOR DARK_GRAY}. I don't have any Pokémon, but she's grown up side-by-side with it."))
	}
	else
	{
		msgbox(format("Yawn... My sister sure loves her {COLOR BLUE}Corsola{COLOR DARK_GRAY}...\p Hm? Where'd she go?"))
	}
	closemessage
	release
	end
}

