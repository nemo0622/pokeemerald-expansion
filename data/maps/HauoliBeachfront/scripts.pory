mapscripts HauoliBeachfront_MapScripts {

}

// ------------------------------------------ EVENT SCRIPTS ---------------------------------------

script HauoliBeachfront_Event_CorsolaAndMareanie
{
	lock

	// Corsola and Mareanie fighting
	applymovement(LOCALID_HAUOLI_BEACHFRONT_CORSOLA, moves(walk_in_place_slow_right * 3, step_end))
	waitmovement(0)
	setspeaker("Corsola")
    playmoncry(SPECIES_CORSOLA, CRY_MODE_NORMAL)
    msgbox(format("So-sou..."))
    waitmoncry
    closemessage
	delay(10)
	applymovement(LOCALID_HAUOLI_BEACHFRONT_MAREANIE, moves(jump_in_place_left * 2, step_end))
	waitmovement(0)
	setspeaker("Mareanie")
    playmoncry(SPECIES_MAREANIE, CRY_MODE_NORMAL)
    msgbox(format("Re-aie!!"))
    waitmoncry
    closemessage
	delay(10)

	// Swimmer asks you to protect Corsola
	emote(16, EMOTE_EXCLAM)
	applymovement(16, Common_Movement_FaceRight)
	waitmovement(0)
	setspeaker("Swimmer")
	msgbox(format("Hey, that's my sister's {COLOR BLUE}Corsola{COLOR DARK_GRAY}! Is that {COLOR BLUE}Mareanie{COLOR DARK_GRAY} attacking it?!\pYou're a Trainer, right? Please, you have to get rid of that {COLOR BLUE}Mareanie{COLOR DARK_GRAY}!"))
	closemessage
	delay(10)

	// Player approaches Mareanie
	hidefollower
	getplayerxy(VAR_TEMP_1, VAR_TEMP_2)
	switch(var(VAR_TEMP_1))
	{
		case 31:
			applymovement(LOCALID_PLAYER, moves(walk_down, walk_right * 2, face_up, step_end))
		case 32:
			if(var(VAR_TEMP_2) == 37)
			{
				applymovement(LOCALID_PLAYER, moves(walk_left, walk_down * 2, walk_right * 2, face_up, step_end))
			}
			else
			{
				applymovement(LOCALID_PLAYER, moves(walk_right, face_up, step_end))
			}
		case 33:
			if(var(VAR_TEMP_2) == 37)
			{
				applymovement(LOCALID_PLAYER, moves(walk_right, walk_down * 2, walk_left, face_up, step_end))
			}
		case 34:
			applymovement(LOCALID_PLAYER, moves(walk_down, walk_left, face_up, step_end))
		default:
			applymovement(LOCALID_PLAYER, moves(walk_left * 2, face_up, step_end))
	}
	waitmovement(0)
	applymovement(LOCALID_HAUOLI_BEACHFRONT_MAREANIE, Common_Movement_FaceDown)
	waitmovement(0)
	createplayerfieldmugshot(EMOTION_INTENSE)
	msgbox(format("{SPEAKER NAME_PLAYER}Woah! Wild Pokémon fighting is one thing, but I can't let someone's {COLOR BLUE}Corsola{COLOR DARK_GRAY} get hurt. Hold on!"))
	closemessage

	// Battle Mareanie!
	setflag(FLAG_PREVENT_RUNNING)
	setwildbattle(SPECIES_MAREANIE, 10)
    dowildbattle
	clearflag(FLAG_PREVENT_RUNNING)
	setflag(FLAG_HIDE_MAREANIE_HAUOLI_BEACHFRONT)
	removeobject(LOCALID_HAUOLI_BEACHFRONT_MAREANIE)

	// Have a Picnicker appear afterwards to collect the Corsola and thank you,
	// giving you the TM Protect
	clearflag(FLAG_HIDE_PICNICKER_HAUOLI_BEACHFRONT)
	addobject(20)
	delay(30)
	applymovement(20, moves(walk_down * 2, walk_right, walk_down * 3, walk_right, step_end))
	waitmovement(0)
	applymovement(LOCALID_HAUOLI_BEACHFRONT_CORSOLA, Common_Movement_FaceLeft)
	applymovement(LOCALID_PLAYER, Common_Movement_FaceLeft)
	waitmovement(0)
	setspeaker("Picnicker")
	msgbox(format("Shniff... {COLOR BLUE}Corsola{COLOR DARK_GRAY}, you're really okay!\p I just left to buy you a Berry Juice, but I heard my brother shouting, and I got scared..."))
	closemessage
	delay(10)
	applymovement(20, moves(walk_down, walk_right, step_end))
	waitmovement(0)
	setspeaker("Picnicker")
	msgbox(format("In the wild, {COLOR BLUE}Mareanie{COLOR DARK_GRAY} break off and eat pieces of lone {COLOR BLUE}Corsola{COLOR DARK_GRAY}. It must've been waiting behind those rocks...\pThank you so much for helping my Pokémon. Please, take this!"))
	closemessage
	giveitem(ITEM_TM_PROTECT)
	closemessage
	delay(10)
	setspeaker("Picnicker")
	msgbox(format("I'll take {COLOR BLUE}Corsola{COLOR DARK_GRAY} to the Pokémon Center now. Goodbye!"))
	closemessage
	delay(10)
	applymovement(20, moves(walk_left * 6, step_end))
	applymovement(LOCALID_HAUOLI_BEACHFRONT_CORSOLA, moves(walk_down, walk_left * 5, step_end))
	delay(60)
	fadescreenswapbuffers(FADE_TO_BLACK)
	delay(30)
	setflag(FLAG_HIDE_CORSOLA_HAUOLI_BEACHFRONT)
	setflag(FLAG_HIDE_PICNICKER_HAUOLI_BEACHFRONT)
	removeobject(20)
	removeobject(LOCALID_HAUOLI_BEACHFRONT_CORSOLA)
	delay(30)
	fadescreenswapbuffers(FADE_FROM_BLACK)
	delay(20)
	releaseall
	end
}


