script HauoliBeachfront_NPC_BeachShopkeep
{
	lock
    setspeaker("Farmer")
	message(format("Welcome to our Farmer's Market! How can I help ya?"))
	waitmessage
	pokemart(Mart_HauoliBeachfrontMarket)
    setspeaker("Farmer")
	msgbox("Come back soon!")
	release
    end
}

mart Mart_HauoliBeachfrontMarket {
	ITEM_BERRY_JUICE
	ITEM_CASTELIACONE
	ITEM_BIG_MALASADA
}

